      "followers_url": "https://api.github.com/users/kradalby/followers",
      "following_url": "https://api.github.com/users/kradalby/following{/other_user}",
      "gists_url": "https://api.github.com/users/kradalby/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/kradalby/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/kradalby/subscriptions",
      "organizations_url": "https://api.github.com/users/kradalby/orgs",
