    "title": "policy: fix issue where non existent user results in empty ssh pol",
    "user": {
      "login": "kradalby",
      "id": 98431,
      "node_id": "MDQ6VXNlcjk4NDMx",
      "avatar_url": "https://avatars.githubusercontent.com/u/98431?v=4",
