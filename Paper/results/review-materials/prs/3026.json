    "title": "policy: fix asymmetric peer visibility with autogroup:self",
    "user": {
      "login": "kradalby",
      "id": 98431,
      "node_id": "MDQ6VXNlcjk4NDMx",
      "avatar_url": "https://avatars.githubusercontent.com/u/98431?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/kradalby",
      "html_url": "https://github.com/kradalby",
