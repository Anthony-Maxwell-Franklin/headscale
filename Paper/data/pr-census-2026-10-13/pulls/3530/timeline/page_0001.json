[{"sha":"369896a587f110a4bf29a70489f3b9e8716cf1da","node_id":"C_kwDOEFLz89oAKDM2OTg5NmE1ODdmMTEwYTRiZjI5YTcwNDg5ZjNiOWU4NzE2Y2YxZGE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/369896a587f110a4bf29a70489f3b9e8716cf1da","html_url":"https://github.com/juanfont/headscale/commit/369896a587f110a4bf29a70489f3b9e8716cf1da","author":{"name":"Martin -nexus- Mlynář","email":"nexus@smoula.net","date":"2026-10-01T21:52:11Z"},"committer":{"name":"Martin -nexus- Mlynář","email":"nexus@smoula.net","date":"2026-10-03T14:06:07Z"},"tree":{"sha":"d566594c62317c1ac4665a8640ce2a2fdeba500c","url":"https://api.github.com/repos/juanfont/headscale/git/trees/d566594c62317c1ac4665a8640ce2a2fdeba500c"},"message":"state: send relogin of an expired node as a whole node\n\nPeers receive an expired node with Expired=true. On relogin the node key\nrotation was sent as a PeerChange patch, but PeerChange has no Expired\nfield, so peers kept the node expired: the Tailscale client gives an\nexpired peer no AllowedIPs and wireguard-go drops its handshakes, while\ndisco still works. Traffic only resumed once something else sent the\nwhole node, such as a Hostinfo change in the client's next MapRequest,\nwhich is why this does not show up on every relogin.\n\nSend the relogin of a node that was expired as a whole-node add so peers\nclear the flag, on both the interactive and the pre-auth key path.\nRelogins of non-expired nodes keep the patch path.","parents":[{"sha":"eeaac680bef26585c8cc1569f949e26d0d6aba80","url":"https://api.github.com/repos/juanfont/headscale/git/commits/eeaac680bef26585c8cc1569f949e26d0d6aba80","html_url":"https://github.com/juanfont/headscale/commit/eeaac680bef26585c8cc1569f949e26d0d6aba80"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niQIzBAABCgAdFiEEfKImgk9RvnBlABTGG+ROeHcXQ6wFAmrBC88ACgkQG+ROeHcX\nQ6z75Q/9FkNvQW32Wgf/ijEP3JJJ8BbrSeMUgWdUNNMk+6kpkVDeIoNk3iHJX8pg\nyQS5FYP6bgVOUI2egQTfrtcLpCdDNo2FvB5pajLn47yf1E5QZj7GVJB4E4tGxsra\nyey6sgAdsx0FjfHsBfbR94DlmcC/aP8EvfgNUBViBge61lw5nMKxqKpUgPaKIda8\nhSovqiF+rhKpsPklXZPVV/jxWfjD2aESCz17QY9I3fKpMnJ5YSS1VcYvl7TfIgkY\nptpYdJp3JrUc1H+eiQiq7qERorpT6NQgPpYdUoFEMdEvliqjDn3HcCBovA6PPJ13\nZxl1oG4wCG46p62oVN4LSouNIalcScYlZr9YwU5lOzBum7iVxR4bfqPIC4znBPj+\nEtB6/7+5LxdagWeE78NAjJHnJI6VED7Dt7+Bg3nnHM0FC/z4QnEfqjs7UdJCxxJV\nzylliVz6WgZgG53aOFUlgBeIVnIx2pIor699I+U4rgmOd5nYHF2Kw7PNt4agRMpk\nGuZM/yEjS6RW3ly8B8sORmJWc8fzk3FaeJuTK0UZxSiaWjhiFdhHfaLNaMoOBR+7\nBBPIV3TiWijKcFJdC+NO4ojBeX1NDAjvBU9fEASWeXlvyGO0yzdvZ47NW4fVwUKU\nCDQMAuLo3A3kDwl3rNWN+GovXveUZWZepDruxhFhdURTIRz+LV0=\n=rrvu\n-----END PGP SIGNATURE-----","payload":"tree d566594c62317c1ac4665a8640ce2a2fdeba500c\nparent eeaac680bef26585c8cc1569f949e26d0d6aba80\nauthor Martin -nexus- Mlynář <nexus@smoula.net> 1790891531 +0200\ncommitter Martin -nexus- Mlynář <nexus@smoula.net> 1791036367 +0200\n\nstate: send relogin of an expired node as a whole node\n\nPeers receive an expired node with Expired=true. On relogin the node key\nrotation was sent as a PeerChange patch, but PeerChange has no Expired\nfield, so peers kept the node expired: the Tailscale client gives an\nexpired peer no AllowedIPs and wireguard-go drops its handshakes, while\ndisco still works. Traffic only resumed once something else sent the\nwhole node, such as a Hostinfo change in the client's next MapRequest,\nwhich is why this does not show up on every relogin.\n\nSend the relogin of a node that was expired as a whole-node add so peers\nclear the flag, on both the interactive and the pre-auth key path.\nRelogins of non-expired nodes keep the patch path.\n","verified_at":"2026-10-03T14:06:11Z"},"event":"committed"},{"id":32400176801,"node_id":"RRE_lADOEFLz888AAAABUyz5cs8AAAAHizN2oQ","url":"https://api.github.com/repos/juanfont/headscale/issues/events/32400176801","actor":{"login":"nextsux","id":926250,"node_id":"MDQ6VXNlcjkyNjI1MA==","avatar_url":"https://avatars.githubusercontent.com/u/926250?v=4","gravatar_id":"","url":"http