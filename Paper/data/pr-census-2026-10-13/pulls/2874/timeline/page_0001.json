[{"sha":"4b71fa1ae88b53b520209608d75cf677cbda4af0","node_id":"C_kwDOEFLz89oAKDRiNzFmYTFhZTg4YjUzYjUyMDIwOTYwOGQ3NWNmNjc3Y2JkYTRhZjA","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4b71fa1ae88b53b520209608d75cf677cbda4af0","html_url":"https://github.com/juanfont/headscale/commit/4b71fa1ae88b53b520209608d75cf677cbda4af0","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-10T15:57:07Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-10T15:57:07Z"},"tree":{"sha":"e5fab16e72b2a7ac16a018759531e1f59740d274","url":"https://api.github.com/repos/juanfont/headscale/git/trees/e5fab16e72b2a7ac16a018759531e1f59740d274"},"message":"policy: reproduce 2863 in test\n\nreproduce that if a user does not exist, the ssh policy ends up empty\n\nUpdates #2863\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>","parents":[{"sha":"2024219bd10adbb5c0d29f900ed0961ace8cc15c","url":"https://api.github.com/repos/juanfont/headscale/git/commits/2024219bd10adbb5c0d29f900ed0961ace8cc15c","html_url":"https://github.com/juanfont/headscale/commit/2024219bd10adbb5c0d29f900ed0961ace8cc15c"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgmMAoz5Zf+w0nAxyA6/zsNd95cP\n98YbtHIIXyy9A1sssAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQAdBa79Lk2gXh5smYz+msSCnf7Fy5pUsJNOCeKNAWXUfSD/ynsx8/tpJSNvo9Vyf6I\nYORIJo7R5nXhlg5TZhOgE=\n-----END SSH SIGNATURE-----","payload":"tree e5fab16e72b2a7ac16a018759531e1f59740d274\nparent 2024219bd10adbb5c0d29f900ed0961ace8cc15c\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1762790227 +0100\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1762790227 +0100\n\npolicy: reproduce 2863 in test\n\nreproduce that if a user does not exist, the ssh policy ends up empty\n\nUpdates #2863\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>\n","verified_at":"2025-11-10T16:02:52Z"},"event":"committed"},{"sha":"2c740432cedc54b3691299bd6b386e8691a4c4d0","node_id":"C_kwDOEFLz89oAKDJjNzQwNDMyY2VkYzU0YjM2OTEyOTliZDZiMzg2ZTg2OTFhNGM0ZDA","url":"https://api.github.com/repos/juanfont/headscale/git/commits/2c740432cedc54b3691299bd6b386e8691a4c4d0","html_url":"https://github.com/juanfont/headscale/commit/2c740432cedc54b3691299bd6b386e8691a4c4d0","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-10T16:00:03Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-10T16:00:03Z"},"tree":{"sha":"6be266e6e3161c69f621c28f7f3007d7393cffa4","url":"https://api.github.com/repos/juanfont/headscale/git/trees/6be266e6e3161c69f621c28f7f3007d7393cffa4"},"message":"policy: fix issue where non existent user results in empty ssh pol\n\nWhen we encounter a source we cannot resolve, we skipped the whole rule,\neven if some of the srcs could be resolved. In this case, if we had one user\nthat exists and one that does not.\n\nIn the regular policy, we log this, and still let a rule be created from what\ndoes exist, while in the SSH policy we did not.\n\nThis commit fixes it so the behaviour is the same.\n\nFixes #2863\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>","parents":[{"sha":"4b71fa1ae88b53b520209608d75cf677cbda4af0","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4b71fa1ae88b53b520209608d75cf677cbda4af0","html_url":"https://github.com/juanfont/headscale/commit/4b71fa1ae88b53b520209608d75cf677cbda4af0"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgmMAoz5Zf+w0nAxyA6/zsNd95cP\n98YbtHIIXyy9A1sssAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQOiIGU52vtpWYrAGb0jZsUnxhy9lAs4jdAGjOvFaLe8wSKCnQakAsVcY+o/PRYmuMt\nD01nMgeYzbj5xPJOR9AA0=\n-----END SSH SIGNATURE-----","payload":"tree 6be266e6e3161c69f621c28f7f3007d7393cffa4\nparent 4b71fa1ae88b53b520209608d75cf677cbda4af0\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1762790403 +0100\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1762790403 +0100\n\npolicy: fix issue where non existent user results in empty ssh pol\n\nWhen we encounter a source we cannot resolve, we skipped the whole rule,\neven if some of the srcs could be resolved. In this case, if we had one user\nthat exists and one that does not.\n\nIn the regular policy, we log this, and still let a rule be created from what\ndoes exist, while in the SSH policy we did not.\n\nThis commit fixes it so the behaviour is the same.\n\nFixes #2863\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>\n","verified_at":"2025-11-10T16:02:52Z"},"event":"committed"},{"id":20840832872,"node_id":"RRE_lADOEFLz887XGF8uzwAAAATaNd9o","url":"https://api.github.com/repos/juanfont/headscale/issues/events/20840832872","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"review_requested","commit_id":null,"commit_url":null,"created_at":"2025-11-10T16:03:21Z","review_requester":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avat