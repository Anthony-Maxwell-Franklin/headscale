ub.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"performed_via_github_app":null},{"sha":"b07bd37f396649992acde2be335954a01642a1a1","node_id":"C_kwDOEFLz89oAKGIwN2JkMzdmMzk2NjQ5OTkyYWNkZTJiZTMzNTk1NGEwMTY0MmExYTE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/b07bd37f396649992acde2be335954a01642a1a1","html_url":"https://github.com/juanfont/headscale/commit/b07bd37f396649992acde2be335954a01642a1a1","author":{"name":"Lukas Wolfsteiner","email":"lukas@wolfsteiner.media","date":"2026-02-09T01:13:07Z"},"committer":{"name":"Lukas Wolfsteiner","email":"lukas@wolfsteiner.media","date":"2026-02-09T01:15:40Z"},"tree":{"sha":"eebc13a07f5da1b5e5cb9b0ab0989d995cb9b1d7","url":"https://api.github.com/repos/juanfont/headscale/git/trees/eebc13a07f5da1b5e5cb9b0ab0989d995cb9b1d7"},"message":"feat(oidc): add use_email_as_username option to fall back to email claim\n\nSome OIDC providers (e.g. Google OAuth) do not send the\npreferred_username claim when the profile scope is requested,\ncausing the username in Headscale to be blank.\n\nAdd oidc.use_email_as_username config option (default: false) that,\nwhen enabled, uses the email claim as the username if\npreferred_username is not available. When preferred_username is\npresent, it is always used regardless of this setting.\n\n- Add UseEmailAsUsername to OIDCConfig with viper wiring\n- Extend FromClaim() to accept useEmailAsUsername parameter\n- Add 5 test cases covering fallback enabled/disabled, priority,\n  empty email, and unverified email scenarios\n- Update docs, config example, and Google OAuth guidance\n\nFixes #3071.\n\nCheers!","parents":[{"sha":"0f6d312ada15911e3b373e6202df0974818f2cf2","url":"https://api.github.com/repos/juanfont/headscale/git/commits/0f6d312ada15911e3b373e6202df0974818f2cf2","html_url":"https://github.com/juanfont/headscale/commit/0f6d312ada15911e3b373e6202df0974818f2cf2"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":22629939535,"node_id":"HRFPE_lADOEFLz887pSr71zwAAAAVE2XlP","url":"https://api.github.com/repos/juanfont/headscale/issues/events/22629939535","actor":{"login":"dotWee","id":8060356,"node_id":"MDQ6VXNlcjgwNjAzNTY=","avatar_url":"https://avatars.githubusercontent.com/u/8060356?v=4","gravatar_id":"","url":"https://api.github.com/users/dotWee","html_url":"https://github.com/dotWee","followers_url":"https://api.github.com/users/dotWee/followers","following_url":"https://api.github.com/users/dotWee/following{/other_user}","gists_url":"https://api.github.com/users/dotWee/gists{/gist_id}","starred_url":"https://api.github.com/users/dotWee/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dotWee/subscriptions","organizations_url":"https://api.github.com/users/dotWee/orgs","repos_url":"https://api.github.com/users/dotWee/repos","events_url":"https://api.github.com/users/dotWee/events{/privacy}","received_events_url":"https://api.github.com/users/dotWee/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"b07bd37f396649992acde2be335954a01642a1a1","commit_url":"https://api.github.com/repos/dotWee/headscale/commits/b07bd37f396649992acde2be335954a01642a1a1","created_at":"2026-02-09T01:15:55Z","performed_via_github_app":null}]