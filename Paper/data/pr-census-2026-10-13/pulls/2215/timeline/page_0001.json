[{"sha":"50165ce9e1746303a14790fe0b6e9222ca455942","node_id":"C_kwDOEFLz89oAKDUwMTY1Y2U5ZTE3NDYzMDNhMTQ3OTBmZTBiNmU5MjIyY2E0NTU5NDI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/50165ce9e1746303a14790fe0b6e9222ca455942","html_url":"https://github.com/juanfont/headscale/commit/50165ce9e1746303a14790fe0b6e9222ca455942","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2024-10-21T17:58:59Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2024-10-24T03:31:37Z"},"tree":{"sha":"357307553cec35464a5ba65168b5d07bbe2284cc","url":"https://api.github.com/repos/juanfont/headscale/git/trees/357307553cec35464a5ba65168b5d07bbe2284cc"},"message":"resolve user identifier to stable ID\n\ncurrently, the policy approach node to user matching\nwith a quite naive approach looking at the username\nprovided in the policy and matched it with the username\non the nodes. This worked ok as long as usernames were\nunique and did not change.\n\nAs usernames are no longer guarenteed to be unique in\nan OIDC environment we cant rely on this.\n\nThis changes the mechanism that matches the user string\n(now user token) with nodes:\n\n- first find all potential users by looking up:\n  - database ID\n  - provider ID (OIDC)\n  - username/email\n\nIf more than one user is matching, then the query is\nrejected, and zero matching nodes are returned.\n\nWhen a single user is found, the node is matched against\nthe User database ID, which are also present on the actual\nnode.\n\nThis means that from this commit, users can use the following\nto identify users in the policy:\n- provider identity (iss + sub)\n- username\n- email\n- database id\n\nThere are more changes coming to this, so it is not recommended\nto start using any of these new abilities, with the exception\nof email, which will not change since it includes an @.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>","parents":[{"sha":"e2d5ee0927df90ba1ec38ce0726bd3043fa7c372","url":"https://api.github.com/repos/juanfont/headscale/git/commits/e2d5ee0927df90ba1ec38ce0726bd3043fa7c372","html_url":"https://github.com/juanfont/headscale/commit/e2d5ee0927df90ba1ec38ce0726bd3043fa7c372"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAAGgAAAATZWNkc2Etc2hhMi1uaXN0cDI1NgAAAAhuaXN0cDI1NgAAAE\nEE6bT6+U8pNExCb214X9sKtM8QMSqzWb4HmQxm24sqHasMtgza7Cws+M2NoiUVB+RSfa/I\nCoai/Io5VHtD9nbzKgAAAANnaXQAAAAAAAAABnNoYTUxMgAAAGMAAAATZWNkc2Etc2hhMi\n1uaXN0cDI1NgAAAEgAAAAgOUeVeEl5b9rvBmMb9LOxSFyqpVxc0QDoYbOv0yh2r5QAAAAg\nJd3wrxnoX90VPiNYyEZIo/VEs64HaZ1m+oLQ6Cx16Os=\n-----END SSH SIGNATURE-----","payload":"tree 357307553cec35464a5ba65168b5d07bbe2284cc\nparent e2d5ee0927df90ba1ec38ce0726bd3043fa7c372\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1729533539 -0600\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1729740697 -0500\n\nresolve user identifier to stable ID\n\ncurrently, the policy approach node to user matching\nwith a quite naive approach looking at the username\nprovided in the policy and matched it with the username\non the nodes. This worked ok as long as usernames were\nunique and did not change.\n\nAs usernames are no longer guarenteed to be unique in\nan OIDC environment we cant rely on this.\n\nThis changes the mechanism that matches the user string\n(now user token) with nodes:\n\n- first find all potential users by looking up:\n  - database ID\n  - provider ID (OIDC)\n  - username/email\n\nIf more than one user is matching, then the query is\nrejected, and zero matching nodes are returned.\n\nWhen a single user is found, the node is matched against\nthe User database ID, which are also present on the actual\nnode.\n\nThis means that from this commit, users can use the following\nto identify users in the policy:\n- provider identity (iss + sub)\n- username\n- email\n- database id\n\nThere are more changes coming to this, so it is not recommended\nto start using any of these new abilities, with the exception\nof email, which will not change since it includes an @.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>\n","verified_at":"2024-11-07T21:48:06Z"},"event":"committed"},{"sha":"6afb554e20cb06ed535ce9abd29a7abbdb8a72e4","node_id":"C_kwDOEFLz89oAKDZhZmI1NTRlMjBjYjA2ZWQ1MzVjZTlhYmQyOWE3YWJiZGI4YTcyZTQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/6afb554e20cb06ed535ce9abd29a7abbdb8a72e4","html_url":"https://github.com/juanfont/headscale/commit/6afb554e20cb06ed535ce9abd29a7abbdb8a72e4","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2024-10-26T16:42:14Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2024-10-26T16:42:14Z"},"tree":{"sha":"0e88a268c5b1675e2d23a316f27aea778d5b87fc","url":"https://api.github.com/repos/juanfont/headscale/git/trees/0e88a268c5b1675e2d23a316f27aea778d5b87fc"},"message":"wrap policy in policy manager interface\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>","parents":[{"sha":"50165ce9e1746303a14790fe0b6e9222ca455942","url":"https://api.github.com/repos/juanfont/headscale/git/commits/50165ce9e1746303a14790fe0b6e9222ca455942","html_url":"https://github.com/juanfont/headscale/commit/50165ce9e1746303a14790fe0b6e9222ca455942"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAAGgAAAATZWNkc2Etc2hhMi1uaXN0cDI1NgAAAAhuaXN0cDI1NgAAAE\nEE6bT6+U8pNExCb214X9sKtM8QMSqzWb4HmQxm24sqHasMtgza7Cws+M2NoiUVB+RSfa/I\nCoai/Io5VHtD9nbzKgAAAANnaXQAAAAAAAAABnNoYTUxMgAAAGQAAAATZWNkc2Etc2hhMi\n1uaXN0cDI1NgAAAEkAAAAgIev6Fk/A6327LqENfkRaLXmh/CGDg1jQcODxyQcFF9EAAAAh\nALfWwNbAXafj3Qt/y644bjbZNP44PDuqSq5c41ikdghj\n-----END SSH SIGNATURE-----","payload":"tree 0e88a268c5b1675e2d23a316f27aea778d5b87fc\nparent 50165ce9e1746303a14790fe0b6e9222ca455942\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1729960934 -0500\ncommitter Kristoffer Dalby <krist