itializes machine key's expiry time with `&time.Time{}`. This is formatted to, `0001-01-01T00:00:00Z`(in RFC3339 format). \r\n\r\nThis means, The keys expiry time will always be in the past and clients will be stuck in a loop renewing the key. \r\n\r\nThis PR addresses this problem by adding a minimum validity of 60 minutes to the generated keys. \r\n\r\n","created_at":"2022-08-24T20:18:48Z","updated_at":"2023-09-24T20:57:47Z","closed_at":"2023-09-24T20:57:46Z","merged_at":null,"merge_commit_sha":"ffed7385f623f19afc904fb3112dcdb089858886","assignees":[],"requested_reviewers":[{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false}],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/juanfont/headscale/pulls/765/commits","review_comments_url":"https://api.github.com/repos/juanfont/headscale/pulls/765/comments","review_comment_url":"https://api.github.com/repos/juanfont/headscale/pulls/comments{/number}","comments_url":"https://api.github.com/repos/juanfont/headscale/issues/765/comments","statuses_url":"https://api.github.com/repos/juanfont/headscale/statuses/8d