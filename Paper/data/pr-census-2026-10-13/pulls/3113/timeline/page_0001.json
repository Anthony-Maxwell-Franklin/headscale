[{"sha":"ab6f730afea8e74766e75a617c3598ad4eef03c7","node_id":"C_kwDOEFLz89oAKGFiNmY3MzBhZmVhOGU3NDc2NmU3NWE2MTdjMzU5OGFkNGVlZjAzYzc","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ab6f730afea8e74766e75a617c3598ad4eef03c7","html_url":"https://github.com/juanfont/headscale/commit/ab6f730afea8e74766e75a617c3598ad4eef03c7","author":{"name":"cobyfrombrooklyn-bot","email":"cobyfrombrooklyn@gmail.com","date":"2026-02-26T21:49:01Z"},"committer":{"name":"cobyfrombrooklyn-bot","email":"cobyfrombrooklyn@gmail.com","date":"2026-02-26T21:49:01Z"},"tree":{"sha":"9b665728f3b51fcea075d941d42e735f22073148","url":"https://api.github.com/repos/juanfont/headscale/git/trees/9b665728f3b51fcea075d941d42e735f22073148"},"message":"fix: OIDC expiry 0 now sets nil expiry instead of far-future date\n\nWhen oidc.expiry is set to 0, the intent is 'no expiry'. Previously,\nthis was represented as MaxDuration (~292 years), which resulted in a\nfar-future date in the database. Clients like Headplane couldn't\ndistinguish this from an actual expiry.\n\nNow determineNodeExpiry returns zero time for MaxDuration, and\nhandleRegistration passes nil to HandleNodeFromAuthPath when the\nexpiry is zero, resulting in NULL in the database.\n\nExported MaxDuration from types package for use in the check.\nAdded TestDetermineNodeExpiry with three cases.\n\nFixes #3111","parents":[{"sha":"84adda226be25cc9e3240d39ef5b56627ade6a47","url":"https://api.github.com/repos/juanfont/headscale/git/commits/84adda226be25cc9e3240d39ef5b56627ade6a47","html_url":"https://github.com/juanfont/headscale/commit/84adda226be25cc9e3240d39ef5b56627ade6a47"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":23118104648,"node_id":"RRE_lADOEFLz887uS4uHzwAAAAVh8khI","url":"https://api.github.com/repos/juanfont/headscale/issues/events/23118104648","actor":{"login":"cobyfrombrooklyn-bot","id":262706804,"node_id":"U_kgDOD6iWdA","avatar_url"