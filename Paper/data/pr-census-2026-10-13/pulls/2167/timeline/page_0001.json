[{"sha":"86e277003160f03dbf1548fbb88284fe9286c8b3","node_id":"C_kwDOEFLz89oAKDg2ZTI3NzAwMzE2MGYwM2RiZjE1NDhmYmI4ODI4NGZlOTI4NmM4YjM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/86e277003160f03dbf1548fbb88284fe9286c8b3","html_url":"https://github.com/juanfont/headscale/commit/86e277003160f03dbf1548fbb88284fe9286c8b3","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2024-10-03T07:18:13Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2024-10-03T07:18:13Z"},"tree":{"sha":"986098c2ad55676fa55ced3ae906ed67d318a8e7","url":"https://api.github.com/repos/juanfont/headscale/git/trees/986098c2ad55676fa55ced3ae906ed67d318a8e7"},"message":"make reauth test compat with tailscale head\n\ntailscale/tailscale@1eaad7d broke our reauth test as it makes the client\nretry with https/443 if it reconnects within 2 minutes.\n\nThis commit fixes this by running the test as a two part,\n- with https, to confirm instant reconnect works\n- with http, and a 3 min wait, to check that it work without.\n\nThe change is not a general consern as headscale in prod is ran\nwith https.\n\nUpdates #2164\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>","parents":[{"sha":"e16ea2ee6995667ce7db872ad353f8b31146c80c","url":"https://api.github.com/repos/juanfont/headscale/git/commits/e16ea2ee6995667ce7db872ad353f8b31146c80c","html_url":"https://github.com/juanfont/headscale/commit/e16ea2ee6995667ce7db872ad353f8b31146c80c"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAAGgAAAATZWNkc2Etc2hhMi1uaXN0cDI1NgAAAAhuaXN0cDI1NgAAAE\nEE6bT6+U8pNExCb214X9sKtM8QMSqzWb4HmQxm24sqHasMtgza7Cws+M2NoiUVB+RSfa/I\nCoai/Io5VHtD9nbzKgAAAANnaXQAAAAAAAAABnNoYTUxMgAAAGQAAAATZWNkc2Etc2hhMi\n1uaXN0cDI1NgAAAEkAAAAgexoepmBnQn1eIj5Jav3J0amOMdpRf9svfyEgSBen/y8AAAAh\nAOMKab8Q7Qya9/6QcXVimE3toIK9JovcPTUfonYi9197\n-----END SSH SIGNATURE-----","payload":"tree 986098c2ad55676fa55ced