[{"sha":"5b444ff37a31247416dba456c081e60c113e6853","node_id":"C_kwDOEFLz89oAKDViNDQ0ZmYzN2EzMTI0NzQxNmRiYTQ1NmMwODFlNjBjMTEzZTY4NTM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/5b444ff37a31247416dba456c081e60c113e6853","html_url":"https://github.com/juanfont/headscale/commit/5b444ff37a31247416dba456c081e60c113e6853","author":{"name":"Alberindo Loffrè","email":"albethedev@gmail.com","date":"2026-08-17T21:44:37Z"},"committer":{"name":"Alberindo Loffrè","email":"albethedev@gmail.com","date":"2026-08-17T21:44:37Z"},"tree":{"sha":"684a38ce2df495396ef3ee4ffa76c3c9d5ff8d1d","url":"https://api.github.com/repos/juanfont/headscale/git/trees/684a38ce2df495396ef3ee4ffa76c3c9d5ff8d1d"},"message":"hscontrol: add setUser to change a user's display name, email and picture\n\nHeadscale already carries DisplayName and ProfilePicURL end to end, into\ntailcfg.UserProfile and out to clients, but they could only be set when the\nuser was created. Correcting a display name or adding an avatar afterwards\nmeant destroying and recreating the user, which is impossible once the user\nowns nodes.\n\nAdd PUT /api/v1/user/{id}. The request body fields are pointers so that an\nabsent field is left unchanged while an explicit empty string clears the\nvalue: removing an avatar is a real operation, and GORM's struct-based\nUpdates() skips zero values, so the write goes through a column map instead.\nThe picture URL must be an absolute http(s) URL, since Headscale hands it to\nevery client's user interface.\n\nOIDC-provisioned users are refused, reusing ErrCannotChangeOIDCUser from the\nrename path: FromClaim overwrites all three fields on every login, so a\nmanual edit would be silently reverted.\n\nFix two defects the write path exposed in State.UpdateUser, which affected\nrename and OIDC re-login as much as this feature:\n\n  - types.Node embeds its owning types.User and the mapper reads the owner\n    from the NodeStore snapshot, not the database, so a profile change was\n    invisible to connected nodes until the server restarted. Refresh the\n    cached copies in one UpdateNodes batch. This resolves the TODO left in\n    UpdateUser.\n  - The returned change was whatever the policy manager reported, which is\n    empty when the policy does not reference the user, so no map update was\n    sent. Return a full update when a client-visible field actually changed.\n    The comparison matters: OIDC calls UpdateUser on every login, and\n    broadcasting a full update to every node each time would be a\n    regression.\n\nUpdates #2166\n\nCo-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>","parents":[{"sha":"565fd254d06c4c7f9a8cad1714a43445c79ba420","url":"https://api.github.com/repos/juanfont/headscale/git/commits/565fd254d06c4c7f9a8cad1714a43445c79ba420","html_url":"https://github.com/juanfont/headscale/commit/565fd254d06c4c7f9a8cad1714a43445c79ba420"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"7988a181c47822e10d080d82749eb70ae4af69f1","node_id":"C_kwDOEFLz89oAKDc5ODhhMTgxYzQ3ODIyZTEwZDA4MGQ4Mjc0OWViNzBhZTRhZjY5ZjE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7988a181c47822e10d080d82749eb70ae4af69f1","html_url":"https://github.com/juanfont/headscale/commit/7988a181c47822e10d080d82749eb70ae4af69f1","author":{"name":"Alberindo Loffrè","email":"albethedev@gmail.com","date":"2026-08-17T21:44:48Z"},"committer":{"name":"Alberindo Loffrè","email":"albethedev@gmail.com","date":"2026-08-17T21:44:48Z"},"tree":{"sha":"f78555ee3e5b9b9fb533703966197ae47fa308e7","url":"https://api.github.com/repos/juanfont/headscale/git/trees/f78555ee3e5b9b9fb533703966197ae47fa308e7"},"message":"gen: regenerate the v1 client for setUser\n\nOutput of `make client` after adding the setUser operation.\n\nCo-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>","parents":[{"sha":"5b444ff37a31247416dba456c081e60c113e6853","url":"https://api.github.com/repos/juanfont/headscale/git/commits/5b444ff37a31247416dba456c081e60c113e6853","html_url":"https://github.com/juanfont/headscale/commit/5b444ff37a31247416dba456c081e60c113e6853"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"7bddd0b41f1f4cee71008f05b93edbf48805e26e","node_id":"C_kwDOEFLz89oAKDdiZGRkMGI0MWYxZjRjZWU3MTAwOGYwNWI5M2VkYmY0ODgwNWUyNmU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7bddd0b41f1f4cee71008f05b93edbf48805e26e","html_url":"https://github.com/juanfont/headscale/commit/7bddd0b41f1f4cee71008f05b93edbf48805e26e","author":{"name":"Alberindo Loffrè","email":"albethedev@gmail.com","date":"2026-08-17T21:44:48Z"},"committer":{"name":"Alberindo Loffrè","email":"albethedev@gmail.com","date":"2026-08-17T21:44:48Z"},"tree":{"sha":"70cd9b51a314c9910fe3143d8523180f4914cbef","url":"https://api.github.com/repos/juanfont/headscale/git/trees/70cd9b51a314c9910fe3143d8523180f4914cbef"},"message":"cli: add `headscale users set`\n\nSets the display name, email and profile picture URL of an existing user,\nselected with the same --identifier/--name flags as rename and destroy:\n\n    headscale users set -i 1 --display-name \"Vika\" --picture-url \"https://…\"\n    headscale users set -n vika --picture-url \"\"\n\nOnly the flags that were passed are sent. Flags().Changed is what separates\n\"leave this field alone\" from \"clear this field\"; an empty-string check\nalone cannot express the difference.\n\n`users create` now validates --picture-url with the same rule as the API\ninstead of url.Parse, which accepts almost anything and so never rejected a\nbad value.\n\nTestUserSetCommand covers the happy path, clearing, and the validation\nerrors, and asserts the new profile reaches the connected node's netmap as\ntailcfg.UserProfile — the point of the feature is what the client renders,\nnot what the API returns.\n\nUpdates #2166\n\nCo-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>","parents":[{"sha":"7988a181c47822e10d080d82749eb70ae4af69f1","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7988a181c47822e10d080d82749eb70ae4af69f1","html_url":"https://github.com/juanfont/headscale/commit/7988a181c47822e10d080d82749eb70ae4af69f1"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"c0dd45375110712a54f8e24a283b7c1bd24478fa","node_id":"C_kwDOEFLz89oAKGMwZGQ0NTM3NTExMDcxMmE1NGY4ZTI0YTI4M2I3YzFiZDI0NDc4ZmE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c0dd45375110712a54f8e24a283b7c1bd24478fa","html_url":"https://github.com/juanfont/headscale/commit/c0dd45375110712a54f8e24a283b7c1bd24478fa","author":{"name":"Alberindo Loffrè","email":"albethedev@gmail.com","date":"2026-08-17T21:44:48Z"},"committer":{"name":"Alberindo Loffrè","email":"albethedev@gmail.com","date":"2026-08-17T21:44:48Z"},"tree":{"sha":"36663f6ae251ee826096075a2062d94e0db3afbf","url":"https://api.github.com/repos/juanfont/headscale/git/trees/36663f6ae251ee826096075a2062d94e0db3afbf"},"message":"docs: document setting user profile fields\n\nUpdates #2166\n\nCo-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>","parents":[{"sha":"7bddd0b41f1f4cee71008f05b93edbf48805e26e","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7bddd0b41f1f4cee71008f05b93edbf48805e26e","html_url":"https://github.com/juanfont/headscale/commit/7bddd0b41f1f4cee71008f05b93edbf48805e26e"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":29585082722,"node_id":"RRE_lADOEFLz888AAAABNIJzNM8AAAAG42iJYg","url":"https://api.github.com/repos/juanfont/headscale/issues/events/29585082722","actor":{"login":"albedev","id":25616798,"node_id":"MDQ6VXNlcjI1NjE2Nzk4","avatar_url":"https://avatars.githubusercontent.com/u/25616798?v=4","gravatar_i