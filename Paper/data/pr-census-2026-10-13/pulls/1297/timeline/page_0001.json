used":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false}},{"sha":"dde736a16a0454284996ee32c2c171c686391a20","node_id":"C_kwDOEFLz89oAKGRkZTczNmExNmEwNDU0Mjg0OTk2ZWUzMmMyYzE3MWM2ODYzOTFhMjA","url":"https://api.github.com/repos/juanfont/headscale/git/commits/dde736a16a0454284996ee32c2c171c686391a20","html_url":"https://github.com/juanfont/headscale/commit/dde736a16a0454284996ee32c2c171c686391a20","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2023-03-28T16:43:33Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2023-04-06T11:32:09Z"},"tree":{"sha":"11de8046663109b4cb3fbac0884a1abb9eefeabb","url":"https://api.github.com/repos/juanfont/headscale/git/trees/11de8046663109b4cb3fbac0884a1abb9eefeabb"},"message":"Simplify goreleaser, package deb and rpm\n\nThis commit simplifies the goreleaser configuration and then adds nfpm\nsupport which allows us to build .deb and .rpm for each of the ARCH we\nsupport.\n\nThe deb and rpm packages adds systemd services and users, creates\ndirectories etc and should in general give the user a working\nenvironment. We should be able to remove a lot of the complicated,\nPEBCAK inducing documentation after this.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>","parents":[{"sha":"dfc5d861c727ba63adabf3a5edc7fe76ba60b0b7","url":"https://api.github.com/repos/juanfont/headscale/git/commits/dfc5d861c727ba63adabf3a5edc7fe76ba60b0b7","html_url":"https://github.com/juanfont/headscale/commit/dfc5d861c727ba63adabf3a5edc7fe76ba60b0b7"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAAGgAAAATZWNkc2Etc2hhMi1uaXN0cDI1NgAAAAhuaXN0cDI1NgAAAE\nEE6bT6+U8pNExCb214X9sKtM8QMSqzWb4HmQxm24sqHasMtgza7Cws+M2NoiUVB+RSfa/I\nCoai/Io5VHtD9nbzKgAAAANnaXQAAAAAAAAABnNoYTUxMgAAAGQAAAATZWNkc2Etc2hhMi\n1uaXN0cDI1NgAAAEkAAAAhAOraN3LUqyk/LXcBbuDLcpqfgfEfL5FjHJlvOMhP3BiNAAAA\nIDqCp68pzxvSya7izdeSIxIZHWtSLrkokhX5lMP8gG7r\n-----END SSH SIGNATURE-----","payload":"tree 11de8046663109b4cb3fbac0884a1abb9eefeabb\nparent dfc5d861c727ba63adabf3a5edc7fe76ba60b0b7\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1680021813 +0200\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1680780729 +0200\n\nSimplify goreleaser, package deb and rpm\n\nThis commit simplifies the goreleaser configuration and then adds nfpm\nsupport which allows us to build .deb and .rpm for each of the ARCH we\nsupport.\n\nThe deb and rpm packages adds systemd services and users, creates\ndirectories etc and should in general give the user a working\nenvironment. We should be able to remove a lot of the complicated,\nPEBCAK inducing documentation after this.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>\n","verified_at":"2024-11-21T14:01:46Z"},"event":"committed"},{"id":8944970445,"node_id":"HRFPE_lADOEFLz885iAn2QzwAAAAIVKWrN","url":"https://api.github.com/repos/juanfont/headscale/issues/events/8944970445","actor":{"login":"kradalby","id":98431,"node_id