rs/arnarg/followers","following_url":"https://api.github.com/users/arnarg/following{/other_user}","gists_url":"https://api.github.com/users/arnarg/gists{/gist_id}","starred_url":"https://api.github.com/users/arnarg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arnarg/subscriptions","organizations_url":"https://api.github.com/users/arnarg/orgs","repos_url":"https://api.github.com/users/arnarg/repos","events_url":"https://api.github.com/users/arnarg/events{/privacy}","received_events_url":"https://api.github.com/users/arnarg/received_events","type":"User","user_view_type":"public","site_admin":false},"body":null,"commit_id":"85f8f9524d96f34dc10acd5332bbbc67313fca1f","state":"commented","html_url":"https://github.com/juanfont/headscale/pull/940#pullrequestreview-1171078219","pull_request_url":"https://api.github.com/repos/juanfont/headscale/pulls/940","_links":{"html":{"href":"https://github.com/juanfont/headscale/pull/940#pullrequestreview-1171078219"},"pull_request":{"href":"https://api.github.com/repos/juanfont/headscale/pulls/940"}},"submitted_at":"2022-11-07T20:51:15Z","updated_at":"2022-11-07T20:51:15Z","author_association":"CONTRIBUTOR","event":"reviewed"},{"url":"https://api.github.com/repos/juanfont/headscale/issues/comments/1307595735","html_url":"https://github.com/juanfont/headscale/pull/940#issuecomment-1307595735","issue_url":"https://api.github.com/repos/juanfont/headscale/issues/940","id":1307595735,"node_id":"IC_kwDOEFLz885N8FPX","user":{"login":"arnarg","id":1291396,"node_id":"MDQ6VXNlcjEyOTEzOTY=","avatar_url":"https://avatars.githubusercontent.com/u/1291396?v=4","gravatar_id":"","url":"https://api.github.com/users/arnarg","html_url":"https://github.com/arnarg","followers_url":"https://api.github.com/users/arnarg/followers","following_url":"https://api.github.com/users/arnarg/following{/other_user}","gists_url":"https://api.github.com/users/arnarg/gists{/gist_id}","starred_url":"https://api.github.com/users/arnarg/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arnarg/subscriptions","organizations_url":"https://api.github.com/users/arnarg/orgs","repos_url":"https://api.github.com/users/arnarg/repos","events_url":"https://api.github.com/users/arnarg/events{/privacy}","received_events_url":"https://api.github.com/users/arnarg/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-11-08T17:40:21Z","updated_at":"2022-11-08T17:40:21Z","body":"I updated some of the code as I wasn't happy with everything and I realized that in `getMapResponseDNSConfig` the dnsConfigOrig is only cloned when if magic dns is enabled. I believe NextDNS resolver can be enabled without magic DNS but as is it will overwrite the resolver in the global config, appending machine specific config over and over again.\r\n\r\nWhat do you think would be more appropriate to resolve that.\r\n\r\n- Only do the machine config appending to the nextdns resolver when magic DNS is enabled\r\n- _Always_ clone the `dnsConfigOrig` in case there is a nextdns resolver in there that needs to be modified for the machine\r\n\r\nI personally think the second would be better as the DoH resolvers don't have much to do with magic DNS.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/juanfont/headscale/issues/comments/1307595735/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"arnarg","id":1291396,"node_id":"MDQ6VXNlcjEyOTEzOTY=","avatar_url":"https://avatars.githubusercontent.com/u/1291396?v=4","gravatar_id":"","url":"https://api.github.com/users/arnarg","html_url":"https://github.com/arnarg","followers_url":"https://api.github.com/users/arnarg/followers","following_url":"https://api.github.com/users/arnarg/following{/other_user}","gists_url":"https://api.github.com/users/arnarg/gists{/gist_id}","st