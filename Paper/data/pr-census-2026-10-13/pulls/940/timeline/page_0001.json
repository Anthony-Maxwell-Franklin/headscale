b7be74756e23d4385a91a9608fd68eddd5a249a/net/dns/publicdns/publicdns.go#L42","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/juanfont/headscale/issues/comments/1309073283/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"iSchluff","id":1429641,"node_id":"MDQ6VXNlcjE0Mjk2NDE=","avatar_url":"https://avatars.githubusercontent.com/u/1429641?v=4","gravatar_id":"","url":"https://api.github.com/users/iSchluff","html_url":"https://github.com/iSchluff","followers_url":"https://api.github.com/users/iSchluff/followers","following_url":"https://api.github.com/users/iSchluff/following{/other_user}","gists_url":"https://api.github.com/users/iSchluff/gists{/gist_id}","starred_url":"https://api.github.com/users/iSchluff/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/iSchluff/subscriptions","organizations_url":"https://api.github.com/users/iSchluff/orgs","repos_url":"https://api.github.com/users/iSchluff/repos","events_url":"https://api.github.com/users/iSchluff/events{/privacy}","received_events_url":"https://api.github.com/users/iSchluff/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/juanfont/headscale/issues/comments/1309220719","html_url":"https://github.com/juanfont/headscale/pull/940#issuecomment-1309220719","issue_url":"https://api.github.com/repos/juanfont/headscale/issues/940","id":1309220719,"node_id":"IC_kwDOEFLz885OCR9v","user":{"login":"arnarg","id":1291396,"node_id":"MDQ6VXNlcjEyOTEzOTY=","avatar_url":"https://avatars.githubusercontent.com/u/1291396?v=4","gravatar_id":"","url":"https://api.github.com/users/arnarg","html_url":"https://github.com/arnarg","followers_url":"https://api.github.com/users/arnarg/followers","following_url":"https://api.github.com/users/arnarg/following{/other_user}","gists_url