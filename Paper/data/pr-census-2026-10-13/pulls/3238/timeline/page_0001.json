[{"id":25031849963,"node_id":"HRFPE_lADOEFLz888AAAABA7NkLc8AAAAF1AO36w","url":"https://api.github.com/repos/juanfont/headscale/issues/events/25031849963","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"11f5a4d49a5c86d98a29da0c18eaa47657dca6ed","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/11f5a4d49a5c86d98a29da0c18eaa47657dca6ed","created_at":"2026-04-30T11:41:08Z","performed_via_github_app":null},{"sha":"e0b70c50fa1ef4bee9dea7d3f013e6364829cc6e","node_id":"C_kwDOEFLz89oAKGUwYjcwYzUwZmExZWY0YmVlOWRlYTdkM2YwMTNlNjM2NDgyOWNjNmU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/e0b70c50fa1ef4bee9dea7d3f013e6364829cc6e","html_url":"https://github.com/juanfont/headscale/commit/e0b70c50fa1ef4bee9dea7d3f013e6364829cc6e","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-30T11:40:29Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-30T11:53:13Z"},"tree":{"sha":"b81bbbdd2e36dffbacedf9c85d697856c809d5e5","url":"https://api.github.com/repos/juanfont/headscale/git/trees/b81bbbdd2e36dffbacedf9c85d697856c809d5e5"},"message":"policy/v2: surface autogroup:internet via grants on exit nodes\n\nA grant of the form `{src: alice, dst: autogroup:internet, via:\ntag:exit1}` was loading without error but stripping every exit node\nfrom alice's view: `tailscale exit-node list` returned \"no exit nodes\nfound\".\n\nTwo sites skipped autogroup:internet at the compile / steering layer:\ncompileViaForNode's *AutoGroup arm produced no FilterRule for the\nvia-tagged exit node, and ViaRoutesForPeer's *AutoGroup arm produced\nno Include/Exclude. With pm.needsPerNodeFilter true, the exit node's\nmatchers were empty, BuildPeerMap could not link source to exit, and\nRoutesForPeer's ReduceRoutes stripped 0.0.0.0/0 and ::/0 from\nAllowedIPs.\n\nThe skip belongs at the wire-format layer (ReduceFilterRules), not at\nthe compile layer that also feeds internal matchers. Lift\nautogroup:internet handling into both *AutoGroup arms with the same\nshape used for *Prefix destinations: emit a TheInternet rule on\nvia-tagged exit advertisers; surface peer.ExitRoutes() in Include\nwhen the peer carries the via tag, Exclude otherwise.\nReduceFilterRules continues to keep the rule on exit-route\nadvertisers' wire output and strip it elsewhere, preserving SaaS\nPacketFilter encoding.\n\nAlso drop compileViaForNode's early len(SubnetRoutes)==0 return:\nSubnetRoutes excludes exit routes, so the early return pre-empted the\nautogroup:internet branch on nodes that only advertise exit routes.\n\nExisting tests pinning the buggy behaviour (TestViaRoutesForPeer\nsubtests, TestCompileViaGrant case) flipped to the new contract.\n\nFixes #3233","parents":[{"sha":"ecaf56e0a0b2717779b96e1f8300c60587461387","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ecaf56e0a0b2717779b96e1f8300c60587461387","html_url":"https://github.com/juanfont/headscale/commit/ecaf56e0a0b2717779b96e1f8300c60587461387"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":25032368995,"node_id":"HRFPE_lADOEFLz888AAAABA7NkLc8AAAAF1AujYw","url":"https://api.github.com/repos/juanfont/headscale/issues/events/25032368995","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"08b18d9dd445ae4414deb033f374113a58a95bd2","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/08b18d9dd445ae4414deb033f374113a58a95bd2","created_at":"2026-04-30T11:56:41Z","performed_via_github_app":null},{"sha":"143b5a47d0f07378a9a6dc5cec5f54fde940c599","node_id":"C_kwDOEFLz89oAKDE0M2I1YTQ3ZDBmMDczNzhhOWE2ZGM1Y2VjNWY1NGZkZTk0MGM1OTk","url":"https://api.github.com/repos/juanfont/headscale/git/commits/143b5a47d0f07378a9a6dc5cec5f54fde940c599","html_url":"https://github.com/juanfont/headscale/commit/143b5a47d0f07378a9a6dc5cec5f54fde940c599","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-30T11:40:43Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-30T13:58:39Z"},"tree":{"sha":"a78f65d14462ba8ecc25c940723d7892558cd6e9","url":"https://api.github.com/repos/juanfont/headscale/git/trees/a78f65d14462ba8ecc25c940723d7892558cd6e9"},"message":"servertest: cover via-grant exit-node visibility end-to-end\n\nTestGrantViaExitNodeInternetVisibility boots a server, applies a\npolicy that scopes autogroup:internet to a tag, registers a tagged\nexit advertiser and a regular client, and asserts the client's netmap\nsurfaces the exit node with 0.0.0.0/0 and ::/0 in AllowedIPs — the\nsubstrate the Tailscale client reads to populate\n`tailscale exit-node list`.\n\nTestGrantViaExitNodeNoFilterRules retains its assertion (literal /0\nabsent from the exit node's PacketFilter, matching SaaS PacketFilter\nencoding); only its docstring is updated to reflect that the exit\nnode now does receive a TheInternet-shaped rule, just not the\nliteral /0 form.\n\nUpdates #3233","parents":[{"sha":"e0b70c50fa1ef4bee9dea7d3f013e6364829cc6e","url":"https://api.github.com/repos/juanfont/headscale/git/commits/e0b70c50fa1ef4bee9dea7d3f013e6364829cc6e","html_url":"https://github.com/juanfont/headscale/commit/e0b70c50fa1ef4bee9dea7d3f013e6364829cc6e"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":25036989961,"node_id":"HRFPE_lADOEFLz888AAAABA7NkLc8AAAAF1FImCQ","url":"https://api.github.com/repos/juanfont/headscale/issues/events/25036989961","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscripti