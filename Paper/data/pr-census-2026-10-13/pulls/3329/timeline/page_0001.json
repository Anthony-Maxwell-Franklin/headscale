GEyNDQ4NjQxZmQyM2M","url":"https://api.github.com/repos/juanfont/headscale/git/commits/d4c227b4afbddd022dbd6f1d168a2448641fd23c","html_url":"https://github.com/juanfont/headscale/commit/d4c227b4afbddd022dbd6f1d168a2448641fd23c","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-20T20:16:51Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-20T20:16:51Z"},"tree":{"sha":"dfd05513081e2153e5d0c0fa9b1ce49a2b9d951e","url":"https://api.github.com/repos/juanfont/headscale/git/trees/dfd05513081e2153e5d0c0fa9b1ce49a2b9d951e"},"message":"db: add API-key owner and pre-auth-key description for v2\n\nGive API keys an optional owning user and pre-auth keys a free-text\ndescription, plus the state accessors the v2 API needs to act as a\nkey's owner and to persist descriptions.","parents":[{"sha":"e4b599a17ad3cd52b85e8c25bc08196b3e4cdcd7","url":"https://api.github.com/repos/juanfont/headscale/git/commits/e4b599a17ad3cd52b85e8c25bc08196b3e4cdcd7","html_url":"https://github.com/juanfont/headscale/commit/e4b599a17ad3cd52b85e8c25bc08196b3e4cdcd7"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"4740e47d78b964fd045a04535430f62bacb24c64","node_id":"C_kwDOEFLz89oAKDQ3NDBlNDdkNzhiOTY0ZmQwNDVhMDQ1MzU0MzBmNjJiYWNiMjRjNjQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4740e47d78b964fd045a04535430f62bacb24c64","html_url":"https://github.com/juanfont/headscale/commit/4740e47d78b964fd045a04535430f62bacb24c64","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-20T20:16:51Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-20T20:16:51Z"},"tree":{"sha":"b91b9b0b53f5a5b0a4abb79c1f454e901a0b4fbb","url":"https://api.github.com/repos/juanfont/headscale/git/trees/b91b9b0b53f5a5b0a4abb79c1f454e901a0b4fbb"},"message":"state: return ErrGivenNameInvalid for invalid node rename\n\nRenameNode wrapped the raw dnsname error, so the v2 API mapped it to a\n500. Emit the sentinel so an invalid name surfaces as a 400.","parents":[{"sha":"d4c227b4afbddd022dbd6f1d168a2448641fd23c","url":"https://api.github.com/repos/juanfont/headscale/git/commits/d4c227b4afbddd022dbd6f1d168a2448641fd23c","html_url":"https://github.com/juanfont/headscale/commit/d4c227b4afbddd022dbd6f1d168a2448641fd23c"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"01ad22376fc16750fcc9a6ac806cfc50481900ea","node_id":"C_kwDOEFLz89oAKDAxYWQyMjM3NmZjMTY3NTBmY2M5YTZhYzgwNmNmYzUwNDgxOTAwZWE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/01ad22376fc16750fcc9a6ac806cfc50481900ea","html_url":"https://github.com/juanfont/headscale/commit/01ad22376fc16750fcc9a6ac806cfc50481900ea","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-20T20:16:51Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-20T20:16:51Z"},"tree":{"sha":"9b309a3e27793d837b1d270eea701ce3578bf2e2","url":"https://api.github.com/repos/juanfont/headscale/git/trees/9b309a3e27793d837b1d270eea701ce3578bf2e2"},"message":"api/v2: add Tailscale-compatible keys API\n\nAdd the v2 foundation — Basic/Bearer auth, scope scaffolding, the\ntailnet check, and the Tailscale error shape — plus the auth-key\nendpoints mapped onto Headscale pre-auth keys.","parents":[{"sha":"4740e47d78b964fd045a04535430f62bacb24c64","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4740e47d78b964fd045a04535430f62bacb24c64","html_url":"https://github.com/juanfont/headscale/commit/4740e47d78b964fd045a04535430f62bacb24c64"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"7e71039781e5ce71a0e99400f61a36acf1684f59","node_id":"C_kwDOEFLz89oAKDdlNzEwMzk3ODFlNWNlNzFhMGU5OTQwMGY2MWEzNmFjZjE2ODRmNTk","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7e71039781e5ce71a0e99400f61a36acf1684f59","html_url":"https://github.com/juanfont/headscale/commit/7e71039781e5ce71a0e99400f61a36acf1684f59","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-20T20:16:51Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-20T20:16:51Z"},"tree":{"sha":"c6ccabca07a11c337806f26d497560e43bb1ad34","url":"https://api.github.com/repos/juanfont/headscale/git/trees/c6ccabca07a11c337806f26d497560e43bb1ad34"},"message":"hscontrol: mount the v2 API at /api/v2\n\nWire the v2 mux into the router beside v1, threading the state, change\nsink, and config through the Backend.","parents":[{"sha":"01ad22376fc16750fcc9a6ac806cfc50481900ea","url":"https://api.github.com/repos/juanfont/headscale/git/commits/01ad22376fc16750fcc9a6ac806cfc50481900ea","html_url":"https://github.com/juanfont/headscale/commit/01ad22376fc16750fcc9a6ac806cfc50481900ea"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"cfc7a397adc35058fd98be91d3f2d24b86f9de7c","node_id":"C_kwDOEFLz89oAKGNmYzdhMzk3YWRjMzUwNThmZDk4YmU5MWQzZjJkMjRiODZmOWRlN2M","url":"https://api.github.com/repos/juanfont/headscale/git/commits/cfc7a397adc35058fd98be91d3f2d24b86f9de7c","html_url":"https://github.com/juanfont/headscale/commit/cfc7a397adc35058fd98be91d3f2d24b86f9de7c","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-20T20:16:51Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-20T20:16:51Z"},"tree":{"sha":"3a7b60ba8aa275f334ff60d5ab6c76fb3b8af934","url":"https://api.github.com/repos/juanfont/headscale/git/trees/3a7b60ba8aa275f334ff60d5ab6c76fb3b8af934"},"message":"api/v2: soft-revoke auth keys with a configurable collector\n\nTailscale's keys API has no separate expire verb: DELETE is the revoke.\nMap it to a soft revoke so the key stays retrievable as invalid afterwards\ninstead of vanishing, matching the SDK and Terraform's expectations.\n\nAdd a revoked timestamp to pre-auth keys (migration plus schema), mark a\nkey invalid once revoked, and have the keys DELETE handler stamp it rather\nthan destroy the row. A background collector reaps revoked keys after a\nconfigurable retention window (preauth_keys.revoked_retention, default\n168h), so the table does not grow without bound.","parents":[{"sha":"7e71039781e5ce71a0e99400f61a36acf1684f59","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7e71039781e5ce71a0e99400f61a36acf1684f59","html_url":"https://github.com/juanfont/headscale/commit/7e71039781e5ce71a0e99400f61a36acf1684f59"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"ee06e918952b42639d0e7dde1fdf7d9240806d50","node_id":"C_kwDOEFLz89oAKGVlMDZlOTE4OTUyYjQyNjM5ZDBlN2RkZTFmZGY3ZDkyNDA4MDZkNTA","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ee06e918952b42639d0e7dde1fdf7d9240806d50","html_url":"https://github.com/juanfont/headscale/commit/ee06e918952b42639d0e7dde1fdf7d9240806d50","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-20T20:16:51Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-20T20:16:51Z"},"tree":{"sha":"957e0ee1913fe9780d8fe5dfc085e86e83971a71","url":"https://api.github.com/repos/juanfont/headscale/git/trees/957e0ee1913fe9780d8fe5dfc085e86e83971a71"},"message":"api/v2: add Tailscale-compatible devices API\n\nMap the Tailscale device surface — get, list, delete, set name, tags,\nkey expiry, routes, and authorization — onto Headscale nodes.","parents":[{"sha":"cfc7a397adc35058fd98be91d3f2d24b86f9de7c","url":"https://api.github.com/repos/juanfont/headscale/git/commits/cfc7a397adc35058fd98be91d3f2d24b86f9de7c","html_url":"https://github.com/juanfont/headscale/comm