s","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"6c1ed1063237873622ecbe2843e7c265a8fe6379","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/6c1ed1063237873622ecbe2843e7c265a8fe6379","created_at":"2026-06-24T17:24:14Z","performed_via_github_app":null},{"id":27184479334,"node_id":"HRFPE_lADOEFLz888AAAABGd0Zjs8AAAAGVFI8Zg","url":"https://api.github.com/repos/juanfont/headscale/issues/events/27184479334","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"4a3e73107886884b6d238fe40ae201386eb48126","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/4a3e73107886884b6d238fe40ae201386eb48126","created_at":"2026-06-25T08:08:51Z","performed_via_github_app":null},{"sha":"df6bb833dd44e4d2f92462ecd36d6d9efd385eea","node_id":"C_kwDOEFLz89oAKGRmNmJiODMzZGQ0NGU0ZDJmOTI0NjJlY2QzNmQ2ZDllZmQzODVlZWE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/df6bb833dd44e4d2f92462ecd36d6d9efd385eea","html_url":"https://github.com/juanfont/headscale/commit/df6bb833dd44e4d2f92462ecd36d6d9efd385eea","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-25T08:05:46Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-01T12:11:51Z"},"tree":{"sha":"95d23d43bda9c9dd592fe5e58b8544dbd1b6ca88","url":"https://api.github.com/repos/juanfont/headscale/git/trees/95d23d43bda9c9dd592fe5e58b8544dbd1b6ca88"},"message":"ci: pin the integration tailscale versions, generated from capver\n\nThe hermetic nix checks cannot pull tailscale images at eval time, so the tested\nversion set and the per-arch image digests are pinned in\nintegration/tailscale-versions.json. capver.IntegrationVersions() is the single\nsource the suite, the drift guard and the pin generator share; the generator\n(tools/tailscale-versions, run via go generate) refreshes it after a capver bump\nand reuses already-present pins so a routine generate makes no network call.","parents":[{"sha":"518b497be90d2f3c0bd0e226ff5d238e7da818c0","url":"https://api.github.com/repos/juanfont/headscale/git/commits/518b497be90d2f3c0bd0e226ff5d238e7da818c0","html_url":"https://github.com/juanfont/headscale/commit/518b497be90d2f3c0bd0e226ff5d238e7da818c0"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"a5152db397b942076156602b886662b2a68d52e9","node_id":"C_kwDOEFLz89oAKGE1MTUyZGIzOTdiOTQyMDc2MTU2NjAyYjg4NjY2MmIyYTY4ZDUyZTk","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a5152db397b942076156602b886662b2a68d52e9","html_url":"https://github.com/juanfont/headscale/commit/a5152db397b942076156602b886662b2a68d52e9","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-25T08:06:34Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-01T12:11:51Z"},"tree":{"sha":"32de57d7f84c9213fffb627fa7562bc164f3fdde","url":"https://api.github.com/repos/juanfont/headscale/git/trees/32de57d7f84c9213fffb627fa7562bc164f3fdde"},"message":"nix: build the headscale and tailscale-HEAD test images\n\nReplaces the Dockerfile builds for the flake-check path. headscale is built\nfrom the Go-filtered source; one tailscale-HEAD image serves client, daemon,\nderper and the websocket-DERP test. Released tailscale versions and postgres\nare pinned registry pulls, arch following the build system. Tools the suite\nused to apk-add (curl/ssh/dig/python3) and the SSH login users are baked in at\nbuild time so no container is mutated at startup, and busybox su is included so\ntaildrive can fork its per-user fileserver.","parents":[{"sha":"df6bb833dd44e4d2f92462ecd36d6d9efd385eea","url":"https://api.github.com/repos/juanfont/headscale/git/commits/df6bb833dd44e4d2f92462ecd36d6d9efd385eea","html_url":"https://github.com/juanfont/headscale/commit/df6bb833dd44e4d2f92462ecd36d6d9efd385eea"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"bdb9cc510cd61ff1d1523660f859c0c8d011a7cd","node_id":"C_kwDOEFLz89oAKGJkYjljYzUxMGNkNjFmZjFkMTUyMzY2MGY4NTljMGM4ZDAxMWE3Y2Q","url":"https://api.github.com/repos/juanfont/headscale/git/commits/bdb9cc510cd61ff1d1523660f859c0c8d011a7cd","html_url":"https://github.com/juanfont/headscale/commit/bdb9cc510cd61ff1d1523660f859c0c8d011a7cd","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-25T08:06:37Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-01T12:11:51Z"},"tree":{"sha":"e495239a0004daf2a71b468ff56dad3ab44fc231","url":"https://api.github.com/repos/juanfont/headscale/git/trees/e495239a0004daf2a71b468ff56dad3ab44fc231"},"message":"integration: support prebuilt images and the slow nix VM in the suite\n\nRead the HEADSCALE_INTEGRATION_*_IMAGE knobs through one envknob helper and\nassert required tooling is present instead of installing it at runtime (the\nnix VM is offline). dsic waits for both the derper cert and key before starting\nderper, so the container can't die between the two uploads. The nested-docker\nVM is slower than a host daemon, so every integration timeout (convergence,\ndocker exec, peer sync, pool wait) now flows through one\ndockertestutil.ScaleTimeout honouring HEADSCALE_INTEGRATION_TIMEOUT_SCALE.","parents":[{"sha":"a5152db397b942076156602b886662b2a68d52e9","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a5152db397b942076156602b886662b2a68d52e9","html_url":"https://github.com/juanfont/headscale/commit/a5152db397b942076156602b886662b2a68d52e9"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"70b0c9208b1fbb72bca231d243fc7632eaa27af2","node_id":"C_kwDOEFLz89oAKDcwYjBjOTIwOGIxZmJiNzJiY2EyMzFkMjQzZmM3NjMyZWFhMjdhZjI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/70b0c9208b1fbb72bca231d243fc7632eaa27af2","html_url":"https://github.com/juanfont/headscale/commit/70b0c9208b1fbb72bca231d243fc7632eaa27af2","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-25T08:07:22Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-01T12:11:51Z"},"tree":{"sha":"5ab94efdaa5ca63c6528bb94b1afd5cc2347b4b0","url":"https://api.github.com/repos/juanfont/headscale/git/trees/5ab94efdaa5ca63c6528bb94b1afd5cc2347b4b0"},"message":"nix: run each integration test as a NixOS-VM flake check\n\nEach test becomes a hermetic check: a VM boots docker, loads the prebuilt images\nand runs that one test (nix/tests/integration.nix), so the suite runs offline as\nnix build .#checks.<name>. The generator emits the test list as nix: heavy\nmulti-subtest tests are split into per-subtest checks, and tests the nested\ndocker VM can't host are excluded for the legacy pipeline. flake.nix wires the\nchecks, the images, and the Go build/test/lint checks (with the version JSON on\nthe embed whitelist).","parents":[{"sha":"bdb9cc510cd61ff1d1523660f859c0c8d011a7cd","url":"https://api.github.com/repos/juanfont/headscale/git/commits/bdb9cc510cd61ff1d1523660f859c0c8d011a7cd","html_url":"https://github.com/juanfont/headscale/commit/bdb9cc510cd61ff1d1523660f859c0c8d011a7cd"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"4e5e538903b5b00728767d1a705fbf6c12031a9b","node_id":"C_kwDOEFLz89oAKDRlNWU1Mzg5MDNiNWIwMDcyODc2N2QxYTcwNWZiZjZjMTIwMzFhOWI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4e5e538903b5b00728767d1a705fbf6c12031a9b","html_url":"https://github.com/juanfont/headscale/commit/4e5e538903b5b00728767d1a705fbf6c12031a9b","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-25T08:07:29Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-01T12:13:04Z"},"tree":{"sha":"81c8e8b66a571056486780ab43310aed6c423fea","url":"https://api.github.com/repos/juanfont/headscale/git/trees/81c8e8b66a571056486780ab43310aed6c423fea"},"message":"ci: replace the integration workflow with the flake checks and a legacy pipeline\n\nCI runs nix build .#checks.<system>.integration-* instead of the bespoke docker\nmatrix — the generated checks are the matrix. The tests the hermetic VM can't\nrun (real-internet DERP, docker cable-pull) run via cmd/hi in a slim legacy\nworkflow, which also keeps cmd/hi and the integration Dockerfiles exercised.\ncheck-tests guards the pinned versions against capver drift.","parents":[{"sha":"70b0c9208b1fbb72bca231d243fc7632eaa27af2","url":"https://api.github.com/repos/juanfont/headscale/git/commits/70b0c9208b1fbb72bca231d243fc7632eaa27af2","html_url":"https://github.com/juanfont/headscale/commit/70b0c9208b1fbb72bca231d243fc7632eaa27af2"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"359127a800457fec4c439977dfc1ff47f4890ae8","node_id":"C_kwDOEFLz89oAKDM1OTEyN2E4MDA0NTdmZWM0YzQzOTk3N2RmYzFmZjQ3ZjQ4OTBhZTg","url":"https://api.github.com/repos/juanfont/headscale/git/commits/359127a800457fec4c439977dfc1ff47f4890ae8","html_url":"https://github.com/juanfont/headscale/commit/359127a800457fec4c439977dfc1ff47f4890ae8","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-01T12:09:11Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-01T12:13:04Z"},"tree":{"sha":"855c4c27a011af3ec34deeef8195ce89ffa7f0f9","url":"https://api.github.com/repos/juanfont/headscale/git/trees/855c4c27a011af3ec34deeef8195ce89ffa7f0f9"},"message":"ci: remove the CI jobs garnix now runs as flake checks\n\nGarnix builds every flake check and package directly, so the GitHub\nActions wrappers around them are redundant:\n\n  - nix-checks       checks.{build,gotest,golangci-lint,formatting}\n  - nix-module-test  checks.headscale (NixOS module test)\n  - test-integration the integration-* NixOS-VM check matrix\n  - build            packages.headscale (nix build)\n\nKept are the pipelines garnix cannot reproduce: servertest (excluded\nfrom the flake), integration-legacy (needs real DERP, so it cannot run\nhermetically), and the check-generated / check-tests generators that\nkeep the nix integration matrix and protobuf output in sync.\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01WxukxKem3HU4i5CqNrvvdj","parents":[{"sha":"4e5e538903b5b00728767d1a705fbf6c12031a9b","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4e5e538903b5b00728767d1a705fbf6c12031a9b","html_url":"https://github.com/juanfont/headscale/commit/4e5e538903b5b00728767d1a705fbf6c12031a9b"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":27427677788,"node_id":"HRFPE_lADOEFLz888AAAABGd0Zjs8AAAAGYtEmXA","url":"https://api.github.com/repos/juanfont/headscale/issues/events/27427677788","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"a4a3633670194625a3652352a698bf55596ea942","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/a4a3633670194625a3652352a698bf55596ea942","created_at":"2026-07-01T12:15:35Z","performed_via_github_app":null},{"sha":"566a978aef44d40f88ae2f3c86e48f852421f01e","node_id":"C_kwDOEFLz89oAKDU2NmE5NzhhZWY0NGQ0MGY4OGFlMmYzYzg2ZTQ4Zjg1MjQyMWYwMWU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/566a978aef44d40f88ae2f3c86e48f852421f01e","html_url":"https://github.com/juanfont/headscale/commit/566a978aef44d40f88ae2f3c86e48f852421f01e","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-01T12:15:31Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-01T13:57:26Z"},"tree":{"sha":"d517471f7d75787a88360f662119dec8fd9414cf","url":"https://api.github.com/repos/juanfont/headscale/git/trees/d517471f7d75787a88360f662119dec8fd9414cf"},"message":"integration: refresh the nix test matrix for the rebased main\n\nRebasing onto main pulled in TestK8sOperator and the OAuth client CLI tests; regenerate integration/tests.nix so the NixOS-VM check matrix runs them too.\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01WxukxKem3HU4i5CqNrvvdj","parents":[{"sha":"359127a800457fec4c439977dfc1ff47f4890ae8","url":"https://api.github.com/repos/juanfont/headscale/git/commits/359127a800457fec4c439977dfc1ff47f4890ae8","html_url":"https://github.com/juanfont/headscale/commit/359127a800457fec4c439977dfc1ff47f4890ae8"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":27432243306,"node_id":"HRFPE_lADOEFLz888AAAABGd0Zjs8AAAAGYxbQag","url":"https://api.github.com/repos/juanfont/headscale/issues/events/27432243306","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"566a978aef44d40f88ae2f3c86e48f852421f01e","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/566a978aef44d40f88ae2f3c86e48f852421f01e","created_at":"2026-07-01T13:57:29Z","performed_via_github_app":null},{"sha":"556f5e356b9604231f468bbcd702e0ba0d474870","node_id":"C_kwDOEFLz89oAKDU1NmY1ZTM1NmI5NjA0MjMxZjQ2OGJiY2Q3MDJlMGJhMGQ0NzQ4NzA","url":"https://api.github.com/repos/juanfont/headscale/git/commits/556f5e356b9604231f468bbcd702e0ba0d474870","html_url":"https://github.com/juanfont/headscale/commit/556f5e356b9604231f468bbcd702e0ba0d474870","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-01T15:07:42Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-01T15:07:42Z"},"tree":{"sha":"16cd4f7114a70f63c19331ba82b99aacce0c0c3f","url":"https://api.github.com/repos/juanfont/headscale/git/trees/16cd4f7114a70f63c19331ba82b99aacce0c0c3f"},"message":"nix: shrink integration VMs to fit the builder's job concurrency\n\nThe self-hosted garnix builder runs many checks at once (nix max-jobs is 16 on our box), so the 8 GB integration VMs overcommit its 64 GB RAM (16 * 8 = 128 GB) and the whole matrix thrashes with none completing. Drop each VM to 3.5 GB (16 * 3.5 = 56 GB, leaving host headroom) so the checks actually run; raise it back toward 8 GB once the builder caps max-jobs.\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01WxukxKem3HU4i5CqNrvvdj","parents":[{"sha":"566a978aef44d40f88ae2f3c86e48f852421f01e","url":"https://api.github.com/repos/juanfont/headscale/git/commits/566a978aef44d40f88ae2f3c86e48f852421f01e","html_url":"https://github.com/juanfont/headscale/commit/566a978aef44d40f88ae2f3c86e48f852421f01e"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"2af4566b41f3faeaa05c7ac974814e580c82286e","node_id":"C_kwDOEFLz89oAKDJhZjQ1NjZiNDFmM2ZhZWFhMDVjN2FjOTc0ODE0ZTU4MGM4MjI4NmU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/2af4566b41f3faeaa05c7ac974814e580c82286e","html_url":"https://github.com/juanfont/headscale/commit/2af4566b41f3faeaa05c7ac974814e580c82286e","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-01T16:11:38Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-01T16:11:38Z"},"tree":{"sha":"fedf6b88d522ba34e8aeec4ca7ea436f37e029aa","url":"https://api.github.com/repos/juanfont/headscale/git/trees/fedf6b88d522ba34e8aeec4ca7ea436f37e029aa"},"message":"nix: restore 8 GB integration VMs; concurrency is a builder cap\n\nThe 3.5 GB reduction was a diagnostic. The matrix wedged because the self-hosted builder runs unbounded max-jobs and does not cancel superseded runs (stacked ghost VM builds), not because 8 GB VMs are too big. Keep the tested-safe size; the fix is capping the builder's max-jobs so memorySize * max-jobs fits its RAM.\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01WxukxKem3HU4i5CqNrvvdj","parents":[{"sha":"556f5e356b9604231f468bbcd702e0ba0d474870","url":"https://api.github.com/repos/juanfont/headscale/git/commits/556f5e356b9604231f468bbcd702e0ba0d474870","html_url":"https://github.com/juanfont/headscale/commit/556f5e356b9604231f468bbcd702e0ba0d474870"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"6029b16a428a6d68061466441ee47670252d7dce","node_id":"C_kwDOEFLz89oAKDYwMjliMTZhNDI4YTZkNjgwNjE0NjY0NDFlZTQ3NjcwMjUyZDdkY2U","url":"https://api.github.com/repos/juanfont/headscale/git/commits/6029b16a428a6d68061466441ee47670252d7dce","html_url":"https://github.com/juanfont/headscale/commit/6029b16a428a6d68061466441ee47670252d7dce","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-01T17:54:10Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-01T17:54:10Z"},"tree":{"sha":"123b717a91832c62b8ca31f0673bc2b45146f1d4","url":"https://api.github.com/repos/juanfont/headscale/git/trees/123b717a91832c62b8ca31f0673bc2b45146f1d4"},"message":"nix: batch integration checks so the VM matrix fits a shared builder\n\nRunning each of the 161 integration tests as its own 8 GB NixOS-VM check overcommits a single self-hosted garnix builder: garnix fans them out past the builder's RAM and the OOM killer takes down the build (and the garnix coordinator VM itself). Group the matrix into 6 sqlite batches + 1 postgres batch, each running its tests sequentially (-test.parallel=1) in one 6 GB VM, so at most 7 VMs (~42 GB) ever run regardless of garnix's build concurrency. Trade-off: per-test checks collapse to per-batch (a failure shows in the batch log, not as its own check).\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01WxukxKem3HU4i5CqNrvvdj","parents":[{"sha":"2af4566b41f3faeaa05c7ac974814e580c82286e","url":"https://api.github.com/repos/juanfont/headscale/git/commits/2af4566b41f3faeaa05c7ac974814e580c82286e","html_url":"https://github.com/juanfont/headscale/commit/2af4566b41f3faeaa05c7ac974814e580c82286e"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"}]