[{"sha":"bc0d9ff6a6555d9ea76be8869e76c7119faf7af1","node_id":"C_kwDOEFLz89oAKGJjMGQ5ZmY2YTY1NTVkOWVhNzZiZTg4NjllNzZjNzExOWZhZjdhZjE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/bc0d9ff6a6555d9ea76be8869e76c7119faf7af1","html_url":"https://github.com/juanfont/headscale/commit/bc0d9ff6a6555d9ea76be8869e76c7119faf7af1","author":{"name":"Nelson Jeppesen","email":"50854675+NelsonJeppesen@users.noreply.github.com","date":"2026-07-09T15:58:43Z"},"committer":{"name":"Nelson Jeppesen","email":"50854675+NelsonJeppesen@users.noreply.github.com","date":"2026-07-09T19:58:09Z"},"tree":{"sha":"043532b2a10b2216a86ac137c89126b4400650e7","url":"https://api.github.com/repos/juanfont/headscale/git/trees/043532b2a10b2216a86ac137c89126b4400650e7"},"message":"config: add dns.nameservers.use_with_exit_node\n\nAdd a per-nameserver list that marks the listed resolvers with\nTailscale's dnstype.Resolver.UseWithExitNode flag, so those resolvers\nkeep being used when a client selects an exit node instead of having\nall DNS delegated to the exit node. This lets a self-hosted resolver on\nthe tailnet be reached directly.\n\nThe flag requires client capability version 125 (Tailscale v1.88);\nolder clients ignore it. Default is empty, preserving current behaviour.\n\nFixes #2816","parents":[{"sha":"048308511c72fa77da103e932f9b857a6e5247b9","url":"https://api.github.com/repos/juanfont/headscale/git/commits/048308511c72fa77da103e932f9b857a6e5247b9","html_url":"https://github.com/juanfont/headscale/commit/048308511c72fa77da103e932f9b857a6e5247b9"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgZcLE63K7FIzdbVtjfzH0bG4IVJ\n71Ww3o2lqYrFugkBYAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQFPwIoFNR6O8jpQOQeKO7QIo46qsYStaBoIcQVzQ96tzKzrsAosnE/O2XrtT0yEBf3\nSDpDvQvWNOYLRU56x0kQQ=\n-----END SSH SIGNATURE-----","payload":"tree 043532b2a10b2216a86ac137c89126b4400650e7\nparent 048308511c72fa77da103e932f9b857a6e5247b9\nauthor Nelson Jeppesen <50854675+NelsonJeppesen@users.noreply.github.com> 1783612723 -0700\ncommitter Nelson Jeppesen <50854675+NelsonJeppesen@users.noreply.github.com> 1783627089 -0700\n\nconfig: add dns.nameservers.use_with_exit_node\n\nAdd a per-nameserver list that marks the listed resolvers with\nTailscale's dnstype.Resolver.UseWithExitNode flag, so those resolvers\nkeep being used when a client selects an exit node instead of having\nall DNS delegated to the exit node. This lets a self-hosted resolver on\nthe tailnet be reached directly.\n\nThe flag requires client capability version 125 (Tailscale v1.88);\nolder clients ignore it. Default is empty, preserving current behaviour.\n\nFixes #2816\n","verified_at":"2026-07-09T19:59:12Z"},"event":"committed"},{"sha":"b2dd8e0a95c6d7b9b5352c4fd44ba7329a294a56","node_id":"C_kwDOEFLz89oAKGIyZGQ4ZTBhOTVjNmQ3YjliNTM1MmM0ZmQ0NGJhNzMyOWEyOTRhNTY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/b2dd8e0a95c6d7b9b5352c4fd44ba7329a294a56","html_url":"https://github.com/juanfont/headscale/commit/b2dd8e0a95c6d7b9b5352c4fd44ba7329a294a56","author":{"name":"Nelson Jeppesen","email":"50854675+NelsonJeppesen@users.noreply.github.com","date":"2026-07-09T19:27:45Z"},"committer":{"name":"Nelson Jeppesen","email":"50854675+NelsonJeppesen@users.noreply.github.com","date":"2026-07-09T19:58:14Z"},"tree":{"sha":"dcc5d3fd6d2cf84865dcd28f71464b271a4a5ddb","url":"https://api.github.com/repos/juanfont/headscale/git/trees/dcc5d3fd6d2cf84865dcd28f71464b271a4a5ddb"},"message":"integration: test DNS use_with_exit_node survives exit node\n\nAdd TestExitNodeUseWithExitNodeDNS: with an exit node selected, a\nresolver listed in dns.nameservers.use_with_exit_node keeps its\nUseWithExitNode flag in the client netmap, while an unlisted resolver\ndoes not. Register it in the SQLite CI matrix via the workflow\ngenerator.\n\nThe client feature needs Tailscale v1.88+, so the scenario pins the\nhead version.","parents":[{"sha":"bc0d9ff6a6555d9ea76be8869e76c7119faf7af1","url":"https://api.github.com/repos/juanfont/headscale/git/commits/bc0d9ff6a6555d9ea76be8869e76c7119faf7af1","html_url":"https://github.com/juanfont/headscale/commit/bc0d9ff6a6555d9ea76be8869e76c7119faf7af1"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgZcLE63K7FIzdbVtjfzH0bG4IVJ\n71Ww3o2lqYrFugkBYAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQGwB43Xvxl5izwG8QOe7F0P8Q3u5daTw5YaKHVbSppO+0JLRWUmp+JGXbQDJHFsAYf\n83mxAoCuSnSnvpIJUsfAU=\n-----END SSH SIGNATURE-----","payload":"tree dcc5d3fd6d2cf84865dcd28f71464b271a4a5ddb\nparent bc0d9ff6a6555d9ea76be8869e76c7119faf7af1\nauthor Nelson Jeppesen <50854675+NelsonJeppesen@users.noreply.github.com> 1783625265 -0700\ncommitter Nelson Jeppesen <50854675+NelsonJeppesen@users.noreply.github.com> 1783627094 -0700\n\nintegration: test DNS use_with_exit_node survives exit node\n\nAdd TestExitNodeUseWithExitNodeDNS: with an exit node selected, a\nresolver listed in dns.nameservers.use_with_exit_node keeps its\nUseWithExitNode flag in the client netmap, while an unlisted resolver\ndoes not. Register it in the SQLite CI matrix via the workflow\ngenerator.\n\nThe client feature needs Tailscale v1.88+, so the scenario pins the\nhead version.\n","verified_at":"2026-07-09T19:59:12Z"},"event":"committed"},{"sha":"4d85a7b2c107b4465c28c8da268c9456b5b083a5","node_id":"C_kwDOEFLz89oAKDRkODVhN2IyYzEwN2I0NDY1YzI4YzhkYTI2OGM5NDU2YjViMDgzYTU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4d85a7b2c107b4465c28c8da268c9456b5b083a5","html_url":"https://github.com/juanfont/headscale/commit/4d85a7b2c107b4465c28c8da268c9456b5b083a5","author":{"name":"Nelson Jeppesen","email":"50854675+NelsonJeppesen@users.noreply.github.com","date":"2026-07-09T19:29:58Z"},"committer":{"name":"Nelson Jeppesen","email":"50854675+NelsonJeppesen@users.noreply.github.com","date":"2026-07-09T19