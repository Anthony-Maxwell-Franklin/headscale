VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"c715145dd61f3eaaf4a7512ba2b3e71332e879dc","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/c715145dd61f3eaaf4a7512ba2b3e71332e879dc","created_at":"2026-03-09T18:18:43Z","performed_via_github_app":null},{"sha":"980ebcb0d6097da1ec0b1eec2a782072e78a8a6a","node_id":"C_kwDOEFLz89oAKDk4MGViY2IwZDYwOTdkYTFlYzBiMWVlYzJhNzgyMDcyZTc4YThhNmE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/980ebcb0d6097da1ec0b1eec2a782072e78a8a6a","html_url":"https://github.com/juanfont/headscale/commit/980ebcb0d6097da1ec0b1eec2a782072e78a8a6a","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-10T09:59:56Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-10T10:00:02Z"},"tree":{"sha":"4b32137a52fb353368f04265fe98e6861c49e093","url":"https://api.github.com/repos/juanfont/headscale/git/trees/4b32137a52fb353368f04265fe98e6861c49e093"},"message":"integration: harden WaitForPeers with InNetworkMap and InMagicSock checks\n\nAdd InNetworkMap and InMagicSock verification to the WaitForPeers\nreadiness check in tsic.go. This ensures that nodes are not only\npresent in the peer list but also fully established in the network map\nand magicsock layer before tests proceed. WaitForPeers is the single\nchoke point used by 77+ call sites through WaitForTailscaleSync.\n\nAlso update ping defaults to match the tailscale CLI (5s timeout,\n10 attempts = 50s budget vs the old 200ms x 5 = 1s budget), and\nset curl retry to 0 so EventuallyWithT handles retries instead of\ncurl's internal retry mechanism.\n\nRemove the CurlFailFast method from the TailscaleClient interface\nsince with retry=0, regular Curl() already fails fast.\n\nUpdates #3125","parents":[{"sha":"8423af2732f2ef363c0a6fa53efc925a3ca12742","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8423af2732f2ef363c0a6fa53efc925a3ca12742","html_url":"https://github.com/juanfont/headscale/commit/8423af2732f2ef363c0a6fa53efc925a3ca12742"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"28b1929ba7860794e76944a43de03048ba44defa","node_id":"C_kwDOEFLz89oAKDI4YjE5MjliYTc4NjA3OTRlNzY5NDRhNDNkZTAzMDQ4YmE0NGRlZmE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/28b1929ba7860794e76944a43de03048ba44defa","html_url":"https://github.com/juanfont/headscale/commit/28b1929ba7860794e76944a43de03048ba44defa","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-10T10:00:20Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-10T10:00:20Z"},"tree":{"sha":"3bece84f19e7b119d78c61951b5f1d7bc7479b9d","url":"https://api.github.com/repos/juanfont/headscale/git/trees/3bece84f19e7b119d78c61951b5f1d7bc7479b9d"},"message":"integration: use CI-friendly timeouts and improve test robustness\n\nReplace all hardcoded EventuallyWithT timeout values across all\nintegration test files with integrationutil.PeerSyncTimeout(), which\nreturns 60s locally and 120s in CI. This gives resource-constrained\nCI runners enough headroom while keeping local development fast.\n\nConsolidate ping assertion helpers into assertPingAll/assertPingDerpAll\nin helpers.go, replacing scattered per-test ping loops. Add\nconnectivity warm-up phases and packet filter readiness checks where\ntests depend on ACL policy propagation.\n\nFix a mutation-in-EventuallyWithT anti-pattern in route_test.go where\nclient.Execute() (a state-changing call) was inside a retry loop.\n\nUse assert (soft failure) instead of require for the unstable client\nDNS warm-up in TestACLPolicyPropagationOverTime, since the HEAD\ntailscale client sporadically fails to configure MagicDNS.\n\nIntentional exclusions preserved:\n- 5s negative-test timeouts verifying denial is fast\n- 3-4 min expiry/TTL timeouts waiting for real clock events\n- OIDC token expiry waits computed from actual TTL\n\nUpdates #3125","parents":[{"sha":"980ebcb0d6097da1ec0b1eec2a782072e78a8a6a","url":"https://api.github.com/repos/juanfont/headscale/git/commits/980ebcb0d6097da1ec0b1eec2a782072e78a8a6a","html_url":"https://github.com/juanfont/headscale/commit/980ebcb0d6097da1ec0b1eec2a782072e78a8a6a"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"8f35638f7ee1761cc498a2f7e4360da5d639938d","node_id":"C_kwDOEFLz89oAKDhmMzU2MzhmN2VlMTc2MWNjNDk4YTJmN2U0MzYwZGE1ZDYzOTkzOGQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8f35638f7ee1761cc498a2f7e4360da5d639938d","html_url":"https://github.com/juanfont/headscale/commit/8f35638f7ee1761cc498a2f7e4360da5d639938d","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-10T10:00:28Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-10T10:00:28Z"},"tree":{"sha":"31148c59e34f0c2a063be1338f35e97e47184019","url":"https://api.github.com/repos/juanfont/headscale/git/trees/31148c59e34f0c2a063be1338f35e97e47184019"},"message":"state: filter ListPeers through peer visibility map\n\nFix State.ListPeers() to always filter through peersByNode (the\npolicy-aware peer map) instead of returning raw database results when\nspecific peer IDs are requested. The unfiltered path bypassed ACL\nvisibility rules, causing tests to see peers they shouldn't.\n\nAdd a test verifying that ListPeers respects peer visibility filtering.\n\nUpdates #3125","parents":[{"sha":"28b1929ba7860794e76944a43de03048ba44defa","url":"https://api.github.com/repos/juanfont/headscale/git/commits/28b1929ba7860794e76944a43de03048ba44defa","html_url":"https://github.com/juanfont/headscale/commit/28b1929ba7860794e76944a43de03048ba44defa"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"c58f286dbfde321a512920543d932b6c629063ff","node_id":"C_kwDOEFLz89oAKGM1OGYyODZkYmZkZTMyMWE1MTI5MjA1NDNkOTMyYjZjNjI5MDYzZmY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c58f286dbfde321a512920543d932b6c629063ff","html_url":"https://github.com/juanfont/headscale/commit/c58f286dbfde321a512920543d932b6c629063ff","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-10T10:00:33Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-10T10:00:33Z"},"tree":{"sha":"d59b584266bb25c65f8a43629264ab4a7111a9c4","url":"https://api.github.com/repos/juanfont/headscale/git/trees/d59b584266bb25c65f8a43629264ab4a7111a9c4"},"message":"cmd/hi: add images subcommand to list required Docker Hub images\n\nAdd 'hi images' subcommand that prints all Docker Hub images needed by\nintegration tests. This enables CI workflows to pre-pull images before\nrunning tests, avoiding Docker Hub rate limit failures.\n\nUpdates #3125","parents":[{"sha":"8f35638f7ee1761cc498a2f7e4360da5d639938d","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8f35638f7ee1761cc498a2f7e4360da5d639938d","html_url":"https://github.com/juanfont/headscale/commit/8f35638f7ee1761cc498a2f7e4360da5d639938d"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":23426278057,"node_id":"HRFPE_lADOEFLz887wFuvqzwAAAAV0UKKp","url":"https://api.github.com/repos/juanfont/headscale/issues/events/23426278057","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"d2ac49acd97d6e85f2998d378e7d29c9be959609","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/d2ac49acd97d6e85f2998d378e7d29c9be959609","created_at":"2026-03-10T10:01:07Z","performed_via_github_app":null},{"sha":"f60acea97f5f8e4e79b2d24e696fe1a66b23b427","node_id":"C_kwDOEFLz89oAKGY2MGFjZWE5N2Y1ZjhlNGU3OWIyZDI0ZTY5NmZlMWE2NmIyM2I0Mjc","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f60acea97f5f8e4e79b2d24e696fe1a66b23b427","html_url":"https://github.com/juanfont/headscale/commit/f60acea97f5f8e4e79b2d24e696fe1a66b23b427","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-10T12:15:41Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-10T12:15:41Z"},"tree":{"sha":"68074e1cf9f378bc98d5edad1edfac2da13b6bb2","url":"https://api.github.com/repos/juanfont/headscale/git/trees/68074e1cf9f378bc98d5edad1edfac2da13b6bb2"},"message":"ci: pre-pull Docker Hub images and bump Go to 1.26.1\n\nAdd a build-images job to the integration test workflow that pre-pulls\nall Docker Hub images listed by 'hi images' with retries, preventing\nrate limit failures during parallel test execution.\n\nBump Go to 1.26.1 in both Dockerfile.tailscale-HEAD and\nDockerfile.derper.\n\nUpdates #3125","parents":[{"sha":"c58f286dbfde321a512920543d932b6c629063ff","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c58f286dbfde321a512920543d932b6c629063ff","html_url":"https://github.com/juanfont/headscale/commit/c58f286dbfde321a512920543d932b6c629063ff"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":23430074270,"node_id":"HRFPE_lADOEFLz887wFuvqzwAAAAV0io-e","url":"https://api.github.com/repos/juanfont/headscale/issues/events/23430074270","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://a