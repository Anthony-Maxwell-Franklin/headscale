ion\n- TestSSHMultipleUsersAllToAll: use autogroup:self instead of\n  username destinations for group-to-user SSH access\n\nUpdates #3009\nUpdates #3010","parents":[{"sha":"3f49ef9f1aa9af888ab333d80365e992f248ce25","url":"https://api.github.com/repos/juanfont/headscale/git/commits/3f49ef9f1aa9af888ab333d80365e992f248ce25","html_url":"https://github.com/juanfont/headscale/commit/3f49ef9f1aa9af888ab333d80365e992f248ce25"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"c6f9d840e62787d285e18cafb33308b1695a6aaa","node_id":"C_kwDOEFLz89oAKGM2ZjlkODQwZTYyNzg3ZDI4NWUxOGNhZmIzMzMwOGIxNjk1YTZhYWE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c6f9d840e62787d285e18cafb33308b1695a6aaa","html_url":"https://github.com/juanfont/headscale/commit/c6f9d840e62787d285e18cafb33308b1695a6aaa","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-21T15:30:11Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-21T15:30:11Z"},"tree":{"sha":"2e72843ba01ed24b61bf75348101da9a8ac95049","url":"https://api.github.com/repos/juanfont/headscale/git/trees/2e72843ba01ed24b61bf75348101da9a8ac95049"},"message":"docs: add changelog for SSH policy changes\n\nDocument breaking changes:\n- Wildcard (*) no longer supported as SSH destination\n- SSH source/destination validation enforces Tailscale's security model\n\nFixes #3009\nFixes #3010","parents":[{"sha":"8452ea27e74f2a46d9d3cb53888c7c395e367bda","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8452ea27e74f2a46d9d3cb53888c7c395e367bda","html_url":"https://github.com/juanfont/headscale/commit/8452ea27e74f2a46d9d3cb53888c7c395e367bda"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":22191369441,"node_id":"HRFPE_lADOEFLz887kyi7czwAAAAUqtWzh","url":"https://api.github.com/repos/juanfont