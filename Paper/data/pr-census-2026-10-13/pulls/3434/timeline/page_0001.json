[{"sha":"8369badc5f6ca3f031aa51efbedfcc946583add0","node_id":"C_kwDOEFLz89oAKDgzNjliYWRjNWY2Y2EzZjAzMWFhNTFlZmJlZGZjYzk0NjU4M2FkZDA","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8369badc5f6ca3f031aa51efbedfcc946583add0","html_url":"https://github.com/juanfont/headscale/commit/8369badc5f6ca3f031aa51efbedfcc946583add0","author":{"name":"Mr-DS-ML-85","email":"gojmanday@gmail.com","date":"2026-08-22T09:43:35Z"},"committer":{"name":"Mr-DS-ML-85","email":"gojmanday@gmail.com","date":"2026-08-22T09:44:05Z"},"tree":{"sha":"245ce05126368cedeaa0d9e894362d4992120529","url":"https://api.github.com/repos/juanfont/headscale/git/trees/245ce05126368cedeaa0d9e894362d4992120529"},"message":"policy: add oidcgrp: principal type for OIDC group-based ACLs\n\nAdds support for oidcgrp:<group> as a principal type in ACL policies,\nallowing policy rules to reference OIDC group memberships. Groups are\nfetched from the OIDC provider during login and stored in a new\nuser_oidc_groups join table. The PolicyManager resolves oidcgrp:\nprincipals via an injected OIDCGroupResolver interface.","parents":[{"sha":"565fd254d06c4c7f9a8cad1714a43445c79ba420","url":"https://api.github.com/repos/juanfont/headscale/git/commits/565fd254d06c4c7f9a8cad1714a43445c79ba420","html_url":"https://github.com/juanfont/headscale/commit/565fd254d06c4c7f9a8cad1714a43445c79ba420"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"851b59b471e48210b4319282c5afd82b07af84c9","node_id":"C_kwDOEFLz89oAKDg1MWI1OWI0NzFlNDgyMTBiNDMxOTI4MmM1YWZkODJiMDdhZjg0Yzk","url":"https://api.github.com/repos/juanfont/headscale/git/commits/851b59b471e48210b4319282c5afd82b07af84c9","html_url":"https://github.com/juanfont/headscale/commit/851b59b471e48210b4319282c5afd82b07af84c9","author":{"name":"Mr-DS-ML-85","email":"gojmanday@gmail.com","date":"2026-08-22T09:53:36Z"},"committer":{"name":"Mr-DS-ML-85","email":"gojmanday@gmail.com","date":"2026-08-22T09:53:36Z"},"tree":{"sha":"a9f1ab0cbaf0e0f0d1db22e3a0994efff48bf0a7","url":"https://api.github.com/repos/juanfont/headscale/git/trees/a9f1ab0cbaf0e0f0d1db22e3a0994efff48bf0a7"},"message":"oidc: add group refresh, admin API, and documentation\n\n- Add periodic OIDC group refresh that clears stale memberships on\n  a 15-minute interval, with fresh groups populated at next login\n- Add admin API endpoints: GET/PUT /api/v1/user/{id}/oidc-groups\n  and GET /api/v1/user/oidc-group?group=<name> for querying users\n  by OIDC group membership\n- Add docs/ref/oidc-groups.md with usage examples and API reference","parents":[{"sha":"8369badc5f6ca3f031aa51efbedfcc946583add0","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8369badc5f6ca3f031aa51efbedfcc946583add0","html_url":"https://github.com/juanfont/headscale/commit/8369badc5f6ca3f031aa51efbedfcc946583add0"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"43d902dbd0a5ad54ab954434c871a48b79dfafcf","node_id":"C_kwDOEFLz89oAKDQzZDkwMmRiZDBhNWFkNTRhYjk1NDQzNGM4NzFhNDhiNzlkZmFmY2Y","url":"https://api.github.com/repos/juanfont/headscale/git/commits/43d902dbd0a5ad54ab954434c871a48b79dfafcf","html_url":"https://github.com/juanfont/headscale/commit/43d902dbd0a5ad54ab954434c871a48b79dfafcf","author":{"name":"Mr-DS-ML-85","email":"gojmanday@gmail.com","date":"2026-08-22T10:49:17Z"},"committer":{"name":"Mr-DS-ML-85","email":"gojmanday@gmail.com","date":"2026-08-22T10:49:17Z"},"tree":{"sha":"48dcfaf12a2fca02e3c26f91c7f591c70909fe06","url":"https://api.github.com/repos/juanfont/headscale/git/trees/48dcfaf12a2fca02e3c26f91c7f591c70909fe06"},"message":"e2e: add Docker-based E2E test infrastructure\n\nAdd Docker Compose setup with two containers (headscale-server and\nheadscale-client) for real-world E2E testing. The server container\nbootstraps an admin user and API key on first boot. Test suites cover:\n\n- API health and connectivity\n- OIDC group CRUD operations\n- ACL policies with oidcgrp: principal type\n- CLI commands\n- VPN connectivity and user separation\n- Full end-to-end flow (users → groups → policy → VPN)","parents":[{"sha":"851b59b471e48210b4319282c5afd82b07af84c9","url":"https://api.github.com/repos/juanfont/headscale/git/commits/851b59b471e48210b4319282c5afd82b07af84c9","html_url":"https://github.com/juanfont/headscale/commit/851b59b471e48210b4319282c5afd82b07af84c9"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"3c3cc26bcb00bb59f1cd421a8961fc992909afd4","node_id":"C_kwDOEFLz89oAKDNjM2NjMjZiY2IwMGJiNTlmMWNkNDIxYTg5NjFmYzk5MjkwOWFmZDQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/3c3cc26bcb00bb59f1cd421a8961fc992909afd4","html_url":"https://github.com/juanfont/headscale/commit/3c3cc26bcb00bb59f1cd421a8961fc992909afd4","author":{"name":"Mr-DS-ML-85","email":"gojmanday@gmail.com","date":"2026-08-22T12:34:27Z"},"committer":{"name":"Mr-DS-ML-85","email":"gojmanday@gmail.com","date":"2026-08-22T12:34:27Z"},"tree":{"sha":"42d3400a8b377ebbc7812cd634e315d7c281738e","url":"https://api.github.com/repos/juanfont/headscale/git/trees/42d3400a8b377ebbc7812cd634e315d7c281738e"},"message":"e2e: fix E2E tests to pass reliably in Docker containers\n\nFixes:\n- Fix UNIQUE constraint in SetUserOIDCGroups (use Unscoped() delete)\n- Fix test runner to disable set -u for test functions\n- Add get_user_id() helper for self-contained test functions\n- Fix health check to accept JSON {\"status\":\"pass\"} response\n- Fix preauth key API endpoint to use /api/v1/preauthkey\n- Replace CLI tests with API-based tests (CLI needs unix socket)\n- Fix policy tests to use correct {\"policy\": ...} request format\n- Fix user separation tests to use get_user_id() helper\n- Add Keycloak for real OIDC testing\n- All 34 alice tests + 7 bob tests passing","parents":[{"sha":"43d902dbd0a5ad54ab954434c871a48b79dfafcf","url":"https://api.github.com/repos/juanfont/headscale/git/commits/43d902dbd0a5ad54ab954434c871a48b79dfafcf","html_url":"https://github.com/juanfont/headscale/commit/43d902dbd0a5ad54ab954434c871a48b79dfafcf"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"b8b3ae5bd4d5d463ca1605420ce55e21082c97b5","node_id":"C_kwDOEFLz89oAKGI4YjNhZTViZDRkNWQ0NjNjYTE2MDU0MjBjZTU1ZTIxMDgyYzk3YjU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/b8b3ae5bd4d5d463ca1605420ce55e21082c97b5","html_url":"https://github.com/juanfont/headscale/commit/b8b3ae5bd4d5d463ca1605420ce55e21082c97b5","author":{"name":"Mr-DS-ML-85","email":"gojmanday@gmail.com","date":"2026-08-22T13:38:40Z"},"committer":{"name":"Mr-DS-ML-85","email":"gojmanday@gmail.com","date":"2026-08-22T13:38:40Z"},"tree":{"sha":"d712311e7d87933e38b97a1870e7cf93b64b588a","url":"https://api.github.com/repos/juanfont/headscale/git/trees/d712311e7d87933e38b97a1870e7cf93b64b588a"},"message":"e2e: add VPN connectivity test and refresh monitor\n\n- VPN test: starts tailscaled, registers via preauth key, verifies IP and node\n- Refresh monitor: long-running test checking OIDC group consistency over time\n- Fix preauth key creation with proper ISO timestamp expiration\n- Fix tailscale registration with --login-server flag for headscale URL\n- All 35/35 alice tests + 8/8 bob tests passing in Docker E2E","parents":[{"sha":"3c3cc26bcb00bb59f1cd421a8961fc992909afd4","url":"https://api.github.com/repos/juanfont/headscale/git/commits/3c3cc26bcb00bb59f1cd421a8961fc992909afd4","html_url":"https://github.com/juanfont/headscale/commit/3c3cc26bcb00bb59f1cd421a8961fc992909afd4"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"96861ccfda0b8627b2738de6105ce70a392f6e3f","node_id":"C_kwDOEFLz89oAKDk2ODYxY2NmZGEwYjg2MjdiMjczOGRlNjEwNWNlNzBhMzkyZjZlM2Y","url"