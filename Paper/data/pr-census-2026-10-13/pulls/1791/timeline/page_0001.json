ha":"5439c10ba2cd4df6c6e83375f6238397d5755c8d","url":"https://api.github.com/repos/juanfont/headscale/git/trees/5439c10ba2cd4df6c6e83375f6238397d5755c8d"},"message":"Rework map session\n\nThis commit restructures the map session in to a struct\nholding the state of what is needed during its lifetime.\n\nFor streaming sessions, the event loop is structured a\nbit differently not hammering the clients with updates\nbut rather batching them over a short, configurable time\nwhich should significantly improve cpu usage, and potentially\nflakyness.\n\nThe use of Patch updates has been dialed back a little as\nit does not look like its a 100% ready for prime time. Nodes\nare now updated with full changes, except for a few things\nlike online status.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>","parents":[{"sha":"2858ab402a347f951b8b3a438c62b49aca8b1d87","url":"https://api.github.com/repos/juanfont/headscale/git/commits/2858ab402a347f951b8b3a438c62b49aca8b1d87","html_url":"https://github.com/juanfont/headscale/commit/2858ab402a347f951b8b3a438c62b49aca8b1d87"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAAGgAAAATZWNkc2Etc2hhMi1uaXN0cDI1NgAAAAhuaXN0cDI1NgAAAE\nEE6bT6+U8pNExCb214X9sKtM8QMSqzWb4HmQxm24sqHasMtgza7Cws+M2NoiUVB+RSfa/I\nCoai/Io5VHtD9nbzKgAAAANnaXQAAAAAAAAABnNoYTUxMgAAAGUAAAATZWNkc2Etc2hhMi\n1uaXN0cDI1NgAAAEoAAAAhALaTPYAXtpembSHFdW1G0hfDwPcjRqWtSmjpD6q22Is5AAAA\nIQD44xLDkBFUY3cy7v8QtAEvEoShGZuDKYWry/igb4TJWQ==\n-----END SSH SIGNATURE-----","payload":"tree 5439c10ba2cd4df6c6e83375f6238397d5755c8d\nparent 2858ab402a347f951b8b3a438c62b49aca8b1d87\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1708682364 +0100\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1712930984 +0200\n\nRework map session\n\nThis commit restructures the map session in to a struct\nholding the state of what is needed during its lifetime.\n\nFor streaming sessions, the event loop is structured a\nbit differently not hammering the clients with updates\nbut rather batching them over a short, configurable time\nwhich should significantly improve cpu usage, and potentially\nflakyness.\n\nThe use of Patch updates has been dialed back a little as\nit does not look like its a 100% ready for prime time. Nodes\nare now updated with full changes, except for a few things\nlike online status.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>\n","verified_at":"2024-11-17T01:00:16Z"},"event":"committed"},{"sha":"1ba079dd57259d6559df1872f7ae78c899fc8667","node_id":"C_kwDOEFLz89oAKDFiYTA3OWRkNTcyNTlkNjU1OWRmMTg3MmY3YWU3OGM4OTlmYzg2Njc","url":"https://api.github.com/repos/juanfont/headscale/git/commits/1ba079dd57259d6559df1872f7ae78c899fc8667","html_url":"https://github.com/juanfont/headscale/commit/1ba079dd57259d6559df1872f7ae78c899fc8667","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2024-04-10T12:49:34Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2024-04-12T14:13:28Z"},"tree":{"sha":"eeccc19694aaae70212598b7d98975ff3d67675f","url":"https://api.github.com/repos/juanfont/headscale/git/trees/eeccc19694aaae70212598b7d98975ff3d67675f"},"message":"clean up use of log.Error where errors could be wrapped\n\nReplace a lot of occurences of log.Error with fmt.Errorf,\nbubbling the error up the chain instead.","parents":[{"sha":"210fceb713b05f0635e7fe1afff838633c325427","url":"https://api.github.com/repos/juanfont/headscale/git/commits/210fceb713b05f0635e7fe1afff838633c325427","html_url":"https://github.com/juanfont/headscale/commit/210fceb713b05f0635e7fe1afff838633c325427"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAAGgAAAATZWNkc2Etc2hhMi1uaXN0cDI1NgAAAAhuaXN0cDI1NgAAAE\nEE6bT6+U8pNExCb214X9sKtM8QMSqzWb4HmQxm24sqHasMtgza7Cws+M2NoiUVB+RSfa/I\nCoai/Io5VHtD9nbzKgAAAANnaXQAAAAAAAAABnNoYTUxMgAAAGQAAAATZWNkc2Etc2hhMi\n1uaXN0cDI1NgAAAEkAAAAhAOP5cdH