[{"sha":"bee51fbf6f942103a2a74f1f3126ab73a184ee94","node_id":"C_kwDOEFLz89oAKGJlZTUxZmJmNmY5NDIxMDNhMmE3NGYxZjMxMjZhYjczYTE4NGVlOTQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/bee51fbf6f942103a2a74f1f3126ab73a184ee94","html_url":"https://github.com/juanfont/headscale/commit/bee51fbf6f942103a2a74f1f3126ab73a184ee94","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-11T11:17:55Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-11T11:17:55Z"},"tree":{"sha":"da08f9762ab3b8c3f4842713fb7e5f357ebf77f8","url":"https://api.github.com/repos/juanfont/headscale/git/trees/da08f9762ab3b8c3f4842713fb7e5f357ebf77f8"},"message":"policy/matcher: include CapGrant.Dsts in match destinations\n\nMatchFromFilterRule only read DstPorts[].IP into the destination\nIPSet. Cap-grant-only filter rules (e.g. tailscale.com/cap/relay)\ncarry their destinations in CapGrant[].Dsts, so the derived matchers\nhad empty dest sets and BuildPeerMap / ReduceNodes never exposed the\ncap target to its source nodes. Without a companion IP-level grant\nthe relay node stayed invisible, so clients never tried to use it\nand connections sat on DERP.\n\nUnion CapGrant[].Dsts into the destination IPSet alongside DstPorts.\nRestores peer-visibility for any cap-grant-only relationship; the\npeer-relay flow is the most visible instance.\n\nFixes #3256","parents":[{"sha":"795a1efe9bd9cb86310124aa6ba0a86b907381aa","url":"https://api.github.com/repos/juanfont/headscale/git/commits/795a1efe9bd9cb86310124aa6ba0a86b907381aa","html_url":"https://github.com/juanfont/headscale/commit/795a1efe9bd9cb86310124aa6ba0a86b907381aa"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":25381964258,"node_id":"RFRE_lADOEFLz888AAAABB3l1jM8AAAAF6OIJ4g","url":"https://api.github.com/repos/juanfont/headscale/issues/events/25381964258","actor":{"login":"kradalby","id":98