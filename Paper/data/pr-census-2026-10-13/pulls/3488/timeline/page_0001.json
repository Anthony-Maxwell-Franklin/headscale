vents{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"45a612c94bda329042757f68c8ef8fed7653e31d","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/45a612c94bda329042757f68c8ef8fed7653e31d","created_at":"2026-10-09T14:34:31Z","performed_via_github_app":null},{"sha":"007172663c2e6d62f5b63eeb73547c247598e7d3","node_id":"C_kwDOEFLz89oAKDAwNzE3MjY2M2MyZTZkNjJmNWI2M2VlYjczNTQ3YzI0NzU5OGU3ZDM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/007172663c2e6d62f5b63eeb73547c247598e7d3","html_url":"https://github.com/juanfont/headscale/commit/007172663c2e6d62f5b63eeb73547c247598e7d3","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-09-28T08:50:39Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-10-09T14:36:29Z"},"tree":{"sha":"fa9288a0f75884f4e4a5e17a45acae86f6b1eae4","url":"https://api.github.com/repos/juanfont/headscale/git/trees/fa9288a0f75884f4e4a5e17a45acae86f6b1eae4"},"message":"integration: add Android emulator image with test helper app\n\nHeadless KVM emulator (google_apis, API 33) plus a small helper app:\na device-owner DPC that sets the Tailscale app's managed configuration,\nand a probe that resolves and fetches as an ordinary app, through the\nVPN.\n\nUpdates tailscale/tailscale#15660","parents":[{"sha":"a8d6f5be81e578a078001b908e41611ec03ce69e","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a8d6f5be81e578a078001b908e41611ec03ce69e","html_url":"https://github.com/juanfont/headscale/commit/a8d6f5be81e578a078001b908e41611ec03ce69e"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"c1e619d74aba3f2404efdab8033795ee1b9ccb93","node_id":"C_kwDOEFLz89oAKGMxZTYxOWQ3NGFiYTNmMjQwNGVmZGFiODAzMzc5NWVlMWI5Y2NiOTM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c1e619d74aba3f2404efdab8033795ee1b9ccb93","html_url":"https://github.com/juanfont/headscale/commit/c1e619d74aba3f2404efdab8033795ee1b9ccb93","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-09-28T08:50:46Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-10-09T14:36:29Z"},"tree":{"sha":"f1c9633a2d33965c27190762cb621ad41ef7f524","url":"https://api.github.com/repos/juanfont/headscale/git/trees/f1c9633a2d33965c27190762cb621ad41ef7f524"},"message":"integration/androidic: add Android emulator client\n\nRuns the official Tailscale Android app in the emulator and drives it\nlike a user, over adb and uiautomator: login via the alternate server\ndialog, an auth key, MDM or the debug login hook, CA installation in the\nuser or system store, network toggles, exit node selection and Taildrop.\nThe app has no CLI, so tests verify externally.\n\nUpdates tailscale/tailscale#15660","parents":[{"sha":"007172663c2e6d62f5b63eeb73547c247598e7d3","url":"https://api.github.com/repos/juanfont/headscale/git/commits/007172663c2e6d62f5b63eeb73547c247598e7d3","html_url":"https://github.com/juanfont/headscale/commit/007172663c2e6d62f5b63eeb73547c247598e7d3"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"1d03b9cfb18a309827300b80db222458d607f2b8","node_id":"C_kwDOEFLz89oAKDFkMDNiOWNmYjE4YTMwOTgyNzMwMGI4MGRiMjIyNDU4ZDYwN2YyYjg","url":"https://api.github.com/repos/juanfont/headscale/git/commits/1d03b9cfb18a309827300b80db222458d607f2b8","html_url":"https://github.com/juanfont/headscale/commit/1d03b9cfb18a309827300b80db222458d607f2b8","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-09-28T08:50:56Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-10-09T14:36:29Z"},"tree":{"sha":"60c494de3bda5f16c1316e80