[{"id":24294972410,"node_id":"HRFPE_lADOEFLz8877zJNqzwAAAAWoF9v6","url":"https://api.github.com/repos/juanfont/headscale/issues/events/24294972410","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"c518f07eb3da0b3e527a19cc68dbd23d108b2fda","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/c518f07eb3da0b3e527a19cc68dbd23d108b2fda","created_at":"2026-04-08T12:29:38Z","performed_via_github_app":null},{"sha":"17f99487d2d796efdb807187e6e3e5dd46f5776b","node_id":"C_kwDOEFLz89oAKDE3Zjk5NDg3ZDJkNzk2ZWZkYjgwNzE4N2U2ZTNlNWRkNDZmNTc3NmI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/17f99487d2d796efdb807187e6e3e5dd46f5776b","html_url":"https://github.com/juanfont/headscale/commit/17f99487d2d796efdb807187e6e3e5dd46f5776b","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-04-02T13:10:20Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-04-09T07:33:43Z"},"tree":{"sha":"f1026efc4af81d45770f14bba1d6abbfdd3b728e","url":"https://api.github.com/repos/juanfont/headscale/git/trees/f1026efc4af81d45770f14bba1d6abbfdd3b728e"},"message":"types/change: fix slice aliasing in Change.Merge\n\nMerge copies the receiver by value, but the slice headers share the\nbacking array with the original. When append has spare capacity, it\nwrites through to the original's memory, and uniqueNodeIDs then\nsorts that shared data in place.\n\nReplace append with slices.Concat which always allocates a fresh\nbacking array, preventing mutation of the receiver's slices.","parents":[{"sha":"7c756b82019755ee8110557ff57d94a0db66a0ac","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7c756b82019755ee8110557ff57d94a0db66a0ac","html_url":"https://github.com/juanfont/headscale/commit/7c756b82019755ee8110557ff57d94a0db66a0ac"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"7420efb3dc752c5b233570ee4478dde924b24bec","node_id":"C_kwDOEFLz89oAKDc0MjBlZmIzZGM3NTJjNWIyMzM1NzBlZTQ0NzhkZGU5MjRiMjRiZWM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7420efb3dc752c5b233570ee4478dde924b24bec","html_url":"https://github.com/juanfont/headscale/commit/7420efb3dc752c5b233570ee4478dde924b24bec","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-04-02T13:11:25Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-04-09T07:33:43Z"},"tree":{"sha":"a1b2cdd02e3ff2c8373d9b790f9bb5d5fa8807dd","url":"https://api.github.com/repos/juanfont/headscale/git/trees/a1b2cdd02e3ff2c8373d9b790f9bb5d5fa8807dd"},"message":"state: fix routesChanged mutating input Hostinfo\n\nroutesChanged aliases newHI.RoutableIPs into a local variable then\nsorts it in place, which mutates the caller's Hostinfo data. The\nHostinfo is subsequently stored on the node, so the mutation\npropagates but the input contract is violated.\n\nClone the slice before sorting to avoid mutating the input.","parents":[{"sha":"17f99487d2d796efdb807187e6e3e5dd46f5776b","url":"https://api.github.com/repos/juanfont/headscale/git/commits/17f99487d2d796efdb807187e6e3e5dd46f5776b","html_url":"https://github.com/juanfont/headscale/commit/17f99487d2d796efdb807187e6e3e5dd46f5776b"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"52a2a727a4af4a6dccbbee0d29415889064bfa33","node_id":"C_kwDOEFLz89oAKDUyYTJhNzI3YTRhZjRhNmRjY2JiZWUwZDI5NDE1ODg5MDY0YmZhMzM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/52a2a727a4af4a6dccbbee0d29415889064bfa33","html_url":"https://github.com/juanfont/headscale/commit/52a2a727a4af4a6dccbbee0d29415889064bfa33","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-04-08T12:25:21Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-04-09T07:33:43Z"},"tree":{"sha":"57a2b37b0514eea58bdffa01690f883f9aa57e4a","url":"https://api.github.com/repos/juanfont/headscale/git/trees/57a2b37b0514eea58bdffa01690f883f9aa57e4a"},"message":"db: fix slice aliasing in migration tag merge\n\nThe migration at db.go:680 appends validated tags to existing tags\nusing append(existingTags, validatedTags...) where existingTags\naliases node.Tags. When node.Tags has spare capacity, append writes\ninto the shared backing array, and the subsequent slices.Sort\ncorrupts the original.\n\nClone existingTags before appending to prevent aliasing.","parents":[{"sha":"7420efb3dc752c5b233570ee4478dde924b24bec","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7420efb3dc752c5b233570ee4478dde924b24bec","html_url":"https://github.com/juanfont/headscale/commit/7420efb3dc752c5b233570ee4478dde924b24bec"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"d67de3da96609d86755f08f2bf6114d667d95b85","node_id":"C_kwDOEFLz89oAKGQ2N2RlM2RhOTY2MDlkODY3NTVmMDhmMmJmNjExNGQ2NjdkOTViODU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/d67de3da96609d86755f08f2bf6114d667d95b85","html_url":"https://github.com/juanfont/headscale/commit/d67de3da96609d86755f08f2bf6114d667d95b85","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-04-08T12:25:50Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-04-09T07:33:43Z"},"tree":{"sha":"e2363f24f3ddf9e0ac0b82695606d664128b863f","url":"https://api.github.com/repos/juanfont/headscale/git/trees/e2363f24f3ddf9e0ac0b82695606d664128b863f"},"message":"types: fix nil panics in Owner() and TailscaleUserID() for orphaned nodes\n\nOwner() on a non-tagged node with nil User returns an invalid\nUserView that panics when Name() is called. Add a guard to return\nan empty UserView{} when the user is not valid.\n\nTailscaleUserID() calls UserID().Get() without checking Valid()\nfirst, which panics on orphaned nodes (no tags, no UserID). Add a\nvalidity check to return 0 for this invalid state.\n\nCallers should check Owner().Valid() before accessing fields.","parents":[{"sha":"52a2a727a4af4a6dccbbee0d29415889064bfa33","url":"https://api.github.com/repos/juanfont/headscale/git/commits/52a2a727a4af4a6dccbbee0d29415889064bfa33","html_url":"https://github.com/juanfont/headscale/commit/52a2a727a4af4a6dccbbee0d29415889064bfa33"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"85f9a769809d85627911ec5037c57ee80ed779b6","node_id":"C_kwDOEFLz89oAKDg1ZjlhNzY5ODA5ZDg1NjI3OTExZWM1MDM3YzU3ZWU4MGVkNzc5YjY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/85f9a769809d85627911ec5037c57ee80ed779b6","html_url":"https://github.com/juanfont/headscale/commit/85f9a769809d85627911ec5037c57ee80ed779b6","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-04-08T12:26:06Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-04-09T07:33:43Z"},"tree":{"sha":"0a8ad2298145f6d68d28883d2bdf07d9923870cc","url":"https://api.github.com/repos/juanfont/headscale/git/trees/0a8ad2298145f6d68d28883d2bdf07d9923870cc"},"message":"types: fix OIDC identifier path traversal dropping subject\n\nurl.JoinPath resolves path-traversal segments like '..' and '.',\nwhich silently drops the OIDC subject from the identifier. For\nexample, Iss='https://example.com' with Sub='..' produces\n'https://example.com' — the subject is lost entirely. This causes\ndistinct OIDC users to receive colliding identifiers.\n\nReplace url.JoinPath with simple string concatenation using a slash\nseparator. This preserves the subject literally regardless of its\ncontent. url.PathEscape does not help because dots are valid URL\npath characters and are not escaped.","parents":[{"sha":"d67de3da96609d86755f08f2bf6114d667d95b85","url":"https://api.github.com/repos/juanfont/headscale/git/commits/d67de3da96609d86755f08f2bf6114d667d95b85","html_url":"https://github.com/juanfont/headscale/commit/d67de3da96609d86755f08f2bf6114d667d95b85"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"9efa8fc3e9aa90d5ed868d1a09b63c45b97df3ef","node_id":"C_kwDOEFLz89oAKDllZmE4ZmMzZTlhYTkwZDVlZDg2OGQxYTA5YjYzYzQ1Yjk3ZGYzZWY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/9efa8fc3e9aa90d5ed868d1a09b63c45b97df3ef","html_url":"https://github.com/juanfont/headscale/commit/9efa8fc3e9aa90d5ed868d1a09b63c45b97df3ef","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-04-08T12:26:22Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-04-09T07:33:43Z"},"tree":{"sha":"47c2e14d6dd546cc2787b3011f79953ad2443b1e","url":"https://api.github.com/repos/juanfont/headscale/git/trees/47c2e14d6dd546cc2787b3011f79953ad2443b1e"},"message":"types/change: panic on Merge with conflicting TargetNode values\n\nMerging two changes targeted at different nodes is not supported\nbecause the result can only carry one TargetNode. The second\ntarget's content would be silently misrouted.\n\nAdd a panic guard that catches this at the Merge call site rather\nthan allowing silent data loss. In production, Merge is only called\nwith broadcast changes (TargetNode=0) so the guard acts as\ninsurance against future misuse.","parents":[{"sha":"85f9a769809d85627911ec5037c57ee80ed779b6","url":"https://api.github.com/repos/juanfont/headscale/git/commits/85f9a769809d85627911ec5037c57ee80ed779b6","html_url":"https://github.com/juanfont/headscale/commit/85f9a769809d85627911ec5037c57ee80ed779b6"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"732c4ff598fa68637ea8706274d76fb2a1c3426c","node_id":"C_kwDOEFLz89oAKDczMmM0ZmY1OThmYTY4NjM3ZWE4NzA2Mjc0ZDc2ZmIyYTFjMzQyNmM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/732c4ff598fa68637ea8706274d76fb2a1c3426c","html_url":"https://github.com/juanfont/headscale/commit/732c4ff598fa68637ea8706274d76fb2a1c3426c","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-04-08T12:26:44Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-04-09T07:33:43Z"},"tree":{"sha":"1aeb7cdf4d47a0d32d02b78c1bd54c9a615a67ea","url":"https://api.github.com/repos/juanfont/headscale/git/trees/1aeb7cdf4d47a0d32d02b78c1bd54c9a615a67ea"},"message":"mapper: fix empty Peers list not clearing client peer state\n\nWhen a FullUpdate produces zero visible peers (e.g., a restrictive\npolicy isolates a node), the MapResponse has Peers: [] (empty\nnon-nil). The Tailscale client only processes Peers as a full\nreplacement when len(Peers) > 0 (controlclient/map.go:462), so an\nempty list is silently ignored and stale peers persist.\n\nThis triggers when a FullUpdate() replaces a pending PolicyChange()\nin the batcher. The PolicyChange would have used computePeerDiff to\nsend explicit PeersRemoved, but the FullUpdate goes through\nbuildFromChange which sets Peers: [] that the client ignores.\n\nWhen a full update produces zero peers, compute the peer diff\nagainst lastSentPeers and add explicit PeersRemoved entries so the\nclient correctly clears its stale peer state.","parents":[{"sha":"9efa8fc3e9aa90d5ed868d1a09b63c45b97df3ef","url":"https://api.github.com/repos/juanfont/headscale/git/commits/9efa8fc3e9aa90d5ed868d1a09b63c45b97df3ef","html_url":"https://github.com/juanfont/headscale/commit/9efa8fc3e9aa90d5ed868d1a09b63c45b97df3ef"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":24329950041,"node_id":"HRFPE_lADOEFLz8877zJNqzwAAAAWqLZNZ","url":"https://api.github.com/repos/juanfont/headscale/issues/events/24329950041","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"7b1116b148bc651a1869b952a709191d2ce6ded0","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/7b1116b148bc651a1869b952a709191d2ce6ded0","created_at":"2026-04-09T09:30:14Z","performed_via_github_app":null},{"sha":"7c5564f5da357b97e073441d6e7b6208f179d8ce","node_id":"C_kwDOEFLz89oAKDdjNTU2NGY1ZGEzNTdiOTdlMDczNDQxZDZlN2I2MjA4ZjE3OWQ4Y2U","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7c5564f5da357b97e073441d6e7b6208f179d8ce","html_url":"https://github.com/juanfont/headscale/commit/7c5564f5da357b97e073441d6e7b6208f179d8ce","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-04-08T12:27:04Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-04-09T11:33:20Z"},"tree":{"sha":"f02416e96e6ff4908ed0887330e90fe5191ab150","url":"https://api.github.com/repos/juanfont/headscale/git/trees/f02416e96e6ff4908ed0887330e90fe5191ab150"},"message":"mapper: fix phantom updateSentPeers on disconnected nodes\n\nWhen send() is called on a node with zero active connections\n(disconnected but kept for rapid reconnection), it returns nil\n(success). handleNodeChange then calls updateSentPeers, recording\npeers as delivered when no client received the data.\n\nThis corrupts lastSentPeers: future computePeerDiff calculations\nproduce wrong results because they compare against phantom state.\nAfter reconnection, the node's initial map resets lastSentPeers,\nbut any changes processed during the disconnect window leave\nstale entries that cause asymmetric peer visibility.\n\nReturn errNoActiveConnections from send() when there are no\nconnections. handleNodeChange treats this as a no-op (the change\nwas generated but not deliverable) and skips updateSentPeers,\nkeeping lastSentPeers consistent with what clients actually\nreceived.","parents":[{"sha":"732c4ff598fa68637ea8706274d76fb2a1c3426c","url":"https://api.github.com/repos/juanfont/headscale/git/commits/732c4ff598fa68637ea8706274d76fb2a1c3426c","html_url":"https://github.com/juanfont/headscale/commit/732c4ff598fa68637ea8706274d76