submitted_at":"2026-09-14T07:43:36Z","updated_at":"2026-09-14T07:43:36Z","author_association":"COLLABORATOR","event":"reviewed"},{"id":31084575961,"node_id":"MIE_lADOEFLz888AAAABQccMo88AAAAHPMj82Q","url":"https://api.github.com/repos/juanfont/headscale/issues/events/31084575961","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"milestoned","commit_id":null,"commit_url":null,"created_at":"2026-09-14T07:43:52Z","milestone":{"title":"v0.29"},"performed_via_github_app":null},{"sha":"369593f500ed37c468be86933822fd2a750b31cb","node_id":"C_kwDOEFLz89oAKDM2OTU5M2Y1MDBlZDM3YzQ2OGJlODY5MzM4MjJmZDJhNzUwYjMxY2I","url":"https://api.github.com/repos/juanfont/headscale/git/commits/369593f500ed37c468be86933822fd2a750b31cb","html_url":"https://github.com/juanfont/headscale/commit/369593f500ed37c468be86933822fd2a750b31cb","author":{"name":"Andrei Korviakov","email":"4lifenet@gmail.com","date":"2026-09-14T14:04:04Z"},"committer":{"name":"Andrei Korviakov","email":"4lifenet@gmail.com","date":"2026-09-14T14:04:04Z"},"tree":{"sha":"d76d7e65a4f7f71a1c6104c2fb93be8f1322167e","url":"https://api.github.com/repos/juanfont/headscale/git/trees/d76d7e65a4f7f71a1c6104c2fb93be8f1322167e"},"message":"hscontrol: keep the ACME error body readable in acmeLogger\n\nacmeLogger drained and closed the body of every ACME error response before\nhanding the response back to golang.org/x/crypto/acme. The client parses that\nbody to classify errors, so badNonce was no longer recognised: isBadNonce\nreturned false, clearNonces was never called and Client.post treated the 400 as\nnon-retriable.\n\nOne badNonce reply therefore stops certificate renewal for good. autocert\nretries every 30-60 minutes, each attempt reuses a nonce stored from the\nprevious failed response, that nonce has already expired, and the loop repeats\nuntil the process is restarted or the certificate expires.\n\nRestore the body with a fresh reader after logging it.","parents":[{"sha":"4087d1fee9d34d042b279262ffbdaf1030ffd5e8","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4087d1fee9d34d042b279262ffbdaf1030ffd5e8","html_url":"https://github.com/juanfont/headscale/commit/4087d1fee9d34d042b279262ffbdaf1030ffd5e8"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgXmVfGc3ryLgxmXUV25TiHHLbvW\nhnDYGajs6+Osw4fzIAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQDNHssGSJd6+G05o/dliLLcW8dLe8sjyGpK3nSs8GUjLCEDCeyYkd4CB6ZCiWaPWdm\n5ywOMck+VHFphvA0gMWws=\n-----END SSH SIGNATURE-----","payload":"tree d76d7e65a4f7f71a1c6104c2fb93be8f1322167e\nparent 4087d1fee9d34d042b279262ffbdaf1030ffd5e8\nauthor Andrei Korviakov <4lifenet@gmail.com> 1789394644 +0300\ncommitter Andrei Korviakov <4lifenet@gmail.com> 1789394644 +0300\n\nhscontrol: keep the ACME error body readable in acmeLogger\n\nacmeLogger drained and closed the body of every ACME error response before\nhanding the response back to golang.org/x/crypto/acme. The client parses that\nbody to classify errors, so badNonce was no longer recognised: isBadNonce\nreturned false, clearNonces was never called and Client.post treated the 400 as\nnon-retriable.\n\nOne badNonce reply therefore stops certificate renewal for good. autocert\nretries every 30-60 minutes, each attempt reuses a nonce stored from the\nprevious failed response, that nonce has already expired, and the loop repeats\nuntil the process is restarted or the certificate expires.\n\nRestore the body with a fresh reader after logging it.\n","verified_at":"2026-09-14T14:04:49Z"},"event":"committed"},{"sha":"2485e60bc851b3adc830a14bfbe829ac5454cc29","node_id":"C_kwDOEFLz89oAKDI0ODVlNjBiYzg1MWIzYWRjODMwYTE0YmZiZTgyOWFjNTQ1NGNjMjk","url":"https://api.github.com/repos/juanfont/headscale/git/commits/2485e60bc851b3adc830a14bfbe829ac5454cc29","html_url":"https://github.com/juanfont/headscale/commit/2485e60bc851b3adc830a14bfbe829ac5454cc29","author":{"name":"Andrei Korviakov","email":"4lifenet@gmail.com","date":"2026-09-14T14:04:04Z"},"committer":{"name":"Andrei Korviakov","email":"4lifenet@gmail.com","date":"2026-09-14T14:04:04Z"},"tree":{"sha":"e9c4e9e76a580e93cef16f8a2bce38a3215e178b","url":"https://api.github.com/repos/juanfont/headscale/git/trees/e9c4e9e76a580e93cef16f8a2bce38a3215e178b"},"message":"changelog: note the acmeLogger renewal fix","parents":[{"sha":"369593f500ed37c468be86933822fd2a750b31cb","url":"https://api.github.com/repos/juanfont/headscale/git/commits/369593f500ed37c468be86933822fd2a750b31cb","html_url":"https://github.com/juanfont/headscale/commit/369593f500ed37c468be86933822fd2a750b31cb"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgXmVfGc3ryLgxmXUV25TiHHLbvW\nhnDYGajs6+Osw4fzIAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQAiFVACFb8YNDjmK1lDYkaq+aq5lKyOE/G2qwKX9gbEcs4bQo/lhzXWaib/e+3280G\nGT7GvpuvNqTheFOLDEqws=\n-----END SSH SIGNATURE-----","payload":"tree e9c4e9e76a580e93cef16f8a2bce38a3215e178b\nparent 369593f500ed37c468be86933822fd2a750b31cb\nauthor Andrei Korvi