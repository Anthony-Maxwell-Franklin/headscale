[{"sha":"3655a10728b48e42dde189b851dafb26b00504af","node_id":"C_kwDOEFLz89oAKDM2NTVhMTA3MjhiNDhlNDJkZGUxODliODUxZGFmYjI2YjAwNTA0YWY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/3655a10728b48e42dde189b851dafb26b00504af","html_url":"https://github.com/juanfont/headscale/commit/3655a10728b48e42dde189b851dafb26b00504af","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-02-05T11:25:14Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-02-09T08:40:16Z"},"tree":{"sha":"be4d4ec972f8450441995d19b257c3283fee4fe6","url":"https://api.github.com/repos/juanfont/headscale/git/trees/be4d4ec972f8450441995d19b257c3283fee4fe6"},"message":"github: add needs-more-info automation workflow\n\nAdd GitHub Actions automation that helps manage issues requiring\nadditional information from reporters:\n\n- Post an instruction comment when 'needs-more-info' label is added,\n  requesting environment details, debug logs from multiple nodes,\n  configuration files, and proper formatting\n- Automatically remove the label when anyone comments\n- Close the issue after 3 days if no response is provided\n- Exempt needs-more-info labeled issues from the stale bot\n\nThe instruction comment includes guidance on:\n- Required environment and debug information\n- Collecting logs from both connecting and connected-to nodes\n- Proper redaction rules (replace consistently, never remove IPs)\n- Formatting requirements for attachments and Markdown\n- Encouragement to discuss on Discord before filing issues","parents":[{"sha":"9e50071df9ab70730a2921f3e6b3693bc0a60118","url":"https://api.github.com/repos/juanfont/headscale/git/commits/9e50071df9ab70730a2921f3e6b3693bc0a60118","html_url":"https://github.com/juanfont/headscale/commit/9e50071df9ab70730a2921f3e6b3693bc0a60118"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"4e4fcb550bee1006b3a67a22b4cfd3fe61303f42","node_id":"C_kwDOEFLz89oAKDRlNGZjYjU1MGJlZTEwMDZiM2E2N2EyMmI0Y2ZkM2ZlNjEzMDNmNDI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4e4fcb550bee1006b3a67a22b4cfd3fe61303f42","html_url":"https://github.com/juanfont/headscale/commit/4e4fcb550bee1006b3a67a22b4cfd3fe61303f42","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-02-05T11:32:08Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-02-09T08:40:16Z"},"tree":{"sha":"0c6e112eb05b65f727135b2ecc09108152a0280b","url":"https://api.github.com/repos/juanfont/headscale/git/trees/0c6e112eb05b65f727135b2ecc09108152a0280b"},"message":"github: add support-request automation workflow\n\nAdd workflow that automatically closes issues labeled as\nsupport-request with a message directing users to Discord\nfor configuration and support questions.\n\nThe workflow:\n- Triggers when support-request label is added\n- Posts a comment explaining this tracker is for bugs/features\n- Links to documentation and Discord\n- Closes the issue as \"not planned\"","parents":[{"sha":"3655a10728b48e42dde189b851dafb26b00504af","url":"https://api.github.com/repos/juanfont/headscale/git/commits/3655a10728b48e42dde189b851dafb26b00504af","html_url":"https://github.com/juanfont/headscale/commit/3655a10728b48e42dde189b851dafb26b00504af"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"1642822b36918aafdd1015826a8c092d2c335028","node_id":"C_kwDOEFLz89oAKDE2NDI4MjJiMzY5MThhYWZkZDEwMTU4MjZhOGMwOTJkMmMzMzUwMjg","url":"https://api.github.com/repos/juanfont/headscale/git/commits/1642822b36918aafdd1015826a8c092d2c335028","html_url":"https://github.com/juanfont/headscale/commit/1642822b36918aafdd1015826a8c092d2c335028","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-02-05T11:35:04Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc",