l":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"requested_reviewer":{"login":"juanfont","id":181059,"node_id":"MDQ6VXNlcjE4MTA1OQ==","avatar_url":"https://avatars.githubusercontent.com/u/181059?v=4","gravatar_id":"","url":"https://api.github.com/users/juanfont","html_url":"https://github.com/juanfont","followers_url":"https://api.github.com/users/juanfont/followers","following_url":"https://api.github.com/users/juanfont/following{/other_user}","gists_url":"https://api.github.com/users/juanfont/gists{/gist_id}","starred_url":"https://api.github.com/users/juanfont/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/juanfont/subscriptions","organizations_url":"https://api.github.com/users/juanfont/orgs","repos_url":"https://api.github.com/users/juanfont/repos","events_url":"https://api.github.com/users/juanfont/events{/privacy}","received_events_url":"https://api.github.com/users/juanfont/received_events","type":"User","user_view_type":"public","site_admin":false},"performed_via_github_app":null},{"id":11202914226,"node_id":"HRFPE_lADOEFLz8855QhzMzwAAAAKbvuey","url":"https://api.github.com/repos/juanfont/headscale/issues/events/11202914226","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"f219cb421d16749dee5d67b876e1fd6074396c47","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/f219cb421d16749dee5d67b876e1fd6074396c47","created_at":"2023-12-10T13:44:21Z","performed_via_github_app":null},{"sha":"8768eaae7fd8e173ce30f121b9ca8571ad05ae6c","node_id":"C_kwDOEFLz89oAKDg3NjhlYWFlN2ZkOGUxNzNjZTMwZjEyMWI5Y2E4NTcxYWQwNWFlNmM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8768eaae7fd8e173ce30f121b9ca8571ad05ae6c","html_url":"https://github.com/juanfont/headscale/commit/8768eaae7fd8e173ce30f121b9ca8571ad05ae6c","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2023-12-10T13:36:37Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2023-12-10T13:45:05Z"},"tree":{"sha":"3dc4392c269e8c36781dcc3733c80220cd57bd3c","url":"https://api.github.com/repos/juanfont/headscale/git/trees/3dc4392c269e8c36781dcc3733c80220cd57bd3c"},"message":"add versioned migrations\n\nUp until this commit, headscale has had one massive migration func that\nruns every time the server starts. This means that every time we have\nmigrated anything, we have added stuff to it and not really taken into\naccount how the database of clients look like. This means that sometimes\nthe new stuff has had to be added in the middle, as it would break things\nfurther down.\n\nIt is kind of a miracle that it has worked so far with no permament damage,\nparticularly considering some of our larger migrations like Machine -> Node\nor Namespace -> User.\n\nThis commit addresses this by adding gormigrate, which is a simple versioned\nmigration system. As we have to maintain our messy past, the first migration\nis the large, currently working, but hard to change function. Subsequent changes\nshould be added with new IDs after this.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>","parents":[{"sha":"2c8fc9b06155a694da0ebc7b620edcb13b69cac2","url":"https://api.github.com/repos/juanfont/headscale/git/commits/2c8fc9b06155a694da0ebc7b620edcb13b69cac2","html_url":"https://github.com/juanfont/headscale/commit/2c8fc9b06155a694da0ebc7b620edcb13b69cac2"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAAGgAAAATZWNkc2Etc2hhMi1uaXN0cDI1NgAAAAhuaXN0cDI1NgAAAE\nEE6bT6+U8pNExCb214X9sKtM8QMSqzWb4HmQxm24sqHasMtgza7Cws+M2NoiUVB+RSfa/I\nCoai/Io5VHtD9nbzKgAAAANnaXQAAAAAAAAABnNoYTUxMgAAAGQAAAATZWNkc2Etc2hhMi\n1uaXN0cDI1NgAAAEkAAAAhAL0WRykbI8VY5NTmO0rcdmJ6Gjj3RCJXGQHTU1zAjcZkAAAA\nIHxtEH8TcuXgsdu+RCQBkFLYXY2g+t/zHmPAwbBSzKfK\n-----END SSH SIGNATURE-----","payload":"tree 3dc4392c269e8c36781dcc3733c80220cd57bd3c\nparent 2c8fc9b06155a694da0ebc7b620edcb13b69cac2\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1702215397 +0100\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1702215905 +0100\n\nadd versioned migrations\n\nUp until this commit, headscale has had one massive migration func that\nruns every time the server starts. This means that every time we have\nmigrated anything, we have added stuff to it and not really taken into\naccount how the database of clients look like. This means that sometimes\nthe new stuff has had to be added in the middle, as it would break things\nfurther down.\n\nIt is kind of a miracle that it has worked so far with no permament damage,\nparticularly considering some of our larger migrations like Machine -> Node\nor Namespace -> User.\n\nThis commit addresses this by adding gormigrate, which is a simple versioned\nmigration system. As we have to maintain our messy past, the first migration\nis the large, currently working, but hard to change function. Subsequent changes\nshould be added with new IDs after this.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>\n","verified_at":"2024-11-09T08:58:50Z"},"event":"committed"},{"id":11202915608,"node_id":"HRFPE_lADOEFLz8855QhzMzwAAAAKbvu0Y","url":"https://api.github.com/repos/juanfont/headscale/issues/events/11202915608","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"8768eaae7fd8e173ce30f121b9ca8571ad05ae6c","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/8768eaae7fd8e173ce30f121b9ca8571ad05ae6c","created_at":"2023-12-10T13:45:11Z","performed_via_github_app":null},{"id":11202934406,"node_id":"MIE_lADOEFLz8855QhzMzwAAAAKbvzaG","url":"https://api.github.com/repos/juanfont/headscale/issues/events/11202934406","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gi