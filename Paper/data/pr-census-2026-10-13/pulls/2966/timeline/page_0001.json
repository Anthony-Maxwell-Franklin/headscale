[{"sha":"063b6eae410b63443e2c036791150c109d73e45f","node_id":"C_kwDOEFLz89oAKDA2M2I2ZWFlNDEwYjYzNDQzZTJjMDM2NzkxMTUwYzEwOWQ3M2U0NWY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/063b6eae410b63443e2c036791150c109d73e45f","html_url":"https://github.com/juanfont/headscale/commit/063b6eae410b63443e2c036791150c109d73e45f","author":{"name":"Paul Norton","email":"goldfish.paul@gmail.com","date":"2025-12-16T19:45:09Z"},"committer":{"name":"Paul Norton","email":"goldfish.paul@gmail.com","date":"2025-12-16T19:45:09Z"},"tree":{"sha":"fe7556aef2004f9257bf8a1d03c67432c2004813","url":"https://api.github.com/repos/juanfont/headscale/git/trees/fe7556aef2004f9257bf8a1d03c67432c2004813"},"message":"Implement static IP assignment for nodes and add related configurations\n\n- Introduced a new configuration option for static node IP assignments in `config-example.yaml` and `types/config.go`.\n- Added a new gRPC method `SetNodeIP` to allow setting custom IP addresses for nodes via API.\n- Implemented logic in `hscontrol` to apply static IPs on server startup.\n- Created a new document `AGENTS.md` detailing guidelines for the custom IP implementation.\n- Added integration tests to ensure functionality and validate static IP assignments.\n- Updated NixOS module and CI configurations to support new features.\n\nThis commit enhances the Headscale functionality by allowing users to assign custom IP addresses to nodes, improving network management capabilities.","parents":[{"sha":"f658a8eacd4d86edc65424b50635afed46ca4b2a","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f658a8eacd4d86edc65424b50635afed46ca4b2a","html_url":"https://github.com/juanfont/headscale/commit/f658a8eacd4d86edc65424b50635afed46ca4b2a"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"d43bbe5d9e801bbee132b198f77ec945d1edad68","node_id":"C_kwDOEFLz89oAKGQ0M2JiZTVkOWU4MDFiYmVlMTMyYjE5OGY3N2VjOTQ1ZDF