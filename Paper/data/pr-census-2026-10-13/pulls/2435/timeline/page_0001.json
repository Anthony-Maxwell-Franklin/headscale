[{"sha":"4aeee171e200ef8a54910bbced4b1883946b4a81","node_id":"C_kwDOEFLz89oAKDRhZWVlMTcxZTIwMGVmOGE1NDkxMGJiY2VkNGIxODgzOTQ2YjRhODE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4aeee171e200ef8a54910bbced4b1883946b4a81","html_url":"https://github.com/juanfont/headscale/commit/4aeee171e200ef8a54910bbced4b1883946b4a81","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-02-18T19:49:52Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-02-18T19:49:52Z"},"tree":{"sha":"806b5c5291000befc2431a7a615d0c872a294541","url":"https://api.github.com/repos/juanfont/headscale/git/trees/806b5c5291000befc2431a7a615d0c872a294541"},"message":"handle register auth errors\n\nThis commit handles register auth errors as the\nTailscale clients expect. It returns the error as\npart of a tailcfg.RegisterResponse and not as a\nhttp error.\n\nIn addition it fixes a nil pointer panic triggered\nby not handling the errors as part of this chain.\n\nFixes #2434\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>","parents":[{"sha":"2cce3a99ebe09b1db24a42534739bdaf06cbd5bd","url":"https://api.github.com/repos/juanfont/headscale/git/commits/2cce3a99ebe09b1db24a42534739bdaf06cbd5bd","html_url":"https://github.com/juanfont/headscale/commit/2cce3a99ebe09b1db24a42534739bdaf06cbd5bd"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgmMAoz5Zf+w0nAxyA6/zsNd95cP\n98YbtHIIXyy9A1sssAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQMg1GbVRTZHtDm7YxRfCOLr1Lb0idcBPhe+C86xA2MNexWQqQyQkdBem4iLqdjSi6q\nUz4wUjjulJI8Sc1kjfdQ8=\n-----END SSH SIGNATURE-----","payload":"tree 806b5c5291000befc2431a7a615d0c872a294541\nparent 2cce3a99ebe09b1db24a42534739bdaf06cbd5bd\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1739908192 +0100\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1739908192 +0100\n\nhandle register auth errors\n\nThis commit handles register auth errors as the\nTailscale clients expect. It returns the error as\npart of a tailcfg.RegisterResponse and not as a\nhttp error.\n\nIn addition it fixes a nil pointer panic triggered\nby not handling the errors as part of this chain.\n\nFixes #2434\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>\n","verified_at":"2025-02-18T19:52:03Z"},"event":"committed"},{"id":16354818749,"node_id":"RRE_lADOEFLz886qjw-EzwAAAAPO0rq9","url":"https://api.github.com/repos/juanfont/headscale/issues/events/16354818749","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"review_requested","commit_id":null,"commit_url":null,"created_at":"2025-02-18T19:52:16Z","review_requester":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"h