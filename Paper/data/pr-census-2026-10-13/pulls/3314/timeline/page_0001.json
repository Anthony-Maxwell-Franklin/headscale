[{"sha":"0453d6e26d48e132567557d91d6a63c4a042904d","node_id":"C_kwDOEFLz89oAKDA0NTNkNmUyNmQ0OGUxMzI1Njc1NTdkOTFkNmE2M2M0YTA0MjkwNGQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/0453d6e26d48e132567557d91d6a63c4a042904d","html_url":"https://github.com/juanfont/headscale/commit/0453d6e26d48e132567557d91d6a63c4a042904d","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T10:52:37Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T12:13:48Z"},"tree":{"sha":"b57567162fc0d7b6f622035be262e8e59f493064","url":"https://api.github.com/repos/juanfont/headscale/git/trees/b57567162fc0d7b6f622035be262e8e59f493064"},"message":"state: re-register converted tagged nodes with reused key\n\nA node converted to tagged is re-indexed under no user, so re-registration\nkeyed on the key's owner missed it and rejected the spent one-shot key.\nMatch the existing tagged node by machine key.\n\nFixes #3312","parents":[{"sha":"a5ef3aff15ab559e06f1553dcbe653a7b1e2d4f4","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a5ef3aff15ab559e06f1553dcbe653a7b1e2d4f4","html_url":"https://github.com/juanfont/headscale/commit/a5ef3aff15ab559e06f1553dcbe653a7b1e2d4f4"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"4f19afbf23a2e857ec86946292131ae825695068","node_id":"C_kwDOEFLz89oAKDRmMTlhZmJmMjNhMmU4NTdlYzg2OTQ2MjkyMTMxYWU4MjU2OTUwNjg","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4f19afbf23a2e857ec86946292131ae825695068","html_url":"https://github.com/juanfont/headscale/commit/4f19afbf23a2e857ec86946292131ae825695068","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T10:55:45Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T12:13:48Z"},"tree":{"sha":"28ec15bf5e19efb7286c906593308f2ed4c73baf","url":"https://api.github.com/repos/juanfont/headscale/git/trees/28ec15bf5e19efb7286c906593308f2ed4c73baf"},"message":"auth: re-validate key when an expired node re-registers\n\nThe re-registration fast-path skipped validation for a matching node key\nwithout checking expiry, so an expired node could re-auth with a spent key.\nGate it on the node not being expired.\n\nUpdates #3312","parents":[{"sha":"0453d6e26d48e132567557d91d6a63c4a042904d","url":"https://api.github.com/repos/juanfont/headscale/git/commits/0453d6e26d48e132567557d91d6a63c4a042904d","html_url":"https://github.com/juanfont/headscale/commit/0453d6e26d48e132567557d91d6a63c4a042904d"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"a47cacb84dd94364d9ca3008e493fa70b01788d1","node_id":"C_kwDOEFLz89oAKGE0N2NhY2I4NGRkOTQzNjRkOWNhMzAwOGU0OTNmYTcwYjAxNzg4ZDE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a47cacb84dd94364d9ca3008e493fa70b01788d1","html_url":"https://github.com/juanfont/headscale/commit/a47cacb84dd94364d9ca3008e493fa70b01788d1","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T10:58:42Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T12:13:48Z"},"tree":{"sha":"8fc04ff1ebc484b83e609091336559257efcc371","url":"https://api.github.com/repos/juanfont/headscale/git/trees/8fc04ff1ebc484b83e609091336559257efcc371"},"message":"state: reject re-registration claiming another node's key\n\nThe pre-auth-key path wrote the client node key without the collision check\nthe auth path applies, so a re-registration could claim another node's key\nand poison the node-key index. Reject keys bound to a different machine.\n\nUpdates #3312","parents":[{"sha":"4f19afbf23a2e857ec86946292131ae825695068","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4f19afbf23a2e857ec86946292131ae825695068","html_url":"https://github.com/juanfont/headscale/commit/4f19afbf23a2e857ec86946292131ae825695068"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":4497436411,"node_id":"PRR_kwDOEFLz888AAAABDBFu-w","user":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"body":null,"commit_id":"d9130f2331338cb3d669bb522d6a1b40d0a43f85","state":"commented","html_url":"https://github.com/juanfont/headscale/pull/3314#pullrequestreview-4497436411","pull_request_url":"https://api.github.com/repos/juanfont/headscale/pulls/3314","_links":{"html":{"href":"https://github.com/juanfont/headscale/pull/3314#pullrequestreview-4497436411"},"pull_request":{"href":"https://api.github.com/repos/juanfont/headscale/pulls/3314"}},"submitted_at":"2026-06-15T12:43:28Z","updated_at":"2026-06-15T12:43:28Z","author_association":"COLLABORATOR","event":"reviewed"},{"id":4497631175,"node_id":"PRR_kwDOEFLz888AAAABDBRnxw","user":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"body":null,"commit_id":"ba5b759535c0cc3e40acda3459025dcd99c03a63","state":"commented","html_url":"https://github.com/juanfont/headscale/pull/3314#pullrequestreview-4497631175","pull_request_url":"https://api.github.com/repos/juanfont/headscale/pulls/3314","_links":{"html":{"href":"https://github.com/juanfont/headscale/pull/3314#pullrequestreview-4497631175"},"pull_request":{"href":"https://api.github.com/repos/juanfont/headscale/pulls/3314"}},"submitted_at":"2026-06-15T13:07:14Z","updated_at":"2026-06-15T13:07:14Z","author_association":"COLLABORATOR","event":"reviewed"},{"sha":"4e4ace9cd1e83a0c1a60a320bb37222961f8245e","node_id":"C_kwDOEFLz89oAKDRlNGFjZTljZDFlODNhMGMxYTYwYTMyMGJiMzcyMjI5NjFmODI0NWU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4e4ace9cd1e83a0c1a60a320bb37222961f8245e","html_url":"https://github.com/juanfont/headscale/commit/4e4ace9cd1e83a0c1a60a320bb37222961f8245e","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T11:07:26Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T13:07:22Z"},"tree":{"sha":"1c75e610f2fbb7a90e35da7e1119024b23a38f70","url":"https://api.github.com/repos/juanfont/headscale/git/trees/1c75e610f2fbb7a90e35da7e1119024b23a38f70"},"message":"state: make any-user machine-key lookup deterministic\n\nThe lookup returned the first map match, so re-auth branch choice varied\nwith map order once a machine key had more than one node. Prefer the tagged\nnode, else the lowest node ID.\n\nUpdates #3312","parents":[{"sha":"a47cacb84dd94364d9ca3008e493fa70b01788d1","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a47cacb84dd94364d9ca3008e493fa70b01788d1","html_url":"https://github.com/juanfont/headscale/commit/a47cacb84dd94364d9ca3008e493fa70b01788d1"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"068cfe1e4c90b61cf103b261c1eaa8a3a5531f65","node_id":"C_kwDOEFLz89oAKDA2OGNmZTFlNGM5MGI2MWNmMTAzYjI2MWMxZWFhOGEzYTU1MzFmNjU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/068cfe1e4c90b61cf103b261c1eaa8a3a5531f65","html_url":"https://github.com/juanfont/headscale/commit/068cfe1e4c90b61cf103b261c1eaa8a3a5531f65","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T11:13:34Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T13:08:40Z"},"tree":{"sha":"5c2a462d686e90f10aa928caa0ff38972a9c12d9","url":"https://api.github.com/repos/juanfont/headscale/git/trees/5c2a462d686e90f10aa928caa0ff38972a9c12d9"},"message":"state: update node in place on pre-auth-key re-registration\n\nA reusable key on a converted node, or a tagged key on a user-owned node,\nfell through to new-node creation, leaving two nodes per machine. Match by\nmachine key and update or convert in place.\n\nUpdates #3312","parents":[{"sha":"4e4ace9cd1e83a0c1a60a320bb37222961f8245e","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4e4ace9cd1e83a0c1a60a320bb37222961f8245e","html_url":"https://github.com/juanfont/headscale/commit/4e4ace9cd1e83a0c1a60a320bb37222961f8245e"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"d4d9089071b3615b34f65d278d92e2b3cd08adcf","node_id":"C_kwDOEFLz89oAKGQ0ZDkwODkwNzFiMzYxNWIzNGY2NWQyNzhkOTJlMmIzY2QwOGFkY2Y","url":"https://api.github.com/repos/juanfont/headscale/git/commits/d4d9089071b3615b34f65d278d92e2b3cd08adcf","html_url":"https://github.com/juanfont/headscale/commit/d4d9089071b3615b34f65d278d92e2b3cd08adcf","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T11:16:17Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T13:08:40Z"},"tree":{"sha":"b0d46886fdc680f319ee646f3502ce2610fea03c","url":"https://api.github.com/repos/juanfont/headscale/git/trees/b0d46886fdc680f319ee646f3502ce2610fea03c"},"message":"db: treat unknown pre-auth key as not found\n\nAn unknown or deleted key returned a bare error matching neither the\nnot-found nor pre-auth-key checks, so registration returned a server error\ninstead of 401. Wrap gorm.ErrRecordNotFound.\n\nUpdates #3312","parents":[{"sha":"068cfe1e4c90b61cf103b261c1eaa8a3a5531f65","url":"https://api.github.com/repos/juanfont/headscale/git/commits/068cfe1e4c90b61cf103b261c1eaa8a3a5531f65","html_url":"https://github.com/juanfont/headscale/commit/068cfe1e4c90b61cf103b261c1eaa8a3a5531f65"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"905cfdde52a1262a3811061eca1f14964a58c2ab","node_id":"C_kwDOEFLz89oAKDkwNWNmZGRlNTJhMTI2MmEzODExMDYxZWNhMWYxNDk2NGE1OGMyYWI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/905cfdde52a1262a3811061eca1f14964a58c2ab","html_url":"https://github.com/juanfont/headscale/commit/905cfdde52a1262a3811061eca1f14964a58c2ab","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T11:20:17Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T13:08:40Z"},"tree":{"sha":"e7747fd4916187ab9f12395438e915c5af999cde","url":"https://api.github.com/repos/juanfont/headscale/git/trees/e7747fd4916187ab9f12395438e915c5af999cde"},"message":"state: roll back node store when re-registration write fails\n\nRe-registration mutated the node store before the database write and did not\nrevert on failure, so a restart could drop the client's current node key.\nSnapshot the node and restore it if the write fails.\n\nUpdates #3312","parents":[{"sha":"d4d9089071b3615b34f65d278d92e2b3cd08adcf","url":"https://api.github.com/repos/juanfont/headscale/git/commits/d4d9089071b3615b34f65d278d92e2b3cd08adcf","html_url":"https://github.com/juanfont/headscale/commit/d4d9089071b3615b34f65d278d92e2b3cd08adcf"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":26758859344,"node_id":"HRFPE_lADOEFLz888AAAABFg3vec8AAAAGOvPKUA","url":"https://api.github.com/repos/juanfont/headscale/issues/events/26758859344","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"2978aed1f1226012bb91e3b4780024705e56a8d4","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/2978aed1f1226012bb91e3b4780024705e56a8d4","created_at":"2026-06-15T13:14:53Z","performed_via_github_app":null},{"sha":"7aec2888c2972b6059920e7edc11de6d9a18e121","node_id":"C_kwDOEFLz89oAKDdhZWMyODg4YzI5NzJiNjA1OTkyMGU3ZWRjMTFkZTZkOWExOGUxMjE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7aec2888c2972b6059920e7edc11de6d9a18e121","html_url":"https://github.com/juanfont/headscale/commit/7aec2888c2972b6059920e7edc11de6d9a18e121","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T11:27:13Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T13:19:46Z"},"tree":{"sha":"2a25777e3e477dedba5b5ea23dc679da60b4b7cd","url":"https://api.github.com/repos/juanfont/headscale/git/trees/2a25777e3e477dedba5b5ea23dc679da60b4b7cd"},"message":"state: serialise registration per machine key\n\nConcurrent registrations of one machine key each saw no existing node and\ncreated their own, duplicating nodes and IPs. Hold a per-machine lock across\nthe find-then-create section.\n\nUpdates #3312","parents":[{"sha":"905cfdde52a1262a3811061eca1f14964a58c2ab","url":"https://api.github.com/repos/juanfont/headscale/git/commits/905cfdde52a1262a3811061eca1f14964a58c2ab","html_url":"https://github.com/juanfont/headscale/commit/905cfdde52a1262a3811061eca1f14964a58c2ab"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"feb23c1540607315ea70a5ff7c52559c8887511a","node_id":"C_kwDOEFLz89oAKGZlYjIzYzE1NDA2MDczMTVlYTcwYTVmZjdjNTI1NTljODg4NzUxMWE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/feb23c1540607315ea70a5ff7c52559c8887511a","html_url":"https://github.com/juanfont/headscale/commit/feb23c1540607315ea70a5ff7c52559c8887511a","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T13:10:09Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T13:19:46Z"},"tree":{"sha":"40526192d37c83d5e87129d3069b7e713e0cef65","url":"https://api.github.com/repos/juanfont/headscale/git/trees/40526192d37c83d5e87129d3069b7e713e0cef65"},"message":"state: allow key expiry to be set on tagged nodes\n\nTagged nodes disable key expiry by default but can still have one set\nexplicitly, and changing tags leaves expiry unchanged, matching Tailscale.\n\nUpdates #3312","parents":[{"sha":"7aec2888c2972b6059920e7edc11de6d9a18e121","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7aec2888c2972b6059920e7edc11de6d9a18e121","html_url":"https://github.com/juanfont/headscale/commit/7aec2888c2972b6059920e7edc11de6d9a18e121"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"f6c0c558010cf3b58de04ffcfac811f16478198a","node_id":"C_kwDOEFLz89oAKGY2YzBjNTU4MDEwY2YzYjU4ZGUwNGZmY2ZhYzgxMWYxNjQ3ODE5OGE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f6c0c558010cf3b58de04ffcfac811f16478198a","html_url":"https://github.com/juanfont/headscale/commit/f6c0c558010cf3b58de04ffcfac811f16478198a","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T14:43:37Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T14:43:37Z"},"tree":{"sha":"aab8f63555a76344a8f1f4dcb6826819781ea955","url":"https://api.github.com/repos/juanfont/headscale/git/trees/aab8f63555a76344a8f1f4dcb6826819781ea955"},"message":"state: return all nodes for a machine key, reject ambiguous ownership\n\nCollapse the single-pick machine-key lookups onto GetNodesByMachineKeyAllUsers\nso callers see every node sharing a machine key and reject the ambiguous or\nimpossible cases (tagged and user-owned coexistence; a tagged key with several\nuser-owned candidates) instead of mutating an arbitrarily-picked node.\n\nUpdates #3312","parents":[{"sha":"feb23c1540607315ea70a5ff7c52559c8887511a","url":"https://api.github.com/repos/juanfont/headscale/git/commits/feb23c1540607315ea70a5ff7c52559c8887511a","html_url":"https://github.com/juanfont/headscale/commit/feb23c1540607315ea70a5ff7c52559c8887511a"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"1b2e723a734ba0124d4dacb465f3c8febd7eedb9","node_id":"C_kwDOEFLz89oAKDFiMmU3MjNhNzM0YmEwMTI0ZDRkYWNiNDY1ZjNjOGZlYmQ3ZWVkYjk","url":"https://api.github.com/repos/juanfont/headscale/git/commits/1b2e723a734ba0124d4dacb465f3c8febd7eedb9","html_url":"https://github.com/juanfont/headscale/commit/1b2e723a734ba0124d4dacb465f3c8febd7eedb9","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T14:43:37Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-15T14:43:37Z"},"tree":{"sha":"f097afc21600825dbdc2dc38678a14cc0970a8a2","url":"https://api.github.com/repos/juanfont/headscale/git/trees/f097afc21600825dbdc2dc38678a14cc0970a8a2"},"message":"db: drop ambiguous machine-key getter, match precisely in test helper\n\nThe First()-by-machine-key getter returned an undefined node when a machine\nkey mapped to several nodes. It was used only by RegisterNodeForTest; match on\n(machine_key, user_id) there instead and remove the getter.\n\nUpdates #3312","parents":[{"sha":"f6c0c558010cf3b58de04ffcfac811f16478198a","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f6c0c558010cf3b58de04ffcfac811f16478198a","html_url":"https://github.com/juanfont/headscale/commit/f6c0c558010cf3b58de04ffcfac811f16478198a"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":26763397845,"node_id":"HRFPE_lADOEFLz888AAAABFg3vec8AAAAGOzkK1Q","url":"https://api.github.com