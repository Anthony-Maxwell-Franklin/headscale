by/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"performed_via_github_app":null},{"id":5027392620,"node_id":"PRR_kwDOEFLz888AAAABK6fsbA","user":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"body":null,"commit_id":"ecd4c5d606d1db377920128db3e174b54304ada7","state":"commented","html_url":"https://github.com/juanfont/headscale/pull/3419#pullrequestreview-5027392620","pull_request_url":"https://api.github.com/repos/juanfont/headscale/pulls/3419","_links":{"html":{"href":"https://github.com/juanfont/headscale/pull/3419#pullrequestreview-5027392620"},"pull_request":{"href":"https://api.github.com/repos/juanfont/headscale/pulls/3419"}},"submitted_at":"2026-08-26T06:32:13Z","updated_at":"2026-08-26T06:32:13Z","author_association":"COLLABORATOR","event":"reviewed"},{"url":"https://api.github.com/repos/juanfont/headscale/issues/comments/5421531990","html_url":"https://github.com/juanfont/headscale/pull/3419#issuecomment-5421531990","issue_url":"https://api.github.com/repos/juanfont/headscale/issues/3419","id":5421531990,"node_id":"IC_kwDOEFLz888AAAABQyYDVg","user":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-26T06:34:52Z","updated_at":"2026-08-26T06:34:52Z","body":"Sorry for the long wait, I've been on holiday.\r\n\r\nNow that we are implementing an API that is largely aiming to be compatible with Tailscale, we should also put this IP in the right place. \r\n\r\nTailscale has this notion called \"device attributes\" which has a field for this particular IP that is requested in #2272, and it would fit nicely to wire up that single attribute as our \"initial device attribute\": https://tailscale.com/docs/features/device-posture#geolocation-attributes\r\n\r\n`ip:publicAddress` is used to represent the IP that the node last connected to the control server and can then be fetched from the API: https://tailscale.com/api-docs#tag/devices/GET/device/{deviceId}/attributes.\r\n\r\nIf you are up for giving it a go, that would be welcome, it would fit nicely with this planned release. If not I will get to it eventually. Since this will be some foundational work for working out the device attributes, please keep it to this one to avoid scope creep. \r\n\r\nWe can do the basic ones (`node:`) and expiries in a follow up, while the `custom:` ones can be more of a future thing:\r\n\r\n```\r\n{\r\n  \"attributes\": {\r\n    \"custom:myScore\": 80,\r\n    \"custom:diskEncryption\": true,\r\n    \"custom:myAttribute\": \"my_value\",\r\n    \"node:os\": \"linux\",\r\n    \"node:osVersion\": \"5.19.0-42-generic\",\r\n    \"node:tsReleaseTrack\": \"stable\",\r\n    \"node:tsVersion\": \"1.40.0\",\r\n    \"node:tsAutoUpdate\": false,\r\n    \"node:tsStateEncrypted\": false\r\n  },\r\n  \"expiries\": {\r\n    \"custom:myScore\": \"2024-04-23T18:25:43.511Z\"\r\n  }\r\n}\r\n```","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/juanfont/headscale/issues/comments/5421531990/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false}},{"sha":"9092bcc6a4