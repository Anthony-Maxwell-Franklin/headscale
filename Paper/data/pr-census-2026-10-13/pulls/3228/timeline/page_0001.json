EwMWE4MzgwNzc3ZTAwZjU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/e8e32c91a3aef9146f8c259ca01a8380777e00f5","html_url":"https://github.com/juanfont/headscale/commit/e8e32c91a3aef9146f8c259ca01a8380777e00f5","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-29T08:06:18Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-09T14:08:30Z"},"tree":{"sha":"7afdc169df58424864c3d659ca6502d63c0d7ea7","url":"https://api.github.com/repos/juanfont/headscale/git/trees/7afdc169df58424864c3d659ca6502d63c0d7ea7"},"message":"flake.nix, go.mod: bump tailscale.com to v1.97.0-pre\n\nPulls in the cmd/nardump library split (tailscale/tailscale#19551)\nso flakehashes.json tooling can import nardump.SRI directly.\n\nSide effects: Go directive bumps to 1.26.2 and the nixpkgs lock\nadvances to a revision shipping go 1.26.2.","parents":[{"sha":"4e0c2b855616e08f3745d4db7f0264b402cee19f","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4e0c2b855616e08f3745d4db7f0264b402cee19f","html_url":"https://github.com/juanfont/headscale/commit/4e0c2b855616e08f3745d4db7f0264b402cee19f"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"afdfdf3b6cfc074985aa237a2c5a61b68940aef1","node_id":"C_kwDOEFLz89oAKGFmZGZkZjNiNmNmYzA3NDk4NWFhMjM3YTJjNWE2MWI2ODk0MGFlZjE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/afdfdf3b6cfc074985aa237a2c5a61b68940aef1","html_url":"https://github.com/juanfont/headscale/commit/afdfdf3b6cfc074985aa237a2c5a61b68940aef1","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-29T07:59:05Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-09T14:08:30Z"},"tree":{"sha":"aa0ab7c3ce3e293924da2e9f6a413516fc62901a","url":"https://api.github.com/repos/juanfont/headscale/git/trees/aa0ab7c3ce3e293924da2e9f6a413516fc62901a"},"message":"cmd/vendorhash: track vendor SRI in flakehashes.json\n\nMove the headscale vendorHash out of flake.nix into a content-\naddressed flakehashes.json maintained by a small Go tool. The\nschema and goModFingerprint algorithm mirror upstream tailscale's\ntool/updateflakes so a future shared library extraction is trivial.\n\nvendorhash check verifies flakehashes.json against the current\ngo.mod/go.sum. Hot path is a sha256 over those two files, so\nre-runs without input change are essentially free; only an actual\nfingerprint drift triggers go mod vendor + nardump.SRI.\n\nvendorhash update recomputes both fields and rewrites the JSON.\nThe nix-vendor-sri devShell shim now wraps it.","parents":[{"sha":"e8e32c91a3aef9146f8c259ca01a8380777e00f5","url":"https://api.github.com/repos/juanfont/headscale/git/commits/e8e32c91a3aef9146f8c259ca01a8380777e00f5","html_url":"https://github.com/juanfont/headscale/commit/e8e32c91a3aef9146f8c259ca01a8380777e00f5"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"0635339de2daae31c6449a162a7154c2c157e392","node_id":"C_kwDOEFLz89oAKDA2MzUzMzlkZTJkYWFlMzFjNjQ0OWExNjJhNzE1NGMyYzE1N2UzOTI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/0635339de2daae31c6449a162a7154c2c157e392","html_url":"https://github.com/juanfont/headscale/commit/0635339de2daae31c6449a162a7154c2c157e392","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-29T07:59:19Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-09T14:08:30Z"},"tree":{"sha":"7c7280db5c2370c7100ccad359c26c6e82af3a58","url":"https://api.github.com/repos/juanfont/headscale/git/trees/7c7280db5c2370c7100ccad359c26c6e82af3a58"},"message":"ci, pre-commit: validate vendor hash via vendorhash check\n\nReplace the grep/awk hash extraction in build.yml with a structured\nvendorhash check step; the PR review comment now reads expected/\nactual values directly from $GITHUB_OUTPUT instead of scraping Nix\nstderr. Add a prek hook so divergence is caught locally before push.","parents":[{"sha":"afdfdf3b6cfc074985aa237a2c5a61b68940aef1","url":"https://api.github.com/repos/juanfont/headscale/git/commits/afdfdf3b6cfc074985aa237a2c5a61b68940aef1","html_url":"https://github.com/juanfont/headscale/commit/afdfdf3b6cfc074985aa237a2c5a61b68940aef1"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"910e11f8f2213eed71f0a30a3eebb20c2ee9fbd5","node_id":"C_kwDOEFLz89oAKDkxMGUxMWY4ZjIyMTNlZWQ3MWYwYTMwYTNlZWJiMjBjMmVlOWZiZDU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/910e11f8f2213eed71f0a30a3eebb20c2ee9fbd5","html_url":"https://github.com/juanfont/headscale/commit/910e11f8f2213eed71f0a30a3eebb20c2ee9fbd5","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-29T17:13:06Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-09T14:08:30Z"},"tree":{"sha":"0601eff7d08f7f33a5c1f6a71245535083a6b4e2","url":"https://api.github.com/repos/juanfont/headscale/git/trees/0601eff7d08f7f33a5c1f6a71245535083a6b4e2"},"message":"hscontrol/types: regenerate types_clone.go for viewer bump\n\ncmd/viewer in tailscale.com/cmd v1.97.0-pre emits new(*x) instead\nof ptr.To(*x). No behaviour change.","parents":[{"sha":"0635339de2daae31c6449a162a7154c2c157e392","url":"https://api.github.com/repos/juanfont/headscale/git/commits/0635339de2daae31c6449a162a7154c2c157e392","html_url":"https://github.com/juanfont/headscale/commit/0635339de2daae31c6449a162a7154c2c157e392"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":25339314242,"node_id":"HRFPE_lADOEFLz888AAAABAzXivc8AAAAF5ldAQg","url":"https://api.github.com/repos/juanfont/headscale/issues/events/25339314242","actor":{"login":"kradalby","id":