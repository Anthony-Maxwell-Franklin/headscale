[{"sha":"e6d3ca9fd80ea4bcf3e01ec943a0c050fcb88685","node_id":"C_kwDOEFLz89oAKGU2ZDNjYTlmZDgwZWE0YmNmM2UwMWVjOTQzYTBjMDUwZmNiODg2ODU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/e6d3ca9fd80ea4bcf3e01ec943a0c050fcb88685","html_url":"https://github.com/juanfont/headscale/commit/e6d3ca9fd80ea4bcf3e01ec943a0c050fcb88685","author":{"name":"Igor Serganov","email":"iserganov@tunein.com","date":"2026-09-25T16:08:24Z"},"committer":{"name":"Igor Serganov","email":"iserganov@tunein.com","date":"2026-09-25T16:08:24Z"},"tree":{"sha":"beef7e4acad042670a441281c271e1159c506cfd","url":"https://api.github.com/repos/juanfont/headscale/git/trees/beef7e4acad042670a441281c271e1159c506cfd"},"message":"db: check errors in openDB\n\nOn the SQLite path openDB called db.DB() and configured the pool\nbefore looking at the error from gorm.Open, and both backends\ndiscarded the error from db.DB(). A failed open returned a\nhalf-initialised *gorm.DB alongside the error, and a nil *sql.DB\nfrom db.DB() would have been dereferenced.\n\nReturn early on either error so callers get a nil handle and the\noriginal error.","parents":[{"sha":"e4b4b894484f3e993b2569a23bfc5e57b0c1b311","url":"https://api.github.com/repos/juanfont/headscale/git/commits/e4b4b894484f3e993b2569a23bfc5e57b0c1b311","html_url":"https://github.com/juanfont/headscale/commit/e4b4b894484f3e993b2569a23bfc5e57b0c1b311"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":31849545711,"node_id":"RRE_lADOEFLz888AAAABTOuO5M8AAAAHamF_7w","url":"https://api.github.com/repos/juanfont/headscale/issues/events/31849545711","actor":{"login":"iSerganov","id":41109559,"node_id":"MDQ6VXNlcjQxMTA5NTU5","avatar_url":"https://avatars.githubusercontent.com/u/41109559?v=4","gravatar_id":"","url":"https://api.github.com/users/iSerganov","html_url":"https://github.com/iSerganov","followers_url":"https://api.github.com/users/iSerganov/followers","following_