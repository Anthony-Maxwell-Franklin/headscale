ock/gists{/gist_id}","starred_url":"https://api.github.com/users/nblock/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nblock/subscriptions","organizations_url":"https://api.github.com/users/nblock/orgs","repos_url":"https://api.github.com/users/nblock/repos","events_url":"https://api.github.com/users/nblock/events{/privacy}","received_events_url":"https://api.github.com/users/nblock/received_events","type":"User","user_view_type":"public","site_admin":false},"body":null,"commit_id":"f322788e35987fcfb48f74d673339a24a1623b68","state":"approved","html_url":"https://github.com/juanfont/headscale/pull/2995#pullrequestreview-3644424539","pull_request_url":"https://api.github.com/repos/juanfont/headscale/pulls/2995","_links":{"html":{"href":"https://github.com/juanfont/headscale/pull/2995#pullrequestreview-3644424539"},"pull_request":{"href":"https://api.github.com/repos/juanfont/headscale/pulls/2995"}},"submitted_at":"2026-01-09T15:28:59Z","updated_at":"2026-01-09T15:28:59Z","author_association":"COLLABORATOR","event":"reviewed"},{"sha":"a80a06bfbbb551be3398b47343fe8618c37e143c","node_id":"C_kwDOEFLz89oAKGE4MGEwNmJmYmJiNTUxYmUzMzk4YjQ3MzQzZmU4NjE4YzM3ZTE0M2M","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a80a06bfbbb551be3398b47343fe8618c37e143c","html_url":"https://github.com/juanfont/headscale/commit/a80a06bfbbb551be3398b47343fe8618c37e143c","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-14T08:48:21Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-14T08:48:21Z"},"tree":{"sha":"0bb433f7a2bbe279cbc63ee05240f29289deb5ac","url":"https://api.github.com/repos/juanfont/headscale/git/trees/0bb433f7a2bbe279cbc63ee05240f29289deb5ac"},"message":"types: use Username() in User.Proto() when Name is empty\n\nUser.Proto() was returning u.Name directly, which is empty for OIDC\nusers who have their identifier in the Email field instead. This caused\n\"headscale nodes list\" to show empty user names for OIDC-authenticated\nnodes.\n\nOnly fall back to Username() when Name is empty, which provides a\ndisplay-friendly identifier (Email > ProviderIdentifier > ID). This\nensures OIDC users display their email while CLI users retain their\noriginal Name.\n\nFixes #2972","parents":[{"sha":"e43f19df794158328729c47f479069ec4fdafaf8","url":"https://api.github.com/repos/juanfont/headscale/git/commits/e43f19df794158328729c47f479069ec4fdafaf8","html_url":"https://github.com/juanfont/headscale/commit/e43f19df794158328729c47f479069ec4fdafaf8"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":22037492322,"node_id":"HRFPE_lADOEFLz887iSIbRzwAAAAUhiXJi","url":"https://api.github.com/repos/juanfont/headscale/issues/events/22037492322","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"a80a06bfbbb551be3398b47343fe8618c37e143c","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/a80a06bfbbb551be3398b47343fe8618c37e143c","created_at":"2026-01-