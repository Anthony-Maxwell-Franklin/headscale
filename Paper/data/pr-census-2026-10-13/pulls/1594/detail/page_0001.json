ray.\r\n\r\n<!--\r\nHeadscale is \"Open Source, acknowledged contribution\", this means that any\r\ncontribution will have to be discussed with the Maintainers before being submitted.\r\n\r\nThis model has been chosen to reduce the risk of burnout by limiting the\r\nmaintenance overhead of reviewing and validating third-party code.\r\n\r\nHeadscale is open to code contributions for bug fixes without discussion.\r\n\r\nIf you find mistakes in the documentation, please submit a fix to the documentation.\r\n-->\r\n\r\n<!-- Please tick if the following things apply. You… -->\r\n\r\n- [x] read the [CONTRIBUTING guidelines](README.md#contributing)\r\n- [x] raised a GitHub issue or discussed it on the projects chat beforehand\r\n- [x] added unit tests\r\n- [ ] added integration tests\r\n- [x] updated documentation if needed\r\n- [ ] updated CHANGELOG.md\r\n\r\n<!-- If applicable, please reference the issue using `Fixes #XXX` and add tests to cover your new code. -->\r\n\r\nFixes #1114","created_at":"2023-11-08T13:50:56Z","updated_at":"2024-10-02T12:50:20Z","closed_at":"2024-10-02T12:50:20Z","merged_at":null,"merge_commit_sha":"864521d201103dac57f8a6b276cb98ca970f41b6","assignees":[],"requested_reviewers":[{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privac