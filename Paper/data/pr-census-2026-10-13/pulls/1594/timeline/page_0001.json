e61a4a861ec","url":"https://api.github.com/repos/juanfont/headscale/git/trees/71147a62d72745270b365a5ede772e61a4a861ec"},"message":"Add OIDC claim names options\n\nSome identity providers (auth0 for example) do not allow to set the\ngroups claims and administrators must use custom claims names and add\nthem in the id token.\n\nThis commit adds the following configuration options:\n\n- `oidc.groups_claim` to set the groups claim name\n- `oidc.email_claim` to set the email claim name\n\nAll claims default to the previous values for backwards compatibility.\n\nThe groups claim can now also accept `[]string` or `string` as some\nproviders might return only a string response instead of array.","parents":[{"sha":"2af71c9e3137470d2cdef714819a44b0de160a0b","url":"https://api.github.com/repos/juanfont/headscale/git/commits/2af71c9e3137470d2cdef714819a44b0de160a0b","html_url":"https://github.com/juanfont/headscale/commit/2af71c9e3137470d2cdef714819a44b0de160a0b"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":10901260508,"node_id":"HRFPE_lADOEFLz8852PEePzwAAAAKJxAjc","url":"https://api.github.com/repos/juanfont/headscale/issues/events/10901260508","actor":{"login":"fen4o","id":1710500,"node_id":"MDQ6VXNlcjE3MTA1MDA=","avatar_url":"https://avatars.githubusercontent.com/u/1710500?v=4","gravatar_id":"","url":"https://api.github.com/users/fen4o","html_url":"https://github.com/fen4o","followers_url":"https://api.github.com/users/fen4o/followers","following_url":"https://api.github.com/users/fen4o/following{/other_user}","gists_url":"https://api.github.com/users/fen4o/gists{/gist_id}","starred_url":"https://api.github.com/users/fen4o/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fen4o/subscriptions","organizations_url":"https://api.github.com/users/fen4o/orgs","repos_url":"https://api.github.com/users/fen4o/repos","events_url":"https://api.github.com/users/fen4o/events{