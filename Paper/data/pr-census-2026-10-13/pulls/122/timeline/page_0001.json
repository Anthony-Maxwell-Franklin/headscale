n, error) {\r\n                                return net.Dial(\"unix\", \"/tmp/sockpost.sock\")\r\n                        },\r\n                },\r\n        }\r\n\r\n        var res *http.Response\r\n        res, err := socClient.Post(\"http://unix/place/stuff\", \"application/octet-stream\", fileReader)\r\n        if err != nil {\r\n                log.Fatal(err)\r\n        }\r\n```\r\n\r\nThis would eliminate the need for an external dependency on curl.","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/juanfont/headscale/issues/comments/927299960/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"qbit","id":68368,"node_id":"MDQ6VXNlcjY4MzY4","avatar_url":"https://avatars.githubusercontent.com/u/68368?v=4","gravatar_id":"","url":"https://api.github.com/users/qbit","html_url":"https://github.com/qbit","followers_url":"https://api.github.com/users/qbit/followers","following_url":"https://api.github.com/users/qbit/following{/other_user}","gists_url":"https://api.github.com/users/qbit/gists{/gist_id}","starred_url":"https://api.github.com/users/qbit/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qbit/subscriptions","organizations_url":"https://api.github.com/users/qbit/orgs","repos_url":"https://api.github.com/users/qbit/repos","events_url":"https://api.github.com/users/qbit/events{/privacy}","received_events_url":"https://api.github.com/users/qbit/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/juanfont/headscale/issues/comments/927305187","html_url":"https://github.com/juanfont/headscale/pull/122#issuecomment-927305187","issue_url":"https://api.github.com/repos/juanfont/headscale/issues/122","id":927305187,"node_id":"IC_kwDOEFLz8843RY3j","user":{"login":"juanfont","id":181059,"node_id":"MDQ6VXNlcjE