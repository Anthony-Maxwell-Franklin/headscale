[{"sha":"24cbc7f08dfbb877b8a46e1585306aa070cd45b1","node_id":"C_kwDOEFLz89oAKDI0Y2JjN2YwOGRmYmI4NzdiOGE0NmUxNTg1MzA2YWEwNzBjZDQ1YjE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/24cbc7f08dfbb877b8a46e1585306aa070cd45b1","html_url":"https://github.com/juanfont/headscale/commit/24cbc7f08dfbb877b8a46e1585306aa070cd45b1","author":{"name":"Igor Serganov","email":"iserganov@tunein.com","date":"2026-09-25T16:27:13Z"},"committer":{"name":"Igor Serganov","email":"iserganov@tunein.com","date":"2026-09-25T16:27:13Z"},"tree":{"sha":"9bd46419f9243790c9dcb9157f37741c3bfc3ca4","url":"https://api.github.com/repos/juanfont/headscale/git/trees/9bd46419f9243790c9dcb9157f37741c3bfc3ca4"},"message":"db: release the IPv4 address when IPv6 allocation fails in Next\n\nIPAllocator.Next took the allocator mutex once per address family.\nWhen the IPv6 allocation failed, the IPv4 address had already been\nadded to usedIPs and prev4 had moved past it, so the address stayed\nreserved until headscale restarted even though no node held it.\n\nAllocate both families under a single critical section, and on an\nIPv6 failure remove the IPv4 address from usedIPs and restore prev4.","parents":[{"sha":"e4b4b894484f3e993b2569a23bfc5e57b0c1b311","url":"https://api.github.com/repos/juanfont/headscale/git/commits/e4b4b894484f3e993b2569a23bfc5e57b0c1b311","html_url":"https://github.com/juanfont/headscale/commit/e4b4b894484f3e993b2569a23bfc5e57b0c1b311"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":31854356978,"node_id":"RRE_lADOEFLz888AAAABTPmLks8AAAAHaqrp8g","url":"https://api.github.com/repos/juanfont/headscale/issues/events/31854356978","actor":{"login":"iSerganov","id":41109559,"node_id":"MDQ6VXNlcjQxMTA5NTU5","avatar_url":"https://avatars.githubusercontent.com/u/41109559?v=4","gravatar_id":"","url":"https://api.github.com/users/iSerganov","html_url":"https://github.com/iSerganov","followers_url":