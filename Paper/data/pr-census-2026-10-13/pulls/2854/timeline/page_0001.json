ub.com/juanfont/headscale/pull/2854#pullrequestreview-3408543967"},"pull_request":{"href":"https://api.github.com/repos/juanfont/headscale/pulls/2854"}},"submitted_at":"2025-11-02T09:26:19Z","updated_at":"2025-11-02T09:26:19Z","author_association":"COLLABORATOR","event":"reviewed"},{"sha":"c54e9171cd1774ce80a914001453c62976b6bd58","node_id":"C_kwDOEFLz89oAKGM1NGU5MTcxY2QxNzc0Y2U4MGE5MTQwMDE0NTNjNjI5NzZiNmJkNTg","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c54e9171cd1774ce80a914001453c62976b6bd58","html_url":"https://github.com/juanfont/headscale/commit/c54e9171cd1774ce80a914001453c62976b6bd58","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-01T10:04:36Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-02T09:32:29Z"},"tree":{"sha":"ff5f06985a8958d0c0aa2fa233fb42563079bd42","url":"https://api.github.com/repos/juanfont/headscale/git/trees/ff5f06985a8958d0c0aa2fa233fb42563079bd42"},"message":"cli: only validate bypass-grpc set policy\n\nWhen adding the mode to bypass gRPC, a naive policy validation\nwas added to both the gRPC set, and the bypass mode.\n\nThis caused the policy to invalidate in unexpected ways as the gRPC\nalready handles this validation in the backend.\n\nThis commit moves the validation logic into the bypass branch.\n\nFixes #2825\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>","parents":[{"sha":"f9bb88ad24d95c2dc35fae6e433e1e8eb8faa926","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f9bb88ad24d95c2dc35fae6e433e1e8eb8faa926","html_url":"https://github.com/juanfont/headscale/commit/f9bb88ad24d95c2dc35fae6e433e1e8eb8faa926"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgmMAoz5Zf+w0nAxyA6/zsNd95cP\n98YbtHIIXyy9A1sssAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQJy+C0hv69dhwBiXLO/9m2D6V297J5h3PmOTASwJsw6Nh+HdxyuWdcMu+BUxcPmFd+\nkWYguCqS5vHrT4YocBNA8=\n-----END SSH SIGNATURE-----","payload":"tree ff5f06985a8958d0c0aa2fa233fb42563079bd42\nparent f9bb88ad24d95c2dc35fae6e433e1e8eb8faa926\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1761991476 +0100\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1762075949 +0100\n\ncli: only validate bypass-grpc set policy\n\nWhen adding the mode to bypass gRPC, a naive policy validation\nwas added to both the gRPC set, and the bypass mode.\n\nThis caused the policy to invalidate in unexpected ways as the gRPC\nalready handles this validation in the backend.\n\nThis commit moves the validation logic into the bypass branch.\n\nFixes #2825\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>\n","verified_at":"2025-11-02T09:32:59Z"},"event":"committed"},{"id":20659451075,"node_id":"HRFPE_lADOEFLz887VS160zwAAAATPZjTD","url":"https://api.github.com/repos/juanfont/headscale/issues/events/20659451075","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"c54e9171cd1774ce80a914001453c62976b6bd58","commit_url":"https://api.github