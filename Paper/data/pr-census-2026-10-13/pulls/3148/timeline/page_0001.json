:"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"283a94fd993f584120a0aa1f64a16c47e59d66b1","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/283a94fd993f584120a0aa1f64a16c47e59d66b1","created_at":"2026-03-17T16:44:10Z","performed_via_github_app":null},{"sha":"1859e8ca62a53042411e61c65dc7141af24a8577","node_id":"C_kwDOEFLz89oAKDE4NTllOGNhNjJhNTMwNDI0MTFlNjFjNjVkYzcxNDFhZjI0YTg1Nzc","url":"https://api.github.com/repos/juanfont/headscale/git/commits/1859e8ca62a53042411e61c65dc7141af24a8577","html_url":"https://github.com/juanfont/headscale/commit/1859e8ca62a53042411e61c65dc7141af24a8577","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-14T16:09:22Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-18T07:11:54Z"},"tree":{"sha":"7103ef2d5df5c8715695ae29a5a6c592d6cbb05b","url":"https://api.github.com/repos/juanfont/headscale/git/trees/7103ef2d5df5c8715695ae29a5a6c592d6cbb05b"},"message":"mapper/batcher: serialize per-node work to prevent out-of-order delivery\n\nprocessBatchedChanges queued each pending change for a node as a\nseparate work item. Since multiple workers pull from the same channel,\ntwo changes for the same node could be processed concurrently by\ndifferent workers. This caused two problems:\n\n1. MapResponses delivered out of order — a later change could finish\n   generating before an earlier one, so the client sees stale state.\n2. updateSentPeers and computePeerDiff race against each other —\n   updateSentPeers does Clear() + Store() which is not atomic relative\n   to a concurrent Range() in computePeerDiff.\n\nBundle all pending changes for a node into a single work item so one\nworker processes them sequentially. Add a per-node workMu that\nserializes processing across consecutive batch ticks, preventing a\nsecond worker from starting tick N+1 while tick N is still in progress.\n\nFixes #3140","parents":[{"sha":"81b871c9b50f3c7115d78a45af0b42d7406abc81","url":"https://api.github.com/repos/juanfont/headscale/git/commits/81b871c9b50f3c7115d78a45af0b42d7406abc81","html_url":"https://github.com/juanfont/headscale/commit/81b871c9b50f3c7115d78a45af0b42d7406abc81"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":23670538439,"node_id":"HRFPE_lADOEFLz887zmSvNzwAAAAWC38DH","url":"https://api.github.com/repos/juanfont/headscale/issues/events/23670538439","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"2e13ae36fa14b310befdc7484c18af3cf2c96422","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/2e13ae36fa14b310befdc7484c18af3cf2c96422","created_at":"2026-03-18T07:12:11Z","performed_via_github_app":null},{"sha":"61478099cd19c50353f153075130cb3137692dc9","node_id":"C_kwDOEFLz89oAKDYxNDc4MDk5Y2QxOWM1MDM1M2YxNTMwNzUxMzBjYjMxMzc2OTJkYzk","url":"https://api.github.com/repos/juanfont/headscale/git/commits/61478099cd19c50353f153075130cb3137692dc9","html_url":"https://github.com/juanfont/headscale/commit/61478099cd19c50353f153075130cb3137692dc9","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-16T09:16:43Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-18T08:19:27Z"},"tree":{"sha":"c5b7618b35f61d946c343d5b480b4f81d3f39f78","url":"https://api.github.com/repos/juanfont/headscale/git/trees/c5b7618b35f61d946c343d5b480b4f81d3f39f78"},"message":"hscontrol: add servertest harness for in-process control plane testing\n\nAdd a new hscontrol/servertest package that provides a test harness\nfor exercising the full Headscale control protocol in-process, using\nTailscale's controlclient.Direct as the client.\n\nThe harness consists of:\n- TestServer: wraps a Headscale instance with an httptest.Server\n- TestClient: wraps controlclient.Direct with NetworkMap tracking\n- TestHarness: orchestrates N clients against a single server\n- Assertion helpers for mesh completeness, visibility, and consistency\n\nExport minimal accessor methods on Headscale (HTTPHandler, NoisePublicKey,\nGetState, SetServerURL, StartBatcher, StartEphemeralGC) so the servertest\npackage can construct a working server from outside the hscontrol package.\n\nThis enables fast, deterministic tests of connection lifecycle, update\npropagation, and network weather scenarios without Docker.","parents":[{"sha":"1859e8ca62a53042411e61c65dc7141af24a8577","url":"https://api.github.com/repos/juanfont/headscale/git/commits/1859e8ca62a53042411e61c65dc7141af24a8577","html_url":"https://github.com/juanfont/headscale/commit/1859e8ca62a53042411e61c65dc7141af24a8577"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"27ebaae119aab09eb6bdeb585da1ac485ad7851e","node_id":"C_kwDOEFLz89oAKDI3ZWJhYWUxMTlhYWIwOWViNmJkZWI1ODVkYTFhYzQ4NWFkNzg1MWU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/27ebaae119aab09eb6bdeb585da1ac485ad7851e","html_url":"https://github.com/juanfont/headscale/commit/27ebaae119aab09eb6bdeb585da1ac485ad7851e","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-16T17:07:23Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-18T08:19:27Z"},"tree":{"sha":"4914ab088ee80d7638e1ae25e4dda9ed06bdf5ca","url":"https://api.github.com/repos/juanfont/headscale/git/trees/4914ab088ee80d7638e1ae25e4dda9ed06bdf5ca"},"message":"hscontrol/servertest: add control plane lifecycle and consistency tests\n\nAdd three test files exercising the servertest harness:\n\n- lifecycle_test.go: connection, disconnection, reconnection, session\n  replacement, and mesh formation at various sizes.\n- consistency_test.go: symmetric visibility, consistent peer state,\n  address presence, concurrent join/leave convergence.\n- weather_test.go: rapid reconnects, flapping stability, reconnect\n  with various delays, concurrent reconnects, and scale tests.\n\nAll tests use table-driven patterns with subtests.","parents":[{"sha":"61478099cd19c50353f153075130cb3137692dc9","url":"https://api.github.com/repos/juanfont/headscale/git/commits/61478099cd19c50353f153075130cb3137692dc9","html_url":"https://github.com/juanfont/headscale/commit/61478099cd19c50353f153075130cb3137692dc9"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":23672312069,"node_id":"HRFPE_lADOEFLz887zmSvNzwAAAAWC-tEF","url":"https://api.github.com/repos/juanfont/headscale/issues/events/23672312069","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"55b7b73e03c78f9af18c140b8d04df506f4305f7","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/55b7b73e03c78f9af18c140b8d04df506f4305f7","created_at":"2026-03-18T08:19:52Z","performed_via_github_app":null},{"id":23673687320,"node_id":"HRFPE_lADOEFLz887zmSvNzwAAAAWDD80Y","url":"https://api.github.com/repos/juanfont/headscale/issues/events/23673687320","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"62210f3d6c5edec8e5e20140a549db355cb2a999","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/62210f3d6c5edec8e5e20140a549db355cb2a999","created_at":"2026-03-18T09:04:40Z","performed_via_github_app":null},{"sha":"6cc6b4f8fa1b8b727802de6d95e8d70db62310b9","node_id":"C_kwDOEFLz89oAKDZjYzZiNGY4ZmExYjhiNzI3ODAyZGU2ZDk1ZThkNzBkYjYyMzEwYjk","url":"https://api.github.com/repos/juanfont/headscale/git/commits/6cc6b4f8fa1b8b727802de6d95e8d70db62310b9","html_url":"https://github.com/juanfont/headscale/commit/6cc6b4f8fa1b8b727802de6d95e8d70db62310b9","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-16T19:09:10Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-18T09:51:15Z"},"tree":{"sha":"3ced6fd2fc4ac5be1e2797d7352d1be7811f4ea3","url":"https://api.github.com/repos/juanfont/headscale/git/trees/3ced6fd2fc4ac5be1e2797d7352d1be7811f4ea3"},"message":"hscontrol/servertest: add policy, route, ephemeral, and content tests\n\nExtend the servertest harness with:\n- TestClient.Direct() accessor for advanced operations\n- TestClient.WaitForPeerCount and WaitForCondition helpers\n- TestHarness.ChangePolicy for ACL policy testing\n- AssertDERPMapPresent and AssertSelfHasAddresses\n\nNew test suites:\n- content_test.go: self node, DERP map, peer properties, user profiles,\n  update history monotonicity, and endpoint update propagation\n- policy_test.go: default allow-all, explicit policy, policy triggers\n  updates on all nodes, multiple policy changes, multi-user mesh\n- ephemeral_test.go: ephemeral connect, cleanup after disconnect,\n  mixed ephemeral/regular, reconnect prevents cleanup\n- routes_test.go: addresses in AllowedIPs, route advertise and approve,\n  advertised routes via hostinfo, CGNAT range validation\n\nAlso fix node_departs test to use WaitForCondition instead of\nassert.Eventually, and convert concurrent_join_and_leave to\ninterleaved_join_and_leave with grace-period-tolerant assertions.","parents":[{"sha":"27ebaae119aab09eb6bdeb585da1ac485ad7851e","url":"https://api.github.com/repos/juanfont/headscale/git/commits/27ebaae119aab09eb6bdeb585da1ac485ad7851e","html_url":"https://github.com/juanfont/headscale/commit/27ebaae119aab09eb6bdeb585da1ac485ad7851e"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"6bf8184ed398d20cf76bdbd1c51ac8acef1ddcbe","node_id":"C_kwDOEFLz89oAKDZiZjgxODRlZDM5OGQyMGNmNzZiZGJkMWM1MWFjOGFjZWYxZGRjYmU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/6bf8184ed398d20cf76bdbd1c51ac8acef1ddcbe","html_url":"https://github.com/juanfont/headscale/commit/6bf8184ed398d20cf76bdbd1c51ac8acef1ddcbe","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-16T20:20:19Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-18T09:51:15Z"},"tree":{"sha":"858d4ce8ea65f69953b854d7e6c782cdd2919704","url":"https://api.github.com/repos/juanfont/headscale/git/trees/858d4ce8ea65f69953b854d7e6c782cdd2919704"},"message":"hscontrol/servertest: expand issue tests to 24 scenarios, surface 4 issues\n\nSplit TestIssues into 7 focused test functions to stay under cyclomatic\ncomplexity limits while testing more aggressively.\n\nIssues surfaced (4 failing tests):\n\n1. initial_map_should_include_peer_online_status: Initial MapResponse\n   has Online=nil for peers. Online status only arrives later via\n   PeersChangedPatch.\n\n2. disco_key_should_propagate_to_peers: DiscoPublicKey set by client\n   is not visible to peers. Peers see zero disco key.\n\n3. approved_route_without_announcement_is_visible: Server-side route\n   approval without client-side announcement silently produces empty\n   SubnetRoutes (intersection of empty announced + approved = empty).\n\n4. nodestore_correct_after_rapid_reconnect: After 5 rapid reconnect\n   cycles, NodeStore reports node as offline despite having an active\n   poll session. The connect/disconnect grace period interleaving\n   leaves IsOnline in an incorrect state.\n\nPassing tests (20) verify:\n- IP uniqueness across 10 nodes\n- IP stability across reconnect\n- New peers have addresses immediately\n- Node rename propagates to peers\n- Node delete removes from all peer lists\n- Hostinfo changes (OS field) propagate\n- NodeStore/DB consistency after route mutations\n- Grace period timing (8-20s window)\n- Ephemeral node deletion (not just offline)\n- 10-node simultaneous connect convergence\n- Rapid sequential node additions\n- Reconnect produces complete map\n- Cross-user visibility with default policy\n- Same-user multiple nodes get distinct IDs\n- Same-hostname nodes get unique GivenNames\n- Policy change during connect still converges\n- DERP region references are valid\n- User profiles present for self and peers\n- Self-update arrives after route approval\n- Route advertisement stored as AnnouncedRoutes","parents":[{"sha":"6cc6b4f8fa1b8b727802de6d95e8d70db62310b9","url":"https://api.github.com/repos/juanfont/headscale/git/commits/6cc6b4f8fa1b8b727802de6d95e8d70db62310b9","html_url":"https://github.com/juanfont/headscale/commit/6cc6b4f8fa1b8b727802de6d95e8d70db62310b9"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"a83e14dc0f08bf56508339aadc90c7ab81a3d0a2","node_id":"C_kwDOEFLz89oAKGE4M2UxNGRjMGYwOGJmNTY1MDgzMzlhYWRjOTBjN2FiODFhM2QwYTI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a83e14dc0f08bf56508339aadc90c7ab81a3d0a2","html_url":"https://github.com/juanfont/headscale/commit/a83e14dc0f08bf56508339aadc90c7ab81a3d0a2","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-17T14:32:35Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-18T09:51:15Z"},"tree":{"sha":"5e6d7a936ec6ada7419477bab8983a609f2013d6","url":"https://api.github.com/repos/juanfont/headscale/git/trees/5e6d7a936ec6ada7419477bab8983a609f2013d6"},"message":"hscontrol/servertest: add race, stress, and poll race tests\n\nAdd three test files designed to stress the control plane under\nconcurrent and adversarial conditions:\n\n- race_test.go: 14 tests exercising concurrent mutations, session\n  replacement, batcher contention, NodeStore access, and map response\n  delivery during disconnect. All pass the Go race detector.\n\n- poll_race_test.go: 8 tests targeting the poll.go grace period\n  interleaving. These confirm a logical TOCTOU race: when a node\n  disconnects and reconnects within the grace period, the old\n  session's deferred Disconnect() can overwrite the new session's\n  Connect(), leaving IsOnline=false despite an active poll session.\n\n- stress_test.go: sustained churn, rapid mutations, rolling\n  replacement, data integrity checks under load, and verification\n  that rapid reconnects do not leak false-offline notifications.\n\nKnown failing tests (grace period TOCTOU race):\n- server_state_online_after_reconnect_within_grace\n- update_history_no_false_offline\n- rapid_reconnect_peer_never_sees_offline","parents":[{"sha":"6bf8184ed398d20cf76bdbd1c51ac8acef1ddcbe","url":"https://api.github.com/repos/juanfont/headscale/git/commits/6bf8184ed398d20cf76bdbd1c51ac8acef1ddcbe","html_url":"https://github.com/juanfont/headscale/commit/6bf8184ed398d20cf76bdbd1c51ac8acef1ddcbe"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"6f593f882f6ea8310f18e20186c9e0a3e85af2eb","node_id":"C_kwDOEFLz89oAKDZmNTkzZjg4MmY2ZWE4MzEwZjE4ZTIwMTg2YzllMGEzZTg1YWYyZWI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/6f593f882f6ea8310f18e20186c9e0a3e85af2eb","html_url":"https://github.com/juanfont/headscale/commit/6f593f882f6ea8310f18e20186c9e0a3e85af2eb","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-17T14:35:18Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-18T09:51:15Z"},"tree":{"sha":"94120f7db970eb6359ecf7b2e4da4e687df99182","url":"https://api.github.com/repos/juanfont/headscale/git/trees/94120f7db970eb6359ecf7b2e4da4e687df99182"},"message":"hscontrol/poll,state: fix grace period disconnect TOCTOU race\n\nWhen a node disconnects, serveLongPoll defers a cleanup that starts a\ngrace period goroutine. This goroutine polls batcher.IsConnected() and,\nif the node has not reconnected within ~10 seconds, calls\nstate.Disconnect() to mark it offline. A TOCTOU race exists: the node\ncan reconnect (calling Connect()) between the IsConnected check and\nthe Disconnect() call, causing the stale Disconnect() to overwrite\nthe new session's online status.\n\nFix with a monotonic per-node generation counter:\n\n- State.Connect() increments the counter and returns the current\n  generation alongside the change list.\n- State.Disconnect() accepts the generation from the caller and\n  rejects the call if a newer generation exists, making stale\n  disconnects from old sessions a no-op.\n- serveLongPoll captures the generation at Connect() time and passes\n  it to Disconnect() in the deferred cleanup.\n- RemoveNode's return value is now checked: if another session already\n  owns the batcher slot (reconnect happened), the old session skips\n  the grace period entirely.\n\nUpdate batcher_test.go to track per-node connect generations and\npass them through to Disconnect(), matching production behavior.\n\nFixes the following test failures:\n- server_state_online_after_reconnect_within_grace\n- update_history_no_false_offline\n- nodestore_correct_after_rapid_reconnect\n- rapid_reconnect_peer_never_sees_offline","parents":[{"sha":"a83e14dc0f08bf56508339aadc90c7ab81a3d0a2","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a83e14dc0f08bf56508339aadc90c7ab81a3d0a2","html_url":"https://github.com/juanfont/headscale/commit/a83e14dc0f08bf56508339aadc90c7ab81a3d0a2"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"8968deee523d370235e9c46a5681b4c09ab8cd9d","node_id":"C_kwDOEFLz89oAKDg5NjhkZWVlNTIzZDM3MDIzNWU5YzQ2YTU2ODFiNGMwOWFiOGNkOWQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8968deee523d370235e9c46a5681b4c09ab8cd9d","html_url":"https://github.com/juanfont/headscale/commit/8968deee523d370235e9c46a5681b4c09ab8cd9d","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-17T14:36:18Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-18T09:51:15Z"},"tree":{"sha":"3475f5bf6efe07c1196209ec7e6f9f0502c68bf3","url":"https://api.github.com/repos/juanfont/headscale/git/trees/3475f5bf6efe07c1196209ec7e6f9f0502c68bf3"},"message":"hscontrol/state: fix online status reset during re-registration\n\nTwo fixes to how online status is handled during registration:\n\n1. Re-registration (applyAuthNodeUpdate, HandleNodeFromPreAuthKey) no\n   longer resets IsOnline to false. Online status is managed exclusively\n   by Connect()/Disconnect() in the poll session lifecycle. The reset\n   caused a false offline blip: the auth handler's change notification\n   triggered a map regeneration showing the node as offline to peers,\n   even though Connect() would set it back to true moments later.\n\n2. New node creation (createAndSaveNewNode) now explicitly sets\n   IsOnline=false instead of leaving it nil. This ensures peers always\n   receive a known online status rather than an ambiguous nil/unknown.","parents":[{"sha":"6f593f882f6ea8310f18e20186c9e0a3e85af2eb","url":"https://api.github.com/repos/juanfont/headscale/git/commits/6f593f882f6ea8310f18e20186c9e0a3e85af2eb","html_url":"https://github.com/juanfont/headscale/commit/6f593f882f6ea8310f18e20186c9e0a3e85af2eb"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"f0bc58cf8f7c1e4d8d481db18fc4d7987281ef19","node_id":"C_kwDOEFLz89oAKGYwYmM1OGNmOGY3YzFlNGQ4ZDQ4MWRiMThmYzRkNzk4NzI4MWVmMTk","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f0bc58cf8f7c1e4d8d481db18fc4d7987281ef19","html_url":"https://github.com/juanfont/headscale/commit/f0bc58cf8f7c1e4d8d481db18fc4d7987281ef19","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-17T14:37:18Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-18T09:51:15Z"},"tree":{"sha":"c3fd2f3eb71219ec66ddc400dbd49c58640538f0","url":"https://api.github.com/repos/juanfont/headscale/git/trees/c3fd2f3eb71219ec66ddc400dbd49c58640538f0"},"message":"hscontrol/servertest: fix test expectations for eventual consistency\n\nThree corrections to issue tests that had wrong assumptions about\nwhen data becomes available:\n\n1. initial_map_should_include_peer_online_status: use WaitForCondition\n   instead of checking the initial netmap. Online status is set by\n   Connect() which sends a PeerChange patch after the initial\n   RegisterResponse, so it may not be present immediately.\n\n2. disco_key_should_propagate_to_peers: use WaitForCondition. The\n   DiscoKey is sent in the first MapRequest (not RegisterRequest),\n   so peers may not see it until a subsequent map update.\n\n3. approved_route_without_announcement: invert the test expectation.\n   Tailscale uses a strict advertise-then-approve model -- routes are\n   only distributed when the node advertises them (Hostinfo.RoutableIPs)\n   AND they are approved. An approval without advertisement is a dormant\n   pre-approval. The test now asserts the route does NOT appear in\n   AllowedIPs, matching upstream Tailscale semantics.\n\nAlso fix TestClient.Reconnect to clear the cached netmap and drain\npending updates before re-registering. Without this, WaitForPeers\nreturned immediately based on the old session's stale data.","parents":[{"sha":"8968deee523d370235e9c46a5681b4c09ab8cd9d","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8968deee523d370235e9c46a5681b4c09ab8cd9d","html_url":"https://github.com/juanfont/headscale/commit/8968deee523d370235e9c46a5681b4c09ab8cd9d"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":23675328066,"node_id":"HRFPE_lADOEFLz887zmSvNzwAAAAWDKNZC","url":"https://api.github.com/repos/juanfont/headscale/issues/events/23675328066","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref