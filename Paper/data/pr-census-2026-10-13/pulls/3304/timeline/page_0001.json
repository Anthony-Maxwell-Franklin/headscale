}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"body":null,"commit_id":"8d52a01d44fcd33c947bc8d9ee67c0d11bcc2eb1","state":"commented","html_url":"https://github.com/juanfont/headscale/pull/3304#pullrequestreview-4447529293","pull_request_url":"https://api.github.com/repos/juanfont/headscale/pulls/3304","_links":{"html":{"href":"https://github.com/juanfont/headscale/pull/3304#pullrequestreview-4447529293"},"pull_request":{"href":"https://api.github.com/repos/juanfont/headscale/pulls/3304"}},"submitted_at":"2026-06-08T07:59:01Z","updated_at":"2026-06-08T07:59:01Z","author_association":"COLLABORATOR","event":"reviewed"},{"id":26465951634,"node_id":"HRFPE_lADOEFLz888AAAABEtQoms8AAAAGKX5fkg","url":"https://api.github.com/repos/juanfont/headscale/issues/events/26465951634","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"dedeb5bcdc204a643a4fc8cf8be3277707b580c1","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/dedeb5bcdc204a643a4fc8cf8be3277707b580c1","created_at":"2026-06-08T10:40:56Z","performed_via_github_app":null},{"sha":"b0e236afa8d7e8a82e1d7b43bba1cb82257904d0","node_id":"C_kwDOEFLz89oAKGIwZTIzNmFmYThkN2U4YTgyZTFkN2I0M2JiYTFjYjgyMjU3OTA0ZDA","url":"https://api.github.com/repos/juanfont/headscale/git/commits/b0e236afa8d7e8a82e1d7b43bba1cb82257904d0","html_url":"https://github.com/juanfont/headscale/commit/b0e236afa8d7e8a82e1d7b43bba1cb82257904d0","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-06T16:42:33Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-09T09:58:53Z"},"tree":{"sha":"ddde73d9caa32f71df43935d19ea65e1aa1e8f73","url":"https://api.github.com/repos/juanfont/headscale/git/trees/ddde73d9caa32f71df43935d19ea65e1aa1e8f73"},"message":"policy: guard SSHCheckParams autogroup:self against nil User\n\nThe autogroup:self SSH-check branch dereferenced node.User().ID() guarded only by !IsTagged(); a non-tagged node with an unhydrated User (UserID set, association nil) crashed the server via the Noise SSH-check path. Gate on User().Valid() like filter.go, same shape as 171fd7a3.","parents":[{"sha":"8f75ee56474f606d6926b80957019582d577d6fe","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8f75ee56474f606d6926b80957019582d577d6fe","html_url":"https://github.com/juanfont/headscale/commit/8f75ee56474f606d6926b80957019582d577d6fe"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"e3e9013710467c09bfb20dab505427a7ce3059a4","node_id":"C_kwDOEFLz89oAKGUzZTkwMTM3MTA0NjdjMDliZmIyMGRhYjUwNTQyN2E3Y2UzMDU5YTQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/e3e9013710467c09bfb20dab505427a7ce3059a4","html_url":"https://github.com/juanfont/headscale/commit/e3e9013710467c09bfb20dab505427a7ce3059a4","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-06T20:42:02Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-09T09:58:53Z"},"tree":{"sha":"5b15127b297556ddc379a6d479019fd024ccb852","url":"https://api.github.com/repos/juanfont/headscale/git/trees/5b15127b297556ddc379a6d479019fd024ccb852"},"message":"state: reject registration claiming another machine's NodeKey\n\ncreateAndSaveNewNode trusted the client NodeKey without checking it was already bound to a different machine, so an authenticated party could register a node carrying a victim's public NodeKey, poison the NodeStore NodeKey index, and make the victim's MapRequest resolve to the wrong node (rejected by getAndValidateNode = DoS). Enforce the 1:1 NodeKey/MachineKey binding at registration, as poll time already does.","parents":[{"sha":"b0e236afa8d7e8a82e1d7b43bba1cb82257904d0","url":"https://api.github.com/repos/juanfont/headscale/git/commits/b0e236afa8d7e8a82e1d7b43bba1cb82257904d0","html_url":"https://github.com/juanfont/headscale/commit/b0e236afa8d7e8a82e1d7b43bba1cb82257904d0"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"88ffa0e383faba3b72032f64818bbdb9ac901780","node_id":"C_kwDOEFLz89oAKDg4ZmZhMGUzODNmYWJhM2I3MjAzMmY2NDgxOGJiZGI5YWM5MDE3ODA","url":"https://api.github.com/repos/juanfont/headscale/git/commits/88ffa0e383faba3b72032f64818bbdb9ac901780","html_url":"https://github.com/juanfont/headscale/commit/88ffa0e383faba3b72032f64818bbdb9ac901780","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-06T23:34:50Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-09T09:58:53Z"},"tree":{"sha":"14990e694c3a6f83dd5161e9032606fe07aad555","url":"https://api.github.com/repos/juanfont/headscale/git/trees/14990e694c3a6f83dd5161e9032606fe07aad555"},"message":"oidc: set SameSite=Lax on state/nonce CSRF cookies\n\nsetCSRFCookie set no SameSite attribute despite a nolint comment claiming it did, so the OIDC state/nonce cookies relied on the browser default. Set Lax explicitly (Strict would drop the cookie on the cross-site IdP->callback navigation and break login), hardening browsers that do not default to Lax against OIDC login CSRF.","parents":[{"sha":"e3e9013710467c09bfb20dab505427a7ce3059a4","url":"https://api.github.com/repos/juanfont/headscale/git/commits/e3e9013710467c09bfb20dab505427a7ce3059a4","html_url":"https://github.com/juanfont/headscale/commit/e3e9013710467c09bfb20dab505427a7ce3059a4"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"7a9a76dbfc26686bde3190fde2593c3702f3c0fa","node_id":"C_kwDOEFLz89oAKDdhOWE3NmRiZmMyNjY4NmJkZTMxOTBmZGUyNTkzYzM3MDJmM2MwZmE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7a9a76dbfc26686bde3190fde2593c3702f3c0fa","html_url":"https://github.com/juanfont/headscale/commit/7a9a76dbfc26686bde3190fde2593c3702f3c0fa","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-07T02:43:55Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-09T09:58:53Z"},"tree":{"sha":"e160feb00c5a3ee7c1bcce6eee6ef0100a3b87f8","url":"https://api.github.com/repos/juanfont/headscale/git/trees/e160feb00c5a3ee7c1bcce6eee6ef0100a3b87f8"},"message":"mapper: filter peer-change patches by ACL visibility\n\nbuildFromChange added PeersChangedPatch (online/offline, endpoint, key-expiry) directly, skipping the policy.ReduceNodes visibility filter that buildTailPeers applies to full peers. A node thus received the existence, presence, and addresses of peers its ACL forbids accessing. Restrict patches to the recipient's visible peer set.","parents":[{"sha":"88ffa0e383faba3b72032f64818bbdb9ac901780","url":"https://api.github.com/repos/juanfont/headscale/git/commits/88ffa0e383faba3b72032f64818bbdb9ac901780","html_url":"https://github.com/juanfont/headscale/commit/88ffa0e383faba3b72032f64818bbdb9ac901780"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"9075e0a205613e3659346fadca3c571a7a5f120b","node_id":"C_kwDOEFLz89oAKDkwNzVlMGEyMDU2MTNlMzY1OTM0NmZhZGNhM2M1NzFhN2E1ZjEyMGI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/9075e0a205613e3659346fadca3c571a7a5f120b","html_url":"https://github.com/juanfont/headscale/commit/9075e0a205613e3659346fadca3c571a7a5f120b","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-07T04:34:01Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-09T09:58:53Z"},"tree":{"sha":"d85e06e2597506fd0d1f0edbbcaea5506e5c32b9","url":"https://api.github.com/repos/juanfont/headscale/git/trees/d85e06e2597506fd0d1f0edbbcaea5506e5c32b9"},"message":"mapper: filter incremental UserProfiles by ACL visibility\n\nbuildFromChange's PeersChanged path passed an unfiltered changed-node slice to WithUserProfiles, while the full-map path uses the BuildPeerMap-filtered ListPeers. A node thus received the identities (login name, display name, avatar) of users owning peers its ACL forbids accessing. Filter the UserProfiles peer set via the same ReduceNodes visibility check buildTailPeers applies.","parents":[{"sha":"7a9a76dbfc26686bde3190fde2593c3702f3c0fa","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7a9a76dbfc26686bde3190fde2593c3702f3c0fa","html_url":"https://github.com/juanfont/headscale/commit/7a9a76dbfc26686bde3190fde2593c3702f3c0fa"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"4f8a6ba5ad1eee8afe3ca7573b7e59b4761a2560","node_id":"C_kwDOEFLz89oAKDRmOGE2YmE1YWQxZWVlOGFmZTNjYTc1NzNiN2U1OWI0NzYxYTI1NjA","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4f8a6ba5ad1eee8afe3ca7573b7e59b4761a2560","html_url":"https://github.com/juanfont/headscale/commit/4f8a6ba5ad1eee8afe3ca7573b7e59b4761a2560","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-07T07:35:17Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-09T09:58:53Z"},"tree":{"sha":"9d33760105e09b7e0ea1bffcb8c64b7f29f672b0","url":"https://api.github.com/repos/juanfont/headscale/git/trees/9d33760105e09b7e0ea1bffcb8c64b7f29f672b0"},"message":"state: reject re-auth claiming another machine's NodeKey\n\napplyAuthNodeUpdate rotated the node's NodeKey to the client-supplied value without the 1:1 NodeKey/MachineKey check createAndSaveNewNode (f8f08cf7) and getAndValidateNode enforce. A re-authenticating node could thus rotate its key to a victim's and poison the NodeStore NodeKey index, denying the victim service. Apply the same uniqueness check on the re-auth path.","parents":[{"sha":"9075e0a205613e3659346fadca3c571a7a5f120b","url":"https://api.github.com/repos/juanfont/headscale/git/commits/9075e0a205613e3659346fadca3c571a7a5f120b","html_url":"https://github.com/juanfont/headscale/commit/9075e0a205613e3659346fadca3c571a7a5f120b"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"0405e454cb5147627d6b59b95f4a4f2b0dbba4d5","node_id":"C_kwDOEFLz89oAKDA0MDVlNDU0Y2I1MTQ3NjI3ZDZiNTliOTVmNGE0ZjJiMGRiYmE0ZDU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/0405e454cb5147627d6b59b95f4a4f2b0dbba4d5","html_url":"https://github.com/juanfont/headscale/commit/0405e454cb5147627d6b59b95f4a4f2b0dbba4d5","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-07T07:37:50Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-09T09:58:53Z"},"tree":{"sha":"78ffb39703ed8042fe0dc861973402f38cbc40a8","url":"https://api.github.com/repos/juanfont/headscale/git/trees/78ffb39703ed8042fe0dc861973402f38cbc40a8"},"message":"mapper: guard nil Hostinfo in addNextDNSMetadata\n\naddNextDNSMetadata dereferenced node.Hostinfo().OS() without the .Valid() guard its siblings (RequestTags, TailNode) apply, so building the DNS config for a node with nil Hostinfo (a legacy NULL host_info row) panicked whenever a NextDNS resolver was configured. Guard the OS() dereference.","parents":[{"sha":"4f8a6ba5ad1eee8afe3ca7573b7e59b4761a2560","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4f8a6ba5ad1eee8afe3ca7573b7e59b4761a2560","html_url":"https://github.com/juanfont/headscale/commit/4f8a6ba5ad1eee8afe3ca7573b7e59b4761a2560"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"f622b445ae9cdcec83884c1012e9e46fe51bd3f6","node_id":"C_kwDOEFLz89oAKGY2MjJiNDQ1YWU5Y2RjZWM4Mzg4NGMxMDEyZTllNDZmZTUxYmQzZjY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f622b445ae9cdcec83884c1012e9e46fe51bd3f6","html_url":"https://github.com/juanfont/headscale/commit/f622b445ae9cdcec83884c1012e9e46fe51bd3f6","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-07T10:35:50Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-09T09:58:53Z"},"tree":{"sha":"529aad1e3a9813925a389d9187256535ebe69cbc","url":"https://api.github.com/repos/juanfont/headscale/git/trees/529aad1e3a9813925a389d9187256535ebe69cbc"},"message":"noise: drop write-only nodeKey field to fix data race\n\nnoiseServer.nodeKey was assigned on every PollNetMap and Register request but never read anywhere. The inner HTTP/2 mux multiplexes concurrent requests over one Noise session, so those per-request writes to the shared field raced (caught by -race in servertest TestConnectDisconnectRace, reachable by a client issuing concurrent map requests). Remove the dead field and its two writes.","parents":[{"sha":"0405e454cb5147627d6b59b95f4a4f2b0dbba4d5","url":"https://api.github.com/repos/juanfont/headscale/git/commits/0405e454cb5147627d6b59b95f4a4f2b0dbba4d5","html_url":"https://github.com/juanfont/headscale/commit/0405e454cb5147627d6b59b95f4a4f2b0dbba4d5"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"00012e19c6d95049b164072def53c7693b2d0e0d","node_id":"C_kwDOEFLz89oAKDAwMDEyZTE5YzZkOTUwNDliMTY0MDcyZGVmNTNjNzY5M2IyZDBlMGQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/00012e19c6d95049b164072def53c7693b2d0e0d","html_url":"https://github.com/juanfont/headscale/commit/00012e19c6d95049b164072def53c7693b2d0e0d","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-07T13:36:01Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-09T09:58:53Z"},"tree":{"sha":"a2a0aedd40112cec011c8684dee30002c55553f6","url":"https://api.github.com/repos/juanfont/headscale/git/trees/a2a0aedd40112cec011c8684dee30002c55553f6"},"message":"test: assert NodeKey hijack is rejected on re-auth\n\nTestReAuthWithDifferentMachineKey asserted that a second machine claiming an existing NodeKey succeeds, but that hijack (now rejected by f8f08cf7) poisoned the NodeKey index and DoS'd the original node — the test only checked the hijacker's node, never the original's survival. Assert the registration is rejected and the original node survives intact.","parents":[{"sha":"f622b445ae9cdcec83884c1012e9e46fe51bd3f6","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f622b445ae9cdcec83884c1012e9e46fe51bd3f6","html_url":"https://github.com/juanfont/headscale/commit/f622b445ae9cdcec83884c1012e9e46fe51bd3f6"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"09138afa320a45a290f161b758207844705ee4db","node_id":"C_kwDOEFLz89oAKDA5MTM4YWZhMzIwYTQ1YTI5MGYxNjFiNzU4MjA3ODQ0NzA1ZWU0ZGI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/09138afa320a45a290f161b758207844705ee4db","html_url":"https://github.com/juanfont/headscale/commit/09138afa320a45a290f161b758207844705ee4db","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-08T11:58:05Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-09T09:58:53Z"},"tree":{"sha":"a989684f3e505b90bd2ce3c3bc7dee6b8a10b7ad","url":"https://api.github.com/repos/juanfont/headscale/git/trees/a989684f3e505b90bd2ce3c3bc7dee6b8a10b7ad"},"message":"mapper: test incremental visibility matches full map\n\nPin that NodeOnline patches, NodeAdded peers, and cross-user profiles expose\nexactly the full-map ACL-visible set across the four policy shapes.","parents":[{"sha":"00012e19c6d95049b164072def53c7693b2d0e0d","url":"https://api.github.com/repos/juanfont/headscale/git/commits/00012e19c6d95049b164072def53c7693b2d0e0d","html_url":"https://github.com/juanfont/headscale/commit/00012e19c6d95049b164072def53c7693b2d0e0d"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"ba4225cdc1fe97e9f6ee969a46ec917b4c15d9c1","node_id":"C_kwDOEFLz89oAKGJhNDIyNWNkYzFmZTk3ZTlmNmVlOTY5YTQ2ZWM5MTdiNGMxNWQ5YzE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ba4225cdc1fe97e9f6ee969a46ec917b4c15d9c1","html_url":"https://github.com/juanfont/headscale/commit/ba4225cdc1fe97e9f6ee969a46ec917b4c15d9c1","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-06-08T11:58:05Z"},"commit