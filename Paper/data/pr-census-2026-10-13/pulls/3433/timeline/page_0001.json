[{"sha":"904f5e0ebaefbaf1fb8f2caa0b4a9b5abfab8160","node_id":"C_kwDOEFLz89oAKDkwNGY1ZTBlYmFlZmJhZjFmYjhmMmNhYTBiNGE5YjVhYmZhYjgxNjA","url":"https://api.github.com/repos/juanfont/headscale/git/commits/904f5e0ebaefbaf1fb8f2caa0b4a9b5abfab8160","html_url":"https://github.com/juanfont/headscale/commit/904f5e0ebaefbaf1fb8f2caa0b4a9b5abfab8160","author":{"name":"unknown","email":"1784931579@qq.com","date":"2026-08-22T04:52:03Z"},"committer":{"name":"unknown","email":"1784931579@qq.com","date":"2026-08-22T04:52:03Z"},"tree":{"sha":"5878cf5a771b395d8993c2baab1091f0f0911b65","url":"https://api.github.com/repos/juanfont/headscale/git/trees/5878cf5a771b395d8993c2baab1091f0f0911b65"},"message":"Resync the GivenName DNS label when a node re-registers\n\nRe-registering a node overwrote Hostname and Hostinfo in one step on\nboth the re-auth (applyAuthNodeUpdate) and pre-auth-key\n(HandleNodeFromPreAuthKey) paths, without touching GivenName. The\nhostinfoChanged resync in UpdateNodeFromMapRequest could never fire\nafterwards — re-registration had already stored the new Hostinfo, so\nthe first MapRequest saw no change — and a node that re-registered\nunder a new hostname kept serving its old MagicDNS label forever\n(#3432).\n\nMirror UpdateNodeFromMapRequest's GivenName handling on both paths:\nwhen the current GivenName is still what SanitizeHostname of the old\nhostname would produce (optionally with a -N collision bump), re-derive\nit from the new hostname; an admin rename keeps winning. The pre-auth\nkey site carries an existing TODO asking for exactly these map-request\nsemantics.\n\nTested with TestReauthResyncsGivenName, which fails on the previous\ncode with 'GivenName must follow the new hostname when re-registering\nvia re-auth'.","parents":[{"sha":"565fd254d06c4c7f9a8cad1714a43445c79ba420","url":"https://api.github.com/repos/juanfont/headscale/git/commits/565fd254d06c4c7f9a8cad1714a43445c79ba420","html_url":"https://github.com/juanfont/headscale/commit/565fd254d06c4c7f9a8cad1714a43445c79ba420"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":29838630007,"node_id":"RRE_lADOEFLz888AAAABNyVzZs8AAAAG8oVcdw","url":"https://api.github.com/repos/juanfont/headscale/issues/events/29838630007","actor":{"login":"yzxcj797","id":54314860,"node_id":"MDQ6VXNlcjU0MzE0ODYw","avatar_url":"https://avatars.githubusercontent.com/u/54314860?v=4","gravatar_id":"","url":"https://api.github.com/users/yzxcj797","html_url":"https://github.com/yzxcj797","followers_url":"https://api.github.com/users/yzxcj797/followers","following_url":"https://api.github.com/users/yzxcj797/following{/other_user}","gists_url":"https://api.github.com/users/yzxcj797/gists{/gist_id}","starred_url":"https://api.github.com/users/yzxcj797/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yzxcj797/subscriptions","organizations_url":"https://api.github.com/users/yzxcj797/orgs","repos_url":"https://api.github.com/users/yzxcj797/repos","events_url":"https://api.github.com/users/yzxcj797/events{/privacy}","received_events_url":"https://api.github.com/users/yzxcj797/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"review_requested","commit_id":null,"commit_url":null,"created_at":"2026-08-22T04:53:59Z","review_requester":{"login":"yzxcj797","id":54314860,"node_id":"MDQ6VXNlcjU0MzE0ODYw","avatar_url":"https://avatars.githubusercontent.com/u/54314860?v=4","gravatar_id":"","url":"https://api.github.com/users/yzxcj797","html_url":"https://github.com/yzxcj797","followers_url":"https://api.github.com/users/yzxcj797/followers","following_url":"https://api.github.com/users/yzxcj797/following{/other_user}","gists_url":"https://api.github.com/users/yzxcj797/gists{/gist_id}","starred_url":"https://api.github.com/users/yzxcj797/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yzxcj797/subscriptions","organizations_url":"https://api.git