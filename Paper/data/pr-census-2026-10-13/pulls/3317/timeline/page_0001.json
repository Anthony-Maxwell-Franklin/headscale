[{"sha":"ee05347c30bfb57297d22b34c70710e19e5ca514","node_id":"C_kwDOEFLz89oAKGVlMDUzNDdjMzBiZmI1NzI5N2QyMmIzNGM3MDcxMGUxOWU1Y2E1MTQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ee05347c30bfb57297d22b34c70710e19e5ca514","html_url":"https://github.com/juanfont/headscale/commit/ee05347c30bfb57297d22b34c70710e19e5ca514","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-15T06:18:54Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-17T10:24:55Z"},"tree":{"sha":"fabfb7b200cc73af5daecf8c2ed0c07cdfc2f43a","url":"https://api.github.com/repos/juanfont/headscale/git/trees/fabfb7b200cc73af5daecf8c2ed0c07cdfc2f43a"},"message":"state: cover NodeKey-rotation binding with a regression test\n\nA re-registering node must not rotate its NodeKey onto one already bound\nto a different machine, or it could poison the NodeStore NodeKey index and\ndeny the victim service. This adds a test that drives the rotation from an\nauthenticated session under a different machine key and confirms it is\nrejected with ErrNodeKeyInUse.","parents":[{"sha":"b0c221f3a167505f4337522ba16958701283f69d","url":"https://api.github.com/repos/juanfont/headscale/git/commits/b0c221f3a167505f4337522ba16958701283f69d","html_url":"https://github.com/juanfont/headscale/commit/b0c221f3a167505f4337522ba16958701283f69d"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"7a67f663273a684a17a75a686682377bc6d989ad","node_id":"C_kwDOEFLz89oAKDdhNjdmNjYzMjczYTY4NGExN2E3NWE2ODY2ODIzNzdiYzZkOTg5YWQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7a67f663273a684a17a75a686682377bc6d989ad","html_url":"https://github.com/juanfont/headscale/commit/7a67f663273a684a17a75a686682377bc6d989ad","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-15T10:14:35Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-17T10:24:55Z"},"tree":{"sha":"a8c6ea37bec7d34414df4f96d3c075c802a2a7db","url":"https://api.github.com/repos/juanfont/headscale/git/trees/a8c6ea37bec7d34414df4f96d3c075c802a2a7db"},"message":"types: validate pkce.method when OIDC is active\n\nPKCE method validation was gated on the never-set oidc.enabled key, so an\ninvalid method slipped past startup validation and silently disabled PKCE.\nGate it on oidc.issuer, the real OIDC activation condition, and fail the auth\nhandler on an unknown method instead of emitting no challenge.","parents":[{"sha":"ee05347c30bfb57297d22b34c70710e19e5ca514","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ee05347c30bfb57297d22b34c70710e19e5ca514","html_url":"https://github.com/juanfont/headscale/commit/ee05347c30bfb57297d22b34c70710e19e5ca514"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"93ff450edd9b19d9ca240ffe8cd0f5d266e4d74a","node_id":"C_kwDOEFLz89oAKDkzZmY0NTBlZGQ5YjE5ZDljYTI0MGZmZThjZDBmNWQyNjZlNGQ3NGE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/93ff450edd9b19d9ca240ffe8cd0f5d266e4d74a","html_url":"https://github.com/juanfont/headscale/commit/93ff450edd9b19d9ca240ffe8cd0f5d266e4d74a","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-16T06:55:26Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-17T10:24:55Z"},"tree":{"sha":"793eb50f8fc95576ee4e8811474a949319bfcc8a","url":"https://api.github.com/repos/juanfont/headscale/git/trees/793eb50f8fc95576ee4e8811474a949319bfcc8a"},"message":"handlers: set verify Content-Type before writing the body\n\nVerifyHandler set Content-Type: application/json after handleVerifyRequest had already written the JSON body. The first Write triggers an implicit WriteHeader that snapshots the header map, so the later Set was a no-op and successful /verify responses went out as the sniffed text/plain. Set the header before the body is written.","parents":[{"sha":"7a67f663273a684a17a75a686682377bc6d989ad","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7a67f663273a684a17a75a686682377bc6d989ad","html_url":"https://github.com/juanfont/headscale/commit/7a67f663273a684a17a75a686682377bc6d989ad"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"ed04c014fb1d9279a5df0e4ea11e9d3d4550e8d4","node_id":"C_kwDOEFLz89oAKGVkMDRjMDE0ZmIxZDkyNzlhNWRmMGU0ZWExMWU5ZDNkNDU1MGU4ZDQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ed04c014fb1d9279a5df0e4ea11e9d3d4550e8d4","html_url":"https://github.com/juanfont/headscale/commit/ed04c014fb1d9279a5df0e4ea11e9d3d4550e8d4","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-16T06:57:14Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-17T10:24:55Z"},"tree":{"sha":"a871a25bb1ef2fe05cdad3f300e42b7a2b038407","url":"https://api.github.com/repos/juanfont/headscale/git/trees/a871a25bb1ef2fe05cdad3f300e42b7a2b038407"},"message":"types: strip port before suffix-checking server_url against base_domain\n\nisSafeServerURL split server.Host (port included) into labels, so a\nserver_url like https://server.headscale.com:443 never matched the\nbase_domain suffix and passed validation. Split server.Hostname()\ninstead, matching the equality check above it.","parents":[{"sha":"93ff450edd9b19d9ca240ffe8cd0f5d266e4d74a","url":"https://api.github.com/repos/juanfont/headscale/git/commits/93ff450edd9b19d9ca240ffe8cd0f5d266e4d74a","html_url":"https://github.com/juanfont/headscale/commit/93ff450edd9b19d9ca240ffe8cd0f5d266e4d74a"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":26854908088,"node_id":"HRFPE_lADOEFLz888AAAABFsV5Ec8AAAAGQK1guA","url":"https://api.github.com