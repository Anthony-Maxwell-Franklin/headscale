/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"f936aeb5ea5ee283ba287484755a86bab29342eb","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/f936aeb5ea5ee283ba287484755a86bab29342eb","created_at":"2026-09-02T06:03:18Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/juanfont/headscale/issues/comments/5505361544","html_url":"https://github.com/juanfont/headscale/pull/3448#issuecomment-5505361544","issue_url":"https://api.github.com/repos/juanfont/headscale/issues/3448","id":5505361544,"node_id":"IC_kwDOEFLz888AAAABSCUmiA","user":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-09-02T06:18:28Z","updated_at":"2026-09-02T06:18:28Z","body":"The `build` check is red on a blocker that is not this PR's, and it gates the whole integration matrix (all `sqlite`/`postgres` jobs show as skipping).\n\n`Dockerfile.tailscale-HEAD:7` pins `golang:1.27.0-alpine` and then clones tailscale HEAD, whose `go.mod` now requires `go >= 1.27.1`:\n\n```\n#14 0.080 go: go.mod requires go >= 1.27.1 (running go 1.27.0; GOTOOLCHAIN=local)\nERROR: failed to solve: process \"/bin/sh -c GOARCH=$TARGETARCH go install ...\" exit code: 1\n```\n\nThis same check passed on this exact tree earlier today — the last push changed only commit message text, not a byte of code (`git diff` between the two heads is empty). Nothing in the diff touches `Dockerfile.tailscale-HEAD`, and the failure is deterministic, so a re-run will not clear it. Every PR in the repo will hit it until the pin moves.\n\nProposed patch, same shape as `docker: head tailscale latest go`:\n\n```diff\n-FROM golang:1.27.0-alpine AS build-env\n+FROM golang:1.27.1-alpine AS build-env\n```\n\nVerified locally: `docker build -f Dockerfile.tailscale-HEAD .` fails on the current pin and succeeds with `1.27.1-alpine`. Leaving it out of this PR rather than widening it — happy to port it here or send it separately.","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/juanfont/headscale/issues/comments/5505361544/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_