[{"sha":"889ff4c0e048d2d626c3471cfb2c74a98208443d","node_id":"C_kwDOEFLz89oAKDg4OWZmNGMwZTA0OGQyZDYyNmMzNDcxY2ZiMmM3NGE5ODIwODQ0M2Q","url":"https://api.github.com/repos/juanfont/headscale/git/commits/889ff4c0e048d2d626c3471cfb2c74a98208443d","html_url":"https://github.com/juanfont/headscale/commit/889ff4c0e048d2d626c3471cfb2c74a98208443d","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2023-09-24T21:30:50Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2023-09-24T21:35:16Z"},"tree":{"sha":"7f2edd55892b6720e2566cc0f8739c7991f51eb8","url":"https://api.github.com/repos/juanfont/headscale/git/trees/7f2edd55892b6720e2566cc0f8739c7991f51eb8"},"message":"Add github stale action\n\nWe have a lot of issues that has gone stale, and to help us\nprioritise which ones to pick up, we are adding this stale\naction to close out issues that are no longer active.\n\nThe bot is configured as this:\n- If an issue sees no activity for 6 months (180 days) it is marked as stale\n- If an issue is not confirmed still being an issue within 14 days, it is closed.\n\nThis is of course not a perfect solution, but it will hopefully\nhelp us prioritise active issues with people who can help us debug.\n\nWe might tighten the activity requirement in the future.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>","parents":[{"sha":"6cd0f7751138717f1f9a552c3dfd657c1ba2c9cf","url":"https://api.github.com/repos/juanfont/headscale/git/commits/6cd0f7751138717f1f9a552c3dfd657c1ba2c9cf","html_url":"https://github.com/juanfont/headscale/commit/6cd0f7751138717f1f9a552c3dfd657c1ba2c9cf"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":10455992072,"node_id":"HRFPE_lADOEFLz885x3jBQzwAAAAJvOccI","url":"https://api.github.com/repos/juanfont/headscale/issues/events/10455992072","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":