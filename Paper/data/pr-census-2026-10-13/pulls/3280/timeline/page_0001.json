[{"sha":"1f4f54d976ee44caee43f1dff2a79e91d2ac2e86","node_id":"C_kwDOEFLz89oAKDFmNGY1NGQ5NzZlZTQ0Y2FlZTQzZjFkZmYyYTc5ZTkxZDJhYzJlODY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/1f4f54d976ee44caee43f1dff2a79e91d2ac2e86","html_url":"https://github.com/juanfont/headscale/commit/1f4f54d976ee44caee43f1dff2a79e91d2ac2e86","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-22T09:44:58Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-22T09:44:58Z"},"tree":{"sha":"d14d4ff09515ad53ed9af03828ef4da616bc76d2","url":"https://api.github.com/repos/juanfont/headscale/git/trees/d14d4ff09515ad53ed9af03828ef4da616bc76d2"},"message":"hi: add list-versions subcommand\n\nPrints the tailscale versions integration tests use, with optional\nfilter and format flags. Source of truth stays in hscontrol/capver;\nCI shells out to this instead of duplicating the version list in\nYAML.\n\nExamples:\n  hi list-versions\n  hi list-versions --set=must --exclude=head\n  hi list-versions --set=all --format=json","parents":[{"sha":"4cca63155d7a1bed3c806f876991a1a05e77bb73","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4cca63155d7a1bed3c806f876991a1a05e77bb73","html_url":"https://github.com/juanfont/headscale/commit/4cca63155d7a1bed3c806f876991a1a05e77bb73"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"57849b6d4e3d5cba63769aca3808883bd549b2d7","node_id":"C_kwDOEFLz89oAKDU3ODQ5YjZkNGUzZDVjYmE2Mzc2OWFjYTM4MDg4ODNiZDU0OWIyZDc","url":"https://api.github.com/repos/juanfont/headscale/git/commits/57849b6d4e3d5cba63769aca3808883bd549b2d7","html_url":"https://github.com/juanfont/headscale/commit/57849b6d4e3d5cba63769aca3808883bd549b2d7","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-22T09:45:22Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-22T09:45:22Z"},"tree":{"sha":"a31395289f86b16606a284fac39dec41d55228ef","url":"https://api.github.com/repos/juanfont/headscale/git/trees/a31395289f86b16606a284fac39dec41d55228ef"},"message":"tsic: pull tailscale images from ghcr.io\n\nAnonymous reads on ghcr.io are unmetered. Pulling tailscale/tailscale\nfrom Docker Hub fails on fork PRs without DOCKERHUB_USERNAME because\nthe unauthenticated rate limit is hit at test time.\n\nghcr.io/tailscale/tailscale publishes the same tags. The cache-hit\nshort-circuit in dockertestutil.PullWithAuth still skips the pull when\nthe image is already loaded locally, so the change is a no-op once CI\npre-pulls the images.","parents":[{"sha":"1f4f54d976ee44caee43f1dff2a79e91d2ac2e86","url":"https://api.github.com/repos/juanfont/headscale/git/commits/1f4f54d976ee44caee43f1dff2a79e91d2ac2e86","html_url":"https://github.com/juanfont/headscale/commit/1f4f54d976ee44caee43f1dff2a79e91d2ac2e86"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"0d3fcb2be160082c4d0dd097c3f586a56bec25c6","node_id":"C_kwDOEFLz89oAKDBkM2ZjYjJiZTE2MDA4MmM0ZDBkZDA5N2MzZjU4NmE1NmJlYzI1YzY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/0d3fcb2be160082c4d0dd097c3f586a56bec25c6","html_url":"https://github.com/juanfont/headscale/commit/0d3fcb2be160082c4d0dd097c3f586a56bec25c6","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-22T09:45:38Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-22T09:45:38Z"},"tree":{"sha":"a9c3dc61c213f651bf6be17f01ebd5ca5be273b2","url":"https://api.github.com/repos/juanfont/headscale/git/trees/a9c3dc61c213f651bf6be17f01ebd5ca5be273b2"},"message":"gh: pre-pull released tailscale images for fork-PR CI\n\nFork PRs anonymous-pull tailscale/tailscale:vX.Y at test time and hit\nDocker Hub rate limits, causing flakes. A new build-tailscale-released\njob pulls the MustTestVersions set from ghcr.io once per CI run and\nships them to every test job as a gzipped tarball artifact, matching\nthe shape of the existing headscale/HEAD/postgres caches.\n\nThe version list is driven by 'hi list-versions' so capver is the\nsingle source of truth; adding a version there propagates to CI\nwithout YAML edits.\n\nghcr.io public reads need no auth, so the new job has no docker login\nstep.","parents":[{"sha":"57849b6d4e3d5cba63769aca3808883bd549b2d7","url":"https://api.github.com/repos/juanfont/headscale/git/commits/57849b6d4e3d5cba63769aca3808883bd549b2d7","html_url":"https://github.com/juanfont/headscale/commit/57849b6d4e3d5cba63769aca3808883bd549b2d7"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"efce0c966540dd85a234c92a77be422dae186112","node_id":"C_kwDOEFLz89oAKGVmY2UwYzk2NjU0MGRkODVhMjM0YzkyYTc3YmU0MjJkYWUxODYxMTI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/efce0c966540dd85a234c92a77be422dae186112","html_url":"https://github.com/juanfont/headscale/commit/efce0c966540dd85a234c92a77be422dae186112","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-22T10:35:20Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-22T10:35:20Z"},"tree":{"sha":"149fc385527ac133c641957f511f01ce648e616e","url":"https://api.github.com/repos/juanfont/headscale/git/trees/149fc385527ac133c641957f511f01ce648e616e"},"message":"tsic, gh: keep unstable on Docker Hub\n\nghcr.io/tailscale/tailscale:unstable is stale (last updated 2022,\npoints to v1.35.25). Only tailscale/tailscale on Docker Hub publishes\ncurrent unstable builds, so tsic.go reverts the unstable case and\nbuild-tailscale-released pulls unstable from Docker Hub while keeping\nrelease tags on ghcr.io.\n\nRelease tags on ghcr.io match Docker Hub by digest (verified v1.96),\nso the rate-limit avoidance for the bulk of pulls is preserved.\n\nAdd the conditional docker/login-action step to the new job so the\nmain repo gets authenticated pulls; fork PRs fall through to anonymous\nDH for the single unstable pull per CI run, well under the 100/6h\nanonymous limit.","parents":[{"sha":"0d3fcb2be160082c4d0dd097c3f586a56bec25c6","url":"https://api.github.com/repos/juanfont/headscale/git/commits/0d3fcb2be160082c4d0dd097c3f586a56bec25c6","html_url":"https://github.com/juanfont/headscale/commit/0d3fcb2be160082c4d0dd097c3f586a56bec25c6"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":25850191550,"node_id":"RFRE_lADOEFLz888AAAABDFGVk88AAAAGBMqevg","url":"https://api.github.com/repos/juanfont/headscale/issues/events/25850191550","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"ready_for_review","commit_id":null,"commit_url":null,"created_at":"2026-05-22T12:04:01Z","performed_via_github_app":null},{"id":25850192101,"node_id":"RRE_lADOEFLz888AAAABDFGVk88AAAAGBMqg5Q","url":"https://api.github.com/repos/juanfont/headscale/issues/events/25850192101","actor":{"