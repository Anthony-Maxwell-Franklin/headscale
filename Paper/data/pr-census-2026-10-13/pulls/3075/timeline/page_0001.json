[{"sha":"b9bc6b22c13d95baeff7c95f5e95e666e25254fe","node_id":"C_kwDOEFLz89oAKGI5YmM2YjIyYzEzZDk1YmFlZmY3Yzk1ZjVlOTVlNjY2ZTI1MjU0ZmU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/b9bc6b22c13d95baeff7c95f5e95e666e25254fe","html_url":"https://github.com/juanfont/headscale/commit/b9bc6b22c13d95baeff7c95f5e95e666e25254fe","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-02-09T09:00:22Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-02-09T09:00:22Z"},"tree":{"sha":"a2f185ea6d6397b1e2400172605a36a0bd72b5b2","url":"https://api.github.com/repos/juanfont/headscale/git/trees/a2f185ea6d6397b1e2400172605a36a0bd72b5b2"},"message":"github: fix needs-more-info label race condition\n\nRemove the `issues: labeled` trigger from the timer workflow.\n\nWhen both workflows triggered on label addition, the comment workflow\nwould post the bot comment, and by the time the timer workflow ran,\nissue-manager would see \"a comment was added after the label\" and\nimmediately remove the label due to `remove_label_on_comment: true`.\n\nThe timer workflow now only runs on:\n- Daily cron (to close stale issues)\n- issue_comment (to remove label when humans respond)\n- workflow_dispatch (for manual testing)","parents":[{"sha":"c1b468f9f45867926e00fe7a7a700ed3ac2aad22","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c1b468f9f45867926e00fe7a7a700ed3ac2aad22","html_url":"https://github.com/juanfont/headscale/commit/c1b468f9f45867926e00fe7a7a700ed3ac2aad22"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":22637362082,"node_id":"RRE_lADOEFLz887pXfWozwAAAAVFSrui","url":"https://api.github.com/repos/juanfont/headscale/issues/events/22637362082","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.gith