kChanges() for network change detection.\n","verified_at":"2025-10-23T14:56:48Z"},"event":"committed"},{"sha":"aba890f19f0cbd41d6dd974b7ff6396c98a978f2","node_id":"C_kwDOEFLz89oAKGFiYTg5MGYxOWYwY2JkNDFkNmRkOTc0YjdmZjYzOTZjOThhOTc4ZjI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/aba890f19f0cbd41d6dd974b7ff6396c98a978f2","html_url":"https://github.com/juanfont/headscale/commit/aba890f19f0cbd41d6dd974b7ff6396c98a978f2","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-10-22T14:31:12Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-10-23T14:53:05Z"},"tree":{"sha":"165bcc53b872c87648a4dce4320c0f22a5978f6a","url":"https://api.github.com/repos/juanfont/headscale/git/trees/165bcc53b872c87648a4dce4320c0f22a5978f6a"},"message":"integration: more eventually and timing handling","parents":[{"sha":"7a8d8886ded2f079d93e45d6022cc5345da28d3d","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7a8d8886ded2f079d93e45d6022cc5345da28d3d","html_url":"https://github.com/juanfont/headscale/commit/7a8d8886ded2f079d93e45d6022cc5345da28d3d"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgmMAoz5Zf+w0nAxyA6/zsNd95cP\n98YbtHIIXyy9A1sssAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQDDqQWFUXYNibhi/zDzRomhpBUGkQzcAAK7hnhsdekbwzEHASAJBoINXj9jsC05eLQ\nd8zUdmXSVJa9wNNi9oAwI=\n-----END SSH SIGNATURE-----","payload":"tree 165bcc53b872c87648a4dce4320c0f22a5978f6a\nparent 7a8d8886ded2f079d93e45d6022cc5345da28d3d\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1761143472 +0200\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1761231185 +0200\n\nintegration: more eventually and timing handling\n","verified_at":"2025-10-23T14:56:48Z"},"event":"committed"},{"sha":"f0281a15a68eb18f80cc60dbe90788ce95dbf35e","node_id":"C_kwDOEFLz89oAKGYwMjgxYTE1YTY4ZWIxOGY4MGNjNjBkYmU5MDc4OGNlOTVkYmYzNWU