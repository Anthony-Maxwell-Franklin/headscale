scale/commit/5b84ea3be8a4bf5304b8df44ca5e567362941620"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"b46e217629c452703d60bfb34307eea61dcaea2a","node_id":"C_kwDOEFLz89oAKGI0NmUyMTc2MjljNDUyNzAzZDYwYmZiMzQzMDdlZWE2MWRjYWVhMmE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/b46e217629c452703d60bfb34307eea61dcaea2a","html_url":"https://github.com/juanfont/headscale/commit/b46e217629c452703d60bfb34307eea61dcaea2a","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-16T14:01:07Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-20T14:47:38Z"},"tree":{"sha":"e79b10bd8899533bae9ebed92706276e9515cb1f","url":"https://api.github.com/repos/juanfont/headscale/git/trees/e79b10bd8899533bae9ebed92706276e9515cb1f"},"message":"docs: add changelog entry for API key expire/delete by ID\n\nFixes #2986","parents":[{"sha":"ff1097dd70bf832ff7a407a5e011ab6d4a76dfbd","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ff1097dd70bf832ff7a407a5e011ab6d4a76dfbd","html_url":"https://github.com/juanfont/headscale/commit/ff1097dd70bf832ff7a407a5e011ab6d4a76dfbd"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"3ba24e224826db9c902b4d5d7397898c9dff5df9","node_id":"C_kwDOEFLz89oAKDNiYTI0ZTIyNDgyNmRiOWM5MDJiNGQ1ZDczOTc4OThjOWRmZjVkZjk","url":"https://api.github.com/repos/juanfont/headscale/git/commits/3ba24e224826db9c902b4d5d7397898c9dff5df9","html_url":"https://github.com/juanfont/headscale/commit/3ba24e224826db9c902b4d5d7397898c9dff5df9","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-16T14:10:42Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-20T14:47:38Z"},"tree":{"sha":"df9b91de5cfa7bc0e687477f935b7c11e82f1c19","url":"https://api.github.com/repos/jua