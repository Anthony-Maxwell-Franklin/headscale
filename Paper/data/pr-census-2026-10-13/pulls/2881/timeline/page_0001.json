l":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"requested_reviewer":{"login":"juanfont","id":181059,"node_id":"MDQ6VXNlcjE4MTA1OQ==","avatar_url":"https://avatars.githubusercontent.com/u/181059?v=4","gravatar_id":"","url":"https://api.github.com/users/juanfont","html_url":"https://github.com/juanfont","followers_url":"https://api.github.com/users/juanfont/followers","following_url":"https://api.github.com/users/juanfont/following{/other_user}","gists_url":"https://api.github.com/users/juanfont/gists{/gist_id}","starred_url":"https://api.github.com/users/juanfont/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/juanfont/subscriptions","organizations_url":"https://api.github.com/users/juanfont/orgs","repos_url":"https://api.github.com/users/juanfont/repos","events_url":"https://api.github.com/users/juanfont/events{/privacy}","received_events_url":"https://api.github.com/users/juanfont/received_events","type":"User","user_view_type":"public","site_admin":false},"performed_via_github_app":null},{"id":20898647064,"node_id":"CTDE_lADOEFLz887XqEoDzwAAAATdqAwY","url":"https://api.github.com/repos/juanfont/headscale/issues/events/20898647064","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"convert_to_draft","commit_id":null,"commit_url":null,"created_at":"2025-11-12T21:02:30Z","performed_via_github_app":null},{"sha":"a80505392158d8db6cf56ed4ff91f75a62169446","node_id":"C_kwDOEFLz89oAKGE4MDUwNTM5MjE1OGQ4ZGI2Y2Y1NmVkNGZmOTFmNzVhNjIxNjk0NDY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a80505392158d8db6cf56ed4ff91f75a62169446","html_url":"https://github.com/juanfont/headscale/commit/a80505392158d8db6cf56ed4ff91f75a62169446","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-12T20:24:38Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2025-11-28T10:44:45Z"},"tree":{"sha":"d11620f61e082a94303b12fb2b49590feb172fcb","url":"https://api.github.com/repos/juanfont/headscale/git/trees/d11620f61e082a94303b12fb2b49590feb172fcb"},"message":"cmd/hi: improve test cleanup to reduce CI disk usage\n\nOptimize integration test cleanup to address disk space issues in CI\nenvironments by implementing smarter artifact and image management.\n\nChanges:\n\n1. Add cleanupSuccessfulTestArtifacts function that removes large\n   debugging artifacts after successful test runs:\n   - Database dumps (.db files)\n   - Profile data (pprof/ directories)\n   - MapResponse data (mapresponses/ directories)\n   - Prometheus metrics files (_metrics.txt)\n   - Tailscale status files (_status.json)\n\n   Preserves log files (.log) which are small and useful for verification.\n   Reports freed disk space (e.g., \"freed ~5.5 MB\").\n\n2. Modify CleanImagesInCI to only remove dangling (untagged) images\n   instead of all images. This prevents unnecessary rebuilds of base\n   images (golang:*, tailscale/tailscale:*), making consecutive test\n   runs significantly faster.\n\nThe cleanup runs automatically after successful tests and only removes\nartifacts that are primarily useful for debugging failures. Failed test\nartifacts are preserved for investigation.\n\nFixes disk space exhaustion issues in GitHub Actions CI where tests\nwould fail with \"The command returned a non-zero code: 1\" due to\ninsufficient storage during Docker builds.","parents":[{"sha":"9c4c017eac2e81908d2ae7d8d777e143a13a1772","url":"https://api.github.com/repos/juanfont/headscale/git/commits/9c4c017eac2e81908d2ae7d8d777e143a13a1772","html_url":"https://github.com/juanfont/headscale/commit/9c4c017eac2e81908d2ae7d8d777e143a13a1772"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"d9857236bbbd5d097ab299e2dce120e571639e8a","node_id":"C_kwDOEFLz89oAKGQ5ODU3MjM2YmJiZDVkMDk3YWIyOTllMmRjZTEyMGU1NzE2MzllOGE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/d9857236bbbd5d097ab299e2dce120e571639e8a","html_url":"https://github.com/juanfont/headscale/commit/d9857236bbbd5d097ab299e2dce120e571639e8a","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-12T20:31:27Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2025-11-28T10:44:45Z"},"tree":{"sha":"273c1637ad4239abe524727cc92b34d32f0adb04","url":"https://api.github.com/repos/juanfont/headscale/git/trees/273c1637ad4239abe524727cc92b34d32f0adb04"},"message":"integration: improve Docker build error diagnostics\n\nImprove error messages when Docker container builds fail to surface the\nactual underlying errors instead of generic \"returned a non-zero code: 1\"\nmessages. This makes CI failures much easier to diagnose, especially for\ndisk space issues.\n\nChanges:\n\n1. Modify RunDockerBuildForDiagnostics to:\n   - Return both output and error (previously only returned output on error)\n   - Use CommandContext with 10-minute timeout to prevent hanging\n   - Add --progress=plain and --no-cache flags for detailed output\n   - Always return build output regardless of success/failure\n\n2. Update error handling in hsic.go and tsic.go to:\n   - Display last 100 lines of build output (avoid log overflow)\n   - Differentiate between \"build failed\" and \"build succeeded on retry\"\n   - Show more helpful error message when diagnostic build unavailable\n\nExample improved error message:\n```\ncould not start headscale container: exit status 1\n\nDocker build failed. Last 100 lines of output:\n#12 [7/7] RUN CGO_ENABLED=0 GOOS=linux go build ...\n#12 ERROR: failed to solve: process \"/bin/sh -c ...\"\ndid not complete successfully: exit code: 1\n------\n > [7/7] RUN CGO_ENABLED=0 GOOS=linux go build:\n#12 0.123 # github.com/juanfont/headscale/cmd/headscale\n#12 0.456 /go/pkg/mod/...: no space left on device\n------\n```\n\nThis makes it immediately clear that the issue is disk space rather than\na code compilation error.","parents":[{"sha":"a80505392158d8db6cf56ed4ff91f75a62169446","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a80505392158d8db6cf56ed4ff91f75a62169446","html_url":"https://github.com/juanfont/headscale/commit/a80505392158d8db6cf56ed4ff91f75a62169446"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"47c7b0ace7b4cdb0bb2b5a42f95400d7db185d69","node_id":"C_kwDOEFLz89oAKDQ3YzdiMGFjZTdiNGNkYjBiYjJiNWE0MmY5NTQwMGQ3ZGIxODVkNjk","url":"https://api.github.com/repos/juanfont/headscale/git/commits/47c7b0ace7b4cdb0bb2b5a42f95400d7db185d69","html_url":"https://github.com/juanfont/headscale/commit/47c7b0ace7b4cdb0bb2b5a42f95400d7db185d69","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-12T21:20:21Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2025-11-28T10:44:45Z"},"tree":{"sha":"8b1828e907e1802f592cbac5f418b333cbd52bc4","url":"https://api.github.com/repos/juanfont/headscale/git/trees/8b1828e907e1802f592cbac5f418b333cbd52bc4"},"message":"integration: always show diagnostic build output on failure\n\nFix issue where diagnostic build output was not shown even when the\nbuild failed, leading to unhelpful \"unable to get diagnostic build\noutput\" messages.\n\nThe previous logic only showed output if `buildOutput != \"\"`, but then\nchecked `buildErr` to determine if it failed. This meant that if the\nbuild failed with no output, or if the output was empty, we wouldn't\nshow it.\n\nNew logic:\n1. Always process the output (even if empty)\n2. If buildErr != nil: show \"Docker build failed\" with output\n3. If buildErr == nil && output != \"\": show \"build succeeded on retry\"\n4. If buildErr == nil && output == \"\": show \"command may have failed silently\"\n\nThis ensures we always get diagnostic information, making it easier to\ndebug issues like disk space exhaustion in CI.","parents":[{"sha":"d9857236bbbd5d097ab299e2dce120e571639e8a","url":"https://api.github.com/repos/juanfont/headscale/git/commits/d9857236bbbd5d097ab299e2dce120e571639e8a","html_url":"https://github.com/juanfont/headscale/commit/d9857236bbbd5d097ab299e2dce120e571639e8a"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":21239866757,"node_id":"HRFPE_lADOEFLz887XqEoDzwAAAATx_qWF","url":"https://api.github.com/repos/juanfont/headscale/issues/events/21239866757","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.c