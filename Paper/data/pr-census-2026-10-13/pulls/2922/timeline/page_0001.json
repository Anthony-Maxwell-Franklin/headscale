[{"sha":"7c354caffa0698fe6a357327ec88f258975f5ae2","node_id":"C_kwDOEFLz89oAKDdjMzU0Y2FmZmEwNjk4ZmU2YTM1NzMyN2VjODhmMjU4OTc1ZjVhZTI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7c354caffa0698fe6a357327ec88f258975f5ae2","html_url":"https://github.com/juanfont/headscale/commit/7c354caffa0698fe6a357327ec88f258975f5ae2","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2025-11-28T21:27:18Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2025-11-28T21:37:05Z"},"tree":{"sha":"19ddd442fa66ac9a03ef6143bbfd0dc81482cbf5","url":"https://api.github.com/repos/juanfont/headscale/git/trees/19ddd442fa66ac9a03ef6143bbfd0dc81482cbf5"},"message":"cli: remove node move command\n\nThis commit removes support for moving nodes between users.\n\nThe reason for this is that allowing such move is going against\na intended design about identity in Tailscale, where your peer\nhas an identity based on their machine, and user id. By allowing\nthe node to be moved, we are breaking this contract, a user might\nhave a peer, and it cannot be trusting who owns this peer as it\ncant change.\n\nThis feature should not have been added, and now that Tags are being\nimplemented, essentially representing service account, allowing better\nseggeration anyways, we will remove it.\n\nOne of the problems associated with this would be similar to the email\ntakeover on an OIDC platform.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@dalby.cc>","parents":[{"sha":"f00c412cde4a000cc091037f926519b99ceb7626","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f00c412cde4a000cc091037f926519b99ceb7626","html_url":"https://github.com/juanfont/headscale/commit/f00c412cde4a000cc091037f926519b99ceb7626"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":21248278935,"node_id":"RRE_lADOEFLz887bGxZfzwAAAATyfwGX","url":"https://api.github.com/repos/juanfo