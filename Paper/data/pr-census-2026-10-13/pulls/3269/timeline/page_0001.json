}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"body":null,"commit_id":"764c835bb00e133da092395b17679ddab7eaac6e","state":"commented","html_url":"https://github.com/juanfont/headscale/pull/3269#pullrequestreview-4309182095","pull_request_url":"https://api.github.com/repos/juanfont/headscale/pulls/3269","_links":{"html":{"href":"https://github.com/juanfont/headscale/pull/3269#pullrequestreview-4309182095"},"pull_request":{"href":"https://api.github.com/repos/juanfont/headscale/pulls/3269"}},"submitted_at":"2026-05-18T10:05:55Z","updated_at":"2026-05-18T10:05:56Z","author_association":"COLLABORATOR","event":"reviewed"},{"id":4309188242,"node_id":"PRR_kwDOEFLz888AAAABANj-kg","user":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"body":null,"commit_id":"764c835bb00e133da092395b17679ddab7eaac6e","state":"commented","html_url":"https://github.com/juanfont/headscale/pull/3269#pullrequestreview-4309188242","pull_request_url":"https://api.github.com/repos/juanfont/headscale/pulls/3269","_links":{"html":{"href":"https://github.com/juanfont/headscale/pull/3269#pullrequestreview-4309188242"},"pull_request":{"href":"https://api.github.com/repos/juanfont/headscale/pulls/3269"}},"submitted_at":"2026-05-18T10:06:57Z","updated_at":"2026-05-18T10:06:58Z","author_association":"COLLABORATOR","event":"reviewed"},{"sha":"783a9aa6da0eea4c221ded27620b63f03598c186","node_id":"C_kwDOEFLz89oAKDc4M2E5YWE2ZGEwZWVhNGMyMjFkZWQyNzYyMGI2M2YwMzU5OGMxODY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/783a9aa6da0eea4c221ded27620b63f03598c186","html_url":"https://github.com/juanfont/headscale/commit/783a9aa6da0eea4c221ded27620b63f03598c186","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-18T09:42:28Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-18T10:34:28Z"},"tree":{"sha":"3ac96ac66f8eefa845bc418ad27965b65b969324","url":"https://api.github.com/repos/juanfont/headscale/git/trees/3ac96ac66f8eefa845bc418ad27965b65b969324"},"message":"policy/v2: match via-grant destinations by prefix overlap\n\nslices.Contains required exact equality between grant dst and the\nadvertised subnet route. Any non-identical pair was rejected, so a\nvia grant with broader (or narrower) dst emitted no filter rule and\nadded no route to the viewer's AllowedIPs. Tailscale SaaS uses\ncontainment in either direction.\n\nSwitch to slices.ContainsFunc(routes, dst.Overlaps) for filter rule\nemission (keep dst literal in DstPorts), and append overlapping\nadvertised routes to ViaRoutesForPeer.Include / Exclude. Rewrite the\nmulti-router HA election and regular-grant overlap detection to key\noff the matched routes rather than the dst. Resolve *Host aliases to\n*Prefix once in compileOneViaGrant and at the top of ViaRoutesForPeer\nso the switch arms reach them.\n\nFixes #3267","parents":[{"sha":"af7e7a45604dd7fe5e0c64d5e2c907a3108c7c36","url":"https://api.github.com/repos/juanfont/headscale/git/commits/af7e7a45604dd7fe5e0c64d5e2c907a3108c7c36","html_url":"https://github.com/juanfont/headscale/commit/af7e7a45604dd7fe5e0c64d5e2c907a3108c7c36"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"99cc1e507e469ec50a884c16f405f855fac3ce31","node_id":"C_kwDOEFLz89oAKDk5Y2MxZTUwN2U0NjllYzUwYTg4NGMxNmY0MDVmODU1ZmFjM2NlMzE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/99cc1e507e469ec50a884c16f405f855fac3ce31","html_url":"https://github.com/juanfont/headscale/commit/99cc1e507e469ec50a884c16f405f855fac3ce31","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-18T09:42:59Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-18T10:34:28Z"},"tree":{"sha":"364fafaf217ecfd7911cb1dba2f41857f788dd4f","url":"https://api.github.com/repos/juanfont/headscale/git/trees/364fafaf217ecfd7911cb1dba2f41857f788dd4f"},"message":"policy/v2: add SaaS goldens for via-grant prefix containment\n\nCaptures from Tailscale SaaS exercising broader, narrower, host\nalias, disjoint, and 4via6 grant destinations against advertised\nsubnet routes. TestGrantsCompat replays them.\n\nUpdates #3267","parents":[{"sha":"783a9aa6da0eea4c221ded27620b63f03598c186","url":"https://api.github.com/repos/juanfont/headscale/git/commits/783a9aa6da0eea4c221ded27620b63f03598c186","html_url":"https://github.com/juanfont/headscale/commit/783a9aa6da0eea4c221ded27620b63f03598c186"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"0423e90193d62e39a9a637dc12753a68e9825634","node_id":"C_kwDOEFLz89oAKDA0MjNlOTAxOTNkNjJlMzlhOWE2MzdkYzEyNzUzYTY4ZTk4MjU2MzQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/0423e90193d62e39a9a637dc12753a68e9825634","html_url":"https://github.com/juanfont/headscale/commit/0423e90193d62e39a9a637dc12753a68e9825634","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-18T09:43:13Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-18T10:34:28Z"},"tree":{"sha":"c4fce46cf4240518ab5c11b1d663a2e64c832144","url":"https://api.github.com/repos/juanfont/headscale/git/trees/c4fce46cf4240518ab5c11b1d663a2e64c832144"},"message":"servertest: cover broader-dst via grant in filter test\n\nTestGrantViaSubnetFilterRules pins exact-equality dst. Add a sibling\nfor the broader-dst case so the regression sits at the server level\nalongside the policy-engine unit test.\n\nUpdates #3267","parents":[{"sha":"99cc1e507e469ec50a884c16f405f855fac3ce31","url":"https://api.github.com/repos/juanfont/headscale/git/commits/99cc1e507e469ec50a884c16f405f855fac3ce31","html_url":"https://github.com/juanfont/headscale/commit/99cc1e507e469ec50a884c16f405f855fac3ce31"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":25652552589,"node_id":"HRFPE_lADOEFLz888AAAABClClOs8AAAAF-QLjjQ","url":"https://api.github.com/repos/juanfont/headscale/issues/events/25652552589","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.githu