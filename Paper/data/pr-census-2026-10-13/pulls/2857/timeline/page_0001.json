ristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-02T00:17:45Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-12T13:02:45Z"},"tree":{"sha":"f9697f836d865725bb70d9c251557344b7b0643f","url":"https://api.github.com/repos/juanfont/headscale/git/trees/f9697f836d865725bb70d9c251557344b7b0643f"},"message":"nix: add NixOS module and tests\n\nAdd a NixOS module under nix/module.nix that provides declarative\nHeadscale configuration with freeform settings support. The module\nautomatically disables the upstream NixOS module to prevent conflicts.\n\nExpose the module through flake.nix as nixosModules.headscale and\nnixosModules.default for easy consumption.\n\nInclude a comprehensive NixOS test that validates service startup,\nclient connectivity, and MagicDNS functionality.\n\nAdd documentation and example configuration to demonstrate usage.","parents":[{"sha":"000d5c3b0c3f91761c326eddae93c404f2676dd1","url":"https://api.github.com/repos/juanfont/headscale/git/commits/000d5c3b0c3f91761c326eddae93c404f2676dd1","html_url":"https://github.com/juanfont/headscale/commit/000d5c3b0c3f91761c326eddae93c404f2676dd1"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgmMAoz5Zf+w0nAxyA6/zsNd95cP\n98YbtHIIXyy9A1sssAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQMhJEjooDl08FxYnNNTyqEihv8A8JUL6eQ6GCywGeGhhcLugENfwsPeG7GHQlXgNHn\ngnpUhCf/vMpE8a4antmAs=\n-----END SSH SIGNATURE-----","payload":"tree f9697f836d865725bb70d9c251557344b7b0643f\nparent 000d5c3b0c3f91761c326eddae93c404f2676dd1\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1762042665 +0100\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1762952565 +0100\n\nnix: add NixOS module and tests\n\nAdd a NixOS module under nix/module.nix that provides declarative\nHeadscale configuration with freeform settings support. The module\nautomatically disables the upstream NixOS module to prevent conflicts.\n\nExpose the module through flake.nix as nixosModules.headscale and\nnixosModules.default for easy consumption.\n\nInclude a comprehensive NixOS test that validates service startup,\nclient connectivity, and MagicDNS functionality.\n\nAdd documentation and example configuration to demonstrate usage.\n","verified_at":"2025-11-12T13:03:18Z"},"event":"committed"},{"sha":"477bbe892984db1f091c61a70555a434788115c2","node_id":"C_kwDOEFLz89oAKDQ3N2JiZTg5Mjk4NGRiMWYwOTFjNjFhNzA1NTVhNDM0Nzg4MTE1YzI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/477bbe892984db1f091c61a70555a434788115c2","html_url":"https://github.com/juanfont/headscale/commit/477bbe892984db1f091c61a70555a434788115c2","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-02T00:26:03Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-12T13:02:45Z"},"tree":{"sha":"1abc2e25ad973a272645393ec6fe8913e8c072ca","url":"https://api.github.com/repos/juanfont/headscale/git/trees/1abc2e25ad973a272645393ec6fe8913e8c072ca"},"message":"ci: add NixOS module test workflow\n\nAdd GitHub Actions workflow to test the NixOS module on changes to\nnix files or Go source code. The workflow:\n\n- Checks module syntax with 'nix flake check'\n- Builds the NixOS integration test\n- Validates module can be imported and evaluated\n- Tests example configuration evaluates correctly\n\nRuns on push to main and pull requests, with change detection to\nskip when neither nix nor Go files are modified.","parents":[{"sha":"43d668c22390b69ea67899c06e5f81c24facd613","url":"https://api.github.com/repos/juanfont/headscale/git/commits/43d668c22390b69ea67899c06e5f81c24facd613","html_url":"https://github.com/juanfont/headscale/commit/43d668c22390b69ea67899c06e5f81c24facd613"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgmMAoz5Zf+w0nAxyA6/zsNd95cP\n98YbtHIIXyy9A1sssAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQOTZB3CsU5Sj1LB/MavWUWuWiNrvLwdqODiPeMPVVVio8zsnMgtBAzklkMcX1YWUWw\nKiLGwwmvFYVH9qHNXkhwk=\n-----END SSH SIGNATURE-----","payload":"tree 1abc2e25ad973a272645393ec6fe8913e8c072ca\nparent 43d668c22390b69ea67899c06e5f81c24facd613\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1762043163 +0100\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1762952565 +0100\n\nci: add NixOS module test workflow\n\nAdd GitHub Actions workflow to test the NixOS module on changes to\nnix files or Go source code. The workflow:\n\n- Checks module syntax with 'nix flake check'\n- Builds the NixOS integration test\n- Validates module can be imported and evaluated\n- Tests example configuration evaluates correctly\n\nRuns on push to main and pull requests, with change detection to\nskip when neither nix nor Go files are modified.\n","verified_at":"2025-11-12T13:03:18Z"},"event":"committed"},{"sha":"02867ce56bce1b0f90eaefc4f42b9a9a436c68a2","node_id":"C_kwDOEFLz89oAKDAyODY3Y2U1NmJjZTFiMGY5MGVhZWZjNGY0MmI5YTlhNDM2YzY4YTI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/02867ce56bce1b0f90eaefc4f42b9a9a436c68a2","html_url":"https://github.com/juanfont/headscale/commit/02867ce56bce1b0f90eaefc4f42b9a9a436c68a2","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-11T16:19:04Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-12T13:02:45Z"},"tree":{"sha":"6b4f54168a9104d3b9e0f4e40948e78cd4dbd033","url":"https://api.github.com/repos/juanfont/headscale/git/trees/6b4f54168a9104d3b9e0f4e40948e78cd4dbd033"},"message":"nix: add readme","parents":[{"sha":"477bbe892984db1f091c61a70555a434788115c2","url":"https://api.github.com/repos/juanfont/headscale/git/commits/477bbe892984db1f091c61a70555a434788115c2","html_url":"https://github.com/juanfont/headscale/commit/477bbe892984db1f091c61a70555a434788115c2"}],"verification":{