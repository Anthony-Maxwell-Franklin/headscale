","events_url":"https://api.github.com/users/vdovhanych/events{/privacy}","received_events_url":"https://api.github.com/users/vdovhanych/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"mentioned","commit_id":null,"commit_url":null,"created_at":"2026-01-20T17:10:21Z","performed_via_github_app":null},{"id":22167230176,"node_id":"SE_lADOEFLz887kj3ZhzwAAAAUpRRbg","url":"https://api.github.com/repos/juanfont/headscale/issues/events/22167230176","actor":{"login":"vdovhanych","id":45185420,"node_id":"MDQ6VXNlcjQ1MTg1NDIw","avatar_url":"https://avatars.githubusercontent.com/u/45185420?v=4","gravatar_id":"","url":"https://api.github.com/users/vdovhanych","html_url":"https://github.com/vdovhanych","followers_url":"https://api.github.com/users/vdovhanych/followers","following_url":"https://api.github.com/users/vdovhanych/following{/other_user}","gists_url":"https://api.github.com/users/vdovhanych/gists{/gist_id}","starred_url":"https://api.github.com/users/vdovhanych/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vdovhanych/subscriptions","organizations_url":"https://api.github.com/users/vdovhanych/orgs","repos_url":"https://api.github.com/users/vdovhanych/repos","events_url":"https://api.github.com/users/vdovhanych/events{/privacy}","received_events_url":"https://api.github.com/users/vdovhanych/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2026-01-20T17:10:21Z","performed_via_github_app":null},{"sha":"c40d547f93e5c46feb0be19c8d000c6bb71b7b66","node_id":"C_kwDOEFLz89oAKGM0MGQ1NDdmOTNlNWM0NmZlYjBiZTE5YzhkMDAwYzZiYjcxYjdiNjY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c40d547f93e5c46feb0be19c8d000c6bb71b7b66","html_url":"https://github.com/juanfont/headscale/commit/c40d547f93e5c46feb0be19c8d000c6bb71b7b66","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-20T16:49:36Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-20T17:10:34Z"},"tree":{"sha":"20bba74d6f1044a5e97964fb143bf93860863766","url":"https://api.github.com/repos/juanfont/headscale/git/trees/20bba74d6f1044a5e97964fb143bf93860863766"},"message":"policy: fix asymmetric peer visibility with autogroup:self\n\nWhen autogroup:self was combined with other ACL rules (e.g., group:admin\n-> *:*), tagged nodes became invisible to users who should have access.\n\nThe BuildPeerMap function had two code paths:\n- Global filter path: used symmetric OR logic (if either can access, both\n  see each other)\n- Autogroup:self path: used asymmetric logic (only add peer if that\n  specific direction has access)\n\nThis caused problems with one-way rules like admin -> tagged-server. The\nadmin could access the server, but since the server couldn't access the\nadmin, neither was added to the other's peer list.\n\nFix by using symmetric visibility in the autogroup:self path, matching\nthe global filter path behavior: if either node can access the other,\nboth should see each other as peers.\n\nCredit: vdovhanych <vdovhanych@users.noreply.github.com>\n\nFixes #2990","parents":[{"sha":"b3c4d0ec81d360bf1ed97ff646824aca402eb3c1","url":"https://api.github.com/repos/juanfont/headscale/git/commits/b3c4d0ec81d360bf1ed97ff646824aca402eb3c1","html_url":"https://github.com/juanfont/headscale/commit/b3c4d0ec81d360bf1ed97ff646824aca402eb3c1"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":22167237477,"node_id":"HRFPE_lADOEFLz887kj3ZhzwAAAAUpRTNl","url":"https://api.github.com/repos/juanfont/headscale/issues/events/22167237477","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"ht