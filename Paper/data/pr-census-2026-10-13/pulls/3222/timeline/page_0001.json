vent":"head_ref_force_pushed","commit_id":"295bb2bb0e7eb5d66be28d6ddd22fec7c80d739d","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/295bb2bb0e7eb5d66be28d6ddd22fec7c80d739d","created_at":"2026-04-29T13:49:02Z","performed_via_github_app":null},{"sha":"ebb03802859a593ff046cd225599ba5645882a3e","node_id":"C_kwDOEFLz89oAKGViYjAzODAyODU5YTU5M2ZmMDQ2Y2QyMjU1OTliYTU2NDU4ODJhM2U","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ebb03802859a593ff046cd225599ba5645882a3e","html_url":"https://github.com/juanfont/headscale/commit/ebb03802859a593ff046cd225599ba5645882a3e","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-28T11:12:26Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-30T11:53:20Z"},"tree":{"sha":"69b9160d15de10fb5b3152c3c7ded874560027bf","url":"https://api.github.com/repos/juanfont/headscale/git/trees/69b9160d15de10fb5b3152c3c7ded874560027bf"},"message":".github: collapse CODEOWNERS to single rule\n\nDrop per-glob ownership rules. One rule covers everything: maintainers\nown the repo, no need to enumerate paths.","parents":[{"sha":"ecaf56e0a0b2717779b96e1f8300c60587461387","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ecaf56e0a0b2717779b96e1f8300c60587461387","html_url":"https://github.com/juanfont/headscale/commit/ecaf56e0a0b2717779b96e1f8300c60587461387"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"56704d28097e7dfe72775d1d4985433eb8402ec2","node_id":"C_kwDOEFLz89oAKDU2NzA0ZDI4MDk3ZTdkZmU3Mjc3NWQxZDQ5ODU0MzNlYjg0MDJlYzI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/56704d28097e7dfe72775d1d4985433eb8402ec2","html_url":"https://github.com/juanfont/headscale/commit/56704d28097e7dfe72775d1d4985433eb8402ec2","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-28T11:12:36Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-30T11:53:20Z"},"tree":{"sha":"d5c31972efaa7eadf33ca1f93b95627407641803","url":"https://api.github.com/repos/juanfont/headscale/git/trees/d5c31972efaa7eadf33ca1f93b95627407641803"},"message":".github: gate pull requests via vouch\n\nAdopt mitchellh/vouch to gate PRs on a curated allow-list. Issues stay\nopen to everyone — the vouching flow follows our existing\n\"Open Source, acknowledged contribution\" policy: discuss first on the\nissue tracker, get vouched, then submit code.\n\nWorkflows:\n  - vouch-check-pr: auto-close PRs from unvouched authors with a\n    pointer to CONTRIBUTING.md and the !vouch flow\n  - vouch-manage-by-issue: !vouch / !denounce / !unvouch keywords on\n    issue/PR comments from collaborators\n  - vouch-sync-codeowners: weekly sync so CODEOWNERS stay vouched\n\nVOUCHED.td seeded with past PR contributors (merged code) and authors\nof high-quality issues. Authors with currently-open low-signal PRs\nwere intentionally omitted — maintainers can !vouch them later.\n\nWorkflows require a VOUCH_APP_ID / VOUCH_APP_PRIVATE_KEY GitHub App\nsecret pair to commit list updates and close PRs.","parents":[{"sha":"ebb03802859a593ff046cd225599ba5645882a3e","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ebb03802859a593ff046cd225599ba5645882a3e","html_url":"https://github.com/juanfont/headscale/commit/ebb03802859a593ff046cd225599ba5645882a3e"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":25032260921,"node_id":"HRFPE_lADOEFLz888AAAABAti4y88AAAAF1An9OQ","url":"https://api.github.com/repos/juanfont/headscale/issues/events/25032260921","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.gi