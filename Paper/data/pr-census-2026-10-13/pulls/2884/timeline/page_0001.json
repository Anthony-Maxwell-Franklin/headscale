[{"sha":"67051aceaf3e1ef347b935e17aaaf9ad56d7f19e","node_id":"C_kwDOEFLz89oAKDY3MDUxYWNlYWYzZTFlZjM0N2I5MzVlMTdhYWFmOWFkNTZkN2YxOWU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/67051aceaf3e1ef347b935e17aaaf9ad56d7f19e","html_url":"https://github.com/juanfont/headscale/commit/67051aceaf3e1ef347b935e17aaaf9ad56d7f19e","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-13T14:49:27Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-13T14:49:27Z"},"tree":{"sha":"76b8eb2ad97bd7485b4104f31d9b2a035f587a11","url":"https://api.github.com/repos/juanfont/headscale/git/trees/76b8eb2ad97bd7485b4104f31d9b2a035f587a11"},"message":"db: remove _schema from migration tests\n\nPreviously we tested migrations on schemas and dumps\nof old databases.\n\nThe problems with testing migrations against the schemas\nis that the migration table is empty, so we try to run\nmigrations that are already ran on that schema, which might\nblow up.\n\nThis commit removes the schema approach and just leaves all\nthe dumps, which include the migration table.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>","parents":[{"sha":"249630bed8001e3ec634b8c3578ba6d6308616d3","url":"https://api.github.com/repos/juanfont/headscale/git/commits/249630bed8001e3ec634b8c3578ba6d6308616d3","html_url":"https://github.com/juanfont/headscale/commit/249630bed8001e3ec634b8c3578ba6d6308616d3"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgmMAoz5Zf+w0nAxyA6/zsNd95cP\n98YbtHIIXyy9A1sssAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQMmZ/i0newU/dvDQ+KV0B1n50ZRc0PWpKzghHF3RAwQBenu71kwjNJSEGHB4eGxD6M\nBpnr7bFOL9lRYt58PeIgA=\n-----END SSH SIGNATURE-----","payload":"tree 76b8eb2ad97bd7485b4104f31d9b2a035f587a11\nparent 249630bed8001e3ec634b8c3578ba6d6308616d3\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1763045367 +0100\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1763045367 +0100\n\ndb: remove _schema from migration tests\n\nPreviously we tested migrations on schemas and dumps\nof old databases.\n\nThe problems with testing migrations against the schemas\nis that the migration table is empty, so we try to run\nmigrations that are already ran on that schema, which might\nblow up.\n\nThis commit removes the schema approach and just leaves all\nthe dumps, which include the migration table.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>\n","verified_at":"2025-11-13T15:08:07Z"},"event":"committed"},{"sha":"a67ee6644332ef162e91c5d547322409b54daa14","node_id":"C_kwDOEFLz89oAKGE2N2VlNjY0NDMzMmVmMTYyZTkxYzVkNTQ3MzIyNDA5YjU0ZGFhMTQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a67ee6644332ef162e91c5d547322409b54daa14","html_url":"https://github.com/juanfont/headscale/commit/a67ee6644332ef162e91c5d547322409b54daa14","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-13T14:53:48Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-13T14:53:48Z"},"tree":{"sha":"2f8eb4b829097ed16ab40d978199fa49fa94b63e","url":"https://api.github.com/repos/juanfont/headscale/git/trees/2f8eb4b829097ed16ab40d978199fa49fa94b63e"},"message":"db: add comment to always check errors in migration\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>","parents":[{"sha":"67051aceaf3e1ef347b935e17aaaf9ad56d7f19e","url":"https://api.github.com/repos/juanfont/headscale/git/commits/67051aceaf3e1ef347b935e17aaaf9ad56d7f19e","html_url":"https://github.com/juanfont/headscale/commit/67051aceaf3e1ef347b935e17aaaf9ad56d7f19e"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgmMAoz5Zf+w0nAxyA6/zsNd95cP\n98YbtHIIXyy9A1sssAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQILU/pipiuvCaUKrZ7lwfprQ7E2U9Un2