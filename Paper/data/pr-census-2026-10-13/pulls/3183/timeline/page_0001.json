:55:55Z","performed_via_github_app":null},{"id":24451379730,"node_id":"HRFPE_lADOEFLz8878riXozwAAAAWxanIS","url":"https://api.github.com/repos/juanfont/headscale/issues/events/24451379730","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"4e786079603c7fe26983de44bf297f2e40faabce","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/4e786079603c7fe26983de44bf297f2e40faabce","created_at":"2026-04-13T15:05:54Z","performed_via_github_app":null},{"sha":"111a44a9ca4b95ef376bd14d18deb5bcec683883","node_id":"C_kwDOEFLz89oAKDExMWE0NGE5Y2E0Yjk1ZWYzNzZiZDE0ZDE4ZGViNWJjZWM2ODM4ODM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/111a44a9ca4b95ef376bd14d18deb5bcec683883","html_url":"https://github.com/juanfont/headscale/commit/111a44a9ca4b95ef376bd14d18deb5bcec683883","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-10T12:46:19Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-15T08:30:12Z"},"tree":{"sha":"f98b2a127aac36817ccf0237ab7a76630095b8d7","url":"https://api.github.com/repos/juanfont/headscale/git/trees/f98b2a127aac36817ccf0237ab7a76630095b8d7"},"message":"all: implement PingRequest for node connectivity checking\n\nImplement tailcfg.PingRequest support so the control server can verify\nwhether a connected node is still reachable. This is the foundation for\nfaster offline detection (currently ~16min due to Go HTTP/2 TCP retransmit\nbehavior) and future C2N communication.\n\nThe server sends a PingRequest via MapResponse with a unique callback\nURL. The Tailscale client responds with a HEAD request to that URL,\nproving connectivity. Round-trip latency is measured.\n\nWire PingRequest through the Change → Batcher → MapResponse pipeline,\nadd a ping tracker on State for correlating requests with responses,\nadd ResolveNode for looking up nodes by ID/IP/hostname, and expose a\n/debug/ping page (elem-go form UI) and /machine/ping-response endpoint.\n\nUpdates #2902\nUpdates #2129","parents":[{"sha":"32e1d77663e50ec607e512640d281857ce5fb3c8","url":"https://api.github.com/repos/juanfont/headscale/git/commits/32e1d77663e50ec607e512640d281857ce5fb3c8","html_url":"https://github.com/juanfont/headscale/commit/32e1d77663e50ec607e512640d281857ce5fb3c8"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"c7633803f99040a04cefcd54c3c80cba950e3d6f","node_id":"C_kwDOEFLz89oAKGM3NjMzODAzZjk5MDQwYTA0Y2VmY2Q1NGMzYzgwY2JhOTUwZTNkNmY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c7633803f99040a04cefcd54c3c80cba950e3d6f","html_url":"https://github.com/juanfont/headscale/commit/c7633803f99040a04cefcd54c3c80cba950e3d6f","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-10T12:46:33Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-15T08:30:12Z"},"tree":{"sha":"1d8130f77ea54a9d2103f10485b6b66017a760ff","url":"https://api.github.com/repos/juanfont/headscale/git/trees/1d8130f77ea54a9d2103f10485b6b66017a760ff"},"message":"all: add tests for PingRequest implementation\n\nUnit tests for Change (IsEmpty, Merge, Type, PingNode constructor),\nping tracker (register/complete/cancel lifecycle, concurrency, latency),\nand end-to-end servertests exercising the full round-trip with real\ncontrolclient.Direct instances.\n\nUpdates #2902\nUpdates #2129","parents":[{"sha":"111a44a9ca4b95ef376bd14d18deb5bcec683883","url":"https://api.github.com/repos/juanfont/headscale/git/commits/111a44a9ca4b95ef376bd14d18deb5bcec683883","html_url":"https://github.com/juanfont/headscale/commit/111a44a9ca4b95ef376bd14d18deb5bcec683883"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"4080e69a9aa0650e998eba0013b745830d805727","node_id":"C_kwDOEFLz89oAKDQwODBlNjlhOWFhMDY1MGU5OThlYmEwMDEzYjc0NTgzMGQ4MDU3Mjc","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4080e69a9aa0650e998eba0013b745830d805727","html_url":"https://github.com/juanfont/headscale/commit/4080e69a9aa0650e998eba0013b745830d805727","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-10T14:23:21Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-15T08:30:12Z"},"tree":{"sha":"370e73b86a2ac3860088e24baefb669ca560fedd","url":"https://api.github.com/repos/juanfont/headscale/git/trees/370e73b86a2ac3860088e24baefb669ca560fedd"},"message":"go.mod: add tstest/mts tool dependency","parents":[{"sha":"c7633803f99040a04cefcd54c3c80cba950e3d6f","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c7633803f99040a04cefcd54c3c80cba950e3d6f","html_url":"https://github.com/juanfont/headscale/commit/c7633803f99040a04cefcd54c3c80cba950e3d6f"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"a2bafd37600946b9dfa45fab1d197ddcc137a084","node_id":"C_kwDOEFLz89oAKGEyYmFmZDM3NjAwOTQ2YjlkZmE0NWZhYjFkMTk3ZGRjYzEzN2EwODQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a2bafd37600946b9dfa45fab1d197ddcc137a084","html_url":"https://github.com/juanfont/headscale/commit/a2bafd37600946b9dfa45fab1d197ddcc137a084","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-13T12:41:04Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-15T08:30:12Z"},"tree":{"sha":"3ddf3d5a2b5267a6b53bfa67cdecdbd5e76c4e16","url":"https://api.github.com/repos/juanfont/headscale/git/trees/3ddf3d5a2b5267a6b53bfa67cdecdbd5e76c4e16"},"message":"cmd/dev: add local development server tool\n\nAdd a lightweight dev tool that starts a headscale server on localhost\nwith a pre-created user and pre-auth key, ready for connecting real\ntailscale nodes via mts.\n\nThe tool builds the headscale binary, writes a minimal dev config\n(SQLite, public DERP, debug logging), starts the server as a\nsubprocess, and prints a banner with the server URL, auth key, and\nmts usage instructions.\n\nUsage: go run ./cmd/dev\n       make dev-server","parents":[{"sha":"4080e69a9aa0650e998eba0013b745830d805727","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4080e69a9aa0650e998eba0013b745830d805727","html_url":"https://github.com/juanfont/headscale/commit/4080e69a9aa0650e998eba0013b745830d805727"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"e012399ad33092e2a2dadd7f6fbbc6753575ca7f","node_id":"C_kwDOEFLz89oAKGUwMTIzOTlhZDMzMDkyZTJhMmRhZGQ3ZjZmYmJjNjc1MzU3NWNhN2Y","url":"https://api.github.com/repos/juanfont/headscale/git/commits/e012399ad33092e2a2dadd7f6fbbc6753575ca7f","html_url":"https://github.com/juanfont/headscale/commit/e012399ad33092e2a2dadd7f6fbbc6753575ca7f","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-15T08:34:08Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-15T08:34:08Z"},"tree":{"sha":"3cd38f239caf7968a529b7b742481d225e0921fb","url":"https://api.github.com/repos/juanfont/headscale/git/trees/3cd38f239caf7968a529b7b742481d225e0921fb"},"message":"templates: add detailsBox collapsible component\n\nAdd a reusable <details>/<summary> component to the shared design\nsystem. Styled to match the existing card/box component family\n(border, radius, CSS variables for dark mode).\n\nCollapsed by default with a clickable summary line.","parents":[{"sha":"a2bafd37600946b9dfa45fab1d197ddcc137a084","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a2bafd37600946b9dfa45fab1d197ddcc137a084","html_url":"https://github.com/juanfont/headscale/commit/a2bafd37600946b9dfa45fab1d197ddcc137a084"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":24520370101,"node_id":"HRFPE_lADOEFLz8878riXozwAAAAW1hye1","url":"https://api.github.com/repos/juanfont/headscale/issues/events/24520370101","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"even