T08:05:36Z","author_association":"COLLABORATOR","event":"reviewed"},{"id":28425109611,"node_id":"MIE_lADOEFLz888AAAABI93CDM8AAAAGnkTAaw","url":"https://api.github.com/repos/juanfont/headscale/issues/events/28425109611","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"milestoned","commit_id":null,"commit_url":null,"created_at":"2026-07-24T08:06:23Z","milestone":{"title":"v0.29.0"},"performed_via_github_app":null},{"sha":"16a496429ac28a657326e76ebb30d3d013c351d4","node_id":"C_kwDOEFLz89oAKDE2YTQ5NjQyOWFjMjhhNjU3MzI2ZTc2ZWJiMzBkM2QwMTNjMzUxZDQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/16a496429ac28a657326e76ebb30d3d013c351d4","html_url":"https://github.com/juanfont/headscale/commit/16a496429ac28a657326e76ebb30d3d013c351d4","author":{"name":"Igor Serganov","email":"iserganov@tunein.com","date":"2026-07-24T21:15:54Z"},"committer":{"name":"Igor Serganov","email":"iserganov@tunein.com","date":"2026-07-24T21:15:54Z"},"tree":{"sha":"8920ccbc7e8d67a416c47c017b605ef1bd594203","url":"https://api.github.com/repos/juanfont/headscale/git/trees/8920ccbc7e8d67a416c47c017b605ef1bd594203"},"message":"poll: do not cancel ephemeral GC until Connect succeeds\n\nWith node.ephemeral.inactivity_timeout set, ephemeral nodes are\nusually deleted after they go offline, but under reconnect churn some\ndeparted nodes stayed in the node list as disconnected indefinitely\nuntil removed manually or until Headscale restarted.\n\nEphemeral cleanup is timer-based via EphemeralGarbageCollector, not a\nperiodic LastSeen scan. serveLongPoll cancelled any pending GC timer\nat the very start of a long-poll attempt and only rescheduled on a\nclean disconnect after Connect. If a reconnect cancelled the timer and\nthen failed before Connect (for example an UpdateNodeFromMapRequest\nerror), the deferred cleanup saw connectGen == 0 and returned without\nSchedule. The node remained offline with no deletion timer and no\nreconciler to recover it.\n\nCancel the ephemeral GC timer only after a successful Connect, so a\nfailed reconnect leaves an already-armed inactivity timer intact.\nSuccessful reconnects still cancel GC once the node is online, and a\nlater disconnect reschedules as before.\n\nAdd TestFailedReconnectDoesNotCancelEphemeralGC to lock in the\nordering, plus IsScheduled and DeleteNodeFromStoreForTest helpers for\nthe test.\n\nFixes #3382\n\nCo-authored-by: Cursor <cursoragent@cursor.com>","parents":[{"sha":"048308511c72fa77da103e932f9b857a6e5247b9","url":"https://api.github.com/repos/juanfont/headscale/git/commits/048308511c72fa77da103e932f9b857a6e5247b9","html_url":"https://github.com/juanfont/headscale/commit/048308511c72fa77da103e932f9b857a6e5247b9"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":28457076722,"node_id":"HRFPE_lADOEFLz888AAAABI93CDM8AAAAGoCyH8g","url":"https://api.github.com/repos/juanfont/headscale/issues/events/28457076722","actor":{"login":"iSerganov","id":41109559,"node_id":"MDQ6VXNlcjQxMTA5NTU5","avatar_url":"https://avatars.githubusercontent.com/u/41109