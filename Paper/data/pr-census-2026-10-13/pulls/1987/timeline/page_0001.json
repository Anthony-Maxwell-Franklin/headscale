m/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"5ef10ca7eafd2050f7deec6935d39aeba1dc8887","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/5ef10ca7eafd2050f7deec6935d39aeba1dc8887","created_at":"2024-06-20T10:16:22Z","performed_via_github_app":null},{"sha":"2070126c652a0b3be89a6c3d23bdd20c8b4082bf","node_id":"C_kwDOEFLz89oAKDIwNzAxMjZjNjUyYTBiM2JlODlhNmMzZDIzYmRkMjBjOGI0MDgyYmY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/2070126c652a0b3be89a6c3d23bdd20c8b4082bf","html_url":"https://github.com/juanfont/headscale/commit/2070126c652a0b3be89a6c3d23bdd20c8b4082bf","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2024-06-20T08:39:13Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2024-06-21T12:07:46Z"},"tree":{"sha":"f742a5ddea4e127ee9be9a7f723c90d9951386d8","url":"https://api.github.com/repos/juanfont/headscale/git/trees/f742a5ddea4e127ee9be9a7f723c90d9951386d8"},"message":"fix issue where search domains are ignored\n\nThis commit fixes an issue where search domains was ignored\nif the user has not configured any external resolvers. Based\non tailscale's documentation, there is no mention of this\nbehaviour as far as I can see:\nhttps://tailscale.com/kb/1054/dns#search-domains\n\nIn addition, it does add the missing base domain to the\nsearch domain.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>","parents":[{"sha":"dfc089ed6a5c116f3c8dff17f97a68822468fd2c","url":"https://api.github.com/repos/juanfont/headscale/git/commits/dfc089ed6a5c116f3c8dff17f97a68822468fd2c","html_url":"https://github.com/juanfont/headscale/commit/dfc089ed6a5c116f3c8dff17f97a68822468fd2c"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAAGgAAAATZWNkc2Etc2hhMi1uaXN0cDI1NgAAAAhuaXN0cDI1NgAAAE\nEE6bT6+U8pNExCb214X9sKtM8QMSqzWb4HmQxm24sqHasMtgza7Cws+M2NoiUVB+RSfa/I\nCoai/Io5VHtD9nbzKgAAAANnaXQAAAAAAAAABnNoYTUxMgAAAGUAAAATZWNkc2Etc2hhMi\n1uaXN0cDI1NgAAAEoAAAAhAPZ4sRFaXdGtQZncTTNDVetoUXWFNWp+QXwnvlciJoChAAAA\nIQC3CysnqukI+d30F2Id/mTQXZyD8clV4M6xhwIWnmAZdg==\n-----END SSH SIGNATURE-----","payload":"tree f742a5ddea4e127ee9be9a7f723c90d9951386d8\nparent dfc089ed6a5c116f3c8dff17f97a68822468fd2c\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1718872753 +0200\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1718971666 +0200\n\nfix issue where search domains are ignored\n\nThis commit fixes an issue where search domains was ignored\nif the user has not configured any external resolvers. Based\non tailscale's documentation, there is no mention of this\nbehaviour as far as I can see:\nhttps://tailscale.com/kb/1054/dns#search-domains\n\nIn addition, it does add the missing base domain to the\nsearch domain.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>\n","verified_at":"2024-11-23T02:27:31Z"},"event":"committed"},{"sha":"8dfa1d3da81ba6ad44a87989137a579f67b8eef1","node_id":"C_kwDOEFLz89oAKDhkZmExZDNkYTgxYmE2YWQ0NGE4Nzk4OTEzN2E1NzlmNjdiOGVlZjE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8dfa1d3da81ba6ad44a87989137a579f67b8eef1","html_url":"https://github.com/juanfont/headscale/commit/8dfa1d3da81ba6ad44a87989137a579f67b8eef1","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2024-06-20T08:45:23Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2024-06-21T12:07:46Z"},"tree":{"sha":"50ece56724328b9c70318a65eaec1b9007b096e0","url":"https://api.github.com/repos/juanfont/headscale/git/trees/50ece56724328b9c70318a65eaec1b9007b096e0"},"message":"remove username from magicdns names\n\nThis commit removes the username from magicDNS names.\nThis is in preparation of fixing tags, which currently is\nnot correctly disassociated from users when added. With the\ncurrent behaviour, fixing tagged devices would break the\nMagicDNS behaviour.\n\nThis brings headscale to use the same behaviour of tailscale.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>","parents":[{"sha":"2070126c652a0b3be89a6c3d23bdd20c8b4082bf","url":"https://api.github.com/repos/juanfont/headscale/git/commits/2070126c652a0b3be89a6c3d23bdd20c8b4082bf","html_url":"https://github.com/juanfont/headscale/commit/2070126c652a0b3be89a6c3d23bdd20c8b4082bf"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAAGgAAAATZWNkc2Etc2hhMi1uaXN0cDI1NgAAAAhuaXN0cDI1NgAAAE\nEE6bT6+U8pNExCb214X9sKtM8QMSqzWb4HmQxm24sqHasMtgza7Cws+M2NoiUVB+RSfa/I\nCoai/Io5VHtD9nbzKgAAAANnaXQAAAAAAAAABnNoYTUxMgAAAGQAAAATZWNkc2Etc2hhMi\n1uaXN0cDI1NgAAAEkAAAAgDi3/WC93D9PkUwEI5LBRNz3hOBgCWzltwYK5pUlFglwAAAAh\nAIWv9v2ztl0AyIUmqSgthIhykUhDsYA3bA3JNLn+xxCs\n-----END SSH SIGNATURE-----","payload":"tree 50ece56724328b9c70318a65eaec1b9007b096e0\nparent 2070126c652a0b3be89a6c3d23bdd20c8b4082bf\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1718873123 +0200\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1718971666 +0200\n\nremove username from magicdns names\n\nThis commit removes the username from magicDNS names.\nThis is in preparation of fixing tags, which currently is\nnot correctly disassociated from users when added. With the\ncurrent behaviour, fixing tagged devices would break the\nMagicDNS behaviour.\n\nThis brings headscale to use the same behaviour of tailscale.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>\n","verified_at":"2024-11-23T02:27:31Z"},"event":"committed"},{"id":13241771109,"node_id":"HRFPE_lADOEFLz886M53wuzwAAAAMVRWRl","url":"https://api.github.com/repos/juanfont/headscale/issues/events/13241771109","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"8dfa1d3da81ba6ad44a87989137a579f67b8eef1","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/8dfa1d3da81ba6ad44a87989137a579f67b8eef1","created_at":"2024-06-21T12:07:58Z","performed_via_github_app":null},{"id":2141050211,"node_id":"PRR_kwDOEFLz885_ndVj","user":{"login":"juanfont","id":181059,"node_id":"MDQ6VXNlcjE4MTA1OQ==","avatar_url":"https://avatars.githubusercontent.com/u/181059?v=4","gravatar_id":"","url":"https://api.github.com/users/juanfont","html_url":"https://github.com/juanfont","followers_url":"https://api.github.com/users/juanfont/followers","following_url":"https://api.github.com/users/juanfont/follo