[{"sha":"41eb25d5c4f0d4a490df5a797622559f2d294b74","node_id":"C_kwDOEFLz89oAKDQxZWIyNWQ1YzRmMGQ0YTQ5MGRmNWE3OTc2MjI1NTlmMmQyOTRiNzQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/41eb25d5c4f0d4a490df5a797622559f2d294b74","html_url":"https://github.com/juanfont/headscale/commit/41eb25d5c4f0d4a490df5a797622559f2d294b74","author":{"name":"Igor Serganov","email":"iserganov@tunein.com","date":"2026-09-23T17:49:56Z"},"committer":{"name":"Igor Serganov","email":"iserganov@tunein.com","date":"2026-09-23T17:49:56Z"},"tree":{"sha":"c803a6f11eda5a6e64be97e0dd310f126a396ddc","url":"https://api.github.com/repos/juanfont/headscale/git/trees/c803a6f11eda5a6e64be97e0dd310f126a396ddc"},"message":"db: guard argon2 verification against corrupt hash parameters\n\n`verifySecret` read `time/memory/threads` straight out of the stored PHC string and passed them to argon2.IDKey unchecked. A row written as `m=0,t=0,p=0` parsed cleanly and then panicked inside `argon2.IDKey`, permanently burning a slot from the argon2Limiter semaphore since the release wasn't deferred; enough corrupt rows would deadlock all OAuth authentication. A row with a very large `m=` could also drive an unbounded allocation.\n\nValidate time, threads and memory against zero and a new `argon2MaxMemory` ceiling before calling `argon2.IDKey`, and release the semaphore slot with defer so a panic can't leak it.","parents":[{"sha":"0661c6f540aa507c28d44cc9b0e287805b99c789","url":"https://api.github.com/repos/juanfont/headscale/git/commits/0661c6f540aa507c28d44cc9b0e287805b99c789","html_url":"https://github.com/juanfont/headscale/commit/0661c6f540aa507c28d44cc9b0e287805b99c789"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":31697338531,"node_id":"RRE_lADOEFLz888AAAABSz2wDs8AAAAHYU8Aow","url":"https://api.github.com/repos/juanfont/headscale/issues/events/31697338531","actor":{"login":"iSerganov","id":41109559,"node_id":"