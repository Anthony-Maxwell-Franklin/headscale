/b90c740cb44abba96f1065f0f8f889585e358ce3","html_url":"https://github.com/juanfont/headscale/commit/b90c740cb44abba96f1065f0f8f889585e358ce3","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2024-02-17T12:50:26Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2024-02-17T13:09:50Z"},"tree":{"sha":"15cc934700546f7aa5a53483348aa93cff12cd23","url":"https://api.github.com/repos/juanfont/headscale/git/trees/15cc934700546f7aa5a53483348aa93cff12cd23"},"message":"introduce dedicated ip allocator\n\nThis new allocator keeps the used space in memory and\nloads the database only on startup. If it allocates but\nsomething errors before it gets saved to the database,\nthen thats fine because it will be cleared on next restart.\n\nThis should resolve races between ip allocation with postgres\nand as a side effect should make it easier to implement random\nallocation instead of serial if we so desire.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>","parents":[{"sha":"b60ee9db54ce49827a6752df05444ddaa63393a0","url":"https://api.github.com/repos/juanfont/headscale/git/commits/b60ee9db54ce49827a6752df05444ddaa63393a0","html_url":"https://github.com/juanfont/headscale/commit/b60ee9db54ce49827a6752df05444ddaa63393a0"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAAGgAAAATZWNkc2Etc2hhMi1uaXN0cDI1NgAAAAhuaXN0cDI1NgAAAE\nEE6bT6+U8pNExCb214X9sKtM8QMSqzWb4HmQxm24sqHasMtgza7Cws+M2NoiUVB+RSfa/I\nCoai/Io5VHtD9nbzKgAAAANnaXQAAAAAAAAABnNoYTUxMgAAAGQAAAATZWNkc2Etc2hhMi\n1uaXN0cDI1NgAAAEkAAAAhAMtsQB2DU3F0GwmBNxVrfPPnKMxgdKFzQLRR0yCa+Aq8AAAA\nIDPJnqwp10iJXl5U9iMaLbl91X1GGYJqPemFzjBkEQ1z\n-----END SSH SIGNATURE-----","payload":"tree 15cc934700546f7aa5a53483348aa93cff12cd23\nparent b60ee9db54ce49827a6752df05444ddaa63393a0\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1708174226 +0100\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1708175390 +0100\n\nintroduce dedicated ip allocator\n\nThis new allocator keeps the used space in memory and\nloads the database only on startup. If it allocates but\nsomething errors before it gets saved to the database,\nthen thats fine because it will be cleared on next restart.\n\nThis should resolve races between ip allocation with postgres\nand as a side effect should make it easier to implement random\nallocation instead of serial if we so desire.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>\n","verified_at":"2024-11-08T22:41:43Z"},"event":"committed"},{"id":11836368123,"node_id":"HRFPE_lADOEFLz885_XJm_zwAAAALBgKT7","url":"https://api.github.com/repos/juanfont/headscale/issues/events/11836368123","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"9f91990d452baad8999ba32fe9ce7831ae8359bf","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/9f91990d452baad8999ba32fe9ce7831ae8359bf","created_at":"2024-02-17T13:11:26Z","performed_via_github_app":null},{"id":11836368493,"node_id":"RTE_lADOEFLz885_XJm_zwAAAALBgKZt","url":"https://api.gi