1e4dbbd96e7f7","created_at":"2025-09-22T13:54:13Z","performed_via_github_app":null},{"id":3279283357,"node_id":"PRR_kwDOEFLz887DdeSd","user":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"two docs nits, otherwise looks very good","commit_id":"80fe04971dec4fb433c75eff7801e4dbbd96e7f7","state":"approved","html_url":"https://github.com/juanfont/headscale/pull/2773#pullrequestreview-3279283357","pull_request_url":"https://api.github.com/repos/juanfont/headscale/pulls/2773","_links":{"html":{"href":"https://github.com/juanfont/headscale/pull/2773#pullrequestreview-3279283357"},"pull_request":{"href":"https://api.github.com/repos/juanfont/headscale/pulls/2773"}},"submitted_at":"2025-09-29T11:41:56Z","updated_at":"2025-09-29T11:41:56Z","author_association":"COLLABORATOR","event":"reviewed"},{"sha":"f1213760f88a1247984af42758e741c89b737368","node_id":"C_kwDOEFLz89oAKGYxMjEzNzYwZjg4YTEyNDc5ODRhZjQyNzU4ZTc0MWM4OWI3MzczNjg","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f1213760f88a1247984af42758e741c89b737368","html_url":"https://github.com/juanfont/headscale/commit/f1213760f88a1247984af42758e741c89b737368","author":{"name":"Andrey Bobelev","email":"andrey@bobelev.com","date":"2025-08-29T13:55:42Z"},"committer":{"name":"Andrey Bobelev","email":"andrey@bobelev.com","date":"2025-10-06T07:08:55Z"},"tree":{"sha":"88bf6fccb40ac9c235b80d73e8356ca7a587d235","url":"https://api.github.com/repos/juanfont/headscale/git/trees/88bf6fccb40ac9c235b80d73e8356ca7a587d235"},"message":"fix: return valid AuthUrl in followup request on expired reg id\n\n- tailscale client gets a new AuthUrl and sets entry in the regcache\n- regcache entry expires\n- client doesn't know about that\n- client always polls followup request а gets error\n\nWhen user clicks \"Login\" in the app (after cache expiry), they visit\ninvalid URL and get \"node not found in registration cache\". Some clients\non Windows for e.g. can't get a new AuthUrl without restart the app.\n\nTo fix that we can issue a new reg id and return user a new valid\nAuthUrl.\n\nRegisterNode is refactored to be created with NewRegisterNode() to\nautocreate channel and other stuff.","parents":[{"sha":"2dfba3d2ccfea1e65ed7ceecfd289b6cf29d2ed7","url":"https://api.github.com/repos/juanfont/headscale/git/commits/2dfba3d2ccfea1e65ed7ceecfd289b6cf29d2ed7","html_url":"https://github.com/juanfont/headscale/commit/2dfba3d2ccfea1e65ed7ceecfd289b6cf29d2ed7"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niQIzBAABCAAdFiEETsg2zODHWfdLQs6Li8B/uf6u72MFAmjjawgACgkQi8B/uf6u\n72MqZxAAp6u27c0ZRBIQE6t69DnBWx2b98X95O+RX93F/tC6lIXiM+seEFqf0wHY\n+G/B2iNXu8bjPcqC6s9ExFyiPbEuFQ33+k8I1SpWQZ4stccfvNDgTn/8IQOPy/L0\nK7E7oiJa8nfBlXjYAWhoLc4gUgX2rZgnDD7u8pcYToJqNDTTp/aARD19OCuFOHRf\nkEbS63cfIsGgccxXWeAW3CCbQiAIoyS059qleaDG4ycponXEKPI+M0wMyq7j/L8d\nQ4U+/9ELwDFXG4fl9ogBxq1BD4V1KzBmurQdKBsKPqpSALDdcMoRlLbjfd2Rxoaf\nuu+xIYCs4MRT62tJsf2lH/Rox8dRA/gA56S5tEap3O1A5bwv/DIWO11AffocqHMG\nnfh8Dd1aGUs1IwB6UZmoGAFluEixCH8DbI2kS9C6OismK624yQsGon8NV2eD/qnl\nLFtpR0N65s7AB7aOFsryiZxChF+DkjNLE5BNqAqiBd8H4CTChD6LG81gelUXDQLX\nLKCT0wjCLWwv7uSv/9/A6/pj5S0kI6is/5qDAnxABXpTKvvTk7ctElMqpJuIm+2W\nHIFtadGuge1nxCjHpwIdOe3zJNCl/lx92jzsHNDm6XzjBsWl0MdkcaKvZOJhcslr\nb/mDS5kp+OH4hdxzCxDJAZgQ/zmev3sIiTqRDtidRb9VtCtgUrw=\n=jFWO\n-----END PGP SIGNATURE-----","payload":"tree 88bf6fccb40ac9c235b80d73e8356ca7a587d235\nparent 2dfba3d2ccfea1e65ed7ceecfd289b6cf29d2ed7\nauthor Andrey Bobelev <andrey@bobelev.com> 1756475742 +0200\ncommitter Andrey Bobelev <andrey@bobelev.com> 1759734535 +0300\n\nfix: return valid AuthUrl in followup request on expired reg id\n\n- tailscale client gets a new AuthUrl and sets entry in the regcache\n- regcache entry expires\n- client doesn't know about that\n- client always polls followup request а gets error\n\nWhen user clicks \"Login\" in the app (after cache expiry), they visit\ninvalid URL and get \"node not found in registration cache\". Some clients\non Windows for e.g. can't get a new AuthUrl without restart the app.\n\nTo fix that we can issue a new reg id and return user a new valid\nAuthUrl.\n\nRegisterNode is refactored to be created with NewRegisterNode() to\nautocreate channel and other stuff.\n","verified_at":"2025-10-06T07:09:17Z"},"event":"committed"},{"id":20107659850,"node_id":"HRFPE_lADOEFLz887LAuanzwAAAASugopK","url":"https://api.github.com/repos/juanfont/headscale/issues/events/20107659850","actor":{"login":"bobelev","id":3942342,"node_id":"MDQ6VXNlcjM5NDIzNDI=","avatar_url":"https://avatars.githubusercontent.com/u/3942342?v=4","gravatar_id":"","url":"https://api.github.com/users/bobelev","html_url":"https://github.com/bobelev","followers_url":"https://api.github.com/users/bobelev/followers","following_url":"https://api.github.com/users/bobelev/following{/other_user}","gists_url":"https://api.github.com/users/bobelev/gists{/gist_id}","starred_url":"https://api.github.com/users/bobelev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bobelev/subscriptions","organizations_url":"https://api.github.com/users/bobelev/orgs","repos_url":