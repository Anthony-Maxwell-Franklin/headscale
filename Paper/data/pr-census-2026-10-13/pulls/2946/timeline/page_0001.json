yOThlZTdlYzE4MDEyY2RlYzdhYjgxN2U3M2RlMjE1NDQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/adeb705298ee7ec18012cdec7ab817e73de21544","html_url":"https://github.com/juanfont/headscale/commit/adeb705298ee7ec18012cdec7ab817e73de21544","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2025-12-07T12:45:02Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-12-10T16:36:34Z"},"tree":{"sha":"afc355df6818b9fd72804eb18dd1e3459a48ab89","url":"https://api.github.com/repos/juanfont/headscale/git/trees/afc355df6818b9fd72804eb18dd1e3459a48ab89"},"message":"db: use proper synchronization in garbage collector tests\n\nReplace time.Sleep with proper synchronization primitives:\n- Use sync.WaitGroup for waiting on expected deletions\n- Use notification channels for deletion events\n- Use assert.EventuallyWithT for polling goroutine counts\n- Use atomic counters for thread-safe tracking\n\nThis makes the tests more robust and less prone to timing issues.","parents":[{"sha":"ed577b644e23b6c7a6e538feb2bab1c819d2dd6a","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ed577b644e23b6c7a6e538feb2bab1c819d2dd6a","html_url":"https://github.com/juanfont/headscale/commit/ed577b644e23b6c7a6e538feb2bab1c819d2dd6a"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgmMAoz5Zf+w0nAxyA6/zsNd95cP\n98YbtHIIXyy9A1sssAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQIYTrM78dEGugiCJzRn/XRClP02vEHf06PgqzDYW0aOmOzbsDJWDbSnSN6QjZ3PC2F\nE33HuuDNzNcP4ByorORQQ=\n-----END SSH SIGNATURE-----","payload":"tree afc355df6818b9fd72804eb18dd1e3459a48ab89\nparent ed577b644e23b6c7a6e538feb2bab1c819d2dd6a\nauthor Kristoffer Dalby <kristoffer@dalby.cc> 1765111502 +0000\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1765384594 +0100\n\ndb: use proper synchronization in garbage collector tests\n\nReplace time.Sleep with proper synchronization primitives:\n- Use sync.WaitGroup for waiting on expected deletions\n- Use notification channels for deletion events\n- Use assert.EventuallyWithT for polling goroutine counts\n- Use atomic counters for thread-safe tracking\n\nThis makes the tests more robust and less prone to timing issues.\n","verified_at":"2025-12-10T16:40:52Z"},"event":"committed"},{"sha":"46895677f470a3346fd798916901a3847f2a2468","node_id":"C_kwDOEFLz89oAKDQ2ODk1Njc3ZjQ3MGEzMzQ2ZmQ3OTg5MTY5MDFhMzg0N2YyYTI0Njg","url":"https://api.github.com/repos/juanfont/headscale/git/commits/46895677f470a3346fd798916901a3847f2a2468","html_url":"https://github.com/juanfont/headscale/commit/46895677f470a3346fd798916901a3847f2a2468","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2025-12-07T12:50:10Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-12-10T16:40:45Z"},"tree":{"sha":"57c94ce5347a741c40f202818cd96f945c245f1b","url":"https://api.github.com/repos/juanfont/headscale/git/trees/57c94ce5347a741c40f202818cd96f945c245f1b"},"message":"integration: remove flaky sleeps and add nolint for intentional delays\n\n- Replace client shutdown sleeps with EventuallyWithT polling for\n  \"Stopped\" state in auth_key_test.go and cli_test.go\n- Add nolint:forbidigo for intentional delays that must wait for:\n  - Tailscale client 5-min reconnection delay over non-HTTPS\n  - OIDC registration cache expiration (real-time requirement)\n  - DERP updater interval testing","parents":[{"sha":"adeb705298ee7ec18012cdec7ab817e73de21544","url":"https://api.github.com/repos/juanfont/headscale/git/commits/adeb705298ee7ec18012cdec7ab817e73de21544","html_url":"https://github.com/juanfont/headscale/commit/adeb705298ee7ec18012cdec7ab817e73de21544"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgmMAoz5Zf+w0nAxyA6/zsNd95cP\n98YbtHIIXyy9A1sssAAAADZ2l0AAAAAAAAAAZzaGE1MTI