lby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"eeb8f20244bc759b00905d64554ce2764ed49ecb","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/eeb8f20244bc759b00905d64554ce2764ed49ecb","created_at":"2026-04-29T17:12:11Z","performed_via_github_app":null},{"sha":"882daca967bac8c9ea4c8a2d1ef5d3330468cadb","node_id":"C_kwDOEFLz89oAKDg4MmRhY2E5NjdiYWM4YzllYTRjOGEyZDFlZjVkMzMzMDQ2OGNhZGI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/882daca967bac8c9ea4c8a2d1ef5d3330468cadb","html_url":"https://github.com/juanfont/headscale/commit/882daca967bac8c9ea4c8a2d1ef5d3330468cadb","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-28T16:09:42Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-30T11:53:23Z"},"tree":{"sha":"f58ffe8dbc42c55d0404286b2d6f04d76f4683f6","url":"https://api.github.com/repos/juanfont/headscale/git/trees/f58ffe8dbc42c55d0404286b2d6f04d76f4683f6"},"message":"hscontrol/policy/v2: reject ambiguous user references at load time\n\nWhen a user@ token resolved to more than one DB row, ACL and SSH\nrules referencing it were silently dropped at compile time, leaving\nclients with SSHPolicy={rules: null} and no signal to the admin.\n\nValidate every Username reference in groups, tagOwners,\nautoApprovers, ACLs and SSH rules at NewPolicyManager and SetPolicy\nand return ErrMultipleUsersFound. Missing-user tokens stay tolerant\nper #2863.\n\nUpdates #3160","parents":[{"sha":"ecaf56e0a0b2717779b96e1f8300c60587461387","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ecaf56e0a0b2717779b96e1f8300c60587461387","html_url":"https://github.com/juanfont/headscale/commit/ecaf56e0a0b2717779b96e1f8300c60587461387"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"91eedf4a640d0341501e2bcdf96b2c8b03cad73c","node_id":"C_kwDOEFLz89oAKDkxZWVkZjRhNjQwZDAzNDE1MDFlMmJjZGY5NmIyYzhiMDNjYWQ3M2M","url":"https://api.github.com/repos/juanfont/headscale/git/commits/91eedf4a640d0341501e2bcdf96b2c8b03cad73c","html_url":"https://github.com/juanfont/headscale/commit/91eedf4a640d0341501e2bcdf96b2c8b03cad73c","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-28T16:09:51Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-30T11:53:23Z"},"tree":{"sha":"078ace1178a9fdf7bd937be528ca3e85a0ba9815","url":"https://api.github.com/repos/juanfont/headscale/git/trees/078ace1178a9fdf7bd937be528ca3e85a0ba9815"},"message":"cmd/headscale/cli: validate users in policy check\n\nAdd --bypass-grpc-and-access-database-directly to policy check so\nthe new ambiguous-user validator runs against the live user list.\nWithout the flag, policy check stays a syntax-only check and the\nsuccess message says so.\n\nUpdates #3160","parents":[{"sha":"882daca967bac8c9ea4c8a2d1ef5d3330468cadb","url":"https://api.github.com/repos/juanfont/headscale/git/commits/882daca967bac8c9ea4c8a2d1ef5d3330468cadb","html_url":"https://github.com/juanfont/headscale/commit/882daca967bac8c9ea4c8a2d1ef5d3330468cadb"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":25032264218,"node_id":"HRFPE_lADOEFLz888AAAABAvVhD88AAAAF1AoKGg","url