[{"sha":"fd56b983498526abf91bb89eac7a81cf3c724572","node_id":"C_kwDOEFLz89oAKGZkNTZiOTgzNDk4NTI2YWJmOTFiYjg5ZWFjN2E4MWNmM2M3MjQ1NzI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/fd56b983498526abf91bb89eac7a81cf3c724572","html_url":"https://github.com/juanfont/headscale/commit/fd56b983498526abf91bb89eac7a81cf3c724572","author":{"name":"Harini","email":"harininethran@gmail.com","date":"2026-08-17T06:24:22Z"},"committer":{"name":"Harini","email":"harininethran@gmail.com","date":"2026-08-17T06:24:22Z"},"tree":{"sha":"bd845a4ec61aaedcfe285f13dc48cfe5d4b24808","url":"https://api.github.com/repos/juanfont/headscale/git/trees/bd845a4ec61aaedcfe285f13dc48cfe5d4b24808"},"message":"fix: invert HTTP metrics skip condition to record all non-OPTIONS requests\n\nThe Skip function in the chi metrics.Collector middleware was returning\ntrue (skip) for every method that is NOT OPTIONS, meaning only OPTIONS\nrequests were ever recorded in http_requests_total and\nhttp_request_duration_seconds. Regular GET/POST/PUT/DELETE traffic was\nsilently dropped from metrics.\n\nChange != to == so OPTIONS is the one method that is skipped (it is a\npreflight/probe request with no application value in metrics) while all\nreal traffic is recorded. The same inverted condition was present in\nboth the main router (createRouter) and the Noise upgrade router\n(NoiseUpgradeHandler).\n\nFixes #3412","parents":[{"sha":"565fd254d06c4c7f9a8cad1714a43445c79ba420","url":"https://api.github.com/repos/juanfont/headscale/git/commits/565fd254d06c4c7f9a8cad1714a43445c79ba420","html_url":"https://github.com/juanfont/headscale/commit/565fd254d06c4c7f9a8cad1714a43445c79ba420"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":29545992529,"node_id":"RRE_lADOEFLz888AAAABNBfCxM8AAAAG4RQRUQ","url":"https://api.github.com/repos/juanfont/headscale/issues/events/29545992529","actor":{"login":"harriiinnii","id":222820279,