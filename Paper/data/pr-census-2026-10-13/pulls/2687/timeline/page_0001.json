tainerized\ntest environment with network latency and startup delays required\nmore time for CLI operations to complete.\n\nThis fix increases the CLI timeout to 30 seconds specifically for\nintegration tests through the HEADSCALE_CLI_TIMEOUT environment\nvariable.\n\n🤖 Generated with [Claude Code](https://claude.ai/code)\n\nCo-Authored-By: Claude <noreply@anthropic.com>","parents":[{"sha":"91ff5ab34ff5874c3a4de9ced590fb58956dbc9c","url":"https://api.github.com/repos/juanfont/headscale/git/commits/91ff5ab34ff5874c3a4de9ced590fb58956dbc9c","html_url":"https://github.com/juanfont/headscale/commit/91ff5ab34ff5874c3a4de9ced590fb58956dbc9c"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":18654108474,"node_id":"HRFPE_lADOEFLz887AeGi5zwAAAARX3xs6","url":"https://api.github.com/repos/juanfont/headscale/issues/events/18654108474","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"fe4978764b2334d59a07b6d2d17b3c94f57b8a01","commit_url":"https://api.github.com/repos/juanfont/headscale/