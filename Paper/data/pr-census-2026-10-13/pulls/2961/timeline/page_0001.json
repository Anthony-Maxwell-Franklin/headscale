r_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"9f32dc5e38d86b746ea10efb3b44ba49eefdbf1b","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/9f32dc5e38d86b746ea10efb3b44ba49eefdbf1b","created_at":"2025-12-15T14:46:52Z","performed_via_github_app":null},{"sha":"c84d04a8c9bf45a084277b290fe346c6d09ef44e","node_id":"C_kwDOEFLz89oAKGM4NGQwNGE4YzliZjQ1YTA4NDI3N2IyOTBmZTM0NmM2ZDA5ZWY0NGU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c84d04a8c9bf45a084277b290fe346c6d09ef44e","html_url":"https://github.com/juanfont/headscale/commit/c84d04a8c9bf45a084277b290fe346c6d09ef44e","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2025-12-15T14:36:21Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2025-12-15T14:49:59Z"},"tree":{"sha":"05d78f75ac27a2cf4f712f6a2576303ee284fc3a","url":"https://api.github.com/repos/juanfont/headscale/git/trees/05d78f75ac27a2cf4f712f6a2576303ee284fc3a"},"message":"change: smarter change notifications\n\nThis commit replaces the ChangeSet with a simpler bool based\nchange model that can be directly used in the map builder to\nbuild the appropriate map response based on the change that\nhas occured. Previously, we fell back to sending full maps\nfor a lot of changes as that was consider \"the safe\" thing to\ndo to ensure no updates were missed.\n\nThis was slightly problematic as a node that already has a list\nof peers will only do full replacement of the peers if the list\nis non-empty, meaning that it was not possible to remove all\nnodes (if for example policy changed).\n\nNow we will keep track of last seen nodes, so we can send remove\nids, but also we are much smarter on how we send smaller, partial\nmaps when needed.\n\nFixes #2389\n\nSigned-off-by: Kristoffer Dalby <kristoffer@dalby.cc>","parents":[{"sha":"ee5d82a176d75cd0a6f69499fb6898c123a53aac","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ee5d82a176d75cd0a6f69499fb6898c123a53aac","html_url":"https://github.com/juanfont/headscale/commit/ee5d82a176d75cd0a6f69499fb6898c123a53aac"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":21568672966,"node_id":"HRFPE_lADOEFLz887eEKw1zwAAAAUFl9TG","url":"https://api.github.com/repos/juanfont/headscale/issues/events/21568672966","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kr