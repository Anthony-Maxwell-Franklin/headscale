ers/joshuataylor/gists{/gist_id}","starred_url":"https://api.github.com/users/joshuataylor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/joshuataylor/subscriptions","organizations_url":"https://api.github.com/users/joshuataylor/orgs","repos_url":"https://api.github.com/users/joshuataylor/repos","events_url":"https://api.github.com/users/joshuataylor/events{/privacy}","received_events_url":"https://api.github.com/users/joshuataylor/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-01-31T13:53:25Z","updated_at":"2023-01-31T13:54:31Z","body":"I couldn't figure out how to see this via the CLI in Linux, so I tested this with a Mac client, and by default it was pretty short (Google), using the main branch.\r\n\r\nWith this PR I tested a few different times using the config option, and each worked! :tada:\r\n\r\n<img width=\"268\" alt=\"image\" src=\"https://user-images.githubusercontent.com/225131/215778456-361005e1-b6b3-456e-b8bf-ebe379906c7a.png\">\r\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/juanfont/headscale/issues/comments/1410397800/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"joshuataylor","id":225131,"node_id":"MDQ6VXNlcjIyNTEzMQ==","avatar_url":"https://avatars.githubusercontent.com/u/225131?v=4","gravatar_id":"","url":"https://api.github.com/users/joshuataylor","html_url":"https://github.com/joshuataylor","followers_url":"https://api.github.com/users/joshuataylor/followers","following_url":"https://api.github.com/users/joshuataylor/following{/other_user}","gists_url":"https://api.github.com/users/joshuataylor/gists{/gist_id}","starred_url":"https://api.github.com/users/joshuataylor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/joshuataylor/subscriptions","organizations_url":"https://api.github.com/users/joshuataylor/orgs","repos_url":"https://api.github.com/users/joshuataylor/repos","events_url":"https://api.github.com/users/joshuataylor/events{/privacy}","received_events_url":"https://api.github.com/users/joshuataylor/received_events","type":"User","user_view_type":"public","site_admin":false}},{"sha":"07940ecc696e6f0fbae4ffb9cf96e0550a99010c","node_id":"C_kwDOEFLz89oAKDA3OTQwZWNjNjk2ZTZmMGZiYWU0ZmZiOWNmOTZlMDU1MGE5OTAxMGM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/07940ecc696e6f0fbae4ffb9cf96e0550a99010c","html_url":"https://github.com/juanfont/headscale/commit/07940ecc696e6f0fbae4ffb9cf96e0550a99010c","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2023-01-31T11:40:38Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2023-01-31T16:28:47Z"},"tree":{"sha":"c7749744c8186d1b8d7b5dbe9502fbf0b64d223a","url":"https://api.github.com/repos/juanfont/headscale/git/trees/c7749744c8186d1b8d7b5dbe9502fbf0b64d223a"},"message":"Set OpenID Connect Expiry\n\nThis commit adds a default OpenID Connect expiry to 180d to align with\nTailscale SaaS (previously infinite or based on token expiry).\n\nIn addition, it adds an option use the expiry time from the Token sent\nby the OpenID provider. This will typically cause really short expiry\nand you should only turn on this option if you know what you are\ndesiring.\n\nThis fixes #1176.\n\nCo-authored-by: Even Holthe <even.holthe@bekk.no>\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>","parents":[{"sha":"385fd93e73aaade882a6a3bffec3478bffe9aa66","url":"https://api.github.com/repos/juanfont/headscale/git/commits/385fd93e73aaade882a6a3bffec3478bffe9aa66","html_url":"https://github.com/juanfont/headscale/commit/385fd93e73aaade882a6a3bffec3478bffe9aa66"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAAGgAAAATZWNkc2Etc2hhMi1uaXN0cDI1NgAAAAhuaXN0cDI1NgAAAE\nEE6bT6+U8pNExCb214X9sKtM8QMSqzWb4HmQxm24sqHasMtgza7Cws+M2NoiUVB+RSfa/I\nCoai/Io5VHtD9nbzKgAAAANnaXQAAAAAAAAABnNoYTUxMgAAAGMAAAATZWNkc2Etc2hhMi\n1uaXN0cDI1NgAAAEgAAAAge6J7SOE7lI2FBD6CBdRHOsOvX4IwxSt/a6clsfvVpWkAAAAg\nIwY+ltjbRM3Evv9JZxCvPfeJGiXHZ56YTW5asiIeZsY=\n-----END SSH SIGNATURE-----","payload":"tree c7749744c8186d1b8d7b5dbe9502fbf0b64d223a\nparent 385fd93e73aaade882a6a3bffec3478bffe9aa66\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1675165238 +0100\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1675182527 +0100\n\nSet OpenID Connect Expiry\n\nThis commit adds a default OpenID Connect expiry to 180d to align with\nTailscale SaaS (previously infinite or based on token expiry).\n\nIn addition, it adds an option use the expiry time from the Token sent\nby the OpenID provider. This will typically cause really short expiry\nand you should only turn on this option if you know what you are\ndesiring.\n\nThis fixes #1176.\n\nCo-authored-by: Even Holthe <even.holthe@bekk.no>\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>\n","verified_at":"2024-11-07T16:10:16Z"},"event":"committed"},{"id":8401572898,"node_id":"HRFPE_lADOEFLz885dOyQ_zwAAAAH0xdQi","url":"https://api.github.com/repos/juanfont/headscale/issues/events/8401572898","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos