[{"sha":"34d7e8a57b7712953f31dc1a5e25f25d09acece1","node_id":"C_kwDOEFLz89oAKDM0ZDdlOGE1N2I3NzEyOTUzZjMxZGMxYTVlMjVmMjVkMDlhY2VjZTE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/34d7e8a57b7712953f31dc1a5e25f25d09acece1","html_url":"https://github.com/juanfont/headscale/commit/34d7e8a57b7712953f31dc1a5e25f25d09acece1","author":{"name":"Tiger1218","email":"tiger1218@foxmail.com","date":"2026-05-02T10:35:13Z"},"committer":{"name":"Tiger1218","email":"tiger1218@foxmail.com","date":"2026-05-02T10:35:13Z"},"tree":{"sha":"57dc6d4b641748fb0574bc939c3f3bca5012a971","url":"https://api.github.com/repos/juanfont/headscale/git/trees/57dc6d4b641748fb0574bc939c3f3bca5012a971"},"message":"policy: implement nodeAttrs support (tailscale feature gap #2319)\n\nAdd nodeAttrs parsing, compilation, and distribution through MapResponse.\nThis allows Headscale policy files to inject node capabilities via the\nCapMap field, matching Tailscale SaaS behavior.\n\n- types.go: add NodeAttrGrant struct and Policy.NodeAttrs field\n- compiled.go: add compileNodeAttrs() resolving targets to CapMap\n- policy.go: add nodeAttrsMap cache and public NodeCapMap() method\n- state.go: add NodeCapMap() proxy to PolicyManager\n- pm.go: add NodeCapMap to PolicyManager interface\n- builder.go: merge policy CapMap into self and peer nodes\n- nodeattrs_test.go: test user/tag/ip/wildcard targets + merging\n\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>","parents":[{"sha":"76ee29352b46659fc3ef16d8464bb50eb23ba497","url":"https://api.github.com/repos/juanfont/headscale/git/commits/76ee29352b46659fc3ef16d8464bb50eb23ba497","html_url":"https://github.com/juanfont/headscale/commit/76ee29352b46659fc3ef16d8464bb50eb23ba497"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"db5178d6841cf6f313341448879721073c2744cc","node_id":"C_kwDOEFLz89oAKGRiNTE3OGQ2ODQxY2Y2ZjMxMzM0MTQ0ODg3OTcyMTA3M2MyNzQ0Y2M","url":"h