[{"sha":"8a627e82e66ba3e3ea1ff1676f85204f09e14d08","node_id":"C_kwDOEFLz89oAKDhhNjI3ZTgyZTY2YmEzZTNlYTFmZjE2NzZmODUyMDRmMDllMTRkMDg","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8a627e82e66ba3e3ea1ff1676f85204f09e14d08","html_url":"https://github.com/juanfont/headscale/commit/8a627e82e66ba3e3ea1ff1676f85204f09e14d08","author":{"name":"Rogan Lynch","email":"roganl@gmail.com","date":"2025-12-05T20:31:26Z"},"committer":{"name":"Rogan Lynch","email":"roganl@gmail.com","date":"2025-12-05T20:31:26Z"},"tree":{"sha":"a488ce8ff85757aa4d7fa0c8432696f261f5f1cc","url":"https://api.github.com/repos/juanfont/headscale/git/trees/a488ce8ff85757aa4d7fa0c8432696f261f5f1cc"},"message":"feat: minimal Docker Desktop fix - API version 1.44\n\nFix integration tests for Docker Desktop compatibility by forcing\na modern Docker API version (1.44) instead of the default 1.25.\n\nChanges:\n- integration/scenario.go: Explicitly create Docker client with API 1.44\n- .dockerignore: Exclude test artifacts and build outputs\n\nThis is the minimal fix - no complex Docker Desktop detection needed.\nThe root cause was dockertest.NewPool() defaulting to API 1.25,\nwhich modern Docker daemons (v1.52+) reject.\n\nTotal changes: ~10 lines","parents":[{"sha":"eb788cd007119472b99787c8c3af6d6204e8b834","url":"https://api.github.com/repos/juanfont/headscale/git/commits/eb788cd007119472b99787c8c3af6d6204e8b834","html_url":"https://github.com/juanfont/headscale/commit/eb788cd007119472b99787c8c3af6d6204e8b834"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAARcAAAAHc3NoLXJzYQAAAAMBAAEAAAEBANLHmfZ/tH39b44j6zg9Cf\nEDuSaDwUbQd1QSaH/3ZEechpGdLrCVWspLY+M/WusCFv2O6RhwYdl3uh07Z2KuBoCSUcy8\nFlTGdvoXPkpspT7MtYMN7n0oL7IOJ5jvFS2IIg8lhUbutjVO45O162haDrxRMLGOqTEhsy\neDBQEPhjEfuNBYMs+JjY4iPa2IjyucrusTzHzhfPrJCSmvfMy9tOZBiCh65+9RRpuKXODy\nGGS48+wSUHB8RvtWLBTHWmj8WMGnt4u9B6560pQLu3+6Vo3ToLs7CFa1MGKSV3eqiqMMtP\nDtE2jLJuWthqTn0xfsH/d3rcp1jB6vUhH6