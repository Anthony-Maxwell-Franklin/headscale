b.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"body":null,"commit_id":"8a627e82e66ba3e3ea1ff1676f85204f09e14d08","state":"commented","html_url":"https://github.com/juanfont/headscale/pull/2937#pullrequestreview-3563069926","pull_request_url":"https://api.github.com/repos/juanfont/headscale/pulls/2937","_links":{"html":{"href":"https://github.com/juanfont/headscale/pull/2937#pullrequestreview-3563069926"},"pull_request":{"href":"https://api.github.com/repos/juanfont/headscale/pulls/2937"}},"submitted_at":"2025-12-10T15:15:11Z","updated_at":"2025-12-10T15:15:11Z","author_association":"COLLABORATOR","event":"reviewed"},{"sha":"aac1cc87bedd6f0e92aaa763ebb49ee92e623478","node_id":"C_kwDOEFLz89oAKGFhYzFjYzg3YmVkZDZmMGU5MmFhYTc2M2ViYjQ5ZWU5MmU2MjM0Nzg","url":"https://api.github.com/repos/juanfont/headscale/git/commits/aac1cc87bedd6f0e92aaa763ebb49ee92e623478","html_url":"https://github.com/juanfont/headscale/commit/aac1cc87bedd6f0e92aaa763ebb49ee92e623478","author":{"name":"Rogan Lynch","email":"roganl@gmail.com","date":"2025-12-13T03:55:59Z"},"committer":{"name":"Rogan Lynch","email":"roganl@gmail.com","date":"2025-12-13T03:55:59Z"},"tree":{"sha":"9db5a676e77564830cb85d764106dbf52723a818","url":"https://api.github.com/repos/juanfont/headscale/git/trees/9db5a676e77564830cb85d764106dbf52723a818"},"message":"feat: implement dynamic Docker API version negotiation\n\nReplace hardcoded API version 1.44 with automatic version detection.\n\nThe previous approach had issues:\n- dockertest.NewPool(\"\") auto-negotiated to API 1.25 (too old)\n- Modern Docker daemons reject old versions causing broken pipe errors\n- Hardcoded 1.44 worked but wasn't portable across Docker installations\n\nNew approach:\n- Query Docker daemon's /version endpoint to get MinAPIVersion\n- Use the server's minimum supported version (e.g., 1.44 for Docker Desktop)\n- Fallback to 1.41 if MinAPIVersion not available\n- Respects DOCKER_HOST environment variable\n\nThis ensures compatibility across Docker Desktop, Colima, and other installations\nwhile avoiding the broken pipe errors from outdated API versions.","parents":[{"sha":"8a627e82e66ba3e3ea1ff1676f85204f09e14d08","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8a627e82e66ba3e3ea1ff1676f85204f09e14d08","html_url":"https://github.com/juanfont/headscale/commit/8a627e82e66ba3e3ea1ff1676f85204f09e14d08"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAARcAAAAHc3NoLXJzYQAAAAMBAAEAAAEBANLHmfZ/tH39b44j6zg9Cf\nEDuSaDwUbQd1QSaH/3ZEechpGdLrCVWspLY+M/WusCFv2O6RhwYdl3uh07Z2KuBoCSUcy8\nFlTGdvoXPkpspT7MtYMN7n0oL7IOJ5jvFS2IIg8lhUbutjVO45O162haDrxRMLGOqTEhsy\neDBQEPhjEfuNBYMs+JjY4iPa2IjyucrusTzHzhfPrJCSmvfMy9tOZBiCh65+9RRpuKXODy\nGGS48+wSUHB8RvtWLBTHWmj8WMGnt4u9B6560pQLu3+6Vo3ToLs7CFa1MGKSV3eqiqMMtP\nDtE2jLJuWthqTn0xfsH/d3rcp1jB6vUhH66SQhb/0AAAADZ2l0AAAAAAAAAAZzaGE1MTIA\nAAEUAAAADHJzYS1zaGEyLTI1NgAAAQAQAHjBBx5OFRShmccN5UWLZCkhK+K1u9cCZ5zulQ\nhv+8lAci4u07lCEXQC9rTFQeK8CPDvL/TBZUW3kGZwWsM6w9UkSOIbG2lxYw+HsKwpvM7E\nBAP5o3EMp2hPmvL0vJKZDy9CglLZKCtYYsnDekR3MkLShE9bfF1ZaCYjgAW2mUSky3Jf8c\n3NuHfBUYDMzSm4oFR6pm39psKc3SFpgbLOf/ky0OG0s5DI6oi0gJsE7fnMSRC+UhH9l7AF\n6MOftBgmRReG4mmO5035/Ov95jOSc5em4tWaI8xdqJMpUr4/o1BfkD+rKk8cNGvBQUxFyO\n5xKGk1wLguvCtVkhJzfBfJ\n-----END SSH SIGNATURE-----","payload":"tree 9db5a676e77564830cb85d764106dbf52723a818\nparent 8a627e82e66ba3e3ea1ff1676f85204f09e14d08\nauthor Rogan Lynch <roganl@gmail.com> 1765598159 -0800\ncommitter Rogan Lynch <roganl@gmail.com> 1765598159 -0800\n\nfeat: implement dynamic Docker API version negotiation\n\nReplace hardcoded API version 1.44 with automatic version detection.\n\nThe previous approach had issues:\n- dockertest.NewPool(\"\") auto-negotiated to API 1.25 (too old)\n- Modern Docker daemons reject old versions causing broken pipe errors\n- Hardcoded 1.44 worked but wasn't portable across Docker installations\n\nNew approach:\n- Query Docker daemon's /version endpoint to get MinAPIVersion\n- Use the server's minimum supported version (e.g., 1.44 for Docker Desktop)\n- Fallback to 1.41 if MinAPIVersion not available\n- Respects DOCKER_HOST environment variable\n\nThis ensures compatibility across Docker Desktop, Colima, and other installations\nwhile avoiding the broken pipe errors from outdated API versions.\n","verified_at":"2025-12-13T03:57:06Z"},"event":"committed"},{"sha":"37162267d9c0e1cb08e748a105c2c9e002ac8541","node_id":"C_kwDOEFLz89oAKDM3MTYyMjY3ZDljMGUxY2IwOGU3NDhhMTA1YzJjOWUwMDJhYzg1NDE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/37162267d9c0e1cb08e748a105c2c9e002ac8541","html_url":"https://github.com/juanfont/headscale/commit/37162267d9c0e1cb08e748a105c2c9e002ac8541","author":{"name":"Rogan Lynch","email":"roganl@gmail.com","date":"2025-12-13T03:56:31Z"},"committer":{"name":"Rogan Lynch","email":"roganl@gmail.com","date":"2025-12-13T03:56:31Z"},"tree":{"sha":"e3414afcd3e53b3e998513ffb8a53eea8b1092e6","url":"https://api.github.com/repos/juanfont/headscale/git/trees/e3414afcd3e53b3e998513ffb8a53eea8b1092e6"},"message":"revert: remove .dockerignore changes to avoid side effects","parents":[{"sha":"aac1cc87bedd6f0e92aaa763ebb49ee92e623478","url":"https://api.github.com/repos/juanfont/headscale/git/commits/aac1cc87bedd6f0e92aaa763ebb49ee92e623478","html_url":"https://github.com/juanfont/headscale/commit/aac1cc87bedd6f0e92aaa763ebb49ee92e623478"}],"verification":{"verified":true,"reason":"