[{"sha":"c452327d0a2ed56aeed499028fbb7ef2f96da0ab","node_id":"C_kwDOEFLz89oAKGM0NTIzMjdkMGEyZWQ1NmFlZWQ0OTkwMjhmYmI3ZWYyZjk2ZGEwYWI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c452327d0a2ed56aeed499028fbb7ef2f96da0ab","html_url":"https://github.com/juanfont/headscale/commit/c452327d0a2ed56aeed499028fbb7ef2f96da0ab","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-13T08:44:41Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-13T08:44:41Z"},"tree":{"sha":"555144f78fe3e3ca9f8c258cec1e88c710784908","url":"https://api.github.com/repos/juanfont/headscale/git/trees/555144f78fe3e3ca9f8c258cec1e88c710784908"},"message":"templates: add error box component and error page template\n\nAdd errorBox() and errorIcon() to the design system, mirroring the\nexisting successBox()/checkboxIcon() pattern with red error styling.\nExtract error color constants from the inline values in statusMessage().\n\nAdd AuthError() template that renders a styled HTML error page using\nthe same HtmlStructure/mdTypesetBody/logo/footer as all other\nbrowser-facing pages.\n\nUpdates juanfont/headscale#3182","parents":[{"sha":"1f9635c2ec20b362281daa9c24adcd7e008f765c","url":"https://api.github.com/repos/juanfont/headscale/git/commits/1f9635c2ec20b362281daa9c24adcd7e008f765c","html_url":"https://github.com/juanfont/headscale/commit/1f9635c2ec20b362281daa9c24adcd7e008f765c"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"c314407b2219d0877e82ba774550a3b65bb042f3","node_id":"C_kwDOEFLz89oAKGMzMTQ0MDdiMjIxOWQwODc3ZTgyYmE3NzQ1NTBhM2I2NWJiMDQyZjM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c314407b2219d0877e82ba774550a3b65bb042f3","html_url":"https://github.com/juanfont/headscale/commit/c314407b2219d0877e82ba774550a3b65bb042f3","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-13T08:46:00Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-13T08:46:00Z"},"tree":{"sha":"d8124d5db73b29f4c4e6699e480d0574accc9de7","url":"https://api.github.com/repos/juanfont/headscale/git/trees/d8124d5db73b29f4c4e6699e480d0574accc9de7"},"message":"oidc: render HTML error pages for browser-facing failures\n\nAdd httpUserError() alongside httpError() for browser-facing error\npaths. It renders a styled HTML page using the AuthError template\ninstead of returning plain text. Technical error details stay in\nserver logs; the HTML page shows actionable messages derived from\nthe HTTP status code:\n\n  401/403 → \"You are not authorized. Please contact your administrator.\"\n  410     → \"Your session has expired. Please try again.\"\n  400-499 → \"The request could not be processed. Please try again.\"\n  500+    → \"Something went wrong. Please try again later.\"\n\nConvert all httpError calls in oidc.go (OIDC callback, SSH check,\nregistration confirm) to httpUserError. Machine-facing endpoints\n(noise, verify, key, health, debug) are unchanged.\n\nFixes juanfont/headscale#3182","parents":[{"sha":"c452327d0a2ed56aeed499028fbb7ef2f96da0ab","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c452327d0a2ed56aeed499028fbb7ef2f96da0ab","html_url":"https://github.com/juanfont/headscale/commit/c452327d0a2ed56aeed499028fbb7ef2f96da0ab"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":24438782883,"node_id":"HRFPE_lADOEFLz8879fZE8zwAAAAWwqjuj","url":"https://api.github.com/repos/juanfont/headscale/issues/events/24438782883","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"c314407b2219d0877e82ba774550a3b65bb042f3","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/c314407b2219d0877e82ba774550a3b65bb042f3","created_at":"2026-04-13T08:53:20Z","performed_via_github_app":null},{"sha":"2d3a57c469a5089d0f3888ae3067df241cd73e75","node_id":"C_kwDOEFLz89oAKDJkM2E1N2M0NjlhNTA4OWQwZjM4ODhhZTMwNjdkZjI0MWNkNzNlNzU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/2d3a57c469a5089d0f3888ae3067df241cd73e75","html_url":"https://github.com/juanfont/headscale/commit/2d3a57c469a5089d0f3888ae3067df241cd73e75","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-13T12:38:16Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-13T12:38:16Z"},"tree":{"sha":"19450d9c1e6185566d9eaf0377218aa3fc3b18a2","url":"https://api.github.com/repos/juanfont/headscale/git/trees/19450d9c1e6185566d9eaf0377218aa3fc3b18a2"},"message":"templates: improve accessibility, dark mode, and typography\n\nBump base font size from 0.8rem to 1rem (16px) to meet mobile\naccessibility guidelines and avoid iOS auto-zoom on inputs.\n\nAdd CSS custom properties for all theme colors with a\nprefers-color-scheme: dark media query so pages adapt to OS dark\nmode. Component inline styles reference var(--hs-*) tokens so they\nfollow the scheme automatically.\n\nAccessibility improvements:\n- role=\"status\" + aria-live=\"polite\" on success boxes\n- role=\"alert\" + aria-live=\"assertive\" on error boxes\n- role=\"note\" on warning boxes\n- Visible focus rings via :focus-visible\n- Link underlines (don't rely on color alone)\n- SVG icons use currentColor for theme adaptation\n- prefers-reduced-motion media query\n- <main> landmark element wrapping page content\n- Button styling with 44px min-height touch target\n- List item spacing\n\nUpdates juanfont/headscale#3182","parents":[{"sha":"c314407b2219d0877e82ba774550a3b65bb042f3","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c314407b2219d0877e82ba774550a3b65bb042f3","html_url":"https://github.com/juanfont/headscale/commit/c314407b2219d0877e82ba774550a3b65bb042f3"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"4cb1e80b8bd3dd65416f93c9d960f043cfee95c4","node_id":"C_kwDOEFLz89oAKDRjYjFlODBiOGJkM2RkNjU0MTZmOTNjOWQ5NjBmMDQzY2ZlZTk1YzQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4cb1e80b8bd3dd65416f93c9d960f043cfee95c4","html_url":"https://github.com/juanfont/headscale/commit/4cb1e80b8bd3dd65416f93c9d960f043cfee95c4","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-13T12:38:29Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-13T12:38:29Z"},"tree":{"sha":"b21bbfa8f86c9d2d56314e1d24fd17f177d25a33","url":"https://api.github.com/repos/juanfont/headscale/git/trees/b21bbfa8f86c9d2d56314e1d24fd17f177d25a33"},"message":"all: apply formatter changes","parents":[{"sha":"2d3a57c469a5089d0f3888ae3067df241cd73e75","url":"https://api.github.com/repos/juanfont/headscale/git/commits/2d3a57c469a5089d0f3888ae3067df241cd73e75","html_url":"https://github.com/juanfont/headscale/commit/2d3a57c469a5089d0f3888ae3067df241cd73e75"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"9aa5bf840cf3c6b654803c60b299799512ec2481","node_id":"C_kwDOEFLz89oAKDlhYTViZjg0MGNmM2M2YjY1NDgwM2M2MGIyOTk3OTk1MTJlYzI0ODE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/9aa5bf840cf3c6b654803c60b299799512ec2481","html_url":"https://github.com/juanfont/headscale/commit/9aa5bf840cf3c6b654803c60b299799512ec2481","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-13T12:42:10Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-13T12:42:10Z"},"tree":{"sha":"731b222bcbe1d8eed691fa467e0d82717145b8ae","url":"https://api.github.com/repos/juanfont/headscale/git/trees/731b222bcbe1d8eed691fa467e0d82717145b8ae"},"message":"templates: use CSS variables in all shared components\n\nReplace hardcoded Go color constants with var(--hs-*) and\nvar(--md-*) CSS custom properties in externalLink, orDivider,\ncard, warningBox, downloadButton, and pageFooter. This ensures\nall components follow the dark mode theme automatically.\n\nAlso switch pageFooter from div to semantic footer element and\nsimplify externalLink by letting CSS handle link styling.\n\nUpdates juanfont/headscale#3182","parents":[{"sha":"4cb1e80b8bd3dd65416f93c9d960f043cfee95c4","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4cb1e80b8bd3dd65416f93c9d960f043cfee95c4","html_url":"https://github.com/juanfont/headscale/commit/4cb1e80b8bd3dd65416f93c9d960f043cfee95c4"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"718814ddf52a0045bd03d0cc14ed9b3d26366f0d","node_id":"C_kwDOEFLz89oAKDcxODgxNGRkZjUyYTAwNDViZDAzZDBjYzE0ZWQ5YjNkMjYzNjZmMGQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/718814ddf52a0045bd03d0cc14ed9b3d26366f0d","html_url":"https://github.com/juanfont/headscale/commit/718814ddf52a0045bd03d0cc14ed9b3d26366f0d","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-13T14:46:42Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-13T14:46:42Z"},"tree":{"sha":"8a20882e63cc1d6cb6a4dea942d43f675f68a789","url":"https://api.github.com/repos/juanfont/headscale/git/trees/8a20882e63cc1d6cb6a4dea942d43f675f68a789"},"message":"assets: fix logo alignment and error icon centering\n\nTighten the SVG viewBox to the actual content bounding box and\nremove hardcoded width/height attributes so the browser no longer\nadds horizontal padding via preserveAspectRatio. The \"h\" wordmark\nnow left-aligns with the page content below it.\n\nReplace the error icon SVG path (which had an off-center X) with\na simple circle + two crossed lines drawn from a centered viewBox.\nBoth icons now use fill=\"currentColor\" for dark mode adaptation.\n\nUpdates juanfont/headscale#3182","parents":[{"sha":"9aa5bf840cf3c6b654803c60b299799512ec2481","url":"https://api.github.com/repos/juanfont/headscale/git/commits/9aa5bf840cf3c6b654803c60b299799512ec2481","html_url":"https://github.com/juanfont/headscale/commit/9aa5bf840cf3c6b654803c60b299799512ec2481"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"14d50ba3d31ca7459347f78354a249ff5ab347ab","node_id":"C_kwDOEFLz89oAKDE0ZDUwYmEzZDMxY2E3NDU5MzQ3Zjc4MzU0YTI0OWZmNWFiMzQ3YWI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/14d50ba3d31ca7459347f78354a249ff5ab347ab","html_url":"https://github.com/juanfont/headscale/commit/14d50ba3d31ca7459347f78354a249ff5ab347ab","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-13T14:47:12Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-13T14:47:12Z"},"tree":{"sha":"12490061936a7148a3a80d3ca20aaa18575b89b7","url":"https://api.github.com/repos/juanfont/headscale/git/trees/12490061936a7148a3a80d3ca20aaa18575b89b7"},"message":"templates: use table layout for registration confirm details\n\nReplace the bullet list of device details with a two-column table\nfor cleaner visual hierarchy. Labels are bold and left-aligned,\nvalues right-aligned with subtle row separators. The machine key\nvalue uses an inline code style.\n\nUpdates juanfont/headscale#3182","parents":[{"sha":"718814ddf52a0045bd03d0cc14ed9b3d26366f0d","url":"https://api.github.com/repos/juanfont/headscale/git/commits/718814ddf52a0045bd03d0cc14ed9b3d26366f0d","html_url":"https://github.com/juanfont/headscale/commit/718814ddf52a0045bd03d0cc14ed9b3d26366f0d"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":24450711812,"node_id":"RTE_lADOEFLz8879fZE8zwAAAAWxYEEE","url":"https://api.github.com/repos/juanfont/headscale/issues/events/24450711812","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"renamed","commit_id":null,"commit_url":null,"created_at":"2026-04-13T14:47:59Z","rename":{"from":"oidc: render HTML error pages for browser-facing failures","to":"templates: render HTML err