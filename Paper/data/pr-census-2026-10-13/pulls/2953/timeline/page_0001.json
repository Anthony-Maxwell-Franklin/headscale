[{"sha":"68766cf238b46a00c76c7588202b634b43f0704e","node_id":"C_kwDOEFLz89oAKDY4NzY2Y2YyMzhiNDZhMDBjNzZjNzU4ODIwMmI2MzRiNDNmMDcwNGU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/68766cf238b46a00c76c7588202b634b43f0704e","html_url":"https://github.com/juanfont/headscale/commit/68766cf238b46a00c76c7588202b634b43f0704e","author":{"name":"Rogan Lynch","email":"roganl@gmail.com","date":"2025-12-10T03:22:57Z"},"committer":{"name":"Rogan Lynch","email":"roganl@gmail.com","date":"2025-12-10T03:22:57Z"},"tree":{"sha":"17c77384e07f42eab582695329a66c7eccc2045d","url":"https://api.github.com/repos/juanfont/headscale/git/trees/17c77384e07f42eab582695329a66c7eccc2045d"},"message":"fix: list-routes command now respects identifier filter with JSON output\n\nFixes #2927\n\nIn v0.27.0, the list-routes command with -i flag and -o json output\nwas returning all nodes instead of just the specified node.\n\nThe issue was that JSON output was happening before the identifier\nfiltering logic. This change moves the JSON output to after both\nthe identifier filter and route existence filter are applied,\nensuring the correct filtered results are returned.\n\nThis restores the v0.26.1 behavior where:\n  headscale nodes list-routes -i 12 -o json\ncorrectly returns only node 12's route information.","parents":[{"sha":"eb788cd007119472b99787c8c3af6d6204e8b834","url":"https://api.github.com/repos/juanfont/headscale/git/commits/eb788cd007119472b99787c8c3af6d6204e8b834","html_url":"https://github.com/juanfont/headscale/commit/eb788cd007119472b99787c8c3af6d6204e8b834"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAARcAAAAHc3NoLXJzYQAAAAMBAAEAAAEBANLHmfZ/tH39b44j6zg9Cf\nEDuSaDwUbQd1QSaH/3ZEechpGdLrCVWspLY+M/WusCFv2O6RhwYdl3uh07Z2KuBoCSUcy8\nFlTGdvoXPkpspT7MtYMN7n0oL7IOJ5jvFS2IIg8lhUbutjVO45O162haDrxRMLGOqTEhsy\neDBQEPhjEfuNBYMs+JjY4iPa2IjyucrusTzHzhfPrJCSmvfMy9tOZBiCh65+9RRpuKXODy\nGGS48+wSUHB8RvtWLBTHWmj8WMGnt4u9B6560pQLu3+6Vo3ToLs7CFa1MGKSV3eqiqMMtP\nDtE2jLJuWthqTn0xfsH/d3rcp1jB6vUhH66SQhb/0AAAADZ2l0AAAAAAAAAAZzaGE1MTIA\nAAEUAAAADHJzYS1zaGEyLTI1NgAAAQA/Gu4s8R7SCa7HHxuBQ44nwbJQpdEtgGD7KOHHsT\nWcduFeotFfbd+gfi0vO7BgSvXVTOuR6aQp29MpKQwhksfkhJ8SYlaxUUCFSB1AwHv8AFl9\nqxTl5+VM7mqdsm5Z3JITs1QKx/3MPlSdNTurk/7rONXdaL5U0FRmMzQUj+U5d25kjz5TIg\n2V7IsmlicnklRWutA8DH9FBtmA7hXvxCqLwIOF9hgBjOyDsimnVmHpjAkcdZfcBRglReoa\nz4B4vdEhWAeblJXfY7imwT3BHDHrpv23qERCPlp6bH3Kv6CaAqYWkRMMWw70YIAI6KNrQw\n+jB84x4s+G9XqJ2T/En5e1\n-----END SSH SIGNATURE-----","payload":"tree 17c77384e07f42eab582695329a66c7eccc2045d\nparent eb788cd007119472b99787c8c3af6d6204e8b834\nauthor Rogan Lynch <roganl@gmail.com> 1765336977 -0800\ncommitter Rogan Lynch <roganl@gmail.com> 1765336977 -0800\n\nfix: list-routes command now respects identifier filter with JSON output\n\nFixes #2927\n\nIn v0.27.0, the list-routes command with -i flag and -o json output\nwas returning all nodes instead of just the specified node.\n\nThe issue was that JSON output was happening before the identifier\nfiltering logic. This change moves the JSON output to after both\nthe identifier filter and route existence filter are applied,\nensuring the correct filtered results are returned.\n\nThis restores the v0.26.1 behavior where:\n  headscale nodes list-routes -i 12 -o json\ncorrectly returns only node 12's route information.\n","verified_at":"2025-12-10T03:23:04Z"},"event":"committed"},{"id":21468561830,"node_id":"RRE_lADOEFLz887dVgo_zwAAAAT_oEGm","url":"https://api.github.com/repos/juanfont/headscale/issues/events/21468561830","actor":{"login":"roganlynch","id":44678921,"node_id":"MDQ6VXNlcjQ0Njc4OTIx","avatar_url":"https://avatars.githubusercontent.com/u/44678921?v=4","gravatar_id":"","url":"https://api.github.com/users/roganlynch","html_url":"https://github.com/roganlynch","followers_url":"https://api.github.com/users/roganlynch/followers","following_url":"https://api.github.com/users/roganlynch/following{/other_user}","gists_url":"https://api.gith