com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"86edc5dc148d764e515e6ba93b9621e3650da28e","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/86edc5dc148d764e515e6ba93b9621e3650da28e","created_at":"2026-04-17T14:47:17Z","performed_via_github_app":null},{"sha":"78a905cc3a42941a51d0224f27aa0e40c634466d","node_id":"C_kwDOEFLz89oAKDc4YTkwNWNjM2E0Mjk0MWE1MWQwMjI0ZjI3YWEwZTQwYzYzNDQ2NmQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/78a905cc3a42941a51d0224f27aa0e40c634466d","html_url":"https://github.com/juanfont/headscale/commit/78a905cc3a42941a51d0224f27aa0e40c634466d","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-17T12:04:07Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-17T15:32:41Z"},"tree":{"sha":"69238e74722ef0451cd5272ed635679ea5c01289","url":"https://api.github.com/repos/juanfont/headscale/git/trees/69238e74722ef0451cd5272ed635679ea5c01289"},"message":"state: auto-bump GivenName on collision and add SetGivenName\n\nNodeStore's writer goroutine now resolves GivenName collisions inside\napplyBatch: on PutNode/UpdateNode the landing label gets -N appended\nuntil unique, matching Tailscale SaaS. Empty labels fall back to the\nliteral \"node\".\n\nSetGivenName exposes the admin-rename path: validates via\ndnsname.ValidLabel and rejects on collision with ErrGivenNameTaken,\nso renames do not silently rewrite behind the caller.\n\nUpdates #3188\nUpdates #2926\nUpdates #2343\nUpdates #2762","parents":[{"sha":"436d3db28e8bcf446639beb1bc2394b4bc55f84f","url":"https://api.github.com/repos/juanfont/headscale/git/commits/436d3db28e8bcf446639beb1bc2394b4bc55f84f","html_url":"https://github.com/juanfont/headscale/commit/436d3db28e8bcf446639beb1bc2394b4bc55f84f"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"94313fc9d5066acf2da8c2ca0f49a43ff9913868","node_id":"C_kwDOEFLz89oAKDk0MzEzZmM5ZDUwNjZhY2YyZGE4YzJjYTBmNDlhNDNmZjk5MTM4Njg","url":"https://api.github.com/repos/juanfont/headscale/git/commits/94313fc9d5066acf2da8c2ca0f49a43ff9913868","html_url":"https://github.com/juanfont/headscale/commit/94313fc9d5066acf2da8c2ca0f49a43ff9913868","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-17T12:06:10Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-17T15:33:18Z"},"tree":{"sha":"1294d18db7cb0d292907461cabea6c5034c9636c","url":"https://api.github.com/repos/juanfont/headscale/git/trees/1294d18db7cb0d292907461cabea6c5034c9636c"},"message":"hscontrol: route hostname handling through dnsname and NodeStore\n\nIngest (registration and MapRequest updates) now calls\ndnsname.SanitizeHostname directly and lets NodeStore auto-bump on\ncollision. Admin rename uses dnsname.ValidLabel + SetGivenName so\nconflicts are surfaced to the caller instead of silently mutated.\n\nThree duplicate invalidDNSRegex definitions, the old NormaliseHostname\nand ValidateHostname helpers, EnsureHostname, InvalidString,\nApplyHostnameFromHostInfo, GivenNameHasBeenChanged, generateGivenName\nand EnsureUniqueGivenName are removed along with their tests.\nValidateHostname's username half is retained as ValidateUsername for\nusers.go.\n\nThe SaaS-matching collision rule replaces the random \"invalid-xxxxxx\"\nfallback and the 8-character hash suffix; the empty-input fallback is\nthe literal \"node\". TestUpdateHostnameFromClient now exercises the\nrewrite end-to-end with awkward macOS/Windows names.\n\nFixes #3188\nFixes #2926\nFixes #2343\nFixes #2762\nFixes #2449\nUpdates #2177\nUpdates #2121\nUpdates #363","parents":[{"sha":"78a905cc3a42941a51d0224f27aa0e40c634466d","url":"https://api.github.com/repos/juanfont/headscale/git/commits/78a905cc3a42941a51d0224f27aa0e40c634466d","html_url":"https://github.com/juanfont/headscale/commit/78a905cc3a42941a51d0224f27aa0e40c634466d"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"62330ae7243fe7112af882744bc64ec1e7aecac7","node_id":"C_kwDOEFLz89oAKDYyMzMwYWU3MjQzZmU3MTEyYWY4ODI3NDRiYzY0ZWMxZTdhZWNhYzc","url":"https://api.github.com/repos/juanfont/headscale/git/commits/62330ae7243fe7112af882744bc64ec1e7aecac7","html_url":"https://github.com/juanfont/headscale/commit/62330ae7243fe7112af882744bc64ec1e7aecac7","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-17T12:06:52Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-17T15:33:42Z"},"tree":{"sha":"00d1ccc2bedd293e7c2b2df1a855e1af264bf8a7","url":"https://api.github.com/repos/juanfont/headscale/git/trees/00d1ccc2bedd293e7c2b2df1a855e1af264bf8a7"},"message":"CHANGELOG: document hostname cleanroom rewrite\n\nSummarise the ingest rewrite, the SaaS-matching collision rule, and the\nBREAKING change from random-suffix to numeric-suffix collision labels\nand from \"invalid-<rand>\" to the literal \"node\" fallback.\n\nUpdates #3188","parents":[{"sha":"94313fc9d5066acf2da8c2ca0f49a43ff9913868","url":"https://api.github.com/repos/juanfont/headscale/git/commits/94313fc9d5066acf2da8c2ca0f49a43ff9913868","html_url":"https://github.com/juanfont/headscale/commit/94313fc9d5066acf2da8c2ca0f49a43ff9913868"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":24614003422,"node_id":"HRFPE_lADOEFLz887_Q4EszwAAAAW7G-Le","url":"https://api.github.com/repos/juanfont/headscale/issues/events/24614003422","actor":{"login":"