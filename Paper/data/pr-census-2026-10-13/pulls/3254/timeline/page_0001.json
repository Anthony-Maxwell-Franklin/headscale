assed its address to the state layer, so a request that omitted the\nexpiration persisted 0001-01-01 instead of NULL. Both key types were\nthen rejected as already-expired on first use. Pass the request body's\n*time.Time straight through (nil when omitted).\n\nSigned-off-by: Seena Fallah <seenafallah@gmail.com>","parents":[{"sha":"3c504af2be8fe1ce10f0ff1c9503fd41215c35cc","url":"https://api.github.com/repos/juanfont/headscale/git/commits/3c504af2be8fe1ce10f0ff1c9503fd41215c35cc","html_url":"https://github.com/juanfont/headscale/commit/3c504af2be8fe1ce10f0ff1c9503fd41215c35cc"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":26992597557,"node_id":"HRFPE_lADOEFLz888AAAABBwZm0M8AAAAGSOJaNQ","url":"https://api.github.com/repos/juanfont/headscale/issues/events/26992597557","actor":{"login":"clwluvw","id":46720919,"node_id":"MDQ6VXNlcjQ2NzIwOTE5","avatar_url":"https://avatars.githubusercontent.com/u/46720919?v=4","gravatar_id":"","url":"https://api.github.com/users/clwluvw","html_url":"https://github.com/clwluvw","followers_url":"https://api.github.com/users/clwluvw/followers","following_url":"https://api.github.com/users/clwluvw/following{/other_user}","gists_url":"https://api.github.com/users/clwluvw/gists{/gist_id}","starred_url":"https://api.github.com/users/clwluvw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/clwluvw/subscriptions","organizations_url":"https://api.github.com/users/clwluvw/orgs","repos_url":"https://api.github.com/users/clwluvw/repos","events_url":"https://api.github.com/users/clwluvw/events{/privacy}","received_events_url":"https://api.github.com/users/clwluvw/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"9e5680f011784b11729703024d443301ebbf7ac5","commit_url":"https://api.github.com/repos/clwluvw/headscale/commits/9e5680f011784b11729703024d443301ebbf7ac5","create