 unit tests\r\n- [ ] added integration tests\r\n- [ ] updated documentation if needed\r\n- [x] updated CHANGELOG.md","created_at":"2026-05-09T14:45:23Z","updated_at":"2026-06-20T15:34:34Z","closed_at":null,"merged_at":null,"merge_commit_sha":null,"assignees":[],"requested_reviewers":[{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"nblock","id":131119,"node_id":"MDQ6VXNlcjEzMTExOQ==","avatar_url":"https://avatars.githubusercontent.com/u/131119?v=4","gravatar_id":"","url":"https://api.github.com/users/nblock","html_url":"https://github.com/nblock","followers_url":"https://api.github.com/users/nblock/followers","following_url":"https://api.github.com/users/nblock/following{/other_user}","gists_url":"https://api.github.com/users/nblock/gists{/gist_id}","starred_url":"https://api.github.com/users/nblock/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nblock/subscriptions","organizations_url":"https://api.github.com/users/nblock/orgs","repos_url":"https://api.github.com/users/nblock/repos","events_url":"https://api.github.com/users/nblock/events{/privacy}","received_events_url"