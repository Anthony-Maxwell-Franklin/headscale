h\n\nBuild and push multi-arch container images (linux/amd64, linux/arm64)\nto GHCR and Docker Hub on every push to main that changes Go or Nix\nfiles. Images are tagged as main-<short-sha> using ko with the same\ndistroless base image as release builds.\n\nCross-compiled binaries for linux and darwin (amd64, arm64) are\nuploaded as workflow artifacts. The README links to these via\nnightly.link for stable download URLs.","parents":[{"sha":"3678f6586081bd5ff85b39bd03e3bdb3bddfff52","url":"https://api.github.com/repos/juanfont/headscale/git/commits/3678f6586081bd5ff85b39bd03e3bdb3bddfff52","html_url":"https://github.com/juanfont/headscale/commit/3678f6586081bd5ff85b39bd03e3bdb3bddfff52"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"1dacac69bfab46e8071f2a7f6b4f314dc5d8b4eb","node_id":"C_kwDOEFLz89oAKDFkYWNhYzY5YmZhYjQ2ZTgwNzFmMmE3ZjZiNGYzMTRkYzVkOGI0ZWI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/1dacac69bfab46e8071f2a7f6b4f314dc5d8b4eb","html_url":"https://github.com/juanfont/headscale/commit/1dacac69bfab46e8071f2a7f6b4f314dc5d8b4eb","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-27T09:26:04Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-27T09:26:04Z"},"tree":{"sha":"dddd295627d5346c667c82b35882780edea07a6d","url":"https://api.github.com/repos/juanfont/headscale/git/trees/dddd295627d5346c667c82b35882780edea07a6d"},"message":"docs: add development builds install page\n\nMove the container image and binary download details from the README\ninto a dedicated documentation page at setup/install/main. This gives\ndevelopment builds a proper home in the docs site alongside the other\ninstall methods. The README now links to the docs page instead.","parents":[{"sha":"625ef6cd1cf2f188bfac9161f49742c5d862dff6","url":"https://api.github.com/repos/juanfont/headscale/git/commits/625ef6cd1cf2f1