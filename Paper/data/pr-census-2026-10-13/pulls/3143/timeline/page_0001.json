[{"sha":"be2c9d0feb8a577dfadbeac8891f43eabbc860b6","node_id":"C_kwDOEFLz89oAKGJlMmM5ZDBmZWI4YTU3N2RmYWRiZWFjODg5MWY0M2VhYmJjODYwYjY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/be2c9d0feb8a577dfadbeac8891f43eabbc860b6","html_url":"https://github.com/juanfont/headscale/commit/be2c9d0feb8a577dfadbeac8891f43eabbc860b6","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-14T14:06:52Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-14T14:06:52Z"},"tree":{"sha":"56f6d55cf9511f58f5f4447724a0036a6ff9396a","url":"https://api.github.com/repos/juanfont/headscale/git/trees/56f6d55cf9511f58f5f4447724a0036a6ff9396a"},"message":"mapper/batcher: replace connected map with per-node disconnectedAt\n\nThe Batcher's connected field (*xsync.Map[types.NodeID, *time.Time])\nencoded three states via pointer semantics:\n\n  - nil value:    node is connected\n  - non-nil time: node disconnected at that timestamp\n  - key missing:  node was never seen\n\nThis was error-prone (nil meaning 'connected' inverts Go idioms),\nredundant with b.nodes + hasActiveConnections(), and required keeping\ntwo parallel maps in sync. It also contained a bug in RemoveNode where\nnew(time.Now()) was used instead of &now, producing a zero time.\n\nReplace the separate connected map with a disconnectedAt field on\nmultiChannelNodeConn (atomic.Pointer[time.Time]), tracked directly\non the object that already manages the node's connections.\n\nChanges:\n  - Add disconnectedAt field and helpers (markConnected, markDisconnected,\n    isConnected, offlineDuration) to multiChannelNodeConn\n  - Remove the connected field from Batcher\n  - Simplify IsConnected from two map lookups to one\n  - Simplify ConnectedMap and Debug from two-map iteration to one\n  - Rewrite cleanupOfflineNodes to scan b.nodes directly\n  - Remove the markDisconnectedIfNoConns helper\n  - Update all tests and benchmarks\n\nFixes #3141","parents":[{"sha":"afd3a6acbcf5eb8c6079d181499b60aabe55df7e","url":"https://api.github.com/repos/juanfont/headscale/git/commits/afd3a6acbcf5eb8c6079d181499b60aabe55df7e","html_url":"https://github.com/juanfont/headscale/commit/afd3a6acbcf5eb8c6079d181499b60aabe55df7e"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":23600085211,"node_id":"RFRE_lADOEFLz887y8W8qzwAAAAV-rLjb","url":"https://api.github.com/repos/juanfont/headscale/issues/events/23600085211","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"ready_for_review","commit_id":null,"commit_url":null,"created_at":"2026-03-16T09:16:24Z","performed_via_github_app":null},{"id":23600085589,"node_id":"RRE_lADOEFLz887y8W8qzwAAAAV-rLpV","url":"https://api.github.com/repos/juanfont/headscale/issues/events/23600085589","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.gith