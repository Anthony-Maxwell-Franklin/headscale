,"organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"8beb7fda12ae7319a981dd55717addf03d318c32","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/8beb7fda12ae7319a981dd55717addf03d318c32","created_at":"2025-07-07T14:14:16Z","performed_via_github_app":null},{"sha":"75bc38c6a791bac49ecee0528439a25df535c6a2","node_id":"C_kwDOEFLz89oAKDc1YmMzOGM2YTc5MWJhYzQ5ZWNlZTA1Mjg0MzlhMjVkZjUzNWM2YTI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/75bc38c6a791bac49ecee0528439a25df535c6a2","html_url":"https://github.com/juanfont/headscale/commit/75bc38c6a791bac49ecee0528439a25df535c6a2","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-07-05T21:31:13Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-07-07T14:48:57Z"},"tree":{"sha":"935f825a12bade60b68b90520b9eb35eb5543ec7","url":"https://api.github.com/repos/juanfont/headscale/git/trees/935f825a12bade60b68b90520b9eb35eb5543ec7"},"message":"all: use immutable node view in read path\n\nThis commit changes most of our (*)types.Node to\ntypes.NodeView, which is a readonly version of the\nunderlying node ensuring that there is no mutations\nhappening in the read path.\n\nBased on the migration, there didnt seem to be any, but the\nidea here is to prevent it in the future and simplify other\nnew implementations.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>","parents":[{"sha":"5ba712041809d3416d09ccc0bcc77d2357ffd31f","url":"https://api.github.com/repos/juanfont/headscale/git/commits/5ba712041809d3416d09ccc0bcc77d2357ffd31f","html_url":"https://github.com/juanfont/headscale/commit/5ba712041809d