radalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"performed_via_github_app":null},{"url":"https://api.github.com/repos/juanfont/headscale/issues/comments/4232733778","html_url":"https://github.com/juanfont/headscale/pull/3179#issuecomment-4232733778","issue_url":"https://api.github.com/repos/juanfont/headscale/issues/3179","id":4232733778,"node_id":"IC_kwDOEFLz8878SmRS","user":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-12T20:58:21Z","updated_at":"2026-04-12T20:58:21Z","body":"Thanks for looking into this and for the tests — the mutex move (`pm.mu.Lock()` before the exit route check) is a good catch.\n\nHowever, the fallback to `autoApproveMap` for exit routes would diverge from SaaS behavior. We have investigated how the SaaS control server handles this and found that exit route approval **only** goes through the `exitNode` field — `0.0.0.0/0` in the `routes` map is deliberately ignored for exit approval.\n\nThe current code in `NodeCanApproveRoute` is actually correct:\n\n```go\nif tsaddr.IsExitRoute(route) {\n    if pm.exitSet == nil {    // exitSet is built from autoApprovers.exitNode\n        return false\n    }\n    if slices.ContainsFunc(node.IPs(), pm.exitSet.Contains) {\n        return true\n    }\n    return false\n}\n```\n\nThe early return when `exitSet == nil` is intentional — it prevents the function from falling through to `autoApproveMap` (which contains the `routes` map entries). Adding the fallback:\n\n```go\nif approvers, ok := pm.autoApproveMap[route]; ok {\n    return slices.ContainsFunc(node.IPs(), approvers.Contains)\n}\n```\n\nwould approve exit nodes through `routes: {\"0.0.0.0/0\": [\"tag:exit\"]}`, which SaaS does not do. The `routes` map entry for `0.0.0.0/0` serves a different purpose on SaaS — it acts as a wildcard for **subnet** route approval (e.g., auto-approving `172.16.0.0/24` for a `tag:exit` node that also advertises subnets).\n\nThe correct policy for exit node auto-approval is:\n\n```json\n\"autoApprovers\": {\n    \"exitNode\": [\"tag:exit\"]\n}\n```\n\nWe have compatibility tests covering all the combinations (exitNode field, routes map, both, wrong tags, etc.) — happy to share the test scenarios if useful.\n\nWould you be open to extracting just the mutex fix as a separate PR?","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/juanfont/headscale/issues/comments/4232733778/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":24426070879,"node_id":"CE_lADOEFLz8878dwI4zwAAAAWv6ENf","url":"https://api.github.com/repos/juanfont/headscale/issues/events/24426070879","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/re