[{"sha":"061fb609369dfa2ed22bb28b03dd9e5cd4d849b4","node_id":"C_kwDOEFLz89oAKDA2MWZiNjA5MzY5ZGZhMmVkMjJiYjI4YjAzZGQ5ZTVjZDRkODQ5YjQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/061fb609369dfa2ed22bb28b03dd9e5cd4d849b4","html_url":"https://github.com/juanfont/headscale/commit/061fb609369dfa2ed22bb28b03dd9e5cd4d849b4","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-06T10:36:58Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-06T10:36:58Z"},"tree":{"sha":"5776939767034f02e30399595a7faed49ebf8af5","url":"https://api.github.com/repos/juanfont/headscale/git/trees/5776939767034f02e30399595a7faed49ebf8af5"},"message":"nix: sync module options and descriptions with upstream nixpkgs\n\nAdd missing typed options from the upstream nixpkgs module:\n- configFile: read-only option exposing the generated config path\n  for composability with other NixOS modules\n- dns.split: split DNS configuration with proper type checking\n- dns.extra_records: typed submodule with name/type/value validation\n\nSync descriptions and assertions with upstream:\n- Use Tailscale doc link for override_local_dns description\n- Remove redundant requirement note from nameservers.global\n- Match upstream assertion message wording and expression style\n\nUpdate systemd script to reference cfg.configFile instead of a\nlocal let-binding, matching the upstream pattern.","parents":[{"sha":"8423af2732f2ef363c0a6fa53efc925a3ca12742","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8423af2732f2ef363c0a6fa53efc925a3ca12742","html_url":"https://github.com/juanfont/headscale/commit/8423af2732f2ef363c0a6fa53efc925a3ca12742"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"ca4285fba5358cffadad05eaed25dc5f51deca54","node_id":"C_kwDOEFLz89oAKGNhNDI4NWZiYTUzNThjZmZhZGFkMDVlYWVkMjVkYzVmNTFkZWNhNTQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ca4285fba5358cffadad05eaed25dc5f51deca54","html_url":"https://github.com/juanfont/headscale/commit/ca4285fba5358cffadad05eaed25dc5f51deca54","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-06T10:37:09Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-06T10:37:09Z"},"tree":{"sha":"22b209e05624ce291a4af9d3961a6e7312c020ce","url":"https://api.github.com/repos/juanfont/headscale/git/trees/22b209e05624ce291a4af9d3961a6e7312c020ce"},"message":"nix: disable external DERP URL fetch in VM test\n\nExplicitly set derp.urls to an empty list in the NixOS VM test,\nmatching the upstream nixpkgs test. The VMs have no internet\naccess, so fetching the default Tailscale DERP map would silently\nfail and add unnecessary timeout delay to the test run.","parents":[{"sha":"061fb609369dfa2ed22bb28b03dd9e5cd4d849b4","url":"https://api.github.com/repos/juanfont/headscale/git/commits/061fb609369dfa2ed22bb28b03dd9e5cd4d849b4","html_url":"https://github.com/juanfont/headscale/commit/061fb609369dfa2ed22bb28b03dd9e5cd4d849b4"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":23331962154,"node_id":"RFRE_lADOEFLz887wanumzwAAAAVusX0q","url":"https://api.github.com/repos/juanfont/headscale/issues/events/23331962154","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions",