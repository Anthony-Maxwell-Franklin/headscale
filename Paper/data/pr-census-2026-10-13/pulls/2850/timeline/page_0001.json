ons_variables":"read","administration":"read","agent_secrets":"read","agent_tasks":"write","agent_variables":"read","checks":"read","code_quality":"read","contents":"write","copilot_requests":"write","discussions":"write","environments":"write","gists":"write","issues":"write","metadata":"read","organization_agent_secrets":"read","organization_agent_variables":"read","packages":"read","plugin_gateway_connections":"write","pull_requests":"write","secrets":"read","security_events":"read","statuses":"read","workflows":"write"},"events":[]}},{"sha":"e0107024e894a4fef74076fa73729fe013018b9f","node_id":"C_kwDOEFLz89oAKGUwMTA3MDI0ZTg5NGE0ZmVmNzQwNzZmYTczNzI5ZmUwMTMwMThiOWY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/e0107024e894a4fef74076fa73729fe013018b9f","html_url":"https://github.com/juanfont/headscale/commit/e0107024e894a4fef74076fa73729fe013018b9f","author":{"name":"copilot-swe-agent[bot]","email":"198982749+Copilot@users.noreply.github.com","date":"2025-11-01T08:52:29Z"},"committer":{"name":"copilot-swe-agent[bot]","email":"198982749+Copilot@users.noreply.github.com","date":"2025-11-01T08:52:29Z"},"tree":{"sha":"8bc0fb18cad23c9d6a67ff2fd3b9c5d47b7a5156","url":"https://api.github.com/repos/juanfont/headscale/git/trees/8bc0fb18cad23c9d6a67ff2fd3b9c5d47b7a5156"},"message":"Filter exit routes through ACL policy to fix issue #2788\n\nExit nodes are now only visible to nodes that have permission to use them\naccording to ACL policy. Previously, exit routes (0.0.0.0/0 and ::/0) were\nunconditionally added to the AllowedIPs field in the network map, making\nexit nodes visible to all peers regardless of policy.\n\nChanges:\n- Modified buildTailPeers and WithSelfNode in builder.go to filter exit\n  routes through policy.ReduceRoutes, same as primary routes\n- Removed unconditional addition of exit routes in tail.go tailNode function\n- Updated tail_test.go to reflect new behavior where exit routes are filtered\n\nThe fix ensures that exit nodes are only visible when a node has\nautogroup:internet in their ACL destination rules.\n\nCo-authored-by: kradalby <98431+kradalby@users.noreply.github.com>","parents":[{"sha":"a55cdc2636436afb3b2371bf1f3ac04c921d349a","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a55cdc2636436afb3b2371bf1f3ac04c921d349a","html_url":"https://github.com/juanfont/headscale/commit/a55cdc2636436afb3b2371bf1f3ac04c921d349a"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"4fa1f4baa3d80e77febec614ab9c2501ae328441","node_id":"C_kwDOEFLz89oAKDRmYTFmNGJhYTNkODBlNzdmZWJlYzYxNGFiOWMyNTAxYWUzMjg0NDE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4fa1f4baa3d80e77febec614ab9c2501ae328441","html_url":"https://github.com/juanfont/headscale/commit/4fa1f4baa3d80e77febec614ab9c2501ae328441","author":{"name":"copilot-swe-agent[bot]","email":"198982749+Copilot@users.noreply.github.com","date":"2025-11-01T08:54:29Z"},"committer":{"name":"copilot-swe-agent[bot]","email":"198982749+Copilot@users.noreply.github.com","date":"2025-11-01T08:54:29Z"},"tree":{"sha":"8d920b9988e337752db81a1e431b10ac09d4288d","url":"https://api.github.com/repos/juanfont/headscale/git/trees/8d920b9988e337752db81a1e431b10ac09d4288d"},"message":"Add integration test for exit node ACL visibility (issue #2788)\n\nAdded TestExitNodeVisibilityWithACL to verify that exit nodes are only\nvisible to nodes that have permission according to ACL policy. The test:\n- Creates 3 nodes: mobile, server, and exit-owner\n- Sets up ACL allowing only mobile->server:80 (no autogroup:internet)\n- Advertises and approves exit routes on exit-owner node\n- Verifies mobile and server do NOT see exit node in peer list\n\nThis is a regression test for issue #2788 where exit nodes were visible\nto all nodes regardless of ACL policy.\n\nCo-authored-by: kradalby <98431+kradalby@users.noreply.github.com>","parents":[{"sha":"e0107024e894a4fef74076fa73729fe013018b9f","url":"https://api.github.com/repos/juanfont/headscale/git/commits/e0107024e894a4fef74076fa73729fe013018b9f","html_url":"https://github.com/juanfont/headscale/commit/e0107024e894a4fef74076fa73729fe013018b9f"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"1f4b645d5bb2413fbfeb139478e96b9c45b2da29","node_id":"C_kwDOEFLz89oAKDFmNGI2NDVkNWJiMjQxM2ZiZmViMTM5NDc4ZTk2YjljNDViMmRhMjk","url":"https://api.github.com/repos/juanfont/headscale/git/commits/1f4b645d5bb2413fbfeb139478e96b9c45b2da29","html_url":"https://github.com/juanfont/headscale/commit/1f4b645d5bb2413fbfeb139478e96b9c45b2da29","author":{"name":"copilot-swe-agent[bot]","email":"198982749+Copilot@users.noreply.github.com","date":"2025-11-01T09:05:37Z"},"committer":{"name":"copilot-swe-agent[bot]","email":"198982749+Copilot@users.noreply.github.com","date":"2025-11-01T09:05:37Z"},"tree":{"sha":"66b1dbf21979a30ce78a7fb2f8e7b0d480b38c53","url":"https://api.github.com/repos/juanfont/headscale/git/trees/66b1dbf21979a30ce78a7fb2f8e7b0d480b38c53"},"message":"Refactor: Extract route filtering logic into helper function\n\nAddressed code review feedback:\n- Extracted duplicated exit route filtering logic into buildRouteFilterFunc\n- Reused exitNode lookup in integration test to avoid duplication\n- Added missing matcher package import\n\nThis improves code maintainability while preserving the same functionality.\n\nCo-authored-by: kradalby <98431+kradalby@users.noreply.github.com>","parents":[{"sha":"4fa1f4baa3d80e77febec614ab9c2501ae328441","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4fa1f4baa3d80e77febec614ab9c2501ae328441","html_url":"https://github.com/juanfont/headscale/commit/4fa1f4baa3d80e77febec614ab9c2501ae328441"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":20649749018,"node_id":"RTE_lADOEFLz887VP