[{"sha":"72feb27d779dc13d993ec57b61c74481967bc663","node_id":"C_kwDOEFLz89oAKDcyZmViMjdkNzc5ZGMxM2Q5OTNlYzU3YjYxYzc0NDgxOTY3YmM2NjM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/72feb27d779dc13d993ec57b61c74481967bc663","html_url":"https://github.com/juanfont/headscale/commit/72feb27d779dc13d993ec57b61c74481967bc663","author":{"name":"MsfPablo","email":"129399053+MsfPablo@users.noreply.github.com","date":"2026-08-05T08:47:01Z"},"committer":{"name":"MsfPablo","email":"129399053+MsfPablo@users.noreply.github.com","date":"2026-08-05T08:47:01Z"},"tree":{"sha":"fa167c9dc6f322f3728c708c5dc0505ee16aa6f0","url":"https://api.github.com/repos/juanfont/headscale/git/trees/fa167c9dc6f322f3728c708c5dc0505ee16aa6f0"},"message":"state: expose a JSON-safe summary of pending registration cache entries\n\nDebugRegistrationCache() already stopped marshaling raw AuthRequest\nvalues (fixing the reported chan-in-JSON panic), but it also stopped\nsaying anything about individual entries, leaving unmet the issue's\nstated expectation of being able to \"display the current registration\ncache\".\n\nAuthRequest carries unexported fields backed by a channel, so it can't\nbe marshaled directly. Add a per-entry summary (auth_id, flow type:\nregistration/ssh-check/plain) built from AuthRequest's existing public\naccessors (IsRegistration/IsSSHCheck), which never touch the channel.\nPeek is used instead of Get so inspecting the cache for debugging\ndoesn't itself affect LRU recency/eviction order.\n\nRenamed the existing TestDebugRegistrationCache, which actually\nexercised NodeStore.DebugString (a different type), to\nTestNodeStoreDebugRegistrationCache, and added\nTestStateDebugRegistrationCache to cover State.DebugRegistrationCache\nitself.\n\nRelates to #2714","parents":[{"sha":"565fd254d06c4c7f9a8cad1714a43445c79ba420","url":"https://api.github.com/repos/juanfont/headscale/git/commits/565fd254d06c4c7f9a8cad1714a43445c79ba420","html_url":"https://github.com/juanfont/headscale/commit/565fd254d06c4c7f9a8cad1714a43445c79ba420"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":29010023608,"node_id":"RRE_lADOEFLz888AAAABLkM4KM8AAAAGwSHUuA","url":"https://api.github.com/repos/juanfont/headscale/issues/events/29010023608","actor":{"login":"MsfPablo","id":129399053,"node_id":"U_kgDOB7Z5DQ","avatar_url":"https://avatars.githubusercontent.com/u/129399053?v=4","gravatar_id":"","url":"https://api.github.com/users/MsfPablo","html_url":"https://github.com/MsfPablo","followers_url":"https://api.github.com/users/MsfPablo/followers","following_url":"https://api.github.com/users/MsfPablo/following{/other_user}","gists_url":"https://api.github.com/users/MsfPablo/gists{/gist_id}","starred_url":"https://api.github.com/users/MsfPablo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MsfPablo/subscriptions","organizations_url":"https://api.github.com/users/MsfPablo/orgs","repos_url":"https://api.github.com/users/MsfPablo/repos","events_url":"https://api.github.com/users/MsfPablo/events{/privacy}","received_events_url":"https://api.github.com/users/MsfPablo/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"review_requested","commit_id":null,"commit_url":null,"created_at":"2026-08-05T13:01:29Z","review_requester":{"login":"MsfPablo","id":129399053,"node_id":"U_kgDOB7Z5DQ","avatar_url":"https://avatars.githubusercontent.com/u/129399053?v=4","gravatar_id":"","url":"https://api.github.com/users/MsfPablo","html_url":"https://github.com/MsfPablo","followers_url":"https://api.github.com/users/MsfPablo/followers","following_url":"https://api.github.com/users/MsfPablo/following{/other_user}","gists_url":"https://api.github.com/users/MsfPablo/gists{/gist_id}","starred_url":"https://api.github.com/users/MsfPablo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MsfPablo/subscriptions","organizations_u