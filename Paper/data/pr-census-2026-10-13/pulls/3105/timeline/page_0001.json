[{"sha":"ed7800af24d82157f5907c1cc3f8c8bf6296cafb","node_id":"C_kwDOEFLz89oAKGVkNzgwMGFmMjRkODIxNTdmNTkwN2MxY2MzZjhjOGJmNjI5NmNhZmI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ed7800af24d82157f5907c1cc3f8c8bf6296cafb","html_url":"https://github.com/juanfont/headscale/commit/ed7800af24d82157f5907c1cc3f8c8bf6296cafb","author":{"name":"Loki Jacobsen","email":"loki@eltoro.com","date":"2026-02-25T02:49:07Z"},"committer":{"name":"Loki Jacobsen","email":"loki@eltoro.com","date":"2026-02-25T02:49:07Z"},"tree":{"sha":"51b203c7843329868cd0cfdaf48a33af1019ff99","url":"https://api.github.com/repos/juanfont/headscale/git/trees/51b203c7843329868cd0cfdaf48a33af1019ff99"},"message":"fix(policy/v2): use TrimPrefix for leading @ in username resolution\n\nresolveUser used strings.TrimSuffix to strip the @ character, but the\nheadscale ACL policy format uses a leading @ (e.g., @username), not a\ntrailing one. This caused all group-based ACL source rules to silently\nfail user resolution, producing empty filter sets.\n\nStrip both leading and trailing @ to handle both @username (policy\nformat) and username@ (email-style) identifiers correctly.\n\nFixes juanfont/headscale#3104","parents":[{"sha":"8048f10d1342c6b8e51f3ec85da3ae350f1b196b","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8048f10d1342c6b8e51f3ec85da3ae350f1b196b","html_url":"https://github.com/juanfont/headscale/commit/8048f10d1342c6b8e51f3ec85da3ae350f1b196b"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":23053916966,"node_id":"RRE_lADOEFLz887toygZzwAAAAVeHtsm","url":"https://api.github.com/repos/juanfont/headscale/issues/events/23053916966","actor":{"login":"lokkju","id":235371,"node_id":"MDQ6VXNlcjIzNTM3MQ==","avatar_url":"https://avatars.githubusercontent.com/u/235371?v=4","gravatar_id":"","url":"https://api.github.com/users/lokkju","html_url":"https://github.com/lokkju","followers_url":"http