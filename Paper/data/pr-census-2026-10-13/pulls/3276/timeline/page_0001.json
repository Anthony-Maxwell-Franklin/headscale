[{"sha":"df7cf3e987b332e9cfb1839b3850aebb6dab5688","node_id":"C_kwDOEFLz89oAKGRmN2NmM2U5ODdiMzMyZTljZmIxODM5YjM4NTBhZWJiNmRhYjU2ODg","url":"https://api.github.com/repos/juanfont/headscale/git/commits/df7cf3e987b332e9cfb1839b3850aebb6dab5688","html_url":"https://github.com/juanfont/headscale/commit/df7cf3e987b332e9cfb1839b3850aebb6dab5688","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-20T08:48:35Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-20T08:48:35Z"},"tree":{"sha":"05a006dbce4df6bb60bcc17243f733c2d7d5b153","url":"https://api.github.com/repos/juanfont/headscale/git/trees/05a006dbce4df6bb60bcc17243f733c2d7d5b153"},"message":"noise: pin outer RemoteAddr onto tunnel requests\n\nThe HTTP/2 server inside the Noise tunnel fills r.RemoteAddr from the\nhijacked TCP socket, so /machine/register and /machine/map logged the\nreverse proxy's loopback peer (e.g. 127.0.0.1:44388) even with\ntrusted_proxies set. The outer router's realIPMiddleware had already\nresolved the client IP onto req.RemoteAddr; that value never crossed\nthe hijack.\n\nReplace the inner realIPMiddleware mount — dead inside the encrypted\ntunnel — with overrideRemoteAddr(req.RemoteAddr) so requests served\nover the tunnel report the outer-resolved client IP.","parents":[{"sha":"4cca63155d7a1bed3c806f876991a1a05e77bb73","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4cca63155d7a1bed3c806f876991a1a05e77bb73","html_url":"https://github.com/juanfont/headscale/commit/4cca63155d7a1bed3c806f876991a1a05e77bb73"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":25748160481,"node_id":"RFRE_lADOEFLz888AAAABC1AMfc8AAAAF_rW_4Q","url":"https://api.github.com/repos/juanfont/headscale/issues/events/25748160481","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4