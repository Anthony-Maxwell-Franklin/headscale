[{"sha":"d9b84d0775d67949f306e5b34fdf66def961d78b","node_id":"C_kwDOEFLz89oAKGQ5Yjg0ZDA3NzVkNjc5NDlmMzA2ZTViMzRmZGY2NmRlZjk2MWQ3OGI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/d9b84d0775d67949f306e5b34fdf66def961d78b","html_url":"https://github.com/juanfont/headscale/commit/d9b84d0775d67949f306e5b34fdf66def961d78b","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T16:11:33Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-14T16:09:06Z"},"tree":{"sha":"5dc10054e870cb06d2fef8847c992c55b7d54aaf","url":"https://api.github.com/repos/juanfont/headscale/git/trees/5dc10054e870cb06d2fef8847c992c55b7d54aaf"},"message":"mapper/batcher: remove disabled X-prefixed test functions\n\nRemove XTestBatcherChannelClosingRace (~95 lines) and\nXTestBatcherScalability (~515 lines). These were disabled by\nprefixing with X (making them invisible to go test) and served\nas dead code. The functionality they covered is exercised by the\nactive test suite.\n\nUpdates #2545","parents":[{"sha":"feaf85bfbca1bbb00990faa3feef51c2b420df32","url":"https://api.github.com/repos/juanfont/headscale/git/commits/feaf85bfbca1bbb00990faa3feef51c2b420df32","html_url":"https://github.com/juanfont/headscale/commit/feaf85bfbca1bbb00990faa3feef51c2b420df32"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"181987ca507d5eb8e961451ab7ae5b7e35694ce9","node_id":"C_kwDOEFLz89oAKDE4MTk4N2NhNTA3ZDVlYjhlOTYxNDUxYWI3YWU1YjdlMzU2OTRjZTk","url":"https://api.github.com/repos/juanfont/headscale/git/commits/181987ca507d5eb8e961451ab7ae5b7e35694ce9","html_url":"https://github.com/juanfont/headscale/commit/181987ca507d5eb8e961451ab7ae5b7e35694ce9","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-14T16:09:22Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-14T16:09:22Z"},"tree":{"sha":"5c9ba837d24a08cb827a6ab64b2825e0ae19048b","url":"https://api.github.com/repos/juanfont/headscale/git/trees/5c9ba837d24a08cb827a6ab64b2825e0ae19048b"},"message":"mapper/batcher: serialize per-node work to prevent out-of-order delivery\n\nprocessBatchedChanges queued each pending change for a node as a\nseparate work item. Since multiple workers pull from the same channel,\ntwo changes for the same node could be processed concurrently by\ndifferent workers. This caused two problems:\n\n1. MapResponses delivered out of order — a later change could finish\n   generating before an earlier one, so the client sees stale state.\n2. updateSentPeers and computePeerDiff race against each other —\n   updateSentPeers does Clear() + Store() which is not atomic relative\n   to a concurrent Range() in computePeerDiff.\n\nBundle all pending changes for a node into a single work item so one\nworker processes them sequentially. Add a per-node workMu that\nserializes processing across consecutive batch ticks, preventing a\nsecond worker from starting tick N+1 while tick N is still in progress.\n\nFixes #3140","parents":[{"sha":"d9b84d0775d67949f306e5b34fdf66def961d78b","url":"https://api.github.com/repos/juanfont/headscale/git/commits/d9b84d0775d67949f306e5b34fdf66def961d78b","html_url":"https://github.com/juanfont/headscale/commit/d9b84d0775d67949f306e5b34fdf66def961d78b"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":23599897638,"node_id":"RFRE_lADOEFLz887y9NqNzwAAAAV-qdwm","url":"https://api.github.com/repos/juanfont/headscale/issues/events/23599897638","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com