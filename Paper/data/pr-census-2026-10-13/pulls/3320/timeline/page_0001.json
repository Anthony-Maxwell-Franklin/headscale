age":"cmd/headscale: run the CLI on the generated v1 HTTP client\n\nServe the API over the unix socket (auth bypassed; socket permissions are the\ntrust boundary) and convert every CLI command from the gRPC client to the\ngenerated ogen client. Remote CLI now uses the HTTP API URL.","parents":[{"sha":"87af3320a46ac77792a0a1e94d351346eb748061","url":"https://api.github.com/repos/juanfont/headscale/git/commits/87af3320a46ac77792a0a1e94d351346eb748061","html_url":"https://github.com/juanfont/headscale/commit/87af3320a46ac77792a0a1e94d351346eb748061"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"f78c1900e3dbd002e7fef7db314a54ee32c33e44","node_id":"C_kwDOEFLz89oAKGY3OGMxOTAwZTNkYmQwMDJlN2ZlZjdkYjMxNGE1NGVlMzJjMzNlNDQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f78c1900e3dbd002e7fef7db314a54ee32c33e44","html_url":"https://github.com/juanfont/headscale/commit/f78c1900e3dbd002e7fef7db314a54ee32c33e44","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-17T18:01:04Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-19T06:11:29Z"},"tree":{"sha":"67ee5636edb8d9b685fdfd888d96fba34a23687c","url":"https://api.github.com/repos/juanfont/headscale/git/trees/67ee5636edb8d9b685fdfd888d96fba34a23687c"},"message":"all: remove the gRPC service, grpc-gateway, and Protobuf stack\n\nDelete grpcv1.go, the TCP gRPC listener, the auth interceptor and the HTTP\nbearer middleware; the proto/ definitions and their generated code; the buf,\nproto and gRPC build tooling (flake, Makefile, CI, config); and the proto\nbuilders on the types. The v1 API is now served only over HTTP (TCP + unix\nsocket) by the ogen stack.","parents":[{"sha":"bd30ca55f1443dfb968acafad3c087c1d3be985d","url":"https://api.github.com/repos/juanfont/headscale/git/commits/bd30ca55f1443dfb968acafad3c087c1d3be985d","html_url":"https://github.com/juanfont/headscale/commit/bd30ca55f1443dfb968acafad3c087c1d3be985d"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"1b50b7ef4af30a66a248122eab71559639bbc4ca","node_id":"C_kwDOEFLz89oAKDFiNTBiN2VmNGFmMzBhNjZhMjQ4MTIyZWFiNzE1NTk2MzliYmM0Y2E","url":"https://api.github.com/repos/juanfont/headscale/git/commits/1b50b7ef4af30a66a248122eab71559639bbc4ca","html_url":"https://github.com/juanfont/headscale/commit/1b50b7ef4af30a66a248122eab71559639bbc4ca","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-18T07:37:25Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-19T06:11:29Z"},"tree":{"sha":"f7d519089c15d5ceace408b7013faccf9d150b09","url":"https://api.github.com/repos/juanfont/headscale/git/trees/f7d519089c15d5ceace408b7013faccf9d150b09"},"message":"servertest: cover API error translation for missing and invalid input\n\nAsserts not-found nodes/users/keys return 404 and invalid CIDR/policy\nreturn 400. These caught the node-500 and pre-auth-key silent-success\nbugs fixed alongside.","parents":[{"sha":"f78c1900e3dbd002e7fef7db314a54ee32c33e44","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f78c1900e3dbd002e7fef7db314a54ee32c33e44","html_url":"https://github.com/juanfont/headscale/commit/f78c1900e3dbd002e7fef7db314a54ee32c33e44"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"386391741936b1ef92066365214002db1b2208c5","node_id":"C_kwDOEFLz89oAKDM4NjM5MTc0MTkzNmIxZWY5MjA2NjM2NTIxNDAwMmRiMWIyMjA4YzU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/386391741936b1ef92066365214002db1b2208c5","html_url":"https://github.com/juanfont/headscale/commit/386391741936b1ef92066365214002db1b2208c5","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-17T18:23:06Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-19T06:11:29Z"},"tree":{"sha":"bb2edf76f64ac5b0bde962c25aad4d7a37fc2c4e","url":"https://api.github.com/repos/juanfont/headscale/git/trees/bb2edf76f64ac5b0bde962c25aad4d7a37fc2c4e"},"message":"integration: port tests to the ogen API types\n\nDecode CLI/HTTP output into apiv1 (ogen) types instead of the proto types,\nmatching the new wire format. No proto package is imported outside gen/go now.","parents":[{"sha":"1b50b7ef4af30a66a248122eab71559639bbc4ca","url":"https://api.github.com/repos/juanfont/headscale/git/commits/1b50b7ef4af30a66a248122eab71559639bbc4ca","html_url":"https://github.com/juanfont/headscale/commit/1b50b7ef4af30a66a248122eab71559639bbc4ca"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"0c418213591a767ee4c515bc57c2fbd4dde4aeb4","node_id":"C_kwDOEFLz89oAKDBjNDE4MjEzNTkxYTc2N2VlNGM1MTViYzU3YzJmYmQ0ZGRlNGFlYjQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/0c418213591a767ee4c515bc57c2fbd4dde4aeb4","html_url":"https://github.com/juanfont/headscale/commit/0c418213591a767ee4c515bc57c2fbd4dde4aeb4","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-17T15:12:46Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-06-19T06:11:29Z"},"tree":{"sha":"df83d61b9a60f10693afd4e7743b83db2e214d1c","url":"https://api.github.com/repos/juanfont/headscale/git/trees/df83d61b9a60f10693afd4e7743b83db2e214d1c"},"message":"docs: add v1-ogen migration plan and changelog","parents":[{"sha":"386391741936b1ef92066365214002db1b2208c5","url":"https://api.github.com/repos/juanfont/headscale/git/commits/386391741936b1ef92066365214002db1b2208c5","html_url":"https://github.com/juanfont/headscale/commit/386391741936b1ef92066365214002db1b2208c5"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"c