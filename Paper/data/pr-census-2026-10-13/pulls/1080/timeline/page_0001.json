[{"sha":"1c826e09ba463cdae79c6dffaa587c5fe7fbd1fe","node_id":"C_kwDOEFLz89oAKDFjODI2ZTA5YmE0NjNjZGFlNzljNmRmZmFhNTg3YzVmZTdmYmQxZmU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/1c826e09ba463cdae79c6dffaa587c5fe7fbd1fe","html_url":"https://github.com/juanfont/headscale/commit/1c826e09ba463cdae79c6dffaa587c5fe7fbd1fe","author":{"name":"Juan Font","email":"juanfontalonso@gmail.com","date":"2022-12-09T16:56:43Z"},"committer":{"name":"Kristoffer Dalby","email":"kradalby@kradalby.no","date":"2022-12-21T18:45:56Z"},"tree":{"sha":"8cc14499a25d92695ecef2d397855eefadadbc81","url":"https://api.github.com/repos/juanfont/headscale/git/trees/8cc14499a25d92695ecef2d397855eefadadbc81"},"message":"Run the Noise handlers under a new struct so we can access the noiseConn from the handlers\n\nIn TS2021 the MachineKey can be obtained from noiseConn.Peer() - contrary to what I thought before,\nwhere I assumed MachineKey was dropped in TS2021.\n\nBy having a ts2021App and hanging from there the TS2021 handlers, we can fetch again the MachineKey.","parents":[{"sha":"6e890afc5f648fb757386626837eaf16c288ea20","url":"https://api.github.com/repos/juanfont/headscale/git/commits/6e890afc5f648fb757386626837eaf16c288ea20","html_url":"https://github.com/juanfont/headscale/commit/6e890afc5f648fb757386626837eaf16c288ea20"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAAGgAAAATZWNkc2Etc2hhMi1uaXN0cDI1NgAAAAhuaXN0cDI1NgAAAE\nEEap6x8bOW08D6k1VDrrtPW0rNCjPT2pNyhCyHKDGXvcjcRtgPm+ccW0L62fOJVt/FLHxk\nNG88M3u8cRqUTlTclQAAAANnaXQAAAAAAAAABnNoYTUxMgAAAGQAAAATZWNkc2Etc2hhMi\n1uaXN0cDI1NgAAAEkAAAAgHiK0pj24f8fELPkym8BZKchn8a1djcYB5V+YLLivuwAAAAAh\nAJqh+nzfn0NJ+8m+HisrH1H2YQYqY/Uq9uGTVBVBgi1p\n-----END SSH SIGNATURE-----","payload":"tree 8cc14499a25d92695ecef2d397855eefadadbc81\nparent 6e890afc5f648fb757386626837eaf16c288ea20\nauthor Juan Font <juanfontalonso@gmail.com> 1670605003 +0000\ncommitter Kristoffer Dalby <kradalby@krad