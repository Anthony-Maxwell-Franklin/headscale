ZTU="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["tailscale","tailscale-control-server","tailscale-server","wireguard"],"visibility":"public","forks":2627,"open_issues":132,"watchers":44591,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/juanfont/headscale/pulls/1931"},"html":{"href":"https://github.com/juanfont/headscale/pull/1931"},"issue":{"href":"https://api.github.com/repos/juanfont/headscale/issues/1931"},"comments":{"href":"https://api.github.com/repos/juanfont/headscale/issues/1931/comments"},"review_comments":{"href":"https://api.github.com/repos/juanfont/headscale/pulls/1931/comments"},"review_comment":{"href":"https://api.github.com/repos/juanfont/headscale/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/juanfont/headscale/pulls/1931/commits"},"statuses":{"href":"https://api.github.com/repos/juanfont/headscale/statuses/a49755e1aba88e9d9e41a8c687600093f96c5356"}},"author_association":"COLLABORATOR","auto_merge":{"enabled_by":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"merge_method":"squash","commit_title":"Simplify map session management (#1931)","commit_message":"This PR removes the complicated session management introduced in https://github.com/juanfont/headscale/pull/1791 which kept track of the sessions in a map, in addition to the channel already kept track of in the notifier.\r\n\r\nInstead of trying to close the mapsession, it will now be replaced by the new one and closed after so all new updates goes to the right place.\r\n\r\nThe map session serve function is also split into a streaming and a non-streaming version for better readability.\r\n\r\nRemoveNode in the notifier will not remove a node if the channel is not matching the one that has been passed (e.g. it has been replaced with a new one).\r\n\r\nA new tuning parameter has been added to added to set timeout before the notifier gives up to send an update to a node.\r\n\r\nAdd a keep alive resetter so we wait with sending keep alives if a node has just received an update.\r\n\r\nIn addition it adds a bunch of env debug flags that can be set:\r\n\r\n- `HEADSCALE_DEBUG_HIGH_CARDINALITY_METRICS`: make certain metrics include per node.id, not recommended to use in prod. \r\n- `HEADSCALE_DEBUG_PROFILING_ENABLED`: activate tracing \r\n- `HEADSCALE_DEBUG_PROFILING_PATH`: where to store traces \r\n- `HEADSCALE_DEBUG_DUMP_CONFIG`: calls `spew.Dump` on the config object startup\r\n- `HEADSCALE_DEBUG_DEADLOCK`: enable go-deadlock to dump goroutines if it looks like a deadlock has occured, enabled in integration tests.\r\n\r\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>"},"assignee":null,"active_lock_reason":null,"merged":true,"mergeable":null,"rebaseable":null,"mergeable_state":"unknown","merged_by":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby"