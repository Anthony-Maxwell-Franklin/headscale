[{"sha":"3b8bad4252652995d5b95467d39befc79a1a26db","node_id":"C_kwDOEFLz89oAKDNiOGJhZDQyNTI2NTI5OTVkNWI5NTQ2N2QzOWJlZmM3OWExYTI2ZGI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/3b8bad4252652995d5b95467d39befc79a1a26db","html_url":"https://github.com/juanfont/headscale/commit/3b8bad4252652995d5b95467d39befc79a1a26db","author":{"name":"Rogan Lynch","email":"roganl@gmail.com","date":"2025-12-05T16:40:51Z"},"committer":{"name":"Rogan Lynch","email":"roganl@gmail.com","date":"2025-12-05T16:40:51Z"},"tree":{"sha":"cbd7d67c13168a357c886330fbedd2dcb45f67c2","url":"https://api.github.com/repos/juanfont/headscale/git/trees/cbd7d67c13168a357c886330fbedd2dcb45f67c2"},"message":"feat(mapper): add SendDirectUpdate method for direct MapResponse delivery\n\nAdd SendDirectUpdate method to LockFreeBatcher to enable sending MapResponse\nmessages directly to specific nodes without going through the change broadcast\nsystem. This is useful for targeted updates like PingRequests that need to be\ndelivered immediately to a specific node.\n\nThe method:\n- Validates the MapResponse and node existence\n- Checks for active connections\n- Sends directly via the node's send method\n- Logs delivery status for debugging\n\nThis lays the groundwork for implementing ping functionality that requires\ndirect node communication.\n\nRelated to #2902","parents":[{"sha":"eb788cd007119472b99787c8c3af6d6204e8b834","url":"https://api.github.com/repos/juanfont/headscale/git/commits/eb788cd007119472b99787c8c3af6d6204e8b834","html_url":"https://github.com/juanfont/headscale/commit/eb788cd007119472b99787c8c3af6d6204e8b834"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAARcAAAAHc3NoLXJzYQAAAAMBAAEAAAEBANLHmfZ/tH39b44j6zg9Cf\nEDuSaDwUbQd1QSaH/3ZEechpGdLrCVWspLY+M/WusCFv2O6RhwYdl3uh07Z2KuBoCSUcy8\nFlTGdvoXPkpspT7MtYMN7n0oL7IOJ5jvFS2IIg8lhUbutjVO45O162haDrxRMLGOqTEhsy\neDBQEPhjEfuNBYMs+JjY4iPa2IjyucrusTzHzhfPrJCSmvfMy9tOZBiCh65+