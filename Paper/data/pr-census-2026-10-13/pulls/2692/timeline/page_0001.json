[{"sha":"e8e4d585e3d9a4ab11bbc4664e95115118989443","node_id":"C_kwDOEFLz89oAKGU4ZTRkNTg1ZTNkOWE0YWIxMWJiYzQ2NjRlOTUxMTUxMTg5ODk0NDM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/e8e4d585e3d9a4ab11bbc4664e95115118989443","html_url":"https://github.com/juanfont/headscale/commit/e8e4d585e3d9a4ab11bbc4664e95115118989443","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-07-16T11:07:00Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-07-16T11:07:00Z"},"tree":{"sha":"594d927a10435c6e1f67b2e5968d333a01acee46","url":"https://api.github.com/repos/juanfont/headscale/git/trees/594d927a10435c6e1f67b2e5968d333a01acee46"},"message":"all: remove 32 bit support\n\nThis commit removes the official 32 bit builds.\nAs per #2511, they are broken at runtime and we\ndo not have any good way to ensure that they run over\ntime as we cannot catch these issue at compile or\ntest time.\n\n64-bit has been around for long enough that this\nchange should not be too disruptive.\n\n32-bit users can compile the code themselves, and\nwe can still be open to accept patches for it, but\nnot provide builds as they might not work over time.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>","parents":[{"sha":"a98d9bd05f9b5f02bd642d5853c75d87d708fb4a","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a98d9bd05f9b5f02bd642d5853c75d87d708fb4a","html_url":"https://github.com/juanfont/headscale/commit/a98d9bd05f9b5f02bd642d5853c75d87d708fb4a"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgmMAoz5Zf+w0nAxyA6/zsNd95cP\n98YbtHIIXyy9A1sssAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQEoJRQlA091oudau4XM7XwuLpLQeXo1RfPklmf/QN3zsY5MvLzvhPIAZfgM+7L27Yv\nTmqo6R2egycCxTHzg6eQs=\n-----END SSH SIGNATURE-----","payload":"tree 594d927a10435c6e1f67b2e5968d333a01acee46\nparent a98d9bd05f9b5f02bd642d5853c75d87d708fb4a\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1752664020 +0200\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1752664020 +0200\n\nall: remove 32 bit support\n\nThis commit removes the official 32 bit builds.\nAs per #2511, they are broken at runtime and we\ndo not have any good way to ensure that they run over\ntime as we cannot catch these issue at compile or\ntest time.\n\n64-bit has been around for long enough that this\nchange should not be too disruptive.\n\n32-bit users can compile the code themselves, and\nwe can still be open to accept patches for it, but\nnot provide builds as they might not work over time.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>\n","verified_at":"2025-07-16T11:09:12Z"},"event":"committed"},{"url":"https://api.github.com/repos/juanfont/headscale/issues/comments/3078080979","html_url":"https://github.com/juanfont/headscale/pull/2692#issuecomment-3078080979","issue_url":"https://api.github.com/repos/juanfont/headscale/issues/2692","id":3078080979,"node_id":"IC_kwDOEFLz8863d8nT","user":{"login":"ghost","id":10137,"node_id":"MDQ6VXNlcjEwMTM3","avatar_url":"https://avatars.githubusercontent.com/u/10137?v=4","gravatar_id":"","url":"https://api.github.com/users/ghost","html_url":"https://github.com/ghost","followers_url":"https://api.github.com/users/ghost/followers","following_url":"https://api.github.com/users/ghost/following{/other_user}","gists_url":"https://api.github.com/users/ghost/gists{/gist_id}","starred_url":"https://api.github.com/users/ghost/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ghost/subscriptions","organizations_url":"https://api.github.com/users/ghost/orgs","repos_url":"https://api.github.com/users/ghost/repos","events_url":"https://api.github.com/users/ghost/events{/privacy}","received_events_url":"https://api.github.com/users/ghost/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-07-16T11:09:3