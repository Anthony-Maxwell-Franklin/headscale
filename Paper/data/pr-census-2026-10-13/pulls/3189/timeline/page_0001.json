[{"sha":"5b1f40de5623419d5d682a0bd9423a133582d669","node_id":"C_kwDOEFLz89oAKDViMWY0MGRlNTYyMzQxOWQ1ZDY4MmEwYmQ5NDIzYTEzMzU4MmQ2Njk","url":"https://api.github.com/repos/juanfont/headscale/git/commits/5b1f40de5623419d5d682a0bd9423a133582d669","html_url":"https://github.com/juanfont/headscale/commit/5b1f40de5623419d5d682a0bd9423a133582d669","author":{"name":"Yuri Khrustalev","email":"yuri@liquid.ai","date":"2026-04-14T02:34:35Z"},"committer":{"name":"Yuri Khrustalev","email":"yuri@liquid.ai","date":"2026-04-14T02:55:26Z"},"tree":{"sha":"6565203a4734441f5b2f5178284110fd909849db","url":"https://api.github.com/repos/juanfont/headscale/git/trees/6565203a4734441f5b2f5178284110fd909849db"},"message":"types, util: normalise hostnames from hostinfo instead of rejecting\n\nHostnames like \"Joe's Mac mini\" that aren't valid DNS labels were\ndropped on registration (falling back to invalid-<random>) and then\nrepeatedly rejected on every MapRequest with \"Rejecting invalid\nhostname update from hostinfo\". Route them through\nutil.NormaliseHostname, which strips disallowed characters and\ntruncates to the 63-char DNS label limit; only give up when the\nnormalised value is still invalid (empty, or starts/ends with a dash).","parents":[{"sha":"32e1d77663e50ec607e512640d281857ce5fb3c8","url":"https://api.github.com/repos/juanfont/headscale/git/commits/32e1d77663e50ec607e512640d281857ce5fb3c8","html_url":"https://github.com/juanfont/headscale/commit/32e1d77663e50ec607e512640d281857ce5fb3c8"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niQIzBAABCgAdFiEEe7szMGVXvhxnVHirOGzlfv/r30QFAmndrJ4ACgkQOGzlfv/r\n30RN0Q/9EIC2OFRYBqhER1twv4h+fixEdg6ywExVHhhPSQqKsK+cAG2uilqUW1/D\nN86RvgceBqqD4oAAWiihFw/K83PzPNW9sG5219rjplABoOT7ygeOHj8XDfjZDvVO\nlqBJ6qBf4j1x4VoPxVkxL9UaXXAT5swVDiBPzGdjDthvPbrKYpliVNnPEsd3Q4pg\nVaVAvSJjJvmqr9P4CZFJR7DcjHYupxwdwZmT3JmZwevawzso25I0FvKLA/iUdYZO\n3HONgm3OkD5ryypRG5T0yGQxCrZJGqV2/WW6lCxn8MQ1KfonKv3mlFCHnS35hHFX\n0lsEIDL