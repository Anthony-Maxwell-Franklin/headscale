[{"sha":"ddcadef8cef9273647694c900e57ab24860017bf","node_id":"C_kwDOEFLz89oAKGRkY2FkZWY4Y2VmOTI3MzY0NzY5NGM5MDBlNTdhYjI0ODYwMDE3YmY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ddcadef8cef9273647694c900e57ab24860017bf","html_url":"https://github.com/juanfont/headscale/commit/ddcadef8cef9273647694c900e57ab24860017bf","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-20T08:59:03Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-29T10:17:12Z"},"tree":{"sha":"937867057c2fdec1b794e579b601a9d337509eca","url":"https://api.github.com/repos/juanfont/headscale/git/trees/937867057c2fdec1b794e579b601a9d337509eca"},"message":"build: bump Go toolchain to 1.26.5\n\nTailscale HEAD go.mod now requires go >= 1.26.5; build images pinned\n1.26.4. Bump go.mod, the four Go Dockerfiles, and the nixpkgs pin\n(staging-next-26.05 ships go_1_26 1.26.5; unstable still lags).\n\n(cherry picked from commit 8eec2dbdc2d6fc545ca1e264dcdc3d21f86b966f)","parents":[{"sha":"8eea89488c642f3d5f617fab5493d5f51f6f4ad0","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8eea89488c642f3d5f617fab5493d5f51f6f4ad0","html_url":"https://github.com/juanfont/headscale/commit/8eea89488c642f3d5f617fab5493d5f51f6f4ad0"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"973b791b05ba7d33a1d86738808e12c775ac1022","node_id":"C_kwDOEFLz89oAKDk3M2I3OTFiMDViYTdkMzNhMWQ4NjczODgwOGUxMmM3NzVhYzEwMjI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/973b791b05ba7d33a1d86738808e12c775ac1022","html_url":"https://github.com/juanfont/headscale/commit/973b791b05ba7d33a1d86738808e12c775ac1022","author":{"name":"Florian Preinstorfer","email":"site-github@nblock.org","date":"2026-07-24T16:48:26Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-29T10:17:12Z"},"tree":{"sha":"965a2c3993984970d8ec8e8cdae1d5d1a64e262e","url":"https://api.github.com/repos/juanfont/headscale/git/trees/965a2c3993984970d8ec8e8cdae1d5d1a64e262e"},"message":"Explicitly select lunr as search provider\n\nKeep the existing search provider instead (and the separator) option.\n\n(cherry picked from commit 7a1ee34f7122993ff1b6c703eef96545832c034a)","parents":[{"sha":"ddcadef8cef9273647694c900e57ab24860017bf","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ddcadef8cef9273647694c900e57ab24860017bf","html_url":"https://github.com/juanfont/headscale/commit/ddcadef8cef9273647694c900e57ab24860017bf"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"b1d9a0484965b515ac433d020b1c80ec8e02580c","node_id":"C_kwDOEFLz89oAKGIxZDlhMDQ4NDk2NWI1MTVhYzQzM2QwMjBiMWM4MGVjOGUwMjU4MGM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/b1d9a0484965b515ac433d020b1c80ec8e02580c","html_url":"https://github.com/juanfont/headscale/commit/b1d9a0484965b515ac433d020b1c80ec8e02580c","author":{"name":"Arpit Jain","email":"arpitjain099@gmail.com","date":"2026-07-21T18:34:29Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-29T10:17:12Z"},"tree":{"sha":"0e379a477c7c0b4e9257fe7181b0c941825afc97","url":"https://api.github.com/repos/juanfont/headscale/git/trees/0e379a477c7c0b4e9257fe7181b0c941825afc97"},"message":"auth: check machine key on the followup registration path\n\nwaitForFollowup returns nodeToRegisterResponse for a completed\nregistration without checking that the Noise session polling for the\nresult was started with the machine key that opened the registration.\nThat response carries the registering user's User and Login, so the auth\nID in the followup URL is the only thing protecting it.\n\nhandleRegister and handleLogout both call machineKeyMismatch before\nhanding back a node, so this is the one path of the three that does not.\nThe key is already available: HandleNodeFromAuthPath resolves the node\nfrom the MachineKey cached in RegistrationData, so on the normal path the\nnode and the session agree and the check is a no-op.\n\nThe auth ID is 96 bits of randomness and is not guessable, so this is not\nreachable by brute force. It is logged at info level when a registration\nis created, which makes log access the realistic way to obtain one.\n\nThe existing followup_registration_success case built its node with\nCreateNodeForTest, which picks a random machine key that no real\nregistration would produce. Set the registering machine key so the\nfixture matches the production path.\n\nSigned-off-by: Arpit Jain <arpitjain099@gmail.com>\n(cherry picked from commit 0ce3356b8995f6691d12424b566ac93a0388c867)","parents":[{"sha":"973b791b05ba7d33a1d86738808e12c775ac1022","url":"https://api.github.com/repos/juanfont/headscale/git/commits/973b791b05ba7d33a1d86738808e12c775ac1022","html_url":"https://github.com/juanfont/headscale/commit/973b791b05ba7d33a1d86738808e12c775ac1022"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"aa0b102c2b677cc424537c87623e1aadb4903560","node_id":"C_kwDOEFLz89oAKGFhMGIxMDJjMmI2NzdjYzQyNDUzN2M4NzYyM2UxYWFkYjQ5MDM1NjA","url":"https://api.github.com/repos/juanfont/headscale/git/commits/aa0b102c2b677cc424537c87623e1aadb4903560","html_url":"https://github.com/juanfont/headscale/commit/aa0b102c2b677cc424537c87623e1aadb4903560","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-07-21T13:49:49Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-29T10:17:12Z"},"tree":{"sha":"6f1a46c0ca2a89e4f6f2c33700de4b82ea999e72","url":"https://api.github.com/repos/juanfont/headscale/git/trees/6f1a46c0ca2a89e4f6f2c33700de4b82ea999e72"},"message":"hscontrol: gate /key on supported capability version\n\n/key handed out the Noise public key for any v>=39, a floor unrelated\nto the handshake's capver.MinSupportedCapabilityVersion. Reject below\nthe supported floor, matching /ts2021, and drop the stale constant.\n\nFixes #3380\n\n(cherry picked from commit 5b6e1e17be169603e6c0632fb355dcdd2714a250)","parents":[{"sha":"b1d9a0484965b515ac433d020b1c80ec8e02580c","url":"https://api.github.com/repos/juanfont/headscale/git/commits/b1d9a0484965b515ac433d020b1c80ec8e02580c","html_url":"https://github.com/juanfont/headscale/commit/b1d9a0484965b515ac433d020b1c80ec8e02580c"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"8e63c3bd77ed2ebb107ed1cdf497caaeaee413a1","node_id":"C_kwDOEFLz89oAKDhlNjNjM2JkNzdlZDJlYmIxMDdlZDFjZGY0OTdjYWFlYWVlNDEzYTE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8e63c3bd77ed2ebb107ed1cdf497caaeaee413a1","html_url":"https://github.com/juanfont/headscale/commit/8e63c3bd77ed2ebb107ed1cdf497caaeaee413a1","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-07-22T06:27:34Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-29T10:17:12Z"},"tree":{"sha":"587c680749d8435c5c11c9280043a144e7cea779","url":"https://api.github.com/repos/juanfont/headscale/git/trees/587c680749d8435c5c11c9280043a144e7cea779"},"message":"state: do not expire tagged nodes on logout\n\nTagged nodes never expire, but handleLogout stamped a past expiry on them,\nleaving them stuck expired and unable to re-authenticate.\n\nFixes #3371\n\n(cherry picked from commit 1ed5693fa4c4ae459e607ab652ac7d25c35aef51)","parents":[{"sha":"aa0b102c2b677cc424537c87623e1aadb4903560","url":"https://api.github.com/repos/juanfont/headscale/git/commits/aa0b102c2b677cc424537c87623e1aadb4903560","html_url":"https://github.com/juanfont/headscale/commit/aa0b102c2b677cc424537c87623e1aadb4903560"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"8de9b23754e125b2a578aee197d619c9008b07a5","node_id":"C_kwDOEFLz89oAKDhkZTliMjM3NTRlMTI1YjJhNTc4YWVlMTk3ZDYxOWM5MDA4YjA3YTU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8de9b23754e125b2a578aee197d619c9008b07a5","html_url":"https://github.com/juanfont/headscale/commit/8de9b23754e125b2a578aee197d619c9008b07a5","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-07-22T06:32:08Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-29T10:17:12Z"},"tree":{"sha":"45122a63f20d67ba65b147849e593c1b6c4cfaec","url":"https://api.github.com/repos/juanfont/headscale/git/trees/45122a63f20d67ba65b147849e593c1b6c4cfaec"},"message":"state: apply a new pre-auth key's tags on re-registration\n\nRe-registering a tagged node with a different key discarded the new key's\ntags and left a stale auth-key reference; retag on key change and persist it.\n\nFixes #3370\n\n(cherry picked from commit fc16cc6905e921566b84c3b4d5895e7c812c6d19)","parents":[{"sha":"8e63c3bd77ed2ebb107ed1cdf497caaeaee413a1","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8e63c3bd77ed2ebb107ed1cdf497caaeaee413a1","html_url":"https://github.com/juanfont/headscale/commit/8e63c3bd77ed2ebb107ed1cdf497caaeaee413a1"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"3d7199a8e1f1b513d732dbb7ae9d63588051a0ce","node_id":"C_kwDOEFLz89oAKDNkNzE5OWE4ZTFmMWI1MTNkNzMyZGJiN2FlOWQ2MzU4ODA1MWEwY2U","url":"https://api.github.com/repos/juanfont/headscale/git/commits/3d7199a8e1f1b513d732dbb7ae9d63588051a0ce","html_url":"https://github.com/juanfont/headscale/commit/3d7199a8e1f1b513d732dbb7ae9d63588051a0ce","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-07-22T06:44:22Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-29T10:17:12Z"},"tree":{"sha":"557e33eefbbc30e2d0b05c963992b3f6706b00dd","url":"https://api.github.com/repos/juanfont/headscale/git/trees/557e33eefbbc30e2d0b05c963992b3f6706b00dd"},"message":"policy,state: authorize reauth tags against the authenticating user\n\nRe-authenticating a tagged node with --advertise-tags checked the tag-owned\nnode, not the authenticating user, so every tag was rejected.\n\nFixes #3374\n\n(cherry picked from commit 6275e3a3563bb9302cade9cf78f7b13e90e8ed7e)","parents":[{"sha":"8de9b23754e125b2a578aee197d619c9008b07a5","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8de9b23754e125b2a578aee197d619c9008b07a5","html_url":"https://github.com/juanfont/headscale/commit/8de9b23754e125b2a578aee197d619c9008b07a5"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"4938a663faf0d09432db430412cfe3ad98951698","node_id":"C_kwDOEFLz89oAKDQ5MzhhNjYzZmFmMGQwOTQzMmRiNDMwNDEyY2ZlM2FkOTg5NTE2OTg","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4938a663faf0d09432db430412cfe3ad98951698","html_url":"https://github.com/juanfont/headscale/commit/4938a663faf0d09432db430412cfe3ad98951698","author":{"name":"Igor Serganov","email":"iserganov@tunein.com","date":"2026-07-24T21:15:54Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-29T10:17:12Z"},"tree":{"sha":"ca1bd358d50eca922dc46dd405fef2a40f4cab8c","url":"https://api.github.com/repos/juanfont/headscale/git/trees/ca1bd358d50eca922dc46dd405fef2a40f4cab8c"},"message":"poll: do not cancel ephemeral GC until Connect succeeds\n\nWith node.ephemeral.inactivity_timeout set, ephemeral nodes are\nusually deleted after they go offline, but under reconnect churn some\ndeparted nodes stayed in the node list as disconnected indefinitely\nuntil removed manually or until Headscale restarted.\n\nEphemeral cleanup is timer-based via EphemeralGarbageCollector, not a\nperiodic LastSeen scan. serveLongPoll cancelled any pending GC timer\nat the very start of a long-poll attempt and only rescheduled on a\nclean disconnect after Connect. If a reconnect cancelled the timer and\nthen failed before Connect (for example an UpdateNodeFromMapRequest\nerror), the deferred cleanup saw connectGen == 0 and returned without\nSchedule. The node remained offline with no deletion timer and no\nreconciler to recover it.\n\nCancel the ephemeral GC timer only after a successful Connect, so a\nfailed reconnect leaves an already-armed inactivity timer intact.\nSuccessful reconnects still cancel GC once the node is online, and a\nlater disconnect reschedules as before.\n\nAdd TestFailedReconnectDoesNotCancelEphemeralGC to lock in the\nordering, plus IsScheduled and DeleteNodeFromStoreForTest helpers for\nthe test.\n\nFixes #3382\n\nCo-authored-by: Cursor <cursoragent@cursor.com>\n(cherry picked from commit cfd845cb53efb2f953ff30c7d2ee70329b74f1ce)","parents":[{"sha":"3d7199a8e1f1b513d732dbb7ae9d63588051a0ce","url":"https://api.github.com/repos/juanfont/headscale/git/commits/3d7199a8e1f1b513d732dbb7ae9d63588051a0ce","html_url":"https://github.com/juanfont/headscale/commit/3d7199a8e1f1b513d732dbb7ae9d63588051a0ce"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"ac7b0172fb59c4a36facbc0d4506a3aa334c9245","node_id":"C_kwDOEFLz89oAKGFjN2IwMTcyZmI1OWM0YTM2ZmFjYmMwZDQ1MDZhM2FhMzM0YzkyNDU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ac7b0172fb59c4a36facbc0d4506a3aa334c9245","html_url":"https://github.com/juanfont/headscale/commit/ac7b0172fb59c4a36facbc0d4506a3aa334c9245","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-07-21T13:57:49Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-29T10:17:12Z"},"tree":{"sha":"ae14f937453c96b1909e6c24e3ea363f80ca7e53","url":"https://api.github.com/repos/juanfont/headscale/git/trees/ae14f937453c96b1909e6c24e3ea363f80ca7e53"},"message":"hscontrol: prefer completed auth over expired ctx in followup wait\n\nwaitForFollowup selected on ctx.Done() and the verdict channel with equal\npriority; when both were ready, select picked at random and discarded a\nsuccessful registration as a spurious 401 timeout. Check for a completed\nverdict first, race the deadline only if none is ready.\n\nFixes #3385\n\n(cherry picked from commit d28a6b111ae3d7bfca11742f2438803c786e98fe)","parents":[{"sha":"4938a663faf0d09432db430412cfe3ad98951698","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4938a663faf0d09432db430412cfe3ad98951698","html_url":"https://github.com/juanfont/headscale/commit/4938a663faf0d09432db430412cfe3ad98951698"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"94966ce5640aedadc361f8d8f99fca48e9f2a76e","node_id":"C_kwDOEFLz89oAKDk0OTY2Y2U1NjQwYWVkYWRjMzYxZjhkOGY5OWZjYTQ4ZTlmMmE3NmU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/94966ce5640aedadc361f8d8f99fca48e9f2a76e","html_url":"https://github.com/juanfont/headscale/commit/94966ce5640aedadc361f8d8f99fca48e9f2a76e","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2026-07-28T10:55:22Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-07-29T10:17:12Z"},"tree":{"sha":"bb5d2a71a7016be88e5f6d87a1862266b5e0e10e","url":"https://api.github.com/repos/juanfont/headscale/git/trees/bb5d2a71a7016be88e5f6d87a1862266b5e0e10e"},"message":"CHANGELOG: add 0.29.3\n\nUpdates #3385\n\n(cherry picked from commit 8bb26c5967391ee7e7968ea96b1552d6a14ee259)","parents":[{"sha":"ac7b0172fb59c4a36facbc0d4506a3aa334c9245","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ac7b0172fb59c4a36facbc0d4506a3aa334c9245","html_url":"https://github.com/juanfont/headscale/commit/ac7b0172fb59c4a36facbc0d4506a3aa334c9245"}],"verification":{"verifie