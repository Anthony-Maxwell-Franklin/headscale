[{"sha":"f940826c91eee0c87dd174847f94619c5c7772e7","node_id":"C_kwDOEFLz89oAKGY5NDA4MjZjOTFlZWUwYzg3ZGQxNzQ4NDdmOTQ2MTljNWM3NzcyZTc","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f940826c91eee0c87dd174847f94619c5c7772e7","html_url":"https://github.com/juanfont/headscale/commit/f940826c91eee0c87dd174847f94619c5c7772e7","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-17T08:33:49Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-17T08:33:49Z"},"tree":{"sha":"af0e08d232d5f41f13ea6911a896738af9520810","url":"https://api.github.com/repos/juanfont/headscale/git/trees/af0e08d232d5f41f13ea6911a896738af9520810"},"message":"github: split nu where in needs-more-info timer\n\nGitHub's /issues/:n/events endpoint returns a mixed-schema table.\nOnly labeled/unlabeled rows carry a `label` column. Nu's `where`\ndoes not short-circuit on missing columns, so the combined\npredicate `event == \"labeled\" and label.name == ...` dereferenced\n`label.name` on every row and crashed on the first non-labeled\nevent with `nu::shell::column_not_found`.\n\nThe scheduled job has failed every night since 2026-04-13 (the\nfirst run with a labeled issue), so no `needs-more-info` issue\nhas been auto-closed.\n\nSplit into two sequential `where` filters so `label.name` is only\naccessed on rows that have the column.","parents":[{"sha":"1f9635c2ec20b362281daa9c24adcd7e008f765c","url":"https://api.github.com/repos/juanfont/headscale/git/commits/1f9635c2ec20b362281daa9c24adcd7e008f765c","html_url":"https://github.com/juanfont/headscale/commit/1f9635c2ec20b362281daa9c24adcd7e008f765c"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":24601789499,"node_id":"RFRE_lADOEFLz887_Lt8PzwAAAAW6YYQ7","url":"https://api.github.com/repos/juanfont/headscale/issues/events/24601789499","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk