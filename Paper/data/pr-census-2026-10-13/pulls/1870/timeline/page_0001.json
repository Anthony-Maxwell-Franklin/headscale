usercontent.com/u/20052500?v=4","gravatar_id":"","url":"https://api.github.com/users/K3das","html_url":"https://github.com/K3das","followers_url":"https://api.github.com/users/K3das/followers","following_url":"https://api.github.com/users/K3das/following{/other_user}","gists_url":"https://api.github.com/users/K3das/gists{/gist_id}","starred_url":"https://api.github.com/users/K3das/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/K3das/subscriptions","organizations_url":"https://api.github.com/users/K3das/orgs","repos_url":"https://api.github.com/users/K3das/repos","events_url":"https://api.github.com/users/K3das/events{/privacy}","received_events_url":"https://api.github.com/users/K3das/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-04-21T19:42:16Z","updated_at":"2024-04-21T19:42:16Z","body":"I used \"overwrite\" since that would imply that, by default, it would use certificates defined in the other settings, I'm happy to change this wording.\r\n\r\nMy use case is described in the attached issue; I don't want to configure TLS for the HTTP API endpoints, but configure it for the gRPC endpoints.\r\n\r\nI'll add integration tests if you still consider this an acceptable change.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/juanfont/headscale/issues/comments/2068177418/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"K3das","id":20052500,"node_id":"MDQ6VXNlcjIwMDUyNTAw","avatar_url":"https://avatars.githubusercontent.com/u/20052500?v=4","gravatar_id":"","url":"https://api.github.com/users/K3das","html_url":"https://github.com/K3das","followers_url":"https://api.github.com/users/K3das/followers","following_url":"https://api.github.com/users/K3das/following{/other_user}","gists_url":"https://api.github.com/users/K3das/gists{/gist_id}","starred_url":"https://api.github.com/users/K3das/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/K3das/subscriptions","organizations_url":"https://api.github.com/users/K3das/orgs","repos_url":"https://api.github.com/users/K3das/repos","events_url":"https://api.github.com/users/K3das/events{/privacy}","received_events_url":"https://api.github.com/users/K3das/received_events","type":"User","user_view_type":"public","site_admin":false}},{"url":"https://api.github.com/repos/juanfont/headscale/issues/comments/2068808059","html_url":"https://github.com/juanfont/headscale/pull/1870#issuecomment-2068808059","issue_url":"https://api.github.com/repos/juanfont/headscale/issues/1870","id":2068808059,"node_id":"IC_kwDOEFLz8857T4F7","user":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-04-22T08:32:48Z","updated_at":"2024-04-22T08:32:48Z","body":"> My use case is described in the attached issue; I don't want to configure TLS for the HTTP API endpoints, but configure it for the gRPC endpoints.\r\n\r\nOK, I am not super stoked about this as we mainly encourage less knobs to configure this kind of stuff as users seem to find them, try to use them and generate support load. I appreciate that it is useful for power users whom understand how to use them, we have no good mechanism for preventing everyone else from doing it.\r\n\r\nI can particular imagine that a lot of people using varieties of proxies will run into things here. \r\n\r\n> I'll add integration tests if you still consider this an acceptable change.\r\n\r\nI do not know exactly how I want them to look or how to test something like this, so this might be a challenging exercise in it self, but if you want to take a stab at it, you are welcome to do so.","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/juanfont/headscale/issues/comments/2068808059/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":2014129420,"node_id":"PRR_kwDOEFLz8854DS0M","user":{"login":"kradalby","id":98431,"node_id":"MDQ6VXN