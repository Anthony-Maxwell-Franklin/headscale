ype":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"26e52b7d67dc69ef970983cf55bf5397e05baaa5","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/26e52b7d67dc69ef970983cf55bf5397e05baaa5","created_at":"2025-11-12T14:15:45Z","performed_via_github_app":null},{"sha":"da705048a4da4c20c08f3508fd2af7435c0acad1","node_id":"C_kwDOEFLz89oAKGRhNzA1MDQ4YTRkYTRjMjBjMDhmMzUwOGZkMmFmNzQzNWMwYWNhZDE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/da705048a4da4c20c08f3508fd2af7435c0acad1","html_url":"https://github.com/juanfont/headscale/commit/da705048a4da4c20c08f3508fd2af7435c0acad1","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-01T16:27:00Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-12T15:10:39Z"},"tree":{"sha":"9ca52b744a87be052811dd3bf61879af0771dca9","url":"https://api.github.com/repos/juanfont/headscale/git/trees/9ca52b744a87be052811dd3bf61879af0771dca9"},"message":"types: make pre auth key use bcrypt\n\nthis commit changes the underlying implementation of\npre auth keys to the same as our API keys. This means that\ninstead of having a key in the database, it will consist\nof a prefix and a bcrypt hash.\n\nThis improves the security of the keys as they can not be\nread back in the case of a database getting away.\n\nOld keys still work, but all new keys are created in the\nnew format.\n\nAll keys are prefixed with \"hskey-auth\" to indicate their\npurpose.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>","parents":[{"sha":"e3ced802785dd9bff4b190a56414d1ed7fb91948","url":"https://api.github.com/repos/juanfont/headscale/git/commits/e3ced802785dd9bff4b190a56414d1ed7fb91948","html_url":"https://github.com/juanfont/headscale/commit/e3ced802785dd9bff4b190a56414d1ed7fb91948"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgmMAoz5Zf+w0nAxyA6/zsNd95cP\n98YbtHIIXyy9A1sssAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQOfqo/1fYPNOxnS/qg2wp4bzdFXA6hkJDxoIudmSGjR0KAwV+dIP5Nz3f91fPGnWxL\n6WTw0seSccmGL8VBtwKQY=\n-----END SSH SIGNATURE-----","payload":"tree 9ca52b744a87be052811dd3bf61879af0771dca9\nparent e3ced802785dd9bff4b190a56414d1ed7fb91948\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1762014420 +0100\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1762960239 +0100\n\ntypes: make pre auth key use bcrypt\n\nthis commit changes the underlying implementation of\npre auth keys to the same as our API keys. This means that\ninstead of having a key in the database, it will consist\nof a prefix and a bcrypt hash.\n\nThis improves the security of the keys as they can not be\nread back in the case of a database getting away.\n\nOld keys still work, but all new keys are created in the\nnew format.\n\nAll keys are prefixed with \"hskey-auth\" to indicate their\npurpose.\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>\n","verified_at":"2025-11-12T15:10:50Z"},"event":"committed"},{"sha":"72fcdc8e9495cc3c398c5a38ab2fea69bb0f666f","node_id":"C_kwDOEFLz89oAKDcyZmNkYzhlOTQ5NWNjM2MzOThjNWEzOGFiMmZlYTY5YmIwZjY2NmY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/72fcdc8e9495cc3c398c5a38ab2fea69bb0f666f","html_url":"https://github.com/juanfont/headscale/commit/72fcdc8e9495cc3c398c5a38ab2fea69bb0f666f","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-11T21:05:09Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-12T15:10:41Z"},"tree":{"sha":"3acd685e3831f0ce086751ffaa6e385ae1000067","url":"https://api.github.com/repos/juanfont/headscale/git/trees/3acd685e3831f0ce086751ffaa6e385ae1000067"},"message":"hscontrol/db: add hskey-api prefix format for API keys\n\nNew API keys use hskey-api-{prefix}-{secret} format with bcrypt\nhashing. Legacy keys without prefix continue to work.","parents":[{"sha":"da705048a4da4c20c08f3508fd2af7435c0acad1","url":"https://api.github.com/repos/juanfont/headscale/git/commits/da705048a4da4c20c08f3508fd2af7435c0acad1","html_url":"https://github.com/juanfont/headscale/commit/da705048a4da4c20c08f3508fd2af7435c0acad1"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgmMAoz5Zf+w0nAxyA6/zsNd95cP\n98YbtHIIXyy9A1sssAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQMCiQvoyiMCq0hvryX9b6O78SLI3QdeLvhhqTVDtzvqyadf7XZmrB1/sFhFFURTnII\nOzL2KUgqM2gixKfiT/hg4=\n-----END SSH SIGNATURE-----","payload":"tree 3acd685e3831f0ce086751ffaa6e385ae1000067\nparent da705048a4da4c20c08f3508fd2af7435c0acad1\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1762895109 +0100\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1762960241 +0100\n\nhscontrol/db: add hskey-api prefix format for API keys\n\nNew API keys use hskey-api-{prefix}-{secret} format with bcrypt\nhashing. Legacy keys without prefix continue to work.\n","verified_at":"2025-11-12T15:10:50Z"},"event":"committed"},{"sha":"949b2227b1e90f71102dad445832443cadc65dc6","node_id":"C_kwDOEFLz89oAKDk0OWIyMjI3YjFlOTBmNzExMDJkYWQ0NDU4MzI0NDNjYWRjNjVkYzY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/949b2227b1e90f71102dad445832443cadc65dc6","html_url":"https://github.com/juanfont/headscale/commit/949b2227b1e90f71102dad445832443cadc65dc6","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-11T21:05:41Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-12T15:10:41Z"},"tree":{"sha":"404bbb825ac244240b7780fb08d66ce2bedbb076","url":"https://api.github.com/repos/juanfont/headscale/git/trees/404bbb825ac244240b7780fb08d66ce2bedbb076"},"message":"docs: update CHANGELOG for API key changes","parents":[{"sha":"72fcdc8e9495cc3c398c5a38ab2fea69bb0f666f","url":"https://api.github.com/repos/juanfont/headscale/git/commits/72fcdc8e9495cc3c398c5a38ab2fea69bb0f666f","html_url":"https://github.com/juanfont/headscale/commit/72fcdc8e9495cc3c398c5a38ab2fea69bb0f666f"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgmMAoz5Zf+w0nAxyA6/zsNd95cP\n98YbtHIIXyy9A1sssAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQKFzRgWHMNtOVOrvge0AI/ZWQp06usZP8ZoPQyVlTV5wu9XbUaESNL6boLfx1SBSUr\ngxVO5FEc/ZUb0hBlaOGwQ=\n-----END SSH SIGNATURE-----","payload":"tree 404bbb825ac244240b7780fb08d66ce2bedbb076\nparent 72fcdc8e9495cc3c398c5a38ab2fea69bb0f666f\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1762895141 +0100\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1762960241 +0100\n\ndocs: update CHANGELOG for API key changes\n","verified_at":"2025-11-12T15:10:50Z"},"event":"committed"},{"sha":"c03c8149fd9b71e7d6496cfe9f2e0238cbab36c5","node_id":"C_kwDOEFLz89oAKGMwM2M4MTQ5ZmQ5YjcxZTdkNjQ5NmNmZTlmMmUwMjM4Y2JhYjM2YzU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c03c8149fd9b71e7d6496cfe9f2e0238cbab36c5","html_url":"https://github.com/juanfont/headscale/commit/c03c8149fd9b71e7d6496cfe9f2e0238cbab36c5","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-12T03:37:41Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-12T15:10:41Z"},"tree":{"sha":"98c5d8c679c0bbac91417b44bb01414f47a0695d","url":"https://api.github.com/repos/juanfont/headscale/git/trees/98c5d8c679c0bbac91417b44bb01414f47a0695d"},"message":"hscontrol: add hskey-reg keys for web auth registration tracking\n\nAdd registration keys (hskey-reg-{64-char-random}) for tracking web\nauthentication registration flows in logs. These vanity keys are not\nstored in the database and do not use bcrypt - they exist purely for\nobservability and correlating log entries during the registration process.","parents":[{"sha":"949b2227b1e90f71102dad445832443cadc65dc6","url":"https://api.github.com/repos/juanfont/headscale/git/commits/949b2227b1e90f71102dad445832443cadc65dc6","html_url":"https://github.com/juanfont/headscale/commit/949b2227b1e90f71102dad445832443cadc65dc6"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgmMAoz5Zf+w0nAxyA6/zsNd95cP\n98YbtHIIXyy9A1sssAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQA0GAOK37L+wGBXptjYurPGtyP3YZww/Y79QLyXuLvvu3HwxthJHnszNTJgWu5lB5J\naf6Ej6yS1gIed+yw3oAwY=\n-----END SSH SIGNATURE-----","payload":"tree 98c5d8c679c0bbac91417b44bb01414f47a0695d\nparent 949b2227b1e90f71102dad445832443cadc65dc6\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1762918661 +0100\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1762960241 +0100\n\nhscontrol: add hskey-reg keys for web auth registration tracking\n\nAdd registration keys (hskey-reg-{64-char-random}) for tracking web\nauthentication registration flows in logs. These vanity keys are not\nstored in the database and do not use bcrypt - they exist purely for\nobservability and correlating log entries during the registration process.\n","verified_at":"2025-11-12T15:10:50Z"},"event":"committed"},{"sha":"e7a7dcc4c5ed0331044e746b3c1fe5e5e42bd372","node_id":"C_kwDOEFLz89oAKGU3YTdkY2M0YzVlZDAzMzEwNDRlNzQ2YjNjMWZlNWU1ZTQyYmQzNzI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/e7a7dcc4c5ed0331044e746b3c1fe5e5e42bd372","html_url":"https://github.com/juanfont/headscale/commit/e7a7dcc4c5ed0331044e746b3c1fe5e5e42bd372","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-12T04:03:45Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-11-12T15:10:41Z"},"tree":{"sha":"e6b20221852cb9f4f305bd2d1888bedac49bdbd6","url":"https://api.github.com/repos/juanfont/headscale/git/trees/e6b20221852cb9f4f305bd2d1888bedac49bdbd6"},"message":"types: populate all fields in PreAuthKeyNew.Proto()\n\nPreAuthKeyNew.Proto() was only returning ID and Key fields, causing the\ngRPC CreatePreAuthKey response to omit Ephemeral, Reusable, and other\nfields. This broke integration tests expecting these values.\n\nAdd all fields to PreAuthKeyNew struct and populate them in\nCreatePreAuthKey. Update Proto() method to include all fields with\nproper protobuf timestamp conversion.","parents":[{"sha":"c03c8149fd9b71e7d6496cfe9f2e0238cbab36c5","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c03c8149fd9b71e7d6496cfe9f2e0238cbab36c5","html_url":"https://github.com/juanfont/headscale/commit/c03c8149fd9b71e7d6496cfe9f2e0238cbab36c5"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgmMAoz5Zf+w0nAxyA6/zsNd95cP\n98YbtHIIXyy9A1sssAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQCmkQBWlaZt8Cm2lmzuC09fvY9nmS+JisQLJTHwb9gbTF0McDbRzj6yVPUjHfEIgYT\nQUxRahk65ExhdxQRgyawU=\n-----END SSH SIGNATURE-----","payload":"tree e6b20221852cb9f4f305bd2d1888bedac49bdbd6\nparent c03c8149fd9b71e7d6496cfe9f2e0238cbab36c5\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1762920225 +0100\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1762960241 +0100\n\ntypes: populate all fields in PreAuthKeyNew.Proto()\n\nPreAuthKeyNew.Proto() was only returning ID and Key fields, causing the\ngRPC CreatePreAuthKey response to omit Ephemeral, Reusable, and other\nfields. This broke integration tests expecting these values.\n\nAdd all fields to PreAuthKeyNew struct and populate them in\nCreatePreAuthKey. Update Proto() method to include all fields with\nproper protobuf timestamp conversion.\n","verified_at":"2025-11-12T15:10:50Z"},"event":"committed"},{"id":20891088708,"node_id":"HRFPE_lADOEFLz887VS1hmzwAAAATdNLdE","url":"https://api.github.com/repos/juanfont/headscale/issues/events/20891088708","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_ur