[{"sha":"c5f824c864bc7bb9ec42865a133c156ddf9dd5a6","node_id":"C_kwDOEFLz89oAKGM1ZjgyNGM4NjRiYzdiYjllYzQyODY1YTEzM2MxNTZkZGY5ZGQ1YTY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c5f824c864bc7bb9ec42865a133c156ddf9dd5a6","html_url":"https://github.com/juanfont/headscale/commit/c5f824c864bc7bb9ec42865a133c156ddf9dd5a6","author":{"name":"Akhilesh Arora","email":"akhildawra@gmail.com","date":"2026-04-28T12:36:26Z"},"committer":{"name":"Akhilesh Arora","email":"akhildawra@gmail.com","date":"2026-04-28T12:36:26Z"},"tree":{"sha":"5049805fad5d86850f4e32a6597b3108ccf39fdc","url":"https://api.github.com/repos/juanfont/headscale/git/trees/5049805fad5d86850f4e32a6597b3108ccf39fdc"},"message":"ci: fetch full history in lint workflow for --new-from-rev\n\nThe golangci-lint job runs with --new-from-rev=base.sha to scope\nreported issues to lines added by the PR. With fetch-depth: 2 the\nrunner only has HEAD and HEAD~1, so PRs with more than one commit\ncannot reach base.sha:\n\n    fatal: bad object <base-sha>\n    [runner] Can't process results by diff processor\n\nWhen the diff processor fails open, golangci-lint reports every\nexisting issue in the repo, masking the PR's own contribution.\n\nSet fetch-depth: 0 to make any base sha reachable. Matches the\npattern already used in release.yml and docs-deploy.yml.","parents":[{"sha":"3672a2df3a860bcb97f932d3dc7785406329b49e","url":"https://api.github.com/repos/juanfont/headscale/git/commits/3672a2df3a860bcb97f932d3dc7785406329b49e","html_url":"https://github.com/juanfont/headscale/commit/3672a2df3a860bcb97f932d3dc7785406329b49e"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niQIzBAABCgAdFiEE8C93+uC8TaXngX8sVkphQ/EtRnAFAmnwqcoACgkQVkphQ/Et\nRnBtow//R/cvPspqOH0wjhuj5niSXrDyzadu2hEBDMmmPg3rfEWXBtqWU8BkFLcQ\nxSeTcTiv51qEIB/MX3O1/HViC/1iFdITmnBnXS6HpdL+iIaqA7ZwtXf3kiIDFH6K\nseG+t1OAHx1AAH1g56QoWIICzpCtBeSHl/dr5y2Z9I5WjaDsfha1NVr/UXi4xMeN\nyU6ZS21DjdWbE6nkm9diSivQPx9