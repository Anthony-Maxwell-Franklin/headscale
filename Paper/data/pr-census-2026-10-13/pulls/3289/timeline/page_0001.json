[{"sha":"a1d5959fae4e1ac66380ccc3fdc969134a16a0ad","node_id":"C_kwDOEFLz89oAKGExZDU5NTlmYWU0ZTFhYzY2MzgwY2NjM2ZkYzk2OTEzNGExNmEwYWQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a1d5959fae4e1ac66380ccc3fdc969134a16a0ad","html_url":"https://github.com/juanfont/headscale/commit/a1d5959fae4e1ac66380ccc3fdc969134a16a0ad","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-29T10:06:02Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-29T15:37:22Z"},"tree":{"sha":"6f64d33cf957eb35f90acdcd910ab22f47c89dfa","url":"https://api.github.com/repos/juanfont/headscale/git/trees/6f64d33cf957eb35f90acdcd910ab22f47c89dfa"},"message":"policy: key autogroup:self invalidation on UserID not User view\n\ninvalidateAutogroupSelfCache derived the owning user from\nnode.User().ID(), dereferencing the User association view. The\nNodeStore stores nodes by value with User as a *User pointer, and not\nevery write path hydrates that association, so a non-tagged node could\nreach SetNodes with UserID set but User nil. UserView.ID() then\ndereferenced a nil *User and panicked on /machine/map whenever an\nautogroup:self policy was active and a node restarted tailscaled.\n\nGroup affected nodes by node.TypedUserID(), which reads the UserID\nfield directly. UserID is the authoritative ownership field for\nnon-tagged nodes, so this needs no hydrated association and fixes every\n.User().ID() site in the function.","parents":[{"sha":"ea8fc725700918a8aba59f10d6ba2469a73e82ad","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ea8fc725700918a8aba59f10d6ba2469a73e82ad","html_url":"https://github.com/juanfont/headscale/commit/ea8fc725700918a8aba59f10d6ba2469a73e82ad"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":26117118103,"node_id":"RFRE_lADOEFLz888AAAABDy6TRM8AAAAGFLOYlw","url":"https://api.github.com/repos/juanfon