0100\ncommitter networkException <git@nwex.de> 1701018081 +0100\n\nAllow setting ForcedTags using the acls.hujson config file\n\nThis patch introduces a declarative way to set ForcedTags on\nnodes by recursively expanding alises. These declarative forced\ntags are considered separately from the ones stored in the\ndatabase.\n\n```json\n{\n    \"hosts\": {\n        \"a\": \"fd7a:115c:a1e0::1\",\n        \"b\": \"fd7a:115c:a1e0::2\"\n    },\n    \"forcedTags\": {\n        \"tag:some-tag\": [\n            \"a\",\n            \"tag:some-other-tag\"\n        ],\n        \"tag:some-other-tag\": [\n            \"b\"\n        ]\n    }\n}\n```\n","verified_at":"2024-12-03T17:05:44Z"},"event":"committed"},{"id":11063462034,"node_id":"RRE_lADOEFLz88533z4WzwAAAAKTbwiS","url":"https://api.github.com/repos/juanfont/headscale/issues/events/11063462034","actor":{"login":"networkException","id":42888162,"node_id":"MDQ6VXNlcjQyODg4MTYy","avatar_url":"https://avatars.githubusercontent.com/u/42888162?v=4","gravatar_id":"","url":"https://api.github.com/users/networkException","html_url":"https://github.com/networkException","followers_url":"https://api.github.com/users/networkException/followers","following_url":"https://api.github.com/users/networkException/following{/other_user}","gists_url":"https://api.github.com/users/networkException/gists{/gist_id}","starred_url":"https://api.github.com/users/networkException/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/networkException/subscriptions","organizations_url":"https://api.github.com/users/networkException/orgs","repos_url":"https://api.github.com/users/networkException/repos","events_url":"https://api.github.com/users/networkException/events{/privacy}","received_events_url":"https://api.github.com/users/networkException/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"review_requested","commit_id":null,"commit_url":null,"created_at":"2023-11-26T17:04:05Z","review_reques