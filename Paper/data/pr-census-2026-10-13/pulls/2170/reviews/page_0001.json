[{"id":2349422354,"node_id":"PRR_kwDOEFLz886MCVcS","user":{"login":"micolous","id":246847,"node_id":"MDQ6VXNlcjI0Njg0Nw==","avatar_url":"https://avatars.githubusercontent.com/u/246847?v=4","gravatar_id":"","url":"https://api.github.com/users/micolous","html_url":"https://github.com/micolous","followers_url":"https://api.github.com/users/micolous/followers","following_url":"https://api.github.com/users/micolous/following{/other_user}","gists_url":"https://api.github.com/users/micolous/gists{/gist_id}","starred_url":"https://api.github.com/users/micolous/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/micolous/subscriptions","organizations_url":"https://api.github.com/users/micolous/orgs","repos_url":"https://api.github.com/users/micolous/repos","events_url":"https://api.github.com/users/micolous/events{/privacy}","received_events_url":"https://api.github.com/users/micolous/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Thanks for getting onto this so quickly!\r\n\r\nIt looks like this addresses the concerns I previously raised, but I think that username collisions are going to be a problem with this change.\r\n\r\nOn further inspection, I've noticed a couple of other issues with #2020 where user migration might not work correctly and user renames might not work correctly.\r\n\r\nThe more I think about this, the more that I think the pre-#2020 Headscale OIDC behaviour might be impossible (or at least, extremely difficult) to automatically, securely and reliably recover from for an existing installation.\r\n\r\nThere may be _IdP-specific_ ways for an installation to recover (involving manually querying and editing databases), but not much within the scope of the OIDC protocol and Headscale's pre-#2020 OIDC schema.\r\n\r\nI still think that switching to `sub` is the right thing to do, even if it causes some short term pain.","state":"CHANGES_REQUESTED","html_url":"https://github.com/juanfont/headscale/pull/2170#pullrequestreview-2349422354","pull_request_url":"https://api.github.com/repos/juanfont/headscale/pulls/2170","author_association":"NONE","_links":{"html":{"href":"https://github.com/juanfont/headscale/pull/2170#pullrequestreview-2349422354"},"pull_request":{"href":"https://api.github.com/repos/juanfont/headscale/pulls/2170"}},"submitted_at":"2024-10-05T02:20:45Z","commit_id":"e11b4b70c09e922bde39f921d69c6943500af301"},{"id":2351229491,"node_id":"PRR_kwDOEFLz886MJOoz","user":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/juanfont/headscale/pull/2170#pullrequestreview-2351229491","pull_request_url":"https://api.github.com/repos/juanfont/headscale/pulls/2170","author_association":"COLLABORATOR","_links":{"html":{"href":"https://github.com/juanfont/headscale/pull/2170#pullrequestreview-2351229491"},"pull_request":{"href":"https://api.github.com/repos/juanfont/headscale/pulls/2170"}},"submitted_at":"2024-10-07T08:14:07Z","commit_id":"e11b4b70c09e922bde39f921d69c6943500af301"},{"id":2351230770,"node_id":"PRR_kwDOEFLz886MJO8y","user":{"login":"kra