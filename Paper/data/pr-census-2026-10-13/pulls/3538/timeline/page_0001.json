itle":"v0.29"},"performed_via_github_app":null},{"url":"https://api.github.com/repos/juanfont/headscale/issues/comments/6055980457","html_url":"https://github.com/juanfont/headscale/pull/3538#issuecomment-6055980457","issue_url":"https://api.github.com/repos/juanfont/headscale/issues/3538","id":6055980457,"node_id":"IC_kwDOEFLz888AAAABaPbtqQ","user":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-10-08T08:33:19Z","updated_at":"2026-10-08T08:33:19Z","body":"Thanks, looks like we might need a rebase too. ","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/juanfont/headscale/issues/comments/6055980457/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false}},{"sha":"63b572062db6d3a588a77c59efdd337067fb7686","node_id":"C_kwDOEFLz89oAKDYzYjU3MjA2MmRiNmQzYTU4OGE3N2M1OWVmZGQzMzcwNjdmYjc2ODY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/63b572062db6d3a588a77c59efdd337067fb7686","html_url":"https://github.com/juanfont/headscale/commit/63b572062db6d3a588a77c59efdd337067fb7686","author":{"name":"Jonas Schwartz","email":"js@monta.com","date":"2026-10-06T18:35:08Z"},"committer":{"name":"Jonas Schwartz","email":"js@monta.com","date":"2026-10-08T09:23:20Z"},"tree":{"sha":"a4df0847cf1039cc6e2c0403717c89ccc0d05428","url":"https://api.github.com/repos/juanfont/headscale/git/trees/a4df0847cf1039cc6e2c0403717c89ccc0d05428"},"message":"policy/v2: skip via resolution when the policy has no via grants\n\nViaRoutesForPeer runs for every peer of every map response. Before it\nlooks at Via, it converts every ACL to grants and resolves each grant's\nsources and destinations against the whole node set. Only via grants\ncan add to the result and ACLs never carry via, so without a via grant\nall of that work was discarded. On large tailnets it dominated map\ngeneration. Return early instead.\n\nBenchmarkViaRoutesForPeer, mean per peer (Apple M3 Pro):\n\n\tpolicy     nodes  before    after\n\tglobal     1000   21.8us    9ns, 0 allocs\n\tself       1000   45.0us    9ns, 0 allocs\n\tvia        1000   8.1us     unchanged\n\tvia-mixed  1000   69.0us    unchanged\n\nFixes #3512","parents":[{"sha":"4fd4da75f2ec0b1106e04f4b15640d039bcdb9e5","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4fd4da75f2ec0b1106e04f4b15640d039bcdb9e5","html_url":"https://github.com/juanfont/headscale/commit/4fd4da75f2ec0b1106e04f4b15640d039bcdb9e5"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"5075f099a8d26f7babb2a0afe370bf323bdd7d0d","node_id":"C_kwDOEFLz89oAKDUwNzVmMDk5YThkMjZmN2JhYmIyYTBhZmUzNzBiZjMyM2JkZDdkMGQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/5075f099a8d26f7babb2a0afe370bf323bdd7d0d","html_url":"https://github.com/juanfont/headscale/commit/5075f099a8d26f7babb2a0afe370bf323bdd7d0d","author":{"name":"Jonas Schwartz","email":"js@monta.com","date":"2026-10-06T18:35:17Z"},"committer":{"name":"Jonas Schwartz","email":"js@monta.com","date":"2026-10-08T09:23:20Z"},"tree":{"sha":"29f3ffbd0497c257503bfe2891acac845f935b78","url":"https://api.github.com/repos/juanfont/headscale/git/trees/29f3ffbd0497c257503bfe2891acac845f935b78"},"message":"policy/v2: resolve via-route grants lazily\n\nWith a via grant in the policy, ViaRoutesForPeer still resolved every\ngrant's sources and destinations up front. Non-via grants are only read\nonce a via grant has matched the peer, which is rare (the peer must\nadvertise a covered route), and destinations only for grants whose\nsources match the viewer. Resolve each grant on first use instead.\n\nBenchmarkViaRoutesForPeer, mean per peer (Apple M3 Pro):\n\n\tpolicy     nodes  before    after\n\tvia-mixed  100    9.5us     2.1us\n\tvia-mixed  1000   69.0us    11.6us\n\tvia        1000   8.1us     8.6us","parents":[{"sha":"63b572062db6d3a588a77c59efdd337067fb7686","url":"https://api.github.com/repos/juanfont/headscale/git/commits/63b572062db6d3a588a77c59efdd337067fb7686","html_url":"https://github.com/juanfont/headscale/commit/63b572062db6d3a588a77c59efdd337067fb7686"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"44e17f3d0368eea8c5db7893768488bfc860c21a","node_id":"C_kwDOEFLz89oAKDQ0ZTE3ZjNkMDM2OGVlYThjNWRiNzg5Mzc2ODQ4OGJmYzg2MGMyMWE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/44e17f3d0368eea8c5db7893768488bfc860c21a","html_url":"https://github.com/juanfont/headscale/commit/44e17f3d0368eea8c5db7893768488bfc860c21a","author":{"name":"Jonas Schwartz","email":"js@monta.com","date":"2026-10-07T09:01:46Z"},"committer":{"name":"Jonas Schwartz","email":"js@monta.com","date":"2026-10-08T09:23:27Z"},"tree":{"sha":"9075beea8ccd520989a234df929d25b77e5a13ca","url":"https://api.github.com/repos/juanfont/headscale/git/trees/9075beea8ccd520989a234df929d25b77e5a13ca"},"message":"policy/v2: add Grant.HasVia and tighten the changelog entry","parents":[{"sha":"5075f099a8d26f7babb2a0afe370bf323bdd7d0d","url":"https://api.github.com/repos/juanfont/headscale/git/commits/5075f099a8d26f7babb2a0afe370bf323bdd7d0d","html_url":"https://github.com/juanfont/headscale/commit/5075f099a8d26f7babb2a0afe370bf323bdd7d0d"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":32769882083,"node_id":"HRFPE_lADOEFLz888AAAABVj_uLs8AAAAHoTy34w","url":"https://api.github.com/repos/juanfont/headscale/issues/events/32769882083","actor":{"login":"joscdk","id":2535140,"node_id":"MDQ6VXNlcjI1MzUxNDA=","avatar_url":"https://avatars.githubusercontent.com/u/2535140?v=4","gravatar_id":"","url":"https://api.github.com/users/joscdk","html_url":"https://github.com/joscdk","followers_url":"https://api.github.com/users/joscdk/followers","following_url":"https://api.github.com/users/joscdk/following{/other_user}","gists_url":"https://api.github.com/users/joscdk/gists{/gist_id}","starred_url":"https://api.github.com/users/joscdk/starred{/owner}{/rep