[{"sha":"46555ae79fba21d38c210d566b10f09c590f8b85","node_id":"C_kwDOEFLz89oAKDQ2NTU1YWU3OWZiYTIxZDM4YzIxMGQ1NjZiMTBmMDljNTkwZjhiODU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/46555ae79fba21d38c210d566b10f09c590f8b85","html_url":"https://github.com/juanfont/headscale/commit/46555ae79fba21d38c210d566b10f09c590f8b85","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-02-06T21:39:35Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-02-07T07:43:01Z"},"tree":{"sha":"3d87c3f306f293b08760799d4018d7ee713c7496","url":"https://api.github.com/repos/juanfont/headscale/git/trees/3d87c3f306f293b08760799d4018d7ee713c7496"},"message":"all: upgrade to Go 1.26rc2 and modernize codebase\n\nThis commit upgrades the codebase from Go 1.25.5 to Go 1.26rc2 and\nadopts new language features.\n\nToolchain updates:\n- go.mod: go 1.25.5 → go 1.26rc2\n- flake.nix: buildGo125Module → buildGo126Module, go_1_25 → go_1_26\n- flake.nix: build golangci-lint from source with Go 1.26\n- Dockerfile.integration: golang:1.25-trixie → golang:1.26rc2-trixie\n- Dockerfile.tailscale-HEAD: golang:1.25-alpine → golang:1.26rc2-alpine\n- Dockerfile.derper: golang:alpine → golang:1.26rc2-alpine\n- .goreleaser.yml: go mod tidy -compat=1.25 → -compat=1.26\n- cmd/hi/run.go: fallback Go version 1.25 → 1.26rc2\n- .pre-commit-config.yaml: simplify golangci-lint hook entry\n\nCode modernization using Go 1.26 features:\n- Replace tsaddr.SortPrefixes with slices.SortFunc + netip.Prefix.Compare\n- Replace ptr.To(x) with new(x) syntax\n- Replace errors.As with errors.AsType[T]\n\nLint rule updates:\n- Add forbidigo rules to prevent regression to old patterns","parents":[{"sha":"20dff82f95e33316d52f0d0148f2b2ac00a8a464","url":"https://api.github.com/repos/juanfont/headscale/git/commits/20dff82f95e33316d52f0d0148f2b2ac00a8a464","html_url":"https://github.com/juanfont/headscale/commit/20dff82f95e33316d52f0d0148f2b2ac00a8a464"}],"verification"