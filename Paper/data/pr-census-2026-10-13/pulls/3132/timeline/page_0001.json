er_view_type":"public","site_admin":false},"event":"subscribed","commit_id":null,"commit_url":null,"created_at":"2026-03-11T12:50:33Z","performed_via_github_app":null},{"sha":"99c71a4cbc317e0afebb937f6c623f1892e198b4","node_id":"C_kwDOEFLz89oAKDk5YzcxYTRjYmMzMTdlMGFmZWJiOTM3ZjZjNjIzZjE4OTJlMTk4YjQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/99c71a4cbc317e0afebb937f6c623f1892e198b4","html_url":"https://github.com/juanfont/headscale/commit/99c71a4cbc317e0afebb937f6c623f1892e198b4","author":{"name":"Tanayk07","email":"tkedia7@gmail.com","date":"2026-03-08T07:29:04Z"},"committer":{"name":"Tanayk07","email":"tkedia7@gmail.com","date":"2026-03-23T14:57:31Z"},"tree":{"sha":"d4e516af8d6a546aab186d2c981215329a66db9a","url":"https://api.github.com/repos/juanfont/headscale/git/trees/d4e516af8d6a546aab186d2c981215329a66db9a"},"message":"fix: persist empty ApprovedRoutes and Endpoints to database\n\nGORM's Updates(struct) silently skips zero-value fields, so when\nApprovedRoutes is set to an empty slice (e.g. rejecting all routes\nvia `headscale nodes approve-routes -i 5 -r \"\"`), the empty value\nis never written to the database. On restart, the old routes reappear.\n\nAfter the Updates() call, explicitly write \"[]\" for empty\nApprovedRoutes and Endpoints using the same pattern already\nestablished in db.SetApprovedRoutes.\n\nFixes #3110","parents":[{"sha":"efd83da14e71a5cffee54d41edb86694ab14642d","url":"https://api.github.com/repos/juanfont/headscale/git/commits/efd83da14e71a5cffee54d41edb86694ab14642d","html_url":"https://github.com/juanfont/headscale/commit/efd83da14e71a5cffee54d41edb86694ab14642d"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"e07d391d75bd0d37064b123599a1e91abbfab415","node_id":"C_kwDOEFLz89oAKGUwN2QzOTFkNzViZDBkMzcwNjRiMTIzNTk5YTFlOTFhYmJmYWI0MTU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/e07d391d75bd0d37064b123599a1e91abbfab415","html_url":"https://github.com/juanfont/headscale/commit/e07d391d75bd0d37064b123599a1e91abbfab415","author":{"name":"Tanayk07","email":"tkedia7@gmail.com","date":"2026-03-11T12:49:17Z"},"committer":{"name":"Tanayk07","email":"tkedia7@gmail.com","date":"2026-03-23T14:57:31Z"},"tree":{"sha":"623dfeaed5372d741d588fae6b9943070f6d0693","url":"https://api.github.com/repos/juanfont/headscale/git/trees/623dfeaed5372d741d588fae6b9943070f6d0693"},"message":"fix: use Select(\"*\") to persist zero-value fields in single statement\n\nAddress review feedback from @kradalby: instead of separate Update() calls\noutside the transaction for empty slices, use GORM's Select(\"*\") on the\nexisting Updates() call. This forces GORM to include zero-value fields\n(like empty ApprovedRoutes/Endpoints slices) in a single atomic statement.\n\nFixes: https://github.com/juanfont/headscale/issues/3110","parents":[{"sha":"99c71a4cbc317e0afebb937f6c623f1892e198b4","url":"https://api.github.com/repos/juanfont/headscale/git/commits/99c71a4cbc317e0afebb937f6c623f1892e198b4","html_url":"https://github.com/juanfont/headscale/commit/99c71a4cbc317e0afebb937f6c623f1892e198b4"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":23817238893,"node_id":"HRFPE_lADOEFLz887w2PfVzwAAAAWLnjlt","url":"https://api.github.com/repos/juanfont/headscale/issues/events/23817238893","actor":{"login":"TanayK07","id":95276223,"node_id":"U_kgDOBa3Mvw","avatar_url":"https://avatars.githubusercontent.com/u/95276223?v=4","gravatar_id":"","url":"https://api.github.com/users/TanayK07","html_url":"https://github.com/TanayK07","followers_url":"https://api.github.com/users/TanayK07/followers","following_url":"https://api.github.com/users/TanayK07/following{/other_user}","gists_url":"https://api.github.com/users/TanayK07/gists{/gist_id}","starred_url":"https://api.github.com/users/TanayK07/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TanayK07/subscriptions","organizations_url":"https://api.github.com/users/TanayK07/orgs","repos_url":"https://api.github.com/users/TanayK07/repos","events_url":"https://api.github.com/users/TanayK07/events{/privacy}","received_events_url":"https://api.github.com/users/TanayK07/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"e07d391d75bd0d37064b123599a1e91abbfab415","commit_url":"https://api.github.com/repos/TanayK07/headscale/commits/e07d391d75bd0d37064b123599a1e91abbfab415","created_at":"2026-03-23T14:58:17Z","performed_via_github_app":null},{"url":"https://api.github.com/repos/juanfont/headscale/issues/comments/4111302455","html_url":"https://github.com/juanfont/headscale/pull/3132#issuecomment-4111302455","issue_url":"https://api.github.com/repos/juanfont/headscale/issues/3132","id":4111302455,"node_id":"IC_kwDOEFLz8871DX83","user":{"login":"TanayK07","id":95276223,"node_id":"U_kgDOBa3Mvw","avatar_url":"https://avatars.githubusercontent.com/u/95276223?v=4","gravatar_id":"","url":"https://api.github.com/users/TanayK07","html_url":"https://github.com/TanayK07","followers_url":"https://api.github.com/users/TanayK07/followers","following_url":"https://api.github.com/users/TanayK07/following{/other_user}","gists_url":"https://api.github.com/users/TanayK07/gists{/gist_id}","starred_url":"https://api.github.com/users/TanayK07/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TanayK07/subscriptions","organizations_url":"https://api.github.com/users/TanayK07/orgs","repos_url":"https://api.github.com/users/TanayK07/repos","events_url":"https://api.github.com/users/TanayK07/events{/privacy}","received_events_url":"https://api.github.com/users/TanayK07/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-03-23T15:01:33Z","updated_at":"2026-03-23T15:02:12Z","body":"Hi @kradalby — I've rebased onto latest main (no conflicts). The reworked fix uses `Select(\"*\")` chained on the existing `.Updates()` call to force GORM to include zero-value fields (like empty slices). This is the [documented GORM approach](https://gorm.io/docs/update.html#Update-Selected-Fields) for this — `Omit()` still takes precedence for the protected fields (`expiry`, `AuthKeyID`, `AuthKey`).\r\n\r\nThe change is a single line in `persistNodeToDB`:\r\n```go\r\nerr := s.db.DB.Omit(\"expiry\", \"AuthKeyID\", \"AuthKey\").Select(\"*\").Updates(nodePtr).Error\r\n```\r\n\r\nCI workflows are waiting on approval to runm. Could you approve them when you get a chance if that's okay?","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/juanfont/headscale/issues/comments/4111302455/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null,"event":"commented","actor":{"login":"TanayK07","id":95276223,"node_id":"U_kgDOBa3Mvw","avatar_url":"https://avatars.githubusercontent.com/u/95276223?v=4","gravatar_id":"","url":"https://api.github.com/users/TanayK07","html_url":"https://github.com/TanayK07","followers_url":"https://api.github.com/users/TanayK07/followers","following_url":"https://api.github.com/users/TanayK07/following{/other_user}","gists_url":"https://api.github.com/users/TanayK07/gists{/gist_id}","starred_url":"https://api.github.com/users/TanayK07/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TanayK07/subscriptions","organizations_url":"https://api.github.com/users/TanayK07/orgs","repos_url":"https://api.github.com/users/TanayK07/repos","events_url":"https://api.github.com/users/TanayK07/events{/privacy}","received_events_url":"https://api.github.com/users/TanayK07/received_events","type":"User","user_view_type":"public","site_admin":false}},{"id":23817355519,"node_id":"MEE_lADOEFLz887w2PfVzwAAAAWLoAD_","url":"https://api.github.com/repos/juanfont/headscale