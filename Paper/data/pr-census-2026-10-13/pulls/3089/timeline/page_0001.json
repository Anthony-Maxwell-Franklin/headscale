com/users/juanfont/repos","events_url":"https://api.github.com/users/juanfont/events{/privacy}","received_events_url":"https://api.github.com/users/juanfont/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","commit_id":"d62786b06ea6727aa8529f9e76b352ed4da3f561","state":"approved","html_url":"https://github.com/juanfont/headscale/pull/3089#pullrequestreview-3831297528","pull_request_url":"https://api.github.com/repos/juanfont/headscale/pulls/3089","_links":{"html":{"href":"https://github.com/juanfont/headscale/pull/3089#pullrequestreview-3831297528"},"pull_request":{"href":"https://api.github.com/repos/juanfont/headscale/pulls/3089"}},"submitted_at":"2026-02-20T10:32:47Z","updated_at":"2026-02-20T10:32:47Z","author_association":"OWNER","event":"reviewed"},{"sha":"68e4b50fedfd48b72868fe19bb9e6a39a7a0c2e1","node_id":"C_kwDOEFLz89oAKDY4ZTRiNTBmZWRmZDQ4YjcyODY4ZmUxOWJiOWU2YTM5YTdhMGMyZTE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/68e4b50fedfd48b72868fe19bb9e6a39a7a0c2e1","html_url":"https://github.com/juanfont/headscale/commit/68e4b50fedfd48b72868fe19bb9e6a39a7a0c2e1","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-02-20T09:26:54Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-02-20T20:30:45Z"},"tree":{"sha":"88705caea290c4a33b0bb04d26395a888c7a0205","url":"https://api.github.com/repos/juanfont/headscale/git/trees/88705caea290c4a33b0bb04d26395a888c7a0205"},"message":"hscontrol/db: add migration to clear user_id on tagged nodes\n\nTagged nodes are owned by their tags, not a user. Previously\nuser_id was kept as \"created by\" tracking, but this prevents\ndeleting users whose nodes have all been tagged, and the\nON DELETE CASCADE FK would destroy the tagged nodes.\n\nAdd a migration that sets user_id = NULL on all existing tagged\nnodes. Subsequent commits enforce this invariant at write time.\n\nUpdates #3077","parents":[{"sha":"a0d6802d5b3859586217d44b2fc2ce5a8fa0f08c","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a0d6802d5b3859586217d44b2fc2ce5a8fa0f08c","html_url":"https://github.com/juanfont/headscale/commit/a0d6802d5b3859586217d44b2fc2ce5a8fa0f08c"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"3a8f8901a8aa3d280b8b10a84a3751f621de021e","node_id":"C_kwDOEFLz89oAKDNhOGY4OTAxYThhYTNkMjgwYjhiMTBhODRhMzc1MWY2MjFkZTAyMWU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/3a8f8901a8aa3d280b8b10a84a3751f621de021e","html_url":"https://github.com/juanfont/headscale/commit/3a8f8901a8aa3d280b8b10a84a3751f621de021e","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-02-20T09:27:11Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-02-20T20:30:45Z"},"tree":{"sha":"be5fc263dd1fcaacfc47e9306b8d2ed9720f81a9","url":"https://api.github.com/repos/juanfont/headscale/git/trees/be5fc263dd1fcaacfc47e9306b8d2ed9720f81a9"},"message":"hscontrol: enforce that tagged nodes never have user_id\n\nTagged nodes are owned by their tags, not a user. Enforce this\ninvariant at every write path:\n\n- createAndSaveNewNode: do not set UserID for tagged PreAuthKey\n  registration; clear UserID when advertise-tags are applied\n  during OIDC/CLI registration\n- SetNodeTags: clear UserID/User when tags are assigned\n- processReauthTags: clear UserID/User when tags are applied\n  during re-authentication\n- validateNodeOwnership: reject tagged nodes with non-nil UserID\n- NodeStore: skip nodesByUser indexing for tagged nodes since\n  they have no owning user\n- HandleNodeFromPreAuthKey: add fallback lookup for tagged PAK\n  re-registration (tagged nodes indexed under UserID(0)); guard\n  against nil User deref for tagged nodes in different-user check\n\nSince tagged nodes now have user_id = NULL, ListNodesByUser\nwill not return them and DestroyUser naturally allows deleting\nusers whose nodes have all been tagged. The ON DELETE CASCADE\nFK cannot reach tagged nodes through a NULL foreign key.\n\nAlso tone down shouty comments throughout state.go.\n\nFixes #3077","parents":[{"sha":"68e4b50fedfd48b72868fe19bb9e6a39a7a0c2e1","url":"https://api.github.com/repos/juanfont/headscale/git/commits/68e4b50fedfd48b72868fe19bb9e6a39a7a0c2e1","html_url":"https://github.com/juanfont/headscale/commit/68e4b50fedfd48b72868fe19bb9e6a39a7a0c2e1"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"6e958b316ec10d67756bd5eef450b63ac05760f2","node_id":"C_kwDOEFLz89oAKDZlOTU4YjMxNmVjMTBkNjc3NTZiZDVlZWY0NTBiNjNhYzA1NzYwZjI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/6e958b316ec10d67756bd5eef450b63ac05760f2","html_url":"https://github.com/juanfont/headscale/commit/6e958b316ec10d67756bd5eef450b63ac05760f2","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-02-20T09:27:23Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-02-20T20:30:45Z"},"tree":{"sha":"62ef51d5121fa5e28a9da515fdd6d2db027f55f1","url":"https://api.github.com/repos/juanfont/headscale/git/trees/62ef51d5121fa5e28a9da515fdd6d2db027f55f1"},"message":"hscontrol/types: regenerate types_view.go\n\nmake generate\n\nUpdates #3077","parents":[{"sha":"3a8f8901a8aa3d280b8b10a84a3751f621de021e","url":"https://api.github.com/repos/juanfont/headscale/git/commits/3a8f8901a8aa3d280b8b10a84a3751f621de021e","html_url":"https://github.com/juanfont/headscale/commit/3a8f8901a8aa3d280b8b10a84a3751f621de021e"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"4a6fc7dbce46df0aeadf288ea0dcb188e0ef6c03","node_id":"C_kwDOEFLz89oAKDRhNmZjN2RiY2U0NmRmMGFlYWRmMjg4ZWEwZGNiMTg4ZTBlZjZjMDM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4a6fc7dbce46df0aeadf288ea0dcb188e0ef6c03","html_url":"https://github.com/juanfont/headscale/commit/4a6fc7dbce46df0aeadf288ea0dcb188e0ef6c03","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-02-20T09:27:42Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-02-20T20:30:45Z"},"tree":{"sha":"6e9fc37d79e1794367a8a9b6f2e221f1c5b3abd6","url":"https://api.github.com/repos/juanfont/headscale/git/trees/6e9fc37d79e1794367a8a9b6f2e221f1c5b3abd6"},"message":"hscontrol: add tests for deleting users with tagged nodes\n\nTest the tagged-node-survives-user-deletion scenario at two layers:\n\nDB layer (users_test.go):\n- success_user_only_has_tagged_nodes: tagged nodes with nil\n  user_id do not block user deletion and survive it\n- error_user_has_tagged_and_owned_nodes: user-owned nodes\n  still block deletion even when tagged nodes coexist\n\nApp layer (grpcv1_test.go):\n- TestDeleteUser_TaggedNodeSurvives: full registration flow\n  with tagged PreAuthKey verifies nil UserID after registration,\n  absence from nodesByUser index, user deletion succeeds, and\n  tagged node remains in global node list\n\nAlso update auth_tags_test.go assertions to expect nil UserID\non tagged nodes, consistent with the new invariant.\n\nUpdates #3077","parents":[{"sha":"6e958b316ec10d67756bd5eef450b63ac05760f2","url":"https://api.github.com/repos/juanfont/headscale/git/commits/6e958b316ec10d67756bd5eef450b63ac05760f2","html_url":"https://github.com/juanfont/headscale/commit/6e958b316ec10d67756bd5eef450b63ac05760f2"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"9ee0d2042a149e6aaa0a6c69d583bcdca4ea744f","node_id":"C_kwDOEFLz89oAKDllZTBkMjA0MmExNDllNmFhYTBhNmM2OWQ1ODNiY2RjYTRlYTc0NGY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/9ee0d2042a149e6aaa0a6c69d583bcdca4ea744f","html_url":"https://github.com/juanfont/headscale/commit/9ee0d2042a14