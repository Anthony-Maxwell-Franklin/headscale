-15T13:42:10Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-16T11:03:32Z"},"tree":{"sha":"951ad691aef73b1c13520aa19d8c06edcdfb06d9","url":"https://api.github.com/repos/juanfont/headscale/git/trees/951ad691aef73b1c13520aa19d8c06edcdfb06d9"},"message":"integration: add HA ping failover test\n\nBlock ping callbacks via iptables while keeping the Noise session alive\nto simulate a zombie-connected router. Verify the prober detects it,\nfails over, and does not flap on recovery.\n\nUpdates #2129\nUpdates #2902","parents":[{"sha":"f08c0abb17e30f37de1ba59387c395878b4ab68e","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f08c0abb17e30f37de1ba59387c395878b4ab68e","html_url":"https://github.com/juanfont/headscale/commit/f08c0abb17e30f37de1ba59387c395878b4ab68e"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"b534873540693b252748e661ac7dda97b6dc47c7","node_id":"C_kwDOEFLz89oAKGI1MzQ4NzM1NDA2OTNiMjUyNzQ4ZTY2MWFjN2RkYTk3YjZkYzQ3Yzc","url":"https://api.github.com/repos/juanfont/headscale/git/commits/b534873540693b252748e661ac7dda97b6dc47c7","html_url":"https://github.com/juanfont/headscale/commit/b534873540693b252748e661ac7dda97b6dc47c7","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-15T13:42:29Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-16T11:03:32Z"},"tree":{"sha":"f58f2b6a797e4eaba67d9d3dbd36696fadefeb1d","url":"https://api.github.com/repos/juanfont/headscale/git/trees/f58f2b6a797e4eaba67d9d3dbd36696fadefeb1d"},"message":"ci: regenerate integration test workflow","parents":[{"sha":"3ba73e0bfcb2ee84b3b023b7a7d59108662aff5d","url":"https://api.github.com/repos/juanfont/headscale/git/commits/3ba73e0bfcb2ee84b3b023b7a7d59108662aff5d","html_url":"https://github.com/juanfont/headscale/commit/3ba73e0bfcb2ee84b3b023b7a7d59108662aff5d"}],"verification":{"verifie