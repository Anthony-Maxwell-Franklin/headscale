[{"sha":"911c5bddce34b3474e4915fab5e1ed43fbe33978","node_id":"C_kwDOEFLz89oAKDkxMWM1YmRkY2UzNGIzNDc0ZTQ5MTVmYWI1ZTFlZDQzZmJlMzM5Nzg","url":"https://api.github.com/repos/juanfont/headscale/git/commits/911c5bddce34b3474e4915fab5e1ed43fbe33978","html_url":"https://github.com/juanfont/headscale/commit/911c5bddce34b3474e4915fab5e1ed43fbe33978","author":{"name":"Kristoffer Dalby","email":"kradalby@kradalby.no","date":"2022-06-27T11:56:37Z"},"committer":{"name":"Kristoffer Dalby","email":"kradalby@kradalby.no","date":"2022-06-27T11:56:37Z"},"tree":{"sha":"3afb3dfa8b9aba6b5eed76de46f22989846b7380","url":"https://api.github.com/repos/juanfont/headscale/git/trees/3afb3dfa8b9aba6b5eed76de46f22989846b7380"},"message":"Make saving logs from tests an option (default false)\n\nWe currently have a bit of flaky logic which prevents the docker plugin\nfrom cleaning up the containers if the tests or setup fatals or crashes,\nthis is due to a limitation in the save / passed stats handling.\n\nThis change makes it an environment variable which by default ditches\nthe logs and makes the containers clean up \"correctly\" in the teardown\nmethod.","parents":[{"sha":"4a200c308be84a17d0b2a16489aacbb069277a1e","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4a200c308be84a17d0b2a16489aacbb069277a1e","html_url":"https://github.com/juanfont/headscale/commit/4a200c308be84a17d0b2a16489aacbb069277a1e"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"8cae4f80d79a5baeccd2f41e4d09c1faa17b6f18","node_id":"C_kwDOEFLz89oAKDhjYWU0ZjgwZDc5YTViYWVjY2QyZjQxZTRkMDljMWZhYTE3YjZmMTg","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8cae4f80d79a5baeccd2f41e4d09c1faa17b6f18","html_url":"https://github.com/juanfont/headscale/commit/8cae4f80d79a5baeccd2f41e4d09c1faa17b6f18","author":{"name":"Kristoffer Dalby","email":"kradalby@kradalby.no","date":"2022-06-27T11:58:16Z"},"committer":{"name":"Kristoffer Dalby","email":"kradalby@kradalby.no","date":"2022-06-27T11:58:16Z"},"tree":{"sha":"839289794906602992090e7c59f8146b0ce3e6fd","url":"https://api.github.com/repos/juanfont/headscale/git/trees/839289794906602992090e7c59f8146b0ce3e6fd"},"message":"Fail tests instead of fatal\n\nCurrently we exit the program if the setup does not work, this can cause\nis to leave containers and other resources behind since we dont run\nTearDown. This change will just fail the test if we cant set up, which\nshould mean that the TearDown runs aswell.","parents":[{"sha":"911c5bddce34b3474e4915fab5e1ed43fbe33978","url":"https://api.github.com/repos/juanfont/headscale/git/commits/911c5bddce34b3474e4915fab5e1ed43fbe33978","html_url":"https://github.com/juanfont/headscale/commit/911c5bddce34b3474e4915fab5e1ed43fbe33978"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"3777de7133ebf0cb55c6c1820df264a60544e403","node_id":"C_kwDOEFLz89oAKDM3NzdkZTcxMzNlYmYwY2I1NWM2YzE4MjBkZjI2NGE2MDU0NGU0MDM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/3777de7133ebf0cb55c6c1820df264a60544e403","html_url":"https://github.com/juanfont/headscale/commit/3777de7133ebf0cb55c6c1820df264a60544e403","author":{"name":"Kristoffer Dalby","email":"kradalby@kradalby.no","date":"2022-06-27T12:00:21Z"},"committer":{"name":"Kristoffer Dalby","email":"kradalby@kradalby.no","date":"2022-06-27T12:00:21Z"},"tree":{"sha":"dd30dd98b21e8a7469dd77f48b1cdbd4495d9076","url":"https://api.github.com/repos/juanfont/headscale/git/trees/dd30dd98b21e8a7469dd77f48b1cdbd4495d9076"},"message":"Use failnow for cli tests aswell","parents":[{"sha":"8cae4f80d79a5baeccd2f41e4d09c1faa17b6f18","url":"https://api.github.com/repos/juanfont/headscale/git/commits/8cae4f80d79a5baeccd2f41e4d09c1faa17b6f18","html_url":"https://github.com/juanfont/headscale/commit/8cae4f80d79a5baeccd2f41e4d09c1faa17b6f18"}],"verification":{"verified":false,"reaso