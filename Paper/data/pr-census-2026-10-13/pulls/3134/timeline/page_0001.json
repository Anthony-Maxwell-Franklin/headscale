[{"id":23498820846,"node_id":"HRFPE_lADOEFLz887xnGaUzwAAAAV4o4zu","url":"https://api.github.com/repos/juanfont/headscale/issues/events/23498820846","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"9fc1dcba037ab1fbaa5950391d5d96fe2716dc4d","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/9fc1dcba037ab1fbaa5950391d5d96fe2716dc4d","created_at":"2026-03-12T08:46:39Z","performed_via_github_app":null},{"id":23513591410,"node_id":"HRFPE_lADOEFLz887xnGaUzwAAAAV5hO5y","url":"https://api.github.com/repos/juanfont/headscale/issues/events/23513591410","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"1a0cb836e850714fdbb5e475537c0348776b5663","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/1a0cb836e850714fdbb5e475537c0348776b5663","created_at":"2026-03-12T15:47:47Z","performed_via_github_app":null},{"sha":"4e60b9648b7de3166bb1c7bf1f1d48c740403734","node_id":"C_kwDOEFLz89oAKDRlNjBiOTY0OGI3ZGUzMTY2YmIxYzdiZjFmMWQ0OGM3NDA0MDM3MzQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4e60b9648b7de3166bb1c7bf1f1d48c740403734","html_url":"https://github.com/juanfont/headscale/commit/4e60b9648b7de3166bb1c7bf1f1d48c740403734","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-10T15:06:41Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T13:28:42Z"},"tree":{"sha":"b41ca2fc1a63af90dade7935b389fdad217ca10e","url":"https://api.github.com/repos/juanfont/headscale/git/trees/b41ca2fc1a63af90dade7935b389fdad217ca10e"},"message":"all: fix test flakiness and improve test infrastructure\n\nBuffer the AuthRequest verdict channel to prevent a race where the\nsender blocks indefinitely if the receiver has already timed out, and\nincrease the auth followup test timeout from 100ms to 5s to prevent\nspurious failures under load.\n\nSkip postgres-backed tests when the postgres server is unavailable\ninstead of calling t.Fatal, which was preventing the rest of the test\nsuite from running.\n\nAdd TestMain to db, types, and policy/v2 packages to chdir to the\nsource directory before running tests. This ensures relative testdata/\npaths resolve correctly when the test binary is executed from an\narbitrary working directory (e.g., via \"go tool stress\").","parents":[{"sha":"fffc58b5d04c0da9f38d07f2c53dd00e12f9907b","url":"https://api.github.com/repos/juanfont/headscale/git/commits/fffc58b5d04c0da9f38d07f2c53dd00e12f9907b","html_url":"https://github.com/juanfont/headscale/commit/fffc58b5d04c0da9f38d07f2c53dd00e12f9907b"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"904f14a8ae89ded7a753792282ce452c46d2d102","node_id":"C_kwDOEFLz89oAKDkwNGYxNGE4YWU4OWRlZDdhNzUzNzkyMjgyY2U0NTJjNDZkMmQxMDI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/904f14a8ae89ded7a753792282ce452c46d2d102","html_url":"https://github.com/juanfont/headscale/commit/904f14a8ae89ded7a753792282ce452c46d2d102","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T13:28:57Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T13:28:57Z"},"tree":{"sha":"39e591e5576e2891bda82dc51fa0557f9570e053","url":"https://api.github.com/repos/juanfont/headscale/git/trees/39e591e5576e2891bda82dc51fa0557f9570e053"},"message":"go.mod: add stress tool dependency\n\nAdd golang.org/x/tools/cmd/stress as a tool dependency for running\ntests under repeated stress to surface flaky failures.\n\nUpdate flake vendorHash for the new go.mod dependencies.","parents":[{"sha":"4e60b9648b7de3166bb1c7bf1f1d48c740403734","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4e60b9648b7de3166bb1c7bf1f1d48c740403734","html_url":"https://github.com/juanfont/headscale/commit/4e60b9648b7de3166bb1c7bf1f1d48c740403734"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"f502c8f61e91526783087606b22d53de0a908380","node_id":"C_kwDOEFLz89oAKGY1MDJjOGY2MWU5MTUyNjc4MzA4NzYwNmIyMmQ1M2RlMGE5MDgzODA","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f502c8f61e91526783087606b22d53de0a908380","html_url":"https://github.com/juanfont/headscale/commit/f502c8f61e91526783087606b22d53de0a908380","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-10T15:19:53Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T13:29:07Z"},"tree":{"sha":"fe307661096a581531a033507f4fc1f1b1d70029","url":"https://api.github.com/repos/juanfont/headscale/git/trees/fe307661096a581531a033507f4fc1f1b1d70029"},"message":"mapper/batcher: add unit tests and benchmarks\n\nAdd comprehensive unit tests for the LockFreeBatcher covering\nAddNode/RemoveNode lifecycle, addToBatch routing (broadcast, targeted,\nfull update), processBatchedChanges deduplication, cleanup of offline\nnodes, close/shutdown behavior, IsConnected state tracking, and\nconnected map consistency.\n\nAdd benchmarks for connection entry send, multi-channel send and\nbroadcast, peer diff computation, sentPeers updates, addToBatch at\nvarious scales (10/100/1000 nodes), processBatchedChanges, broadcast\ndelivery, IsConnected lookups, connected map enumeration, connection\nchurn, and concurrent send+churn scenarios.\n\nWiden setupBatcherWithTestData to accept testing.TB so benchmarks can\nreuse the same database-backed test setup as unit tests.","parents":[{"sha":"904f14a8ae89ded7a753792282ce452c46d2d102","url":"https://api.github.com/repos/juanfont/headscale/git/commits/904f14a8ae89ded7a753792282ce452c46d2d102","html_url":"https://github.com/juanfont/headscale/commit/904f14a8ae89ded7a753792282ce452c46d2d102"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":23546871858,"node_id":"RTE_lADOEFLz887xnGaUzwAAAAV7gMAy","url":"https://api.github.com/repos/juanfont/headscale/issues/events/23546871858","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"renamed","commit_id":null,"commit_url":null,"created_at":"2026-03-13T13:50:20Z","rename":{"from":"mapper/batcher: fix 8 concurrency bugs, add tests and benchmarks","to":"mapper/batcher: add tests and rewrite for correctness"},"performed_via_github_app":null},{"id":23547977202,"node_id":"HRFPE_lADOEFLz887xnGaUzwAAAAV7kZ3y","url":"https://api.github.com/repos/juanfont/headscale/issues/events/23547977202","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"d31c58d0ad2aa2eaf10981f79f59b7ff9e908eeb","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/d31c58d0ad2aa2eaf10981f79f59b7ff9e908eeb","created_at":"2026-03-13T14:19:40Z","performed_via_github_app":null},{"sha":"a4baffeaca3b20373f2fc2a95531ed5fa76b9d6b","node_id":"C_kwDOEFLz89oAKGE0YmFmZmVhY2EzYjIwMzczZjJmYzJhOTU1MzFlZDVmYTc2YjlkNmI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a4baffeaca3b20373f2fc2a95531ed5fa76b9d6b","html_url":"https://github.com/juanfont/headscale/commit/a4baffeaca3b20373f2fc2a95531ed5fa76b9d6b","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T13:31:39Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T14:41:18Z"},"tree":{"sha":"f17a8d8a44c76dc65bff0aaba935915bffb9344e","url":"https://api.github.com/repos/juanfont/headscale/git/trees/f17a8d8a44c76dc65bff0aaba935915bffb9344e"},"message":"mapper/batcher: restructure internals for correctness\n\nMove per-node pending changes from a shared xsync.Map on the batcher\ninto multiChannelNodeConn, protected by a dedicated mutex. The new\nappendPending/drainPending methods provide atomic append and drain\noperations, eliminating data races in addToBatch and\nprocessBatchedChanges.\n\nAdd sync.Once to multiChannelNodeConn.close() to make it idempotent,\npreventing panics from concurrent close calls on the same channel.\n\nAdd started atomic.Bool to guard Start() against being called\nmultiple times, preventing orphaned goroutines.\n\nAdd comprehensive concurrency tests validating these changes.","parents":[{"sha":"f502c8f61e91526783087606b22d53de0a908380","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f502c8f61e91526783087606b22d53de0a908380","html_url":"https://github.com/juanfont/headscale/commit/f502c8f61e91526783087606b22d53de0a908380"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"12d29927ab1fe845a764750d2245aa3795638752","node_id":"C_kwDOEFLz89oAKDEyZDI5OTI3YWIxZmU4NDVhNzY0NzUwZDIyNDVhYTM3OTU2Mzg3NTI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/12d29927ab1fe845a764750d2245aa3795638752","html_url":"https://github.com/juanfont/headscale/commit/12d29927ab1fe845a764750d2245aa3795638752","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T13:33:12Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T14:41:21Z"},"tree":{"sha":"2343ea3019df43ca4b3e589d70a40e8f28e59249","url":"https://api.github.com/repos/juanfont/headscale/git/trees/2343ea3019df43ca4b3e589d70a40e8f28e59249"},"message":"mapper/batcher: fix race conditions in cleanup and lookups\n\nReplace the two-phase Load-check-Delete in cleanupOfflineNodes with\nxsync.Map.Compute() for atomic check-and-delete. This prevents the\nTOCTOU race where a node reconnects between the hasActiveConnections\ncheck and the Delete call.\n\nAdd nil guards on all b.nodes.Load() and b.nodes.Range() call sites\nto prevent nil pointer panics from concurrent cleanup races.","parents":[{"sha":"a4baffeaca3b20373f2fc2a95531ed5fa76b9d6b","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a4baffeaca3b20373f2fc2a95531ed5fa76b9d6b","html_url":"https://github.com/juanfont/headscale/commit/a4baffeaca3b20373f2fc2a95531ed5fa76b9d6b"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"9df1e3422119f6e848656046634c0b0511fa43cb","node_id":"C_kwDOEFLz89oAKDlkZjFlMzQyMjExOWY2ZTg0ODY1NjA0NjYzNGMwYjA1MTFmYTQzY2I","url":"https://api.github.com/repos/juanfont/headscale/git/commits/9df1e3422119f6e848656046634c0b0511fa43cb","html_url":"https://github.com/juanfont/headscale/commit/9df1e3422119f6e848656046634c0b0511fa43cb","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-10T17:18:12Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T14:41:21Z"},"tree":{"sha":"36bdde82cf419ea7af5822b2fc677ad052ef1be6","url":"https://api.github.com/repos/juanfont/headscale/git/trees/36bdde82cf419ea7af5822b2fc677ad052ef1be6"},"message":"mapper/batcher: reduce lock contention with two-phase send\n\nRewrite multiChannelNodeConn.send() to use a two-phase approach:\n1. RLock: snapshot connections slice (cheap pointer copy)\n2. Unlock: send to all connections (50ms timeouts happen here)\n3. Lock: remove failed connections by pointer identity\n\nPreviously, send() held the write lock for the entire duration of\nsending to all connections. With N stale connections each timing out\nat 50ms, this blocked addConnection/removeConnection for N*50ms.\nThe two-phase approach holds the lock only for O(N) pointer\noperations, not for N*50ms I/O waits.","parents":[{"sha":"12d29927ab1fe845a764750d2245aa3795638752","url":"https://api.github.com/repos/juanfont/headscale/git/commits/12d29927ab1fe845a764750d2245aa3795638752","html_url":"https://github.com/juanfont/headscale/commit/12d29927ab1fe845a764750d2245aa3795638752"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"898c3653291d4665600c2aec95f13585f967956e","node_id":"C_kwDOEFLz89oAKDg5OGMzNjUzMjkxZDQ2NjU2MDBjMmFlYzk1ZjEzNTg1Zjk2Nzk1NmU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/898c3653291d4665600c2aec95f13585f967956e","html_url":"https://github.com/juanfont/headscale/commit/898c3653291d4665600c2aec95f13585f967956e","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-12T08:42:06Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T14:41:21Z"},"tree":{"sha":"d267e87121127a7b593f74a4792d1b90b6c9f504","url":"https://api.github.com/repos/juanfont/headscale/git/trees/d267e87121127a7b593f74a4792d1b90b6c9f504"},"message":"mapper/batcher: add scale benchmarks\n\nAdd benchmarks that systematically test node counts from 100 to\n50,000 to identify scaling limits and validate performance under\nload.","parents":[{"sha":"9df1e3422119f6e848656046634c0b0511fa43cb","url":"https://api.github.com/repos/juanfont/headscale/git/commits/9df1e3422119f6e848656046634c0b0511fa43cb","html_url":"https://github.com/juanfont/headscale/commit/9df1e3422119f6e848656046634c0b0511fa43cb"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"4f9b04e83a07b86566ac179171d74ff2d3206cab","node_id":"C_kwDOEFLz89oAKDRmOWIwNGU4M2EwN2I4NjU2NmFjMTc5MTcxZDc0ZmYyZDMyMDZjYWI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4f9b04e83a07b86566ac179171d74ff2d3206cab","html_url":"https://github.com/juanfont/headscale/commit/4f9b04e83a07b86566ac179171d74ff2d3206cab","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T13:42:42Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T14:41:21Z"},"tree":{"sha":"fd89dbcbc3e3676135a31ad2b4566beadaefdbfd","url":"https://api.github.com/repos/juanfont/headscale/git/trees/fd89dbcbc3e3676135a31ad2b4566beadaefdbfd"},"message":"mapper: remove Batcher interface, rename to Batcher struct\n\nRemove the Batcher interface since there is only one implementation.\nRename LockFreeBatcher to Batcher and merge batcher_lockfree.go into\nbatcher.go.\n\nDrop type assertions in debug.go now that mapBatcher is a concrete\n*mapper.Batcher pointer.","parents":[{"sha":"898c3653291d4665600c2aec95f13585f967956e","url":"https://api.github.com/repos/juanfont/headscale/git/commits/898c3653291d4665600c2aec95f13585f967956e","html_url":"https://github.com/juanfont/headscale/commit/898c3653291d4665600c2aec95f13585f967956e"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"a4e37e352292767777f5fbad3ba591caaf50a269","node_id":"C_kwDOEFLz89oAKGE0ZTM3ZTM1MjI5Mjc2Nzc3N2Y1ZmJhZDNiYTU5MWNhYWY1MGEyNjk","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a4e37e352292767777f5fbad3ba591caaf50a269","html_url":"https://github.com/juanfont/headscale/commit/a4e37e352292767777f5fbad3ba591caaf50a269","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T13:43:16Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T14:41:21Z"},"tree":{"sha":"5f01a900c274648f3ac327d9d688e33f9c0d16eb","url":"https://api.github.com/repos/juanfont/headscale/git/trees/5f01a900c274648f3ac327d9d688e33f9c0d16eb"},"message":"integration/acl: fix TestACLPolicyPropagationOverTime infrastructure\n\nAdd embedded DERP server, TLS, and netfilter=off to match the\ninfrastructure configuration used by all other ACL integration tests.\n\nWithout these options, the test fails intermittently because traffic\nroutes through external DERP relays and iptables initialization fails\nin Docker containers.\n\nUpdates #3139","parents":[{"sha":"4f9b04e83a07b86566ac179171d74ff2d3206cab","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4f9b04e83a07b86566ac179171d74ff2d3206cab","html_url":"https://github.com/juanfont/headscale/commit/4f9b04e83a07b86566ac179171d74ff2d3206cab"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":23548905484,"node_id":"HRFPE_lADOEFLz887xnGaUzwAAAAV7n8gM","url":"https://api.github.com/repos/juanfont/headscale/issues/events/23548905484","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"a4e37e352292767777f5fbad3ba591caaf50a269","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/a4e37e352292767777f5fbad3ba591caaf50a269","created_at":"2026-03-13T14:42:13Z","performed_via_github_app":null},{"sha":"63b0957f4ef0dbd578677ed202cc0520bd7754b8","node_id":"C_kwDOEFLz89oAKDYzYjA5NTdmNGVmMGRiZDU3ODY3N2VkMjAyY2MwNTIwYmQ3NzU0Yjg","url":"https://api.github.com/repos/juanfont/headscale/git/commits/63b0957f4ef0dbd578677ed202cc0520bd7754b8","html_url":"https://github.com/juanfont/headscale/commit/63b0957f4ef0dbd578677ed202cc0520bd7754b8","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T15:31:33Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T15:31:33Z"},"tree":{"sha":"3d5aa3eaaaa2e1d8a67327baac482a29e4c8624c","url":"https://api.github.com/repos/juanfont/headscale/git/trees/3d5aa3eaaaa2e1d8a67327baac482a29e4c8624c"},"message":"mapper/batcher: replace time.After with NewTimer to avoid timer leak\n\nconnectionEntry.send() is on the hot path: called once per connection\nper broadcast tick. time.After allocates a timer that sits in the\nruntime timer heap until it fires (50 ms), even when the channel send\nsucceeds immediately. At 1000 connected nodes, every tick leaks 1000\ntimers into the heap, creating continuous GC pressure.\n\nReplace with time.NewTimer + defer timer.Stop() so the timer is\nremoved from the heap as soon as the fast-path send completes.","parents":[{"sha":"a4e37e352292767777f5fbad3ba591caaf50a269","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a4e37e352292767777f5fbad3ba591caaf50a269","html_url":"https://github.com/juanfont/headscale/commit/a4e37e352292767777f5fbad3ba591caaf50a269"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"5a3157ba37b028d39e2cc9d75fa22d4d0617d021","node_id":"C_kwDOEFLz89oAKDVhMzE1N2JhMzdiMDI4ZDM5ZTJjYzlkNzVmYTIyZDRkMDYxN2QwMjE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/5a3157ba37b028d39e2cc9d75fa22d4d0617d021","html_url":"https://github.com/juanfont/headscale/commit/5a3157ba37b028d39e2cc9d75fa22d4d0617d021","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T15:32:15Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T15:32:15Z"},"tree":{"sha":"dbedf921cba2bb3a8b4bd10de1e30eccb44a598e","url":"https://api.github.com/repos/juanfont/headscale/git/trees/dbedf921cba2bb3a8b4bd10de1e30eccb44a598e"},"message":"mapper/batcher: track worker goroutines and stop ticker on Close\n\nClose() previously closed the done channel and returned immediately,\nwithout waiting for worker goroutines to exit. This caused goroutine\nleaks in tests and allowed workers to race with connection teardown.\nThe ticker was also never stopped, leaking its internal goroutine.\n\nAdd a sync.WaitGroup to track the doWork goroutine and every worker\nit spawns. Close() now calls wg.Wait() after signalling shutdown,\nensuring all goroutines have exited before tearing down connections.\nAlso stop the ticker to prevent resource leaks.\n\nDocument that a Batcher must not be reused after Close().","parents":[{"sha":"63b0957f4ef0dbd578677ed202cc0520bd7754b8","url":"https://api.github.com/repos/juanfont/headscale/git/commits/63b0957f4ef0dbd578677ed202cc0520bd7754b8","html_url":"https://github.com/juanfont/headscale/commit/63b0957f4ef0dbd578677ed202cc0520bd7754b8"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"547f5d50e0550c6c7b75543ccb9831ea4b9101e1","node_id":"C_kwDOEFLz89oAKDU0N2Y1ZDUwZTA1NTBjNmM3Yjc1NTQzY2NiOTgzMWVhNGI5MTAxZTE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/547f5d50e0550c6c7b75543ccb9831ea4b9101e1","html_url":"https://github.com/juanfont/headscale/commit/547f5d50e0550c6c7b75543ccb9831ea4b9101e1","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T15:36:12Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T15:36:12Z"},"tree":{"sha":"9fff0371a5009a78a489f6f99e48cc9e4dcf2361","url":"https://api.github.com/repos/juanfont/headscale/git/trees/9fff0371a5009a78a489f6f99e48cc9e4dcf2361"},"message":"mapper/batcher: reduce hot-path log verbosity\n\nRemove Caller(), channel pointer formatting (fmt.Sprintf(\"%p\",...)),\nand mutex timing from send(), addConnection(), and\nremoveConnectionByChannel(). Move per-broadcast summary and\nno-connection logs from Debug to Trace. Remove per-connection\n\"attempting\"/\"succeeded\" logs entirely; keep Warn for failures.\n\nThese methods run on every MapResponse delivery, so the savings\ncompound quickly under load.\n\nUpdates #2545","parents":[{"sha":"5a3157ba37b028d39e2cc9d75fa22d4d0617d021","url":"https://api.github.com/repos/juanfont/headscale/git/commits/5a3157ba37b028d39e2cc9d75fa22d4d0617d021","html_url":"https://github.com/juanfont/headscale/commit/5a3157ba37b028d39e2cc9d75fa22d4d0617d021"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"9ad5c006e0b8088f26ffed10d37ff96e2c48daff","node_id":"C_kwDOEFLz89oAKDlhZDVjMDA2ZTBiODA4OGYyNmZmZWQxMGQzN2ZmOTZlMmM0OGRhZmY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/9ad5c006e0b8088f26ffed10d37ff96e2c48daff","html_url":"https://github.com/juanfont/headscale/commit/9ad5c006e0b8088f26ffed10d37ff96e2c48daff","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T15:39:10Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T15:39:10Z"},"tree":{"sha":"7e178ff47d2c8633ca0ae1a948b1457ac5207d10","url":"https://api.github.com/repos/juanfont/headscale/git/trees/7e178ff47d2c8633ca0ae1a948b1457ac5207d10"},"message":"mapper/batcher: add regression tests for timer leak and Close lifecycle\n\nAdd four unit tests guarding fixes introduced in recent commits:\n\n- TestConnectionEntry_SendFastPath_TimerStopped: verifies the\n  time.NewTimer fix (H1) does not leak goroutines after many\n  fast-path sends on a buffered channel.\n\n- TestBatcher_CloseWaitsForWorkers: verifies Close() blocks until all\n  worker goroutines exit (H3), preventing sends on torn-down channels.\n\n- TestBatcher_CloseThenStartIsNoop: verifies the one-shot lifecycle\n  contract; Start() after Close() must not spawn new goroutines.\n\n- TestBatcher_CloseStopsTicker: verifies Close() stops the internal\n  ticker to prevent resource leaks.\n\nUpdates #2545","parents":[{"sha":"547f5d50e0550c6c7b75543ccb9831ea4b9101e1","url":"https://api.github.com/repos/juanfont/headscale/git/commits/547f5d50e0550c6c7b75543ccb9831ea4b9101e1","html_url":"https://github.com/juanfont/headscale/commit/547f5d50e0550c6c7b75543ccb9831ea4b9101e1"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"9a4e849766161f946e3e84a67f2307be9a9f8b31","node_id":"C_kwDOEFLz89oAKDlhNGU4NDk3NjYxNjFmOTQ2ZTNlODRhNjdmMjMwN2JlOWE5ZjhiMzE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/9a4e849766161f946e3e84a67f2307be9a9f8b31","html_url":"https://github.com/juanfont/headscale/commit/9a4e849766161f946e3e84a67f2307be9a9f8b31","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T15:47:58Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T15:47:58Z"},"tree":{"sha":"3c7e0f623adc9680b4601397f93eb61c991b8033","url":"https://api.github.com/repos/juanfont/headscale/git/trees/3c7e0f623adc9680b4601397f93eb61c991b8033"},"message":"mapper/batcher: fix pointer retention, done-channel init, and connected-map races\n\nM7: Nil out trailing *connectionEntry pointers in the backing array\nafter slice removal in removeConnectionAtIndexLocked and send().\nWithout this, the GC cannot collect removed entries until the slice\nis reallocated.\n\nM1: Initialize the done channel in NewBatcher instead of Start().\nPreviously, calling Close() or queueWork before Start() would select\non a nil channel, blocking forever. Moving the make() to the\nconstructor ensures the channel is always usable.\n\nM2: Move b.connected.Delete and b.totalNodes decrement inside the\nCompute callback in cleanupOfflineNodes. Previously these ran after\nthe Compute returned, allowing a concurrent AddNode to reconnect\nbetween the delete and the bookkeeping update, which would wipe the\nfresh connected state.\n\nM3: Call markDisconnectedIfNoConns on AddNode error paths. Previously,\nwhen initial map generation or send timed out, the connection was\nremoved but b.connected retained its old nil (= connected) value,\nmaking IsConnected return true for a node with zero connections.\n\nUpdates #2545","parents":[{"sha":"9ad5c006e0b8088f26ffed10d37ff96e2c48daff","url":"https://api.github.com/repos/juanfont/headscale/git/commits/9ad5c006e0b8088f26ffed10d37ff96e2c48daff","html_url":"https://github.com/juanfont/headscale/commit/9ad5c006e0b8088f26ffed10d37ff96e2c48daff"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"3de3af35b8fcfa2143976836d815bf435180c9b4","node_id":"C_kwDOEFLz89oAKDNkZTNhZjM1YjhmY2ZhMjE0Mzk3NjgzNmQ4MTViZjQzNTE4MGM5YjQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/3de3af35b8fcfa2143976836d815bf435180c9b4","html_url":"https://github.com/juanfont/headscale/commit/3de3af35b8fcfa2143976836d815bf435180c9b4","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T15:48:17Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T15:48:17Z"},"tree":{"sha":"abd317ab094faf769a4fcdbb0a587f33067cd4cf","url":"https://api.github.com/repos/juanfont/headscale/git/trees/abd317ab094faf769a4fcdbb0a587f33067cd4cf"},"message":"mapper/batcher: add regression tests for M1, M3, M7 fixes\n\n- TestBatcher_CloseBeforeStart_DoesNotHang: verifies Close() before\n  Start() returns promptly now that done is initialized in NewBatcher.\n\n- TestBatcher_QueueWorkAfterClose_DoesNotHang: verifies queueWork\n  returns via the done channel after Close(), even without Start().\n\n- TestIsConnected_FalseAfterAddNodeFailure: verifies IsConnected\n  returns false after AddNode fails and removes the last connection.\n\n- TestRemoveConnectionAtIndex_NilsTrailingSlot: verifies the backing\n  array slot is nil-ed after removal to avoid retaining pointers.\n\nUpdates #2545","parents":[{"sha":"9a4e849766161f946e3e84a67f2307be9a9f8b31","url":"https://api.github.com/repos/juanfont/headscale/git/commits/9a4e849766161f946e3e84a67f2307be9a9f8b31","html_url":"https://github.com/juanfont/headscale/commit/9a4e849766161f946e3e84a67f2307be9a9f8b31"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"13a2d9eff607a414a4029eb525352f379c0f4cde","node_id":"C_kwDOEFLz89oAKDEzYTJkOWVmZjYwN2E0MTRhNDAyOWViNTI1MzUyZjM3OWMwZjRjZGU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/13a2d9eff607a414a4029eb525352f379c0f4cde","html_url":"https://github.com/juanfont/headscale/commit/13a2d9eff607a414a4029eb525352f379c0f4cde","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T15:52:23Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T15:52:23Z"},"tree":{"sha":"4ea5127c0f68e7a7fb3918652f3c45f12d1917be","url":"https://api.github.com/repos/juanfont/headscale/git/trees/4ea5127c0f68e7a7fb3918652f3c45f12d1917be"},"message":"mapper: extract node connection types to node_conn.go\n\nMove connectionEntry, multiChannelNodeConn, generateConnectionID, and\nall their methods from batcher.go into a dedicated file. This reduces\nbatcher.go from ~1170 lines to ~800 and separates per-node connection\nmanagement from batcher orchestration.\n\nPure move — no logic changes.\n\nUpdates #2545","parents":[{"sha":"3de3af35b8fcfa2143976836d815bf435180c9b4","url":"https://api.github.com/repos/juanfont/headscale/git/commits/3de3af35b8fcfa2143976836d815bf435180c9b4","html_url":"https://github.com/juanfont/headscale/commit/3de3af35b8fcfa2143976836d815bf435180c9b4"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"f3467baf52d696cdfbd5b48d86c836e43a6c4ddc","node_id":"C_kwDOEFLz89oAKGYzNDY3YmFmNTJkNjk2Y2RmYmQ1YjQ4ZDg2YzgzNmU0M2E2YzRkZGM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f3467baf52d696cdfbd5b48d86c836e43a6c4ddc","html_url":"https://github.com/juanfont/headscale/commit/f3467baf52d696cdfbd5b48d86c836e43a6c4ddc","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T16:03:28Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T16:03:28Z"},"tree":{"sha":"48ca1d09987490341d02884eb6f480df9727b3e6","url":"https://api.github.com/repos/juanfont/headscale/git/trees/48ca1d09987490341d02884eb6f480df9727b3e6"},"message":"mapper/batcher: minor production code cleanup\n\nL1: Replace crypto/rand with an atomic counter for generating\nconnection IDs. These identifiers are process-local and do not need\ncryptographic randomness; a monotonic counter is cheaper and\nproduces shorter, sortable IDs.\n\nL5: Use getActiveConnectionCount() in Debug() instead of directly\nlocking the mutex and reading the connections slice. This avoids\nbypassing the accessor that already exists for this purpose.\n\nL6: Extract the hardcoded 15*time.Minute cleanup threshold into\nthe named constant offlineNodeCleanupThreshold.\n\nL7: Inline the trivial addWork wrapper; AddWork now calls addToBatch\ndirectly.\n\nUpdates #2545","parents":[{"sha":"13a2d9eff607a414a4029eb525352f379c0f4cde","url":"https://api.github.com/repos/juanfont/headscale/git/commits/13a2d9eff607a414a4029eb525352f379c0f4cde","html_url":"https://github.com/juanfont/headscale/commit/13a2d9eff607a414a4029eb525352f379c0f4cde"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"ce031ab3d1ff9e9c35ee7599343fe6a3f04e6880","node_id":"C_kwDOEFLz89oAKGNlMDMxYWIzZDFmZjllOWMzNWVlNzU5OTM0M2ZlNmEzZjA0ZTY4ODA","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ce031ab3d1ff9e9c35ee7599343fe6a3f04e6880","html_url":"https://github.com/juanfont/headscale/commit/ce031ab3d1ff9e9c35ee7599343fe6a3f04e6880","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T16:07:35Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T16:07:35Z"},"tree":{"sha":"8028ba42e70f08622a44c7c40de8922c5da25b09","url":"https://api.github.com/repos/juanfont/headscale/git/trees/8028ba42e70f08622a44c7c40de8922c5da25b09"},"message":"mapper/batcher: clean up test constants and output\n\nL8: Rename SCREAMING_SNAKE_CASE test constants to idiomatic Go\ncamelCase. Remove highLoad* and extremeLoad* constants that were\nonly referenced by disabled (X-prefixed) tests.\n\nL10: Fix misleading assert message that said \"1337\" while checking\nfor region ID 999.\n\nL12: Remove emoji from test log output to avoid encoding issues\nin CI environments.\n\nUpdates #2545","parents":[{"sha":"f3467baf52d696cdfbd5b48d86c836e43a6c4ddc","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f3467baf52d696cdfbd5b48d86c836e43a6c4ddc","html_url":"https://github.com/juanfont/headscale/commit/f3467baf52d696cdfbd5b48d86c836e43a6c4ddc"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"9e30110420f1bcc86ce9af94752bfc37b5a5dac0","node_id":"C_kwDOEFLz89oAKDllMzAxMTA0MjBmMWJjYzg2Y2U5YWY5NDc1MmJmYzM3YjVhNWRhYzA","url":"https://api.github.com/repos/juanfont/headscale/git/commits/9e30110420f1bcc86ce9af94752bfc37b5a5dac0","html_url":"https://github.com/juanfont/headscale/commit/9e30110420f1bcc86ce9af94752bfc37b5a5dac0","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T16:11:33Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-13T16:11:33Z"},"tree":{"sha":"5dc10054e870cb06d2fef8847c992c55b7d54aaf","url":"https://api.github.com/repos/juanfont/headscale/git/trees/5dc10054e870cb06d2fef8847c992c55b7d54aaf"},"message":"mapper/batcher: remove disabled X-prefixed test functions\n\nRemove XTestBatcherChannelClosingRace (~95 lines) and\nXTestBatcherScalability (~515 lines). These were disabled by\nprefixing with X (making them invisible to go test) and served\nas dead code. The functionality they covered is exercised by the\nactive test suite.\n\nUpdates #2545","parents":[{"sha":"ce031ab3d1ff9e9c35ee7599343fe6a3f04e6880","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ce031ab3d1ff9e9c35ee7599343fe6a3f04e6880","html_url":"https://github.com/juanfont/headscale/commit/ce031ab3d1ff9