radalby/headscale/commits/9109c0e31c239c3034a18018c58496fac1a06e7c","created_at":"2026-04-02T11:37:47Z","performed_via_github_app":null},{"id":4052528901,"node_id":"PRR_kwDOEFLz887xjK8F","user":{"login":"nblock","id":131119,"node_id":"MDQ6VXNlcjEzMTExOQ==","avatar_url":"https://avatars.githubusercontent.com/u/131119?v=4","gravatar_id":"","url":"https://api.github.com/users/nblock","html_url":"https://github.com/nblock","followers_url":"https://api.github.com/users/nblock/followers","following_url":"https://api.github.com/users/nblock/following{/other_user}","gists_url":"https://api.github.com/users/nblock/gists{/gist_id}","starred_url":"https://api.github.com/users/nblock/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nblock/subscriptions","organizations_url":"https://api.github.com/users/nblock/orgs","repos_url":"https://api.github.com/users/nblock/repos","events_url":"https://api.github.com/users/nblock/events{/privacy}","received_events_url":"https://api.github.com/users/nblock/received_events","type":"User","user_view_type":"public","site_admin":false},"body":null,"commit_id":"9109c0e31c239c3034a18018c58496fac1a06e7c","state":"approved","html_url":"https://github.com/juanfont/headscale/pull/3122#pullrequestreview-4052528901","pull_request_url":"https://api.github.com/repos/juanfont/headscale/pulls/3122","_links":{"html":{"href":"https://github.com/juanfont/headscale/pull/3122#pullrequestreview-4052528901"},"pull_request":{"href":"https://api.github.com/repos/juanfont/headscale/pulls/3122"}},"submitted_at":"2026-04-02T18:47:30Z","updated_at":"2026-04-02T18:47:30Z","author_association":"COLLABORATOR","event":"reviewed"},{"sha":"636bd5a6c8ea2b57a482fd1814b334f9432873f3","node_id":"C_kwDOEFLz89oAKDYzNmJkNWE2YzhlYTJiNTdhNDgyZmQxODE0YjMzNGY5NDMyODczZjM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/636bd5a6c8ea2b57a482fd1814b334f9432873f3","html_url":"https://github.com/juanfont/headscale/commit/636bd5a6c8ea2b57a482fd1814b334f9432873f3","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-01T22:53:26Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-02T20:43:18Z"},"tree":{"sha":"cc5342630e17c1bbb4d0b9005c466c8559b51e99","url":"https://api.github.com/repos/juanfont/headscale/git/trees/cc5342630e17c1bbb4d0b9005c466c8559b51e99"},"message":"types: add node.expiry config, deprecate oidc.expiry\n\nIntroduce a structured NodeConfig that replaces the flat\nEphemeralNodeInactivityTimeout field with a nested Node section.\n\nAdd node.expiry config (default: no expiry) as the unified default key\nexpiry for all non-tagged nodes regardless of registration method.\n\nRemove oidc.expiry entirely — node.expiry now applies to OIDC nodes\nthe same as all other registration methods. Using oidc.expiry in the\nconfig is a hard error. determineNodeExpiry() returns nil (no expiry)\nunless use_expiry_from_token is enabled, letting state.go apply the\nnode.expiry default uniformly.\n\nThe old ephemeral_node_inactivity_timeout key is preserved for\nbackwards compatibility.\n\nUpdates #1711","parents":[{"sha":"835db974b5cd69028b6dca0c441acde25005469b","url":"https://api.github.com/repos/juanfont/headscale/git/commits/835db974b5cd69028b6dca0c441acde25005469b","html_url":"https://github.com/juanfont/headscale/commit/835db974b5cd69028b6dca0c441acde25005469b"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"99e8d823a548e5e0165d5a12f649ac838d0df21f","node_id":"C_kwDOEFLz89oAKDk5ZThkODIzYTU0OGU1ZTAxNjVkNWExMmY2NDlhYzgzOGQwZGYyMWY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/99e8d823a548e5e0165d5a12f649ac838d0df21f","html_url":"https://github.com/juanfont/headscale/commit/99e8d823a548e5e0165d5a12f649ac838d0df21f","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-01T22:53:55Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-02T20:43:18Z"},"tree":{"sha":"310087985025ebe74de1b2a8103d9b9de9b3bf83","url":"https://api.github.com/repos/juanfont/headscale/git/trees/310087985025ebe74de1b2a8103d9b9de9b3bf83"},"message":"state: apply default node key expiry on registration\n\nUse the node.expiry config to apply a default expiry to non-tagged\nnodes when the client does not request a specific expiry. This covers\nall registration paths: new node creation, re-authentication, and\npre-auth key re-registration.\n\nTagged nodes remain exempt and never expire.\n\nFixes #1711","parents":[{"sha":"636bd5a6c8ea2b57a482fd1814b334f9432873f3","url":"https://api.github.com/repos/juanfont/headscale/git/commits/636bd5a6c8ea2b57a482fd1814b334f9432873f3","html_url":"https://github.com/juanfont/headscale/commit/636bd5a6c8ea2b57a482fd1814b334f9432873f3"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"6b5f6dcf32b4fb465f97e7f400f19e8c8cc1f6f7","node_id":"C_kwDOEFLz89oAKDZiNWY2ZGNmMzJiNGZiNDY1Zjk3ZTdmNDAwZjE5ZThjOGNjMWY2Zjc","url":"https://api.github.com/repos/juanfont/headscale/git/commits/6b5f6dcf32b4fb465f97e7f400f19e8c8cc1f6f7","html_url":"https://github.com/juanfont/headscale/commit/6b5f6dcf32b4fb465f97e7f400f19e8c8cc1f6f7","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-01T22:54:10Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-02T20:43:18Z"},"tree":{"sha":"cc116a5d5c6c9b92022fb6f49a25cf2770d87656","url":"https://api.github.com/repos/juanfont/headscale/git/trees/cc116a5d5c6c9b92022fb6f49a25cf2770d87656"},"message":"hscontrol: add tests for default node key expiry\n\nAdd tests covering the core expiry scenarios:\n- Untagged auth key with zero expiry gets configured default\n- Tagged nodes ignore node.expiry\n- node.expiry=0 disables default (backwards compatible)\n- Client-requested expiry takes precedence\n- Re-registration refreshes the default expiry\n\nUpdates #1711","parents":[{"sha":"99e8d823a548e5e0165d5a12f649ac838d0df21f","url":"https://api.github.com/repos/juanfont/headscale/git/commits/99e8d823a548e5e0165d5a12f649ac838d0df21f","html_url":"https://github.com/juanfont/headscale/commit/99e8d823a548e5e0165d5a12f649ac838d0df21f"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"965b6e2c80b1e80072743b92a0408c84a343e9ba","node_id":"C_kwDOEFLz89oAKDk2NWI2ZTJjODBiMWU4MDA3Mjc0M2I5MmEwNDA4Yzg0YTM0M2U5YmE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/965b6e2c80b1e80072743b92a0408c84a343e9ba","html_url":"https://github.com/juanfont/headscale/commit/965b6e2c80b1e80072743b92a0408c84a343e9ba","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-02T09:19:05Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-02T20:43:18Z"},"tree":{"sha":"edced6b996efbf00e5960b3d214533632ad2cf09","url":"https://api.github.com/repos/juanfont/headscale/git/trees/edced6b996efbf00e5960b3d214533632ad2cf09"},"message":"servertest: use memnet networking and add WithNodeExpiry option\n\nReplace httptest (real TCP sockets) with tailscale.com/net/memnet\nso all connections stay in-process. Wire the client's tsdial.Dialer\nto the server's memnet.Network via SetSystemDialerForTest,\npreserving the full Noise protocol path.\n\nAlso update servertest to use the new Node.Ephemeral.InactivityTimeout\nconfig path introduced in the types refactor, and add WithNodeExpiry\nserver option for testing default node key expiry behaviour.\n\nUpdates #1711","parents":[{"sha":"6b5f6dcf32b4fb465f97e7f400f19e8c8cc1f6f7","url":"https://api.github.com/repos/juanfont/headscale/git/commits/6b5f6dcf32b4fb465f97e7f400f19e8c8cc1f6f7","html_url":"https://github.com/juanfont/headscale/commit/6b5f6dcf32b4fb465f97e7f400f19e8c8cc1f6f7"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"0192a44eba4b669bbba73eb6e2e1e67efd5b961d","node_id":"C_kwDOEFLz89oAKDAxOTJhNDRlYmE0YjY2OWJiYmE3M2ViNmUyZTFlNjdlZmQ1Yjk2MWQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/0192a44eba4b669bbba73eb6e2e1e67efd5b961d","html_url":"https://github.com/juanfont/headscale/commit/0192a44eba4b669bbba73eb6e2e1e67efd5b961d","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-02T20:43:09Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-02T20:43:18Z"},"tree":{"sha":"2476a83cbfc5d8024ab578d4583dba596146555a","url":"https://api.github.com/repos/juanfont/headscale/git/trees/2476a83cbfc5d8024ab578d4583dba596146555a"},"message":"CHANGELOG: document node.expiry and oidc.expiry deprecation\n\nUpdates #1711","parents":[{"sha":"965b6e2c80b1e80072743b92a0408c84a343e9ba","url":"https://api.github.com/repos/juanfont/headscale/git/commits/965b6e2c80b1e80072743b92a0408c84a343e9ba","html_url":"https://github.com/juanfont/headscale/commit/965b6e2c80b1e80072743b92a0408c84a343e9ba"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":24170841763,"node_id":"HRFPE_lADOEFLz887vA3LGzwAAAAWgscaj","url":"https://api.github.com/repos/juanfont/headscale/issues/events/24170841763","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"0192a44eba4b669bbba73eb6e2e1e67efd5b961d","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/0192a44eba4b669bbba73eb6e2e1e67efd5b961d","created_at":"2026-04-03T07:24:41Z","performed_via_github_app":null},{"sha":"53754af47ae3674ef99741faa030f3ac3869268e","node_id":"C_kwDOEFLz89oAKDUzNzU0YWY0N2FlMzY3NGVmOTk3NDFmYWEwMzBmM2FjMzg2OTI2OGU","url":"https://api.github.com/repos/juanfont/headscale/git/commits/53754af47ae3674ef99741faa030f3ac3869268e","html_url":"https://github.com/juanfont/headscale/commit/53754af47ae3674ef99741faa030f3ac3869268e","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-08T10:30:52Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-08T10:30:52Z"},"tree":{"sha":"7005a06080db9ca99feed57c8a8bc99ed8535e54","url":"https://api.github.com/repos/juanfont/headscale/git/trees/7005a06080db9ca99feed57c8a8bc99ed8535e54"},"message":"Dockerfile: bump tailscale HEAD builder to Go 1.26.2\n\nTailscale main now requires go >= 1.26.2, so building the HEAD image\nagainst golang:1.26.1-alpine fails with:\n\n    go: go.mod requires go >= 1.26.2 (running go 1.26.1; GOTOOLCHAIN=local)\n\nBump the base image to golang:1.26.2-alpine so `go run ./cmd/hi run`\ncan build the HEAD container locally again.","parents":[{"sha":"0192a44eba4b669bbba73eb6e2e1e67efd5b961d","url":"https://api.github.com/repos/juanfont/headscale/git/commits/0192a44eba4b669bbba73eb6e2e1e67efd5b961d","html_url":"https://github.com/juanfont/headscale/commit/0192a44eba4b669bbba73eb6e2e1e67efd5b961d"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"5f84ccdb7d8c88f95a46ef5368f699871c136cfa","node_id":"C_kwDOEFLz89oAKDVmODRjY2RiN2Q4Yzg4Zjk1YTQ2ZWY1MzY4ZjY5OTg3MWMxMzZjZmE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/5f84ccdb7d8c88f95a46ef5368f699871c136cfa","html_url":"https://github.com/juanfont/headscale/commit/5f84ccdb7d8c88f95a46ef5368f699871c136cfa","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-08T10:31:08Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-08T10:31:08Z"},"tree":{"sha":"81c99ebe99194d0609519b77963125adfd779b86","url":"https://api.github.com/repos/juanfont/headscale/git/trees/81c99ebe99194d0609519b77963125adfd779b86"},"message":"integration/tsic: accept via peer-relay in non-direct ping check\n\nWhen WithPingUntilDirect(false) is set, the Ping helper should accept\nany indirect path, but the substring check only matched \"via DERP\" and\n\"via relay\". Tailscale peer relay pings output\n\n    pong from ... via peer-relay(ip:port:vni:N) in Nms\n\nwhich does not contain the \"via relay\" substring and was therefore\nrejected as errTailscalePingNotDERP. TestGrantCapRelay Phase 4 never\npassed because of this: even when the data plane was healthy the\nhelper returned an error.\n\nCommit abe1a3e7 attempted to fix this by adding \"via relay\" alongside\n\"via DERP\" but missed the \"peer-\" prefix used by peer relay output.\n\nAdd an explicit \"via peer-relay\" substring check so peer relay pongs\nare accepted alongside DERP and plain relay pongs.\n\nUpdates #2180","parents":[{"sha":"53754af47ae3674ef99741faa030f3ac3869268e","url":"https://api.github.com/repos/juanfont/headscale/git/commits/53754af47ae3674ef99741faa030f3ac3869268e","html_url":"https://github.com/juanfont/headscale/commit/53754af47ae3674ef99741faa030f3ac3869268e"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"7956f9646c95fcaa6cffc54b1d5b566b9c5043a1","node_id":"C_kwDOEFLz89oAKDc5NTZmOTY0NmM5NWZjYWE2Y2ZmYzU0YjFkNWI1NjZiOWM1MDQzYTE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7956f9646c95fcaa6cffc54b1d5b566b9c5043a1","html_url":"https://github.com/juanfont/headscale/commit/7956f9646c95fcaa6cffc54b1d5b566b9c5043a1","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-08T10:31:35Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-08T10:31:35Z"},"tree":{"sha":"6a1c42667bb21e7196f0175b97fa8655bc280399","url":"https://api.github.com/repos/juanfont/headscale/git/trees/6a1c42667bb21e7196f0175b97fa8655bc280399"},"message":"integration: fix ACL tests for address-family-specific resolve\n\nAddress-based aliases (Prefix, Host) now resolve to exactly the literal\nprefix and do not expand to include the matching node's other IP\naddresses. This means an IPv4-only host definition only produces IPv4\nfilter rules, and an IPv6-only definition only produces IPv6 rules.\n\nUpdate TestACLDevice1CanAccessDevice2 and TestACLNamedHostsCanReach to\ntrack which addresses each test case covers via test1Addr/test2Addr/\ntest3Addr fields and only assert connectivity for that family.\nPreviously the tests assumed all address families would work regardless\nof how the policy aliases were defined, which was true only when\naddress-based aliases auto-expanded to include all of a node's IPs.\n\nThe group test case (identity-based) keeps using IPv4 since tags, users,\ngroups, autogroups and the wildcard still resolve to both IPv4 and IPv6.\n\nUpdates #2180","parents":[{"sha":"5f84ccdb7d8c88f95a46ef5368f699871c136cfa","url":"https://api.github.com/repos/juanfont/headscale/git/commits/5f84ccdb7d8c88f95a46ef5368f699871c136cfa","html_url":"https://github.com/juanfont/headscale/commit/5f84ccdb7d8c88f95a46ef5368f699871c136cfa"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"ca54e3fa47b4d7b8975b9663c71231afe7127957","node_id":"C_kwDOEFLz89oAKGNhNTRlM2ZhNDdiNGQ3Yjg5NzViOTY2M2M3MTIzMWFmZTcxMjc5NTc","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ca54e3fa47b4d7b8975b9663c71231afe7127957","html_url":"https://github.com/juanfont/headscale/commit/ca54e3fa47b4d7b8975b9663c71231afe7127957","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-08T10:31:54Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-08T11:18:32Z"},"tree":{"sha":"2bfac53dcb449ac1e6a6a2de763d3ade0de0e2c9","url":"https://api.github.com/repos/juanfont/headscale/git/trees/2bfac53dcb449ac1e6a6a2de763d3ade0de0e2c9"},"message":"state: trigger PolicyChange on every Connect and Disconnect\n\nConnect and Disconnect previously only appended a PolicyChange when\nthe affected node was a subnet router (routeChange) or the database\npersist returned a full change. For every other node the peers just\nreceived a small PeerChangedPatch{Online: ...} and no filter rules\nwere recomputed. That was too narrow: a node going offline or coming\nonline can affect policy compilation in ways beyond subnet routes.\n\nTestGrantCapRelay Phase 4 exposed this. When the cap/relay target node\nwent down with `tailscale down`, headscale only sent an Online=false\npatch, peers never got a recomputed netmap, and their cached\nPeerRelay allocation stayed populated until the 120s assertion\ntimeout. With a PolicyChange queued on Disconnect, peers immediately\nreceive a full netmap on relay loss and clear PeerRelay as expected;\nthe symmetric change on Connect lets Phase 5 re-publish the policy\nwhen the relay comes back.\n\nDrop the now-unused routeChange return from the Disconnect gate.\n\nUpdates #2180","parents":[{"sha":"7956f9646c95fcaa6cffc54b1d5b566b9c5043a1","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7956f9646c95fcaa6cffc54b1d5b566b9c5043a1","html_url":"https://github.com/juanfont/headscale/commit/7956f9646c95fcaa6cffc54b1d5b566b9c5043a1"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":24292920751,"node_id":"HRFPE_lADOEFLz887vA3LGzwAAAAWn-I2v","url":"https://api.github.com/repos/juanfont/headscale/issues/events/24292920751","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"ca54e3fa47b4d7b8975b9663c71231afe7127957","commit_url":"https://api.github.com/repos/kradalby/headscale/commits/ca54e3fa47b4d7b8975b9663c71231afe7127957","created_at":"2026-04-08T11:18:38Z","performed_via_github_app":null},{"sha":"0b1816d82193b11315fb0046fa9141f7f9ad2722","node_id":"C_kwDOEFLz89oAKDBiMTgxNmQ4MjE5M2IxMTMxNWZiMDA0NmZhOTE0MWY3ZjlhZDI3MjI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/0b1816d82193b11315fb0046fa9141f7f9ad2722","html_url":"https://github.com/juanfont/headscale/commit/0b1816d82193b11315fb0046fa9141f7f9ad2722","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-08T11:20:16Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-04-08T11:20:16Z"},"tree":{"sha":"2df9705ecafd0e12951e45e69af1b1a717a54cd6","url":"https://api.github.com/repos/juanfont/headscale/git/trees/2df9705ecafd0e12951e45e69af1b1a717a54cd6"},"message":"capver: regenerate for tailscale v1.96\n\ngo generate ./hscontrol/capver/...\n\nAdds v1.96 (capVer 133) to tailscaleToCapVer and capVerToTailscaleVer,\nrolls the 10-version support window forward so MinSupportedCapabilityVersion\nis now 109 (v1.78), and refreshes the test fixture accordingly.","parents":[{"sha":"ca54e3fa47b4d7b8975b9663c71231afe7127957","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ca54e3fa47b4d7b8975b9663c71231afe7127957","html_url":"https://github.com/juanfont/headscale/commit/ca54e3fa47b4d7b8975b9663c71231afe7127957"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":24294104851,"node_id":"ME_lADOEFLz887vA3LGzwAAAAWoCp8T","url":"https://api.github.com/repos/juanfont/headscale/issues/events/24294104851","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":