[{"sha":"69d77f6e9d57b7dae0951b75139bf0854e28862f","node_id":"MDY6Q29tbWl0MjczODcxODU5OjY5ZDc3ZjZlOWQ1N2I3ZGFlMDk1MWI3NTEzOWJmMDg1NGUyODg2MmY=","url":"https://api.github.com/repos/juanfont/headscale/git/commits/69d77f6e9d57b7dae0951b75139bf0854e28862f","html_url":"https://github.com/juanfont/headscale/commit/69d77f6e9d57b7dae0951b75139bf0854e28862f","author":{"name":"Aaron Bieber","email":"aaron@bolddaemon.com","date":"2021-07-23T22:12:01Z"},"committer":{"name":"Aaron Bieber","email":"aaron@bolddaemon.com","date":"2021-07-23T22:12:01Z"},"tree":{"sha":"c8faa0970e4e0da7e378cd64f02ff8ca4d3c4ef7","url":"https://api.github.com/repos/juanfont/headscale/git/trees/c8faa0970e4e0da7e378cd64f02ff8ca4d3c4ef7"},"message":"Add a 'tls_letsencrypt_listen' config option\n\nCurrently the default (and non-configurable) Let's Encrypt listener will\nbind to all IPs. This isn't ideal if we want to run headscale on a specific\nIP only.\n\nThis also allows for one to set the listener to something other than\nport 80. This is useful for OSs like OpenBSD which only allow root to\nbind the lower port ranges (and don't have `setcap`) as we can now run\n`headscale` as a non-privileged user while still using the baked in ACME\nmagic. Obviously this configuration would also require a reverse proxy\nor firewall rule to redirect traffic. I attempted to outline that in the\nREADME change.","parents":[{"sha":"1af9c11bdd9d78f426cd17a2980ad7ec3426e5c8","url":"https://api.github.com/repos/juanfont/headscale/git/commits/1af9c11bdd9d78f426cd17a2980ad7ec3426e5c8","html_url":"https://github.com/juanfont/headscale/commit/1af9c11bdd9d78f426cd17a2980ad7ec3426e5c8"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":5064036480,"node_id":"MDExOk1lcmdlZEV2ZW50NTA2NDAzNjQ4MA==","url":"https://api.github.com/repos/juanfont/headscale/issues/events/5064036480","actor":{"login":"cure","id":149135,"node_id":"MDQ6VXNlcjE0OTEzNQ==","avatar_