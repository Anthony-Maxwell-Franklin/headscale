[{"sha":"468229c7dc11f4400c3bed4f39bdda147b0b40ec","node_id":"C_kwDOEFLz89oAKDQ2ODIyOWM3ZGMxMWY0NDAwYzNiZWQ0ZjM5YmRkYTE0N2IwYjQwZWM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/468229c7dc11f4400c3bed4f39bdda147b0b40ec","html_url":"https://github.com/juanfont/headscale/commit/468229c7dc11f4400c3bed4f39bdda147b0b40ec","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-02-09T09:00:22Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-02-12T08:26:20Z"},"tree":{"sha":"c62f24d2e0d5bec800ed597d12cf5c7ea3f56c46","url":"https://api.github.com/repos/juanfont/headscale/git/trees/c62f24d2e0d5bec800ed597d12cf5c7ea3f56c46"},"message":"github: fix needs-more-info label race condition\n\nReplace tiangolo/issue-manager with custom logic that distinguishes\nbot comments from human responses. The issue-manager action treated\nall comments equally, so the bot's own instruction comment would\ntrigger label removal on the next scheduled run.\n\nSplit into two jobs:\n- remove-label-on-response: triggers on issue_comment from non-bot\n  users, removes the needs-more-info label immediately\n- close-stale: runs on daily schedule, uses nushell to iterate open\n  needs-more-info issues, checks for human comments after the label\n  was added, and closes after 3 days with no response","parents":[{"sha":"c1b468f9f45867926e00fe7a7a700ed3ac2aad22","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c1b468f9f45867926e00fe7a7a700ed3ac2aad22","html_url":"https://github.com/juanfont/headscale/commit/c1b468f9f45867926e00fe7a7a700ed3ac2aad22"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":22727776198,"node_id":"RRE_lADOEFLz887qR8UFzwAAAAVKrlfG","url":"https://api.github.com/repos/juanfont/headscale/issues/events/22727776198","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars