for example\n\"Printer.fritz.box\" in an extra_records_path file) never resolved and\nqueries fell through to the global nameserver.\n\nNormalize record names to lowercase where the records enter the tailcfg\nDNS config, covering both dns.extra_records and extra_records_path.\n\nFixes #2782","parents":[{"sha":"f3f6c982209b08fe2734c38832edf74468221069","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f3f6c982209b08fe2734c38832edf74468221069","html_url":"https://github.com/juanfont/headscale/commit/f3f6c982209b08fe2734c38832edf74468221069"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":30556236461,"node_id":"HRFPE_lADOEFLz888AAAABHqUy_M8AAAAHHUsqrQ","url":"https://api.github.com/repos/juanfont/headscale/issues/events/30556236461","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"head_ref_force_pushed","commit_id":"aeb8d29fc967e3cb6cea3ffcc434a4dfa9cd3ca2","commit_url":"https://api.github.com/repos/larrasket/headscale/commits/aeb8d29fc967e3cb6cea3ffcc434a4dfa9cd3ca2","created_at":"2026-09-04T