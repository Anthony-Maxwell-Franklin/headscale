[{"sha":"cb8c2fc91a08f0e6449e6fb8e51bcecd9f6e5e46","node_id":"C_kwDOEFLz89oAKGNiOGMyZmM5MWEwOGYwZTY0NDllNmZiOGU1MWJjZWNkOWY2ZTVlNDY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/cb8c2fc91a08f0e6449e6fb8e51bcecd9f6e5e46","html_url":"https://github.com/juanfont/headscale/commit/cb8c2fc91a08f0e6449e6fb8e51bcecd9f6e5e46","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2024-07-12T14:45:11Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2024-07-12T15:44:26Z"},"tree":{"sha":"8e8f3d426f56ac92991aecdbcffd2d6b6be8460b","url":"https://api.github.com/repos/juanfont/headscale/git/trees/8e8f3d426f56ac92991aecdbcffd2d6b6be8460b"},"message":"replace ephemeral deletion logic\n\nthis commit replaces the way we remove ephemeral nodes,\ncurrently they are deleted in a loop and we look at last seen\ntime. This time is now only set when a node disconnects and\nthere was a bug (#2006) where nodes that had never disconnected\nwas deleted since they did not have a last seen.\n\nThe new logic will start an expiry timer when the node disconnects\nand delete the node from the database when the timer is up.\n\nIf the node reconnects within the expiry, the timer is cancelled.\n\nFixes #2006\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>","parents":[{"sha":"eb1591df35624b6cbe85e5c671869a0806dedfba","url":"https://api.github.com/repos/juanfont/headscale/git/commits/eb1591df35624b6cbe85e5c671869a0806dedfba","html_url":"https://github.com/juanfont/headscale/commit/eb1591df35624b6cbe85e5c671869a0806dedfba"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAAGgAAAATZWNkc2Etc2hhMi1uaXN0cDI1NgAAAAhuaXN0cDI1NgAAAE\nEE6bT6+U8pNExCb214X9sKtM8QMSqzWb4HmQxm24sqHasMtgza7Cws+M2NoiUVB+RSfa/I\nCoai/Io5VHtD9nbzKgAAAANnaXQAAAAAAAAABnNoYTUxMgAAAGMAAAATZWNkc2Etc2hhMi\n1uaXN0cDI1NgAAAEgAAAAgGnRIurSkdWJBceN7tb20nw1VI7BmN/rPZKq9o4fL+QkAAAAg\nPKBL3lEl41i+YwJNHezo2QOAtQvYbJrIwea8Bv2Msag=\n-----END SSH SIGNATURE-----","payload":"tree 8e8f3d426f56ac92991aecdbcffd2d6b6be8460b\nparent eb1591df35624b6cbe85e5c671869a0806dedfba\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1720795511 +0200\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1720799066 +0200\n\nreplace ephemeral deletion logic\n\nthis commit replaces the way we remove ephemeral nodes,\ncurrently they are deleted in a loop and we look at last seen\ntime. This time is now only set when a node disconnects and\nthere was a bug (#2006) where nodes that had never disconnected\nwas deleted since they did not have a last seen.\n\nThe new logic will start an expiry timer when the node disconnects\nand delete the node from the database when the timer is up.\n\nIf the node reconnects within the expiry, the timer is cancelled.\n\nFixes #2006\n\nSigned-off-by: Kristoffer Dalby <kristoffer@tailscale.com>\n","verified_at":"2024-11-08T21:47:46Z"},"event":"committed"},{"id":13489177557,"node_id":"HRFPE_lADOEFLz886PZXcNzwAAAAMkBIPV","url":"https://api.github.com/repos/juanfont/headscale/issues/events/13489177557","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","