[{"sha":"2f4194dcf06fab4a6d14758b8791b2ceddd1c61b","node_id":"C_kwDOEFLz89oAKDJmNDE5NGRjZjA2ZmFiNGE2ZDE0NzU4Yjg3OTFiMmNlZGRkMWM2MWI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/2f4194dcf06fab4a6d14758b8791b2ceddd1c61b","html_url":"https://github.com/juanfont/headscale/commit/2f4194dcf06fab4a6d14758b8791b2ceddd1c61b","author":{"name":"Gaku Yasui","email":"gaku.yasui@gmail.com","date":"2026-04-02T08:57:19Z"},"committer":{"name":"Gaku Yasui","email":"gaku.yasui@gmail.com","date":"2026-04-02T09:00:21Z"},"tree":{"sha":"70131a09f2c77266bb31defa95643739ea15d8f0","url":"https://api.github.com/repos/juanfont/headscale/git/trees/70131a09f2c77266bb31defa95643739ea15d8f0"},"message":"fix: DestroyUser should only delete the target user's preauthkeys\n\nListPreAuthKeys(tx) was called without filtering by user ID, causing\nall preauthkeys in the database to be deleted when any single user\nwas destroyed.\n\nReplace with ListPreAuthKeysByUser(tx, uid) to scope deletion.\n\nFixes: https://github.com/juanfont/headscale/issues/3154","parents":[{"sha":"835db974b5cd69028b6dca0c441acde25005469b","url":"https://api.github.com/repos/juanfont/headscale/git/commits/835db974b5cd69028b6dca0c441acde25005469b","html_url":"https://github.com/juanfont/headscale/commit/835db974b5cd69028b6dca0c441acde25005469b"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niHUEABYKAB0WIQTLTOo7fF5hc1HSqSOgSspLPbNPXgUCac4wJgAKCRCgSspLPbNP\nXhAMAP9gsgoqosV3oN8kQH+aKiBVbT0bMSRQn4ZiQJcx79tyXQEAzOxU7OCSGaV6\nG9UAoA33FXfRPDRZEB/BxEgfimONPAo=\n=awGs\n-----END PGP SIGNATURE-----","payload":"tree 70131a09f2c77266bb31defa95643739ea15d8f0\nparent 835db974b5cd69028b6dca0c441acde25005469b\nauthor Gaku Yasui <gaku.yasui@gmail.com> 1775120239 +0900\ncommitter Gaku Yasui <gaku.yasui@gmail.com> 1775120421 +0900\n\nfix: DestroyUser should only delete the target user's preauthkeys\n\nListPreAuthKeys(tx) was called without filtering by user ID, causing\nall preaut