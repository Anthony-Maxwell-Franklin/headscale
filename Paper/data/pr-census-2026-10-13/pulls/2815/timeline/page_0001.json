[{"sha":"4824ce7abcf53d11be7bb729cc3b852bd5210de4","node_id":"C_kwDOEFLz89oAKDQ4MjRjZTdhYmNmNTNkMTFiZTdiYjcyOWNjM2I4NTJiZDUyMTBkZTQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4824ce7abcf53d11be7bb729cc3b852bd5210de4","html_url":"https://github.com/juanfont/headscale/commit/4824ce7abcf53d11be7bb729cc3b852bd5210de4","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-10-24T13:40:22Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-10-24T13:40:22Z"},"tree":{"sha":"5063bde9ce3b5514ca6740e17597bde05472a43b","url":"https://api.github.com/repos/juanfont/headscale/git/trees/5063bde9ce3b5514ca6740e17597bde05472a43b"},"message":"integration/hsic: use pidof instead of ps/grep for PID detection\n\nThe ps aux | grep approach matched both dlv debugger and headscale\nbinary, causing 'multiple headscale processes' errors. Use pidof\nwhich only matches the actual binary name.","parents":[{"sha":"c808587de0e78bae1af0e610346c5cfcf8a99032","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c808587de0e78bae1af0e610346c5cfcf8a99032","html_url":"https://github.com/juanfont/headscale/commit/c808587de0e78bae1af0e610346c5cfcf8a99032"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgmMAoz5Zf+w0nAxyA6/zsNd95cP\n98YbtHIIXyy9A1sssAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQGItuRp+HLbKO9wzKiM+Ig2WV46Xbg8D/ZHox5RK3EDyTG24/k0qHXpmcWGYv9ZtG1\n0CBxIhuulX1bBSSPXmbww=\n-----END SSH SIGNATURE-----","payload":"tree 5063bde9ce3b5514ca6740e17597bde05472a43b\nparent c808587de0e78bae1af0e610346c5cfcf8a99032\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1761313222 +0200\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1761313222 +0200\n\nintegration/hsic: use pidof instead of ps/grep for PID detection\n\nThe ps aux | grep approach matched both dlv debugger and headscale\nbinary, causing 'multiple headscale processes' errors. Use pidof\nwhich only matches the actual binary name.\n","verified_at":"2025-10-24T13:40:49Z"},"event":"committed"},{"sha":"458ea43e6250846f0493fae515955bbc8ed6acc2","node_id":"C_kwDOEFLz89oAKDQ1OGVhNDNlNjI1MDg0NmYwNDkzZmFlNTE1OTU1YmJjOGVkNmFjYzI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/458ea43e6250846f0493fae515955bbc8ed6acc2","html_url":"https://github.com/juanfont/headscale/commit/458ea43e6250846f0493fae515955bbc8ed6acc2","author":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-10-24T13:40:37Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@tailscale.com","date":"2025-10-24T13:40:37Z"},"tree":{"sha":"b99ba14fbfbde07c1bf46fddf66ea3c4eb355012","url":"https://api.github.com/repos/juanfont/headscale/git/trees/b99ba14fbfbde07c1bf46fddf66ea3c4eb355012"},"message":"integration: reduce TestAutoApproveMultiNetwork matrix to 3 tests\n\nReduces the test matrix from 24 combinations to 3 representative tests\nto avoid overwhelming Docker and disk space. The minimal set covers all\nkey dimensions: both auth methods, all approver types, both policy modes,\nand both advertiseDuringUp values.\n\nSet HEADSCALE_INTEGRATION_FULL_MATRIX=1 to run all 24 tests.","parents":[{"sha":"4824ce7abcf53d11be7bb729cc3b852bd5210de4","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4824ce7abcf53d11be7bb729cc3b852bd5210de4","html_url":"https://github.com/juanfont/headscale/commit/4824ce7abcf53d11be7bb729cc3b852bd5210de4"}],"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAgmMAoz5Zf+w0nAxyA6/zsNd95cP\n98YbtHIIXyy9A1sssAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQCu8I234z6rYZpbnVvqZoBooRVQx2VgZjVvhVuA9iIKkzkM1JN5Fd7UaqwaWorLo2H\nmCt8ZzZOu42sl6088M2ws=\n-----END SSH SIGNATURE-----","payload":"tree b99ba14fbfbde07c1bf46fddf66ea3c4eb355012\nparent 4824ce7abcf53d11be7bb729cc3b852bd5210de4\nauthor Kristoffer Dalby <kristoffer@tailscale.com> 1761313237 +0200\ncommitter Kristoffer Dalby <kristoffer@tailscale.com> 1761313237 +0200\n\nintegration: reduce TestAutoApproveMultiNetwork matrix to 3 tests\n\nReduces the test matrix from 24 combinations to 3 representative tests\nto avoid overwhelming Docker and disk space. The minimal set covers all\nkey dimensions: both auth methods, all approver types, both policy modes,\nand both advertiseDuringUp values.\n\nSet HEADSCALE_INTEGRATION_FULL_MATRIX=1 to run all 24 tests.\n","verified_at":"2025-10-24T13:40:49Z"},"event":"committed"},{"id":20484361456,"node_id":"RRE_lADOEFLz887TkikBzwAAAATE9ozw","url":"https://api.github.com/repos/juanfont/headscale/issues/events/20484361456","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"review_requested","commit_id":null,"commit_url":null,"created_at":"2025-10-24T13:41:12Z","review_requester":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"h