[{"sha":"b2d0a3a5e17900af95b57ba2f48718775fb46673","node_id":"C_kwDOEFLz89oAKGIyZDBhM2E1ZTE3OTAwYWY5NWI1N2JhMmY0ODcxODc3NWZiNDY2NzM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/b2d0a3a5e17900af95b57ba2f48718775fb46673","html_url":"https://github.com/juanfont/headscale/commit/b2d0a3a5e17900af95b57ba2f48718775fb46673","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-26T08:54:14Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-26T08:54:14Z"},"tree":{"sha":"6e4dd9bad6fa7b78c496ced40f0f9f2feda2b2ca","url":"https://api.github.com/repos/juanfont/headscale/git/trees/6e4dd9bad6fa7b78c496ced40f0f9f2feda2b2ca"},"message":"state: omit AuthKeyID/AuthKey in node Updates to prevent FK errors\n\nWhen a PreAuthKey is deleted, the database correctly sets auth_key_id\nto NULL on referencing nodes via ON DELETE SET NULL. However, the\nNodeStore (in-memory cache) retains the old AuthKeyID value.\n\nWhen nodes send MapRequests (e.g., after tailscaled restart), GORM's\nUpdates() tries to persist the stale AuthKeyID, causing a foreign key\nconstraint error when trying to reference a deleted PreAuthKey.\n\nFix this by adding AuthKeyID and AuthKey to the Omit() call in all\nthree places where nodes are updated via GORM's Updates():\n- persistNodeToDB (MapRequest processing)\n- HandleNodeFromAuthPath (re-auth via web/OIDC)\n- HandleNodeFromPreAuthKey (re-registration with preauth key)\n\nThis tells GORM to never touch the auth_key_id column or AuthKey\nassociation during node updates, letting the database handle the\nforeign key relationship correctly.\n\nAdded TestDeletedPreAuthKeyNotRecreatedOnNodeUpdate to verify that\ndeleted PreAuthKeys are not recreated when nodes send MapRequests.","parents":[{"sha":"ee127edbf7fcbfc949fbcce56e4307730ae72c51","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ee127edbf7fcbfc949fbcce56e4307730ae72c51","html_url":"https://github.com/juanfont/headscale/commit/ee127edbf7fcbfc949fbcce56e4307730ae72c51"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":22285165179,"node_id":"RTE_lADOEFLz887lyENCzwAAAAUwTKJ7","url":"https://api.github.com/repos/juanfont/headscale/issues/events/22285165179","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"renamed","commit_id":null,"commit_url":null,"created_at":"2026-01-26T09:53:18Z","rename":{"from":"state: omit AuthKeyID/AuthKey in node Updates to prevent FK errors","to":"state: omit AuthKeyID/AuthKey in node Updates"},"performed_via_github_app":null},{"id":22287722345,"node_id":"RFRE_lADOEFLz887lyENCzwAAAAUwc6dp","url":"https://api.github.com/repos/juanfont/headscale/issues/events/22287722345","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.