prof to check and found that ToStringSlice causes the cpu to rise.\r\n\r\nAfter optimizing it, the cpu is still rising occasionally, but not very much.\r\n\r\nThe final solution should be to use the cache to store the machine information for comparison, and modify the database data and cache information only when there are changes. I'm not familiar with it, so I haven't made the appropriate changes yet.\r\n\r\nhttps://user-images.githubusercontent.com/23068780/210695313-54af7475-d527-4274-b33a-50838c44ed98.svg\r\nhttps://user-images.githubusercontent.com/23068780/210695393-754f2a55-6894-42ac-8ecc-6294109e2f19.svg","created_at":"2023-01-11T07:07:17Z","updated_at":"2023-01-11T07:46:25Z","closed_at":"2023-01-11T07:45:55Z","merged_at":"2023-01-11T07:45:54Z","merge_commit_sha":"a6c8718a9788655fff54e5fa20f0cc14de24814b","assignees":[],"requested_reviewers":[{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false}],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/juanfont/headscale/pulls/1129/commits","review_comments_url":"https://api.github.com/repos/juanfont/hea