er","user_view_type":"public","site_admin":false},"performed_via_github_app":null},{"id":25129082004,"node_id":"MIE_lADOEFLz888AAAABBGUe4s8AAAAF2c9clA","url":"https://api.github.com/repos/juanfont/headscale/issues/events/25129082004","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"milestoned","commit_id":null,"commit_url":null,"created_at":"2026-05-04T11:04:22Z","milestone":{"title":"v0.29.0"},"performed_via_github_app":null},{"sha":"42c43e3e663b4c9e1d29a194c0593dc49dd59679","node_id":"C_kwDOEFLz89oAKDQyYzQzZTNlNjYzYjRjOWUxZDI5YTE5NGMwNTkzZGM0OWRkNTk2Nzk","url":"https://api.github.com/repos/juanfont/headscale/git/commits/42c43e3e663b4c9e1d29a194c0593dc49dd59679","html_url":"https://github.com/juanfont/headscale/commit/42c43e3e663b4c9e1d29a194c0593dc49dd59679","author":{"name":"SAY-5","email":"say.apm35@gmail.com","date":"2026-05-05T05:48:28Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-05-05T05:48:28Z"},"tree":{"sha":"84291cf76f46f1701452248cf280344ad57b0698","url":"https://api.github.com/repos/juanfont/headscale/git/trees/84291cf76f46f1701452248cf280344ad57b0698"},"message":"state: avoid nil deref in registration handlers when old user is missing\n\nMirror the guard from HandleNodeFromPreAuthKey in HandleNodeFromAuthPath.\nBoth functions log the old user's name in the \"different user\" branch\nwhen an existing NodeStore entry under the same machine key belongs to\nanother user. UserView.Name dereferences the backing User pointer\nunconditionally, so when the cached node was loaded with a non-nil\nUserID but a nil User (Preload join missed the row, or upstream code\nleft the snapshot in that shape), the log call panics with a nil-pointer\ndereference at hscontrol/types/types_view.go:97.\n\nThe panic is caught by the http2 server's runHandler for the noise\ncontrol plane, so the process keeps running but every retry produces a\nnew panic — production has observed bursts of ~1.9k panics per hour\nduring a tailscaled reconnect loop. The gRPC/OIDC entry has no equivalent\nrecover and would surface the panic to the caller.\n\nGuard both call sites with oldUser.Valid() and fall back to an empty\nold-user name when the pointer is nil. The \"Creating new node for\ndifferent user\" log line still includes the existing node ID, hostname,\nmachine key, and new user, so operator visibility is preserved.\n\nAdd reproduction tests for both handlers seeding the orphan shape\ndirectly into NodeStore via PutNodeInStoreForTest.\n\nCo-Authored-By: Kristoffer Dalby <kristoffer@dalby.cc>","parents":[{"sha":"3d5c0af4e703482aff8f979ff5bde330a7bf97f5","url":"https://api.github.com/repos/juanfont/headscale/git/commits/3d5c0af4e703482aff8f979ff5bde330a7bf97f5","html_url":"https://github.com/juanfont/headscale/commit/3d5c0af4e703482aff8f979ff5bde330a7bf97f5"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":25163337209,"node_id":"HRFPE_lADOEFLz888AAAABBGUe4s8AAAAF29oN-Q","url":"https://api.github.com/repos/juanfont/headscale/issues/events/25163337209","act