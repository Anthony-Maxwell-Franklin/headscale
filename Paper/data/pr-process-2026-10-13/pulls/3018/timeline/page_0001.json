kages":"read","pull_requests":"write"},"events":[]}},{"id":3671754640,"node_id":"PRR_kwDOEFLz887a2oeQ","user":{"login":"Copilot","id":175728472,"node_id":"BOT_kgDOCnlnWA","avatar_url":"https://avatars.githubusercontent.com/in/946600?v=4","gravatar_id":"","url":"https://api.github.com/users/Copilot","html_url":"https://github.com/apps/copilot-pull-request-reviewer","followers_url":"https://api.github.com/users/Copilot/followers","following_url":"https://api.github.com/users/Copilot/following{/other_user}","gists_url":"https://api.github.com/users/Copilot/gists{/gist_id}","starred_url":"https://api.github.com/users/Copilot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Copilot/subscriptions","organizations_url":"https://api.github.com/users/Copilot/orgs","repos_url":"https://api.github.com/users/Copilot/repos","events_url":"https://api.github.com/users/Copilot/events{/privacy}","received_events_url":"https://api.github.com/users/Copilot/received_events","type":"Bot","user_view_type":"public","site_admin":false},"body":"## Pull request overview\n\nCopilot reviewed 7 out of 7 changed files in this pull request and generated 4 comments.\n\n\n\n\n\n---\n\n💡 <a href=\"/juanfont/headscale/new/main/.github/instructions?filename=*.instructions.md\" class=\"Link--inTextBlock\" target=\"_blank\" rel=\"noopener noreferrer\">Add Copilot custom instructions</a> for smarter, more guided reviews. <a href=\"https://docs.github.com/en/copilot/customizing-copilot/adding-repository-custom-instructions-for-github-copilot\" class=\"Link--inTextBlock\" target=\"_blank\" rel=\"noopener noreferrer\">Learn how to get started</a>.","commit_id":"716ea4c52938e259dbc060c3c857ab7eeba0640b","state":"commented","html_url":"https://github.com/juanfont/headscale/pull/3018#pullrequestreview-3671754640","pull_request_url":"https://api.github.com/repos/juanfont/headscale/pulls/3018","_links":{"html":{"href":"https://github.com/juanfont/headscale/pull/3018#pullrequestreview-3671754640"},"pull_request":{"href":"https://api.github.com/repos/juanfont/headscale/pulls/3018"}},"submitted_at":"2026-01-16T16:39:26Z","updated_at":"2026-01-16T16:39:26Z","author_association":"NONE","event":"reviewed"},{"sha":"60dc17bab62acb13b5d2e37ea59ac15dccd066ff","node_id":"C_kwDOEFLz89oAKDYwZGMxN2JhYjYyYWNiMTNiNWQyZTM3ZWE1OWFjMTVkY2NkMDY2ZmY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/60dc17bab62acb13b5d2e37ea59ac15dccd066ff","html_url":"https://github.com/juanfont/headscale/commit/60dc17bab62acb13b5d2e37ea59ac15dccd066ff","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-16T14:39:13Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-20T14:49:22Z"},"tree":{"sha":"07ac15d2b64bb0db62dd232a36460095702cf053","url":"https://api.github.com/repos/juanfont/headscale/git/trees/07ac15d2b64bb0db62dd232a36460095702cf053"},"message":"policy/v2: add SSH src/dst validation for Tailscale parity\n\nAdd validateSSHSrcDstCombination() to enforce Tailscale's SSH policy rules\nat validation time:\n\n- dst=tag: any src allowed\n- dst=autogroup:self: handled at runtime (different rules per node)\n- dst=username: src must contain ONLY the same username\n\nPer Tailscale docs (https://tailscale.com/kb/1337/policy-syntax#dst-1):\n\"The destination can be a tag, autogroup:self (if the source contains only\nusers or groups), or a single named user (if the source contains only the\nsame named user).\"\n\nInvalid combinations now rejected with appropriate error messages:\n- Tag src -> User dst: \"tags in src cannot SSH to user-owned devices\"\n- Group src -> User dst: \"groups in src cannot SSH to user-owned devices\"\n- Different user src -> User dst: \"src X cannot SSH to dst users Y\"\n- Autogroup src -> User dst: \"autogroup X in src cannot SSH to user-owned devices\"\n\nUpdates #3010","parents":[{"sha":"515a22e696e403fa24021830ac21f76ab48230c3","url":"https://api.github.com/repos/juanfont/headscale/git/commits/515a22e696e403fa24021830ac21f76ab48230c3","html_url":"https://github.com/juanfont/headscale/commit/515a22e696e403fa24021830ac21f76ab48230c3"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"d139a2f02ab76ffc8b1de797abb0f1864ab40263","node_id":"C_kwDOEFLz89oAKGQxMzlhMmYwMmFiNzZmZmM4YjFkZTc5N2FiYjBmMTg2NGFiNDAyNjM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/d139a2f02ab76ffc8b1de797abb0f1864ab40263","html_url":"https://github.com/juanfont/headscale/commit/d139a2f02ab76ffc8b1de797abb0f1864ab40263","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-16T14:39:52Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-20T14:49:22Z"},"tree":{"sha":"3846aae54670733f3f79e1188437f19cef48846d","url":"https://api.github.com/repos/juanfont/headscale/git/trees/3846aae54670733f3f79e1188437f19cef48846d"},"message":"policy/v2: add runtime filtering for * dst with tag sources\n\nAdd runtime filtering in compileSSHPolicy() to prevent tag->user SSH\nbypass via the * (asterisk) destination wildcard.\n\nWhen an SSH rule has tag sources and * destination, the runtime now\nfilters to only include tagged nodes as valid destinations. This\nprevents tagged devices from SSH'ing to user-owned devices via * while\nwe still support * as a destination (which Tailscale doesn't allow).\n\nThis is a temporary workaround marked with TODO comments for removal\nwhen #3009 is completed and * is removed from SSH destinations entirely.\n\nThe tests cover:\n- TestSSHWithAsterixAndTagSource: Tag src + * dst excludes user-owned nodes\n- TestSSHWithAsterixAndUserSource: User src + * dst works normally\n- TestSSHWithAsterixAndMixedSource: Mixed src + * dst filters tag access\n\nAlso updates existing filter tests to use valid SSH src/dst combinations\n(group->tag instead of group->user) after validation changes.\n\nFixes #3010","parents":[{"sha":"60dc17bab62acb13b5d2e37ea59ac15dccd066ff","url":"https://api.github.com/repos/juanfont/headscale/git/commits/60dc17bab62acb13b5d2e37ea59ac15dccd066ff","html_url":"https://github.com/juanfont/headscale/commit/60dc17bab62acb13b5d2e37ea59ac15dccd066ff"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"7dd299b683d702acdb8b495d9a2de121497730d7","node_id":"C_kwDOEFLz89oAKDdkZDI5OWI2ODNkNzAyYWNkYjhiNDk1ZDlhMmRlMTIxNDk3NzMwZDc","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7dd299b683d702acdb8b495d9a2de121497730d7","html_url":"https://github.com/juanfont/headscale/commit/7dd299b683d702acdb8b495d9a2de121497730d7","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-16T14:40:28Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-20T14:49:22Z"},"tree":{"sha":"f3593a7d8b2f7352c13abe3ba89aa96fdbb90f7b","url":"https://api.github.com/repos/juanfont/headscale/git/trees/f3593a7d8b2f7352c13abe3ba89aa96fdbb90f7b"},"message":"policy,integration: update tests for SSH src/dst validation\n\nUpdate v1 policy tests and integration tests to use valid SSH src/dst\ncombinations following the new validation rules from #3010.\n\nV1 policy tests (policy_test.go):\n- Add taggedServer node for valid group->tag SSH scenarios\n- Change test destinations from user@ to tag:server for validity\n- Tests now use group->tag instead of group->user\n\nIntegration tests (ssh_test.go):\n- TestSSHMultipleUsersAllToAll: Use autogroup:self instead of cross-user\n- TestSSHIsBlockedInACL: Use autogroup:member->autogroup:self\n- TestSSHUserOnlyIsolation: Use user@->user@ rules (same user)\n- Add TestSSHInvalidPolicySrcDstValidation: Verify policy rejection\n\nThe new integration test validates that invalid SSH policies are\nrejected at policy load time, covering tag->user, group->user,\nand different-user->user combinations.\n\nUpdates #3010","parents":[{"sha":"d139a2f02ab76ffc8b1de797abb0f1864ab40263","url":"https://api.github.com/repos/juanfont/headscale/git/commits/d139a2f02ab76ffc8b1de797abb0f1864ab40263","html_url":"https://github.com/juanfont/headscale/commit/d139a2f02ab76ffc8b1de797abb0f1864ab40263"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"dce7ac0b4b0ba85898892dfeb518b20c82149faf","node_id":"C_kwDOEFLz89oAKGRjZTdhYzBiNGIwYmE4NTg5ODg5MmRmZWI1MThiMjBjODIxNDlmYWY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/dce7ac0b4b0ba85898892dfeb518b20c82149faf","html_url":"https://github.com/juanfont/headscale/commit/dce7ac0b4b0ba85898892dfeb518b20c82149faf","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-16T14:40:44Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-20T14:49:22Z"},"tree":{"sha":"fdeaf58c63c717dbcc58e00cf57516e2b1856053","url":"https://api.github.com/repos/juanfont/headscale/git/trees/fdeaf58c63c717dbcc58e00cf57516e2b1856053"},"message":"CHANGELOG: add SSH policy breaking change for 0.28.0\n\nDocument that SSH rules now validate src/dst combinations following\nTailscale's policy rules. Policies with tag->user or group->user SSH\nrules are now rejected at load time.\n\nUpdates #3010","parents":[{"sha":"7dd299b683d702acdb8b495d9a2de121497730d7","url":"https://api.github.com/repos/juanfont/headscale/git/commits/7dd299b683d702acdb8b495d9a2de121497730d7","html_url":"https://github.com/juanfont/headscale/commit/7dd299b683d702acdb8b495d9a2de121497730d7"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"ed3a4ed6aa7e703f775dc33a9a3bd6974fcc0a53","node_id":"C_kwDOEFLz89oAKGVkM2E0ZWQ2YWE3ZTcwM2Y3NzVkYzMzYTlhM2JkNjk3NGZjYzBhNTM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ed3a4ed6aa7e703f775dc33a9a3bd6974fcc0a53","html_url":"https://github.com/juanfont/headscale/commit/ed3a4ed6aa7e703f775dc33a9a3bd6974fcc0a53","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-20T10:24:14Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-20T14:49:22Z"},"tree":{"sha":"d9a69b708c6f476f2522eb5cfc1665ca9f4b5a43","url":"https://api.github.com/repos/juanfont/headscale/git/trees/d9a69b708c6f476f2522eb5cfc1665ca9f4b5a43"},"message":"policy: address review feedback for SSH validation\n\n- Add clarifying comment in validateSSHSrcDstCombination explaining that\n  all sources are validated, not just the first match\n- Extract srcHasTags check to SSHSrcAliases.ContainsTag() helper method\n  for better maintainability and easier removal when #3009 is completed\n- Add positive assertions in TestSSHWithAsterixAndTagSource to verify\n  tagged nodes ARE included as principals, not just excluded\n- Improve comments in integration test explaining why nil users and\n  empty nodes are sufficient for src/dst validation tests\n\nUpdates #3010","parents":[{"sha":"dce7ac0b4b0ba85898892dfeb518b20c82149faf","url":"https://api.github.com/repos/juanfont/headscale/git/commits/dce7ac0b4b0ba85898892dfeb518b20c82149faf","html_url":"https://github.com/juanfont/headscale/commit/dce7ac0b4b0ba85898892dfeb518b20c82149faf"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":22163618364,"node_id":"HRFPE_lADOEFLz887j1oNhzwAAAAUpDfo8","url":"https://api.github.com/repos/juanfont/headscale/issues/events/22163618364","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/followin