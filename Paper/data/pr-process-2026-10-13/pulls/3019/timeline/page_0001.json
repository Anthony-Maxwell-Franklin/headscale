[{"sha":"3031f29601e4fe5a59a4fc6d15e419abeee8b601","node_id":"C_kwDOEFLz89oAKDMwMzFmMjk2MDFlNGZlNWE1OWE0ZmM2ZDE1ZTQxOWFiZWVlOGI2MDE","url":"https://api.github.com/repos/juanfont/headscale/git/commits/3031f29601e4fe5a59a4fc6d15e419abeee8b601","html_url":"https://github.com/juanfont/headscale/commit/3031f29601e4fe5a59a4fc6d15e419abeee8b601","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-16T16:32:36Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-01-16T16:32:36Z"},"tree":{"sha":"be78038c06472fea4d3e59aa6c321a2cbd78f9b0","url":"https://api.github.com/repos/juanfont/headscale/git/trees/be78038c06472fea4d3e59aa6c321a2cbd78f9b0"},"message":"db: migrate tests from check.v1 to testify\n\nMigrate all database tests from gopkg.in/check.v1 Suite-based testing\nto standard Go tests with testify assert/require.\n\nChanges:\n- Remove empty Suite files (hscontrol/suite_test.go, hscontrol/mapper/suite_test.go)\n- Convert hscontrol/db/suite_test.go to modern helpers only\n- Convert 6 Suite test methods in node_test.go to standalone tests\n- Convert 5 Suite test methods in api_key_test.go to standalone tests\n- Fix stale global variable reference in db_test.go\n\nThe legacy TestListPeers Suite method was renamed to TestListPeersManyNodes\nto avoid conflict with the existing modern TestListPeers function, as they\ntest different aspects (basic peer listing vs ID filtering).","parents":[{"sha":"00f22a84437a9ee61dcfa5139484ac3690a5e8f5","url":"https://api.github.com/repos/juanfont/headscale/git/commits/00f22a84437a9ee61dcfa5139484ac3690a5e8f5","html_url":"https://github.com/juanfont/headscale/commit/00f22a84437a9ee61dcfa5139484ac3690a5e8f5"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"476fc3bc7e0f8ec1023a0e20fbebe05969028e02","node_id":"C_kwDOEFLz89oAKDQ3NmZjM2JjN2UwZjhlYzEwMjNhMGUyMGZiZWJlMDU5NjkwMjhlMDI","url":"https://api.gi