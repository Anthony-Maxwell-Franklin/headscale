5a4dc166263051f92e5e9f"},"message":"Improve Dockerfile\n\nThis commit makes several changes to the dockerfile:\n\n- Add go.mod and go.sum in a seperate stage, subsequently calling `go\n  mod download` to make it cache dependencies and speed up builds\n- Use ubuntu:latest (28MB larger) instead of scratch, makes the image a\n  lot easier to debug (e.g. it has a shell and a package manager)\n- Change ENTRYPOINT to CMD, this makes the behaviour of the image\n  slightly different from a CLI perspective, but makes interacting with\n  the image from code, docker-compose and kubernetes easier.","parents":[{"sha":"d86123195c39667946033f9e3554dc41716847b7","url":"https://api.github.com/repos/juanfont/headscale/git/commits/d86123195c39667946033f9e3554dc41716847b7","html_url":"https://github.com/juanfont/headscale/commit/d86123195c39667946033f9e3554dc41716847b7"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"f973aef80c53aba07113a0f0592add4903b16fe7","node_id":"MDY6Q29tbWl0MjczODcxODU5OmY5NzNhZWY4MGM1M2FiYTA3MTEzYTBmMDU5MmFkZDQ5MDNiMTZmZTc=","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f973aef80c53aba07113a0f0592add4903b16fe7","html_url":"https://github.com/juanfont/headscale/commit/f973aef80c53aba07113a0f0592add4903b16fe7","author":{"name":"Kristoffer Dalby","email":"kradalby@kradalby.no","date":"2021-08-08T16:43:06Z"},"committer":{"name":"Kristoffer Dalby","email":"kradalby@kradalby.no","date":"2021-08-08T16:43:06Z"},"tree":{"sha":"9fb6dfa0e25bd15c4acdac5908f3a0e32963a19e","url":"https://api.github.com/repos/juanfont/headscale/git/trees/9fb6dfa0e25bd15c4acdac5908f3a0e32963a19e"},"message":"Add Dockerfile to build tailscale docker image for integration tests","parents":[{"sha":"a43bb1bb40d73974f1541416b0eabd8e05fcdd04","url":"https://api.github.com/repos/juanfont/headscale/git/commits/a43bb1bb40d73974f1541416b0eabd8e05fcdd04","html_url":"https://github.com/juanfont/headscale/commit/a43bb1bb40d73974f1541416b0eabd8e05fcdd04"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"4e077b053c11a530149b86b3b8543f6f34f00077","node_id":"MDY6Q29tbWl0MjczODcxODU5OjRlMDc3YjA1M2MxMWE1MzAxNDliODZiM2I4NTQzZjZmMzRmMDAwNzc=","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4e077b053c11a530149b86b3b8543f6f34f00077","html_url":"https://github.com/juanfont/headscale/commit/4e077b053c11a530149b86b3b8543f6f34f00077","author":{"name":"Kristoffer Dalby","email":"kradalby@kradalby.no","date":"2021-08-08T16:50:32Z"},"committer":{"name":"Kristoffer Dalby","email":"kradalby@kradalby.no","date":"2021-08-08T16:50:32Z"},"tree":{"sha":"71ab62b500bfe4330992488ccb47c47985982b2e","url":"https://api.github.com/repos/juanfont/headscale/git/trees/71ab62b500bfe4330992488ccb47c47985982b2e"},"message":"Initial work, add integration tests\n\nThis commit adds integration tests to headscale. They are currently\nquite simple, but it lays the groundwork for more comprehensive testing\nand ensuring we dont break things with the official tailscale client.\n\nThe test works by leveraging Docker (via dockertest) to spin up a\nHeadscale container, and a number of tailscale containers (10).\n\nEach tailscale container is joined to the headscale and then \"passed on\"\nto the tests.\n\nCurrently three tests have been implemented:\n\n- Have all tailscale containers join headscale (in the setup process)\n- Get IP from each container (I plan to extend this with cross-ping)\n- List nodes with headscales CLI and verify all has been registered\n\nThis test depends on Docker, and currently, I have not looked into\nhooking it into Github Actions.","parents":[{"sha":"f973aef80c53aba07113a0f0592add4903b16fe7","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f973aef80c53aba07113a0f0592add4903b16fe7","html_url":"https://github.com/juanfont/headscale/commit/f973aef80c53aba07113a0f0592add4903b16fe7"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"c9e5048015d2b952ad1ede4f250f0714b50efdb5","node_id":"MDY6Q29tbWl0MjczODcxODU5OmM5ZTUwNDgwMTVkMmI5NTJhZDFlZGU0ZjI1MGYwNzE0YjUwZWZkYjU=","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c9e5048015d2b952ad1ede4f250f0714b50efdb5","html_url":"https://github.com/juanfont/headscale/commit/c9e5048015d2b952ad1ede4f250f0714b50efdb5","author":{"name":"Kristoffer Dalby","email":"kradalby@kradalby.no","date":"2021-08-08T16:57:28Z"},"committer":{"name":"Kristoffer Dalby","email":"kradalby@kradalby.no","date":"2021-08-08T16:57:28Z"},"tree":{"sha":"93e5e47191607d2b0a4fe0bcfad16c42a93a4fb0","url":"https://api.github.com/repos/juanfont/headscale/git/trees/93e5e47191607d2b0a4fe0bcfad16c42a93a4fb0"},"message":"Merge remote-tracking branch 'upstream/main' into integration-tests","parents":[{"sha":"4e077b053c11a530149b86b3b8543f6f34f00077","url":"https://api.github.com/repos/juanfont/headscale/git/commits/4e077b053c11a530149b86b3b8543f6f34f00077","html_url":"https://github.com/juanfont/headscale/commit/4e077b053c11a530149b86b3b8543f6f34f00077"},{"sha":"275214920fc013e10f9249b1e6f6771f258f9d0c","url":"https://api.github.com/repos/juanfont/headscale/git/commits/275214920fc013e10f9249b1e6f6771f258f9d0c","html_url":"https://github.com/juanfont/headscale/commit/275214920fc013e10f9249b1e6f6771f258f9d0c"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":5126848656,"node_id":"MDIwOlJldmlld1JlcXVlc3RlZEV2ZW50NTEyNjg0ODY1Ng==","url":"https://api.github.com/repos/juanfont/headscale/issues/events/5126848656","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","fol