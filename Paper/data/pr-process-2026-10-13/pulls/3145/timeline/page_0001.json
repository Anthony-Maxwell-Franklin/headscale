nfont/followers","following_url":"https://api.github.com/users/juanfont/following{/other_user}","gists_url":"https://api.github.com/users/juanfont/gists{/gist_id}","starred_url":"https://api.github.com/users/juanfont/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/juanfont/subscriptions","organizations_url":"https://api.github.com/users/juanfont/orgs","repos_url":"https://api.github.com/users/juanfont/repos","events_url":"https://api.github.com/users/juanfont/events{/privacy}","received_events_url":"https://api.github.com/users/juanfont/received_events","type":"User","user_view_type":"public","site_admin":false},"body":null,"commit_id":"c845ccd37a29dfd218adb4ecd6a242c4e3bc63d3","state":"approved","html_url":"https://github.com/juanfont/headscale/pull/3145#pullrequestreview-3952456505","pull_request_url":"https://api.github.com/repos/juanfont/headscale/pulls/3145","_links":{"html":{"href":"https://github.com/juanfont/headscale/pull/3145#pullrequestreview-3952456505"},"pull_request":{"href":"https://api.github.com/repos/juanfont/headscale/pulls/3145"}},"submitted_at":"2026-03-16T09:22:42Z","updated_at":"2026-03-16T09:34:02Z","author_association":"OWNER","event":"reviewed"},{"sha":"f0c074bcfb5a12a58153f2a92fc576b9758632d4","node_id":"C_kwDOEFLz89oAKGYwYzA3NGJjZmI1YTEyYTU4MTUzZjJhOTJmYzU3NmI5NzU4NjMyZDQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f0c074bcfb5a12a58153f2a92fc576b9758632d4","html_url":"https://github.com/juanfont/headscale/commit/f0c074bcfb5a12a58153f2a92fc576b9758632d4","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-16T09:15:46Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-16T09:32:50Z"},"tree":{"sha":"ed723d54f4478829156fd9214db074b3120001e0","url":"https://api.github.com/repos/juanfont/headscale/git/trees/ed723d54f4478829156fd9214db074b3120001e0"},"message":"integration: standardize test infrastructure options\n\nMake embedded DERP server and TLS the default configuration for all\nintegration tests, replacing the per-test opt-in model that led to\ninconsistent and flaky test behavior.\n\nInfrastructure changes:\n- DefaultConfigEnv() includes embedded DERP server settings\n- New() auto-generates a proper CA + server TLS certificate pair\n- CA cert is installed into container trust stores and returned by\n  GetCert() so clients and internal tools (curl) trust the server\n- CreateCertificate() now returns (caCert, cert, key) instead of\n  discarding the CA certificate\n- Add WithPublicDERP() and WithoutTLS() opt-out options\n- Remove WithTLS(), WithEmbeddedDERPServerOnly(), and WithDERPAsIP()\n  since all their behavior is now the default or unnecessary\n\nTest cleanup:\n- Remove all redundant WithTLS/WithEmbeddedDERPServerOnly/WithDERPAsIP\n  calls from test files\n- Give every test a unique WithTestName by parameterizing aclScenario,\n  sshScenario, and derpServerScenario helpers\n- Add WithTestName to tests that were missing it\n- Document all non-standard options with inline comments explaining\n  why each is needed\n\nUpdates #3139","parents":[{"sha":"87b8507ac9d3510ee15074478e235ab62b1ba872","url":"https://api.github.com/repos/juanfont/headscale/git/commits/87b8507ac9d3510ee15074478e235ab62b1ba872","html_url":"https://github.com/juanfont/headscale/commit/87b8507ac9d3510ee15074478e235ab62b1ba872"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"c845ccd37a29dfd218adb4ecd6a242c4e3bc63d3","node_id":"C_kwDOEFLz89oAKGM4NDVjY2QzN2EyOWRmZDIxOGFkYjRlY2Q2YTI0MmM0ZTNiYzYzZDM","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c845ccd37a29dfd218adb4ecd6a242c4e3bc63d3","html_url":"https://github.com/juanfont/headscale/commit/c845ccd37a29dfd218adb4ecd6a242c4e3bc63d3","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-16T09:16:43Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-16T09:32:50Z"},"tree":{"sha":"7a2cd087c39792c354c752e68424858b2f66badb","url":"https://api.github.com/repos/juanfont/headscale/git/trees/7a2cd087c39792c354c752e68424858b2f66badb"},"message":"integration/acl: replace custom entrypoints with WithPackages\n\nReplace inline WithDockerEntrypoint shell scripts in\nTestACLTagPropagation and TestACLTagPropagationPortSpecific with\nthe standard WithPackages and WithWebserver options.\n\nThe custom entrypoints used fragile fixed sleeps and lacked the\nrobust network/cert readiness waits that buildEntrypoint provides.\n\nUpdates #3139","parents":[{"sha":"f0c074bcfb5a12a58153f2a92fc576b9758632d4","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f0c074bcfb5a12a58153f2a92fc576b9758632d4","html_url":"https://github.com/juanfont/headscale/commit/f0c074bcfb5a12a58153f2a92fc576b9758632d4"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":23600632841,"node_id":"HRFPE_lADOEFLz887y9XeKzwAAAAV-tRQJ","url":"https://api.github.com/repos/juanfont/headscale/issues/events/23600632841","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://a