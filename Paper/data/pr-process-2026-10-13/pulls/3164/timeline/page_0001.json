ce characteristics than the\nshared x86_64 pool. This should reduce flakiness caused by\nresource contention on congested runners.\n\nUpdates #3125","parents":[{"sha":"c66d655956661c0fb76ca3df82c4b15e0d514240","url":"https://api.github.com/repos/juanfont/headscale/git/commits/c66d655956661c0fb76ca3df82c4b15e0d514240","html_url":"https://github.com/juanfont/headscale/commit/c66d655956661c0fb76ca3df82c4b15e0d514240"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":24083810838,"node_id":"RRE_lADOEFLz8874m76ezwAAAAWbgcoW","url":"https://api.github.com/repos/juanfont/headscale/issues/events/24083810838","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"review_requested","commit_id":null,"commit_url":null,"created_at":"2026-03-31T17:50:25Z","review_requester":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.gi