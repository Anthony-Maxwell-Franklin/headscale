[{"sha":"1d90d6807c4bcb92b591eaf62c98e34d3e28f3c2","node_id":"C_kwDOEFLz89oAKDFkOTBkNjgwN2M0YmNiOTJiNTkxZWFmNjJjOThlMzRkM2UyOGYzYzI","url":"https://api.github.com/repos/juanfont/headscale/git/commits/1d90d6807c4bcb92b591eaf62c98e34d3e28f3c2","html_url":"https://github.com/juanfont/headscale/commit/1d90d6807c4bcb92b591eaf62c98e34d3e28f3c2","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-30T13:41:36Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-30T13:41:36Z"},"tree":{"sha":"8dc3992b85a12717857d9816e0d32fe14844e570","url":"https://api.github.com/repos/juanfont/headscale/git/trees/8dc3992b85a12717857d9816e0d32fe14844e570"},"message":"integration: add CI-scaled timeouts and curl helpers for flaky ACL tests\n\nAdd ScaledTimeout to scale EventuallyWithT timeouts by 2x on CI,\nconsistent with the existing PeerSyncTimeout (60s/120s) and\ndockertestMaxWait (300s/600s) conventions.\n\nAdd assertCurlSuccessWithCollect and assertCurlFailWithCollect helpers\nfollowing the existing *WithCollect naming convention.\nassertCurlFailWithCollect uses CurlFailFast internally for aggressive\ntimeouts, avoiding wasted retries when expecting blocked connections.\n\nApply these to the three flakiest ACL tests:\n\n- TestACLTagPropagation: swap NetMap and curl verification order so\n  the fast NetMap check (confirms MapResponse arrived) runs before\n  the slower curl check. Use curl helpers and scaled timeouts.\n\n- TestACLTagPropagationPortSpecific: use curl helpers and scaled\n  timeouts.\n\n- TestACLHostsInNetMapTable: scale the 10s EventuallyWithT timeout.\n\nUpdates #3125","parents":[{"sha":"f3512d50dfd2498e6a54e8bc6c651e8c0895a430","url":"https://api.github.com/repos/juanfont/headscale/git/commits/f3512d50dfd2498e6a54e8bc6c651e8c0895a430","html_url":"https://github.com/juanfont/headscale/commit/f3512d50dfd2498e6a54e8bc6c651e8c0895a430"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"9ab794280041f730fba7d6c2c68dcbbb21917b26","node_id":"C_kwDOEFLz89oAKDlhYjc5NDI4MDA0MWY3MzBmYmE3ZDZjMmM2OGRjYmJiMjE5MTdiMjY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/9ab794280041f730fba7d6c2c68dcbbb21917b26","html_url":"https://github.com/juanfont/headscale/commit/9ab794280041f730fba7d6c2c68dcbbb21917b26","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-30T13:45:22Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-30T13:45:22Z"},"tree":{"sha":"19e370ae143cc8915333358dc075b4b2dfe57c39","url":"https://api.github.com/repos/juanfont/headscale/git/trees/19e370ae143cc8915333358dc075b4b2dfe57c39"},"message":"integration/acl: use CurlFailFast for all negative curl assertions\n\nReplace Curl() with CurlFailFast() in all negative curl assertions\n(where the test expects the connection to fail). CurlFailFast uses\n1 retry and 2s max time instead of 3 retries and 5s max, which\navoids wasting time on unnecessary retries when we expect the\nconnection to be blocked.\n\nThis affects 21 call sites across 7 test functions:\n\n- TestACLAllowUser80Dst\n- TestACLDenyAllPort80\n- TestACLAllowUserDst\n- TestACLAllowStarDst\n- TestACLNamedHostsCanReach\n- TestACLDevice1CanAccessDevice2\n- TestPolicyUpdateWhileRunningWithCLIInDatabase\n- TestACLAutogroupSelf\n- TestACLPolicyPropagationOverTime\n\nWhere possible, the inline Curl+Error pattern is replaced with the\nassertCurlFailWithCollect helper introduced in the previous commit.\n\nUpdates #3125","parents":[{"sha":"1d90d6807c4bcb92b591eaf62c98e34d3e28f3c2","url":"https://api.github.com/repos/juanfont/headscale/git/commits/1d90d6807c4bcb92b591eaf62c98e34d3e28f3c2","html_url":"https://github.com/juanfont/headscale/commit/1d90d6807c4bcb92b591eaf62c98e34d3e28f3c2"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"fd1dd1d5b965ff261598ded17adfbccace89f95f","node_id":"C_kwDOEFLz89oAKGZkMWRkMWQ1Yjk2NWZmMjYxNTk4ZGVkMTdhZGZiY2NhY2U4OWY5NWY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/fd1dd1d5b965ff261598ded17adfbccace89f95f","html_url":"https://github.com/juanfont/headscale/commit/fd1dd1d5b965ff261598ded17adfbccace89f95f","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-30T13:48:58Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-30T13:48:58Z"},"tree":{"sha":"71970faa47fb825be37c95d72c2385363b83d347","url":"https://api.github.com/repos/juanfont/headscale/git/trees/71970faa47fb825be37c95d72c2385363b83d347"},"message":"integration: use CI-scaled timeouts for all EventuallyWithT assertions\n\nWrap all 329 hardcoded EventuallyWithT timeouts across 12 test files\nwith integrationutil.ScaledTimeout(), which applies a 2x multiplier\non CI runners. This addresses the systemic issue where hardcoded\ntimeouts that work locally are insufficient under CI resource\ncontention.\n\nVariable-based timeouts (propagationTime, assertTimeout in\nroute_test.go and totalWaitTime in auth_oidc_test.go) are wrapped\nat their definition site so all downstream usages benefit.\n\nThe retry intervals (second duration parameter) are intentionally\nNOT scaled, as they control polling frequency, not total wait time.\n\nUpdates #3125","parents":[{"sha":"9ab794280041f730fba7d6c2c68dcbbb21917b26","url":"https://api.github.com/repos/juanfont/headscale/git/commits/9ab794280041f730fba7d6c2c68dcbbb21917b26","html_url":"https://github.com/juanfont/headscale/commit/9ab794280041f730fba7d6c2c68dcbbb21917b26"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"83a230dfcffa20e57ab6d7fe88b0a9de11ffd096","node_id":"C_kwDOEFLz89oAKDgzYTIzMGRmY2ZmYTIwZTU3YWI2ZDdmZTg4YjBhOWRlMTFmZmQwOTY","url":"https://api.github.com/repos/juanfont/headscale/git/commits/83a230dfcffa20e57ab6d7fe88b0a9de11ffd096","html_url":"https://github.com/juanfont/headscale/commit/83a230dfcffa20e57ab6d7fe88b0a9de11ffd096","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-30T15:56:31Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-30T15:56:31Z"},"tree":{"sha":"40dd30dd789c7c34c79357fd4eed46cb25d95d5b","url":"https://api.github.com/repos/juanfont/headscale/git/trees/40dd30dd789c7c34c79357fd4eed46cb25d95d5b"},"message":"integration/acl: add tag verification step to TestACLTagPropagationPortSpecific\n\nTestACLTagPropagationPortSpecific failed twice on CI because it jumped\nfrom SetNodeTags directly to checking curl, without first verifying the\ntag change was applied on the server. This races against server-side\nprocessing.\n\nAdd a tag verification step (matching TestACLTagPropagation's pattern)\nand bump the Step 4 timeout from 60s to 90s since port-specific filter\nchanges require both endpoints to process the new PacketFilter from\nthe MapResponse while the WireGuard tunnel stays up.\n\nUpdates #3125","parents":[{"sha":"fd1dd1d5b965ff261598ded17adfbccace89f95f","url":"https://api.github.com/repos/juanfont/headscale/git/commits/fd1dd1d5b965ff261598ded17adfbccace89f95f","html_url":"https://github.com/juanfont/headscale/commit/fd1dd1d5b965ff261598ded17adfbccace89f95f"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"sha":"ad27db10a77e280eb69087e3986da6f9de83e4f4","node_id":"C_kwDOEFLz89oAKGFkMjdkYjEwYTc3ZTI4MGViNjkwODdlMzk4NmRhNmY5ZGU4M2U0ZjQ","url":"https://api.github.com/repos/juanfont/headscale/git/commits/ad27db10a77e280eb69087e3986da6f9de83e4f4","html_url":"https://github.com/juanfont/headscale/commit/ad27db10a77e280eb69087e3986da6f9de83e4f4","author":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-31T07:15:47Z"},"committer":{"name":"Kristoffer Dalby","email":"kristoffer@dalby.cc","date":"2026-03-31T07:15:47Z"},"tree":{"sha":"28f1284358f5fbe97c3e64c1ac67898974dcdee9","url":"https://api.github.com/repos/juanfont/headscale/git/trees/28f1284358f5fbe97c3e64c1ac67898974dcdee9"},"message":"integration: make docker execute and ping timeouts CI-aware\n\nThe default docker execute timeout (10s) is the root cause of\n\"dockertest command timed out\" errors across many integration tests\non CI. On congested GitHub Actions runners, docker exec latency\nalone can consume 2-5 seconds of this budget before the command\neven starts inside the container.\n\nReplace the hardcoded 10s constant with a function that returns\n20s on CI, doubling the budget for all container commands\n(tailscale status, headscale CLI, curl, etc.).\n\nSimilarly, scale the default tailscale ping timeout from 200ms to\n400ms on CI. This doubles the per-attempt budget and the docker\nexec timeout for pings (from 200ms*5=1s to 400ms*5=2s), giving\nmore headroom for docker exec overhead.\n\nUpdates #3125","parents":[{"sha":"83a230dfcffa20e57ab6d7fe88b0a9de11ffd096","url":"https://api.github.com/repos/juanfont/headscale/git/commits/83a230dfcffa20e57ab6d7fe88b0a9de11ffd096","html_url":"https://github.com/juanfont/headscale/commit/83a230dfcffa20e57ab6d7fe88b0a9de11ffd096"}],"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null},"event":"committed"},{"id":24066424544,"node_id":"RFRE_lADOEFLz8874m76ezwAAAAWaeH7g","url":"https://api.github.com/repos/juanfont/headscale/issues/events/24066424544","actor":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gis