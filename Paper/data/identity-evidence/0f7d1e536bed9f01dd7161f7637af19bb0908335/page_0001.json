b.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"kradalby","id":98431,"node_id":"MDQ6VXNlcjk4NDMx","avatar_url":"https://avatars.githubusercontent.com/u/98431?v=4","gravatar_id":"","url":"https://api.github.com/users/kradalby","html_url":"https://github.com/kradalby","followers_url":"https://api.github.com/users/kradalby/followers","following_url":"https://api.github.com/users/kradalby/following{/other_user}","gists_url":"https://api.github.com/users/kradalby/gists{/gist_id}","starred_url":"https://api.github.com/users/kradalby/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kradalby/subscriptions","organizations_url":"https://api.github.com/users/kradalby/orgs","repos_url":"https://api.github.com/users/kradalby/repos","events_url":"https://api.github.com/users/kradalby/events{/privacy}","received_events_url":"https://api.github.com/users/kradalby/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"fb619274a97841f95d895b1b8dfed88b50964014","url":"https://api.github.com/repos/juanfont/headscale/commits/fb619274a97841f95d895b1b8dfed88b50964014","html_url":"https://github.com/juanfont/headscale/commit/fb619274a97841f95d895b1b8dfed88b50964014"}],"stats":{"total":5,"additions":5,"deletions":0},"files":[{"sha":"1c3afd8cbd8d11b4f5df2fa90d9d1df7e859bf42","filename":"docs/about/faq.md","status":"modified","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/juanfont/headscale/blob/0f7d1e536bed9f01dd7161f7637af19bb0908335/docs%2Fabout%2Ffaq.md","raw_url":"https://github.com/juanfont/headscale/raw/0f7d1e536bed9f01dd7161f7637af19bb0908335/docs%2Fabout%2Ffaq.md","contents_url":"https://api.github.com/repos/juanfont/headscale/contents/docs%2Fabout%2Ffaq.md?ref=0f7d1e536bed9f01dd7161f7637af19bb0908335","patch":"@@ -206,6 +206,11 @@ Headscale, by default, instructs clients to disable log submission to the centra\n applied by a client once it successfully connected with Headscale. See the configuration option `logtail.enabled` in the\n [configuration file](../ref/configuration.md) for details.\n \n+Do not grant the `https://tailscale.com/cap/data-plane-audit-logs` node attribute while `logtail.enabled` is `false`. A\n+client with log submission disabled treats this attribute as \"the tailnet requires logging\" and turns itself off, as\n+`tailscale down` would. It stays off until the attribute is removed and `tailscale up` is run. A client started with\n+`TS_NO_LOGS_NO_SUPPORT=true` or `--no-logs-no-support` reacts the same way, whatever `logtail.enabled` says.\n+\n Alternatively, logging can also be disabled on the client side. This is independent of Headscale and opting out of\n client logging disables log submission early during client startup. The configuration is operating system specific and\n is usually achieved by setting the environment variable `TS_NO_LOGS_NO_SUPPORT=true` or by passing the flag"}]}